#!/bin/bash
set -e

case "$1" in
    configure)
        # Launch the setup wizard on fresh install only (not upgrades).
        # Prefer the packaged Wayland-aware launcher (DISPLAY alone is not enough).
        if [ -z "$2" ]; then
            LAUNCHER="/usr/share/ubuntu-hello-gtk/run_after_install.py"
            if [ -f "$LAUNCHER" ]; then
                python3 "$LAUNCHER" || true
            else
                REAL_USER="${SUDO_USER:-}"
                if [ -z "$REAL_USER" ] || [ "$REAL_USER" = "root" ]; then
                    REAL_USER=$(loginctl list-sessions --no-legend 2>/dev/null | awk '$3 != "" && $3 != "root" {print $3; exit}' || true)
                fi
                if [ -n "$REAL_USER" ] && [ "$REAL_USER" != "root" ]; then
                    UID_NUM=$(id -u "$REAL_USER" 2>/dev/null || true)
                    RUNTIME="/run/user/${UID_NUM}"
                    USER_HOME=$(eval echo "~$REAL_USER")
                    WAYLAND_OPT=()
                    if [ -S "${RUNTIME}/wayland-0" ]; then
                        WAYLAND_OPT=(WAYLAND_DISPLAY=wayland-0)
                    fi
                    sudo -u "$REAL_USER" -H env -i \
                        HOME="$USER_HOME" USER="$REAL_USER" LOGNAME="$REAL_USER" \
                        XDG_RUNTIME_DIR="$RUNTIME" \
                        DBUS_SESSION_BUS_ADDRESS="unix:path=${RUNTIME}/bus" \
                        DISPLAY="${DISPLAY:-:0}" \
                        "${WAYLAND_OPT[@]}" \
                        PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
                        ubuntu-hello-gtk --force-onboarding \
                        >>/tmp/ubuntu-hello-postinstall.log 2>&1 &
                fi
            fi
        fi
        ;;
esac

#DEBHELPER#

exit 0

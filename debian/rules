#!/usr/bin/make -f

export DH_VERBOSE = 1

DEB_HOST_GNU_TYPE := $(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)

%:
	dh $@ --buildsystem=meson


# Parallel packaging CI cells share a bind-mounted tree; default dh_clean
# runs find(1) across "." and fails when sibling cells remove build-* dirs
# mid-walk (e.g. build-flatpak). Clean only Debian/Meson outputs instead.
override_dh_clean:
	dh_auto_clean --buildsystem=meson
	rm -rf debian/.debhelper/ debian/tmp/ debian/ubuntu-hello/ \
		debian/ubuntu-hello-gtk/ obj-$(DEB_HOST_GNU_TYPE)
	rm -f debian/debhelper-build-stamp debian/ubuntu-hello.substvars \
		debian/ubuntu-hello-gtk.substvars debian/files \
		debian/ubuntu-hello.debhelper.log

override_dh_auto_configure:
	dh_auto_configure -- \
		-Ddlib_data_dir=/etc/ubuntu-hello/dlib-data \
		-Dconfig_dir=/etc/ubuntu-hello \
		-Duser_models_dir=/etc/ubuntu-hello/models \
		-Dinstall_pam_config=true \
		-Dwith_polkit=true \
		-Dfetch_dlib_data=false \
		-Dinih:with_INIReader=true

override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp

# Skip dh_shlibdeps for Python-only package
override_dh_shlibdeps:
	dh_shlibdeps -pubuntu-hello

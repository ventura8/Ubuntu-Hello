#!/bin/bash
set -e

case "$1" in
    configure)
        # shellcheck source=/dev/null
        . /usr/share/ubuntu-hello/package-configure.sh
        uh_package_configure
        # Setup wizard is launched from ubuntu-hello-gtk.postinst only when no
        # face models are enrolled yet (see that script). Do not launch here —
        # this package configures before gtk and must not force a second UI.
        ;;
esac

#DEBHELPER#

exit 0

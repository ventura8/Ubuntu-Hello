                <property name="margin-end">10</property>
                <property name="label" translatable="1">Keyring</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkNotebookPage">
            <property name="child">
              <object class="GtkBox" id="language_page">

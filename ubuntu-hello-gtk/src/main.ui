                        <property name="wrap">1</property>
                        <property name="max-width-chars">40</property>
                        <attributes>
                          <attribute name="weight" value="bold" />
                          <attribute name="scale" value="1.4" />
                        </attributes>
                        <style>
                          <class name="uh-page-title" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="language_restart_note">
                        <property name="label" translatable="1">Automatic follows the system language. Changes apply immediately.</property>
                        <property name="justify">center</property>
                        <property name="wrap">1</property>
                        <property name="max-width-chars">60</property>
                        <style>
                          <class name="dim-label" />
                          <class name="uh-page-hint" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="language_row">
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <property name="spacing">12</property>
                    <style>
                      <class name="uh-card" />
                    </style>
                    <child>
                      <object class="GtkLabel" id="language_label">
                        <property name="halign">center</property>
                        <property name="label" translatable="1">Language</property>
                        <property name="valign">center</property>
                  </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="language_combo">
                        <property name="width-request">320</property>
                        <property name="focusable">1</property>
                        <property name="halign">center</property>
                  </object>
                    </child>
                  </object>
                </child>
                
              </object>
            </property>
            <property name="tab">

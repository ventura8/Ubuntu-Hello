<?xml version='1.0' encoding='UTF-8'?>
<interface domain="ubuntu-hello-gtk">
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="mainwindow">
    <property name="margin_top">5</property>
    <property name="title" translatable="1" context="Window title">Ubuntu Hello Configuration</property>
    <child type="titlebar">
      <object class="GtkHeaderBar" id="headerbar">
        <child type="start">
          <object class="GtkSearchEntry" id="settings_search">
            <property name="focusable">1</property>
            <property name="width_chars">18</property>
            <property name="placeholder_text" translatable="1">Search settings</property>
            <signal name="search-changed" handler="on_settings_search_changed" swapped="no" />
            <signal name="stop-search" handler="on_settings_search_stop" swapped="no" />
          </object>
        </child>
        <property name="title-widget">
          <object class="GtkLabel">
            <property name="label" translatable="1">Ubuntu Hello Configuration</property>
            <style>
              <class name="title" />
            </style>
          </object>
        </property>
      </object>
    </child>
    <property name="child">
      <object class="GtkNotebook" id="notebook">
        <property name="focusable">1</property>
        <property name="margin-start">2</property>
        <property name="tab_pos">left</property>
        <property name="show_border">0</property>
        <signal name="switch-page" handler="on_page_switch" swapped="no" />
        <child>
          <object class="GtkNotebookPage">
            <property name="child">
              <object class="GtkBox" id="box3">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="halign">center</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">18</property>
                    <property name="margin-bottom">14</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">avatar-default-symbolic</property>
                        <property name="pixel-size">56</property>
                        <property name="margin-bottom">4</property>
                        <style>
                          <class name="dim-label" />
                          <class name="uh-page-icon" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="1">Face models</property>
                        <property name="justify">center</property>
                        <property name="wrap">1</property>
                        <property name="max-width-chars">40</property>
                        <attributes>
                          <attribute name="weight" value="bold" />
                          <attribute name="scale" value="1.4" />
                        </attributes>
                        <style>
                          <class name="uh-page-title" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="1">Snapshots of your face that Ubuntu Hello compares against. Keep at least two, recorded in different lighting.</property>
                        <property name="justify">center</property>
                        <property name="wrap">1</property>
                        <property name="max-width-chars">60</property>
                        <style>
                          <class name="dim-label" />
                          <class name="uh-page-hint" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="box4">
                    <property name="margin-start">10</property>
                    <property name="margin-end">10</property>
                    <property name="margin_top">10</property>
                    <property name="spacing">5</property>
                    <child>
                      <object class="GtkLabel" id="userlabel">
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                        <property name="label" translatable="1">Showing saved models for:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="userlist">
                        <property name="halign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="modellistbox">
                    <property name="margin-start">10</property>
                    <property name="margin-end">10</property>
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkSeparator" id="separator1">
                        <property name="margin_top">10</property>
                        <property name="margin_bottom">10</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkRevealer" id="single_model_infobar">
                        <property name="margin_top">10</property>
                        <property name="reveal-child">0</property>
                        <child>
                          <object class="GtkBox">
                            <property name="spacing">12</property>
                            <style>
                              <class name="uh-banner" />
                              <class name="warning" />
                            </style>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">dialog-warning-symbolic</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="single_model_label">
                                <property name="label" translatable="1">Only one face model is enrolled. Lighting changes how your face looks to the camera, so a single model can fail in the evening under lamps (or in daylight). Add a second model recorded in different light to keep unlocking reliable at any time of day.</property>
                                <property name="wrap">1</property>
                                <property name="max-width-chars">60</property>
                                <property name="hexpand">1</property>
                                <property name="xalign">0</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="single_model_button">
                                <property name="label" translatable="1">Add a second model</property>
                                <property name="valign">center</property>
                                <signal name="clicked" handler="on_single_model_button_clicked" swapped="no" />
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="box1">
                    <property name="halign">start</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="margin_top">10</property>
                    <property name="margin_bottom">12</property>
                    <property name="spacing">8</property>
                    <child>
                      <placeholder />
                    </child>
                    <child>
                      <object class="GtkButton" id="addbutton">
                        <property name="focusable">1</property>
                        <signal name="clicked" handler="on_model_add" swapped="no" />
                        <style>
                          <class name="suggested-action" />
                        </style>
                        <child>
                          <object class="GtkBox">
                            <property name="spacing">6</property>
                            <property name="halign">center</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">list-add-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="1">Add</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="deletebutton">
                        <property name="focusable">1</property>
                        <property name="margin-end">11</property>
                        <signal name="clicked" handler="on_model_delete" swapped="no" />
                        <style>
                          <class name="destructive-action" />
                        </style>
                        <child>
                          <object class="GtkBox">
                            <property name="spacing">6</property>
                            <property name="halign">center</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">user-trash-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="1">Delete</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
            <property name="tab">
              <object class="GtkLabel" id="modelstab">
                <property name="margin-start">10</property>
                <property name="margin-end">10</property>
                <property name="label" translatable="1">Models</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkNotebookPage">
            <property name="child">
              <object class="GtkBox" id="box2">
                <property name="orientation">vertical</property>
                <property name="margin-start">20</property>
                <property name="margin-end">20</property>
                <property name="margin_top">10</property>
                <property name="margin_bottom">10</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="halign">center</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">18</property>
                    <property name="margin-bottom">14</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">camera-web-symbolic</property>
                        <property name="pixel-size">56</property>
                        <property name="margin-bottom">4</property>
                        <style>
                          <class name="dim-label" />
                          <class name="uh-page-icon" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="1">Camera</property>
                        <property name="justify">center</property>
                        <property name="wrap">1</property>
                        <property name="max-width-chars">40</property>
                        <attributes>
                          <attribute name="weight" value="bold" />
                          <attribute name="scale" value="1.4" />
                        </attributes>
                        <style>
                          <class name="uh-page-title" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="1">The camera Ubuntu Hello uses to look for your face, with a live preview.</property>
                        <property name="justify">center</property>
                        <property name="wrap">1</property>
                        <property name="max-width-chars">60</property>
                        <style>
                          <class name="dim-label" />
                          <class name="uh-page-hint" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">10</property>
                    <property name="vexpand">1</property>
                    <child>
                  <object class="GtkBox" id="box7">
                    <property name="orientation">vertical</property>
                    <property name="hexpand">1</property>
                    <property name="spacing">4</property>
                    <child>
                      <object class="GtkLabel" id="label1">
                        <property name="halign">start</property>
                        <property name="label" translatable="1">Camera ID:</property>
                        <attributes>
                          <attribute name="weight" value="bold" />
                        </attributes>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="cameraselect">
                        <property name="hexpand">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label6">
                        <property name="halign">start</property>
                        <property name="margin_top">10</property>
                        <property name="label" translatable="1">Real resolution:</property>
                        <attributes>
                          <attribute name="weight" value="bold" />
                        </attributes>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="videores">
                        <property name="halign">start</property>
                        <property name="selectable">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label7">
                        <property name="halign">start</property>
                        <property name="margin_top">10</property>
                        <property name="label" translatable="1">Used resolution:</property>
                        <attributes>
                          <attribute name="weight" value="bold" />
                        </attributes>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="videoresused">
                        <property name="halign">start</property>
                        <property name="selectable">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label8">
                        <property name="halign">start</property>
                        <property name="margin_top">10</property>
                        <property name="label" translatable="1">Recorder:</property>
                        <attributes>
                          <attribute name="weight" value="bold" />
                        </attributes>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="videorecorder">
                        <property name="halign">start</property>
                        <property name="selectable">1</property>
                      </object>
                    </child>
                    <child>
                      <placeholder />
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="opencvbox">
                    <property name="hexpand">1</property>
                    <property name="halign">center</property>
                    <property name="valign">start</property>
                    <property name="width_request">400</property>
                    <property name="height_request">300</property>
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <style>
                      <class name="preview-frame" />
                    </style>
                    <child>
                      <object class="GtkPicture" id="opencvimage">
                        <property name="hexpand">1</property>
                        <property name="vexpand">0</property>
                        <property name="content-fit">contain</property>
                        <property name="can-shrink">1</property>
                      </object>
                    </child>
                  </object>
                </child>
              
                  </object>
                </child>
              </object>
            </property>
            <property name="tab">
              <object class="GtkLabel" id="videotab">
                <property name="label" translatable="1">Video</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkNotebookPage">
            <property name="child">
              <object class="GtkBox" id="notificationsbox">
                <property name="margin-start">20</property>
                <property name="margin-end">20</property>
                <property name="margin_top">10</property>
                <property name="margin_bottom">30</property>
                <property name="orientation">vertical</property>
                <property name="spacing">20</property>
                
                
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="halign">center</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">18</property>
                    <property name="margin-bottom">14</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">preferences-system-notifications-symbolic</property>
                        <property name="pixel-size">56</property>
                        <property name="margin-bottom">4</property>
                        <style>
                          <class name="dim-label" />
                          <class name="uh-page-icon" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="notifications_title">
                        <property name="label" translatable="1">Notifications</property>
                        <property name="justify">center</property>
                        <property name="wrap">1</property>
                        <property name="max-width-chars">40</property>
                        <attributes>
                          <attribute name="weight" value="bold" />
                          <attribute name="scale" value="1.4" />
                        </attributes>
                        <style>
                          <class name="uh-page-title" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="notifications_desc">
                        <property name="label" translatable="1">A desktop notification shows while Ubuntu Hello looks for your face, then reports the result. Failed attempts stay in the notification list.</property>
                        <property name="justify">center</property>
                        <property name="wrap">1</property>
                        <property name="max-width-chars">60</property>
                        <style>
                          <class name="dim-label" />
                          <class name="uh-page-hint" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="notifications_card">
                    <property name="orientation">vertical</property>
                    <property name="spacing">14</property>
                    <property name="halign">center</property>
                    <property name="width-request">520</property>
                    <style>
                      <class name="uh-card" />
                    </style>
                    <child>
                  <object class="GtkBox" id="notifications_enabled_switch_row">
                    <property name="spacing">20</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="hexpand">1</property>
                        <child>
                          <object class="GtkLabel" id="notifications_enabled_switch_label">
                            <property name="halign">start</property>
                            <property name="label" translatable="1">Show notifications</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="notifications_enabled_switch_desc">
                            <property name="halign">start</property>
                            <property name="label" translatable="1">One card per face-authentication attempt, updated in place with the result.</property>
                            <property name="wrap">1</property>
                    <property name="max-width-chars">70</property>
                            <property name="max_width_chars">48</property>
                            <style>
                              <class name="dim-label" />
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSwitch" id="notifications_enabled_switch">
                        <property name="halign">center</property>
                        <property name="focusable">1</property>
                        <property name="valign">center</property>
                        <signal name="state-set" handler="on_notifications_enabled_state_set" swapped="no" />
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="notifications_sound_switch_row">
                    <property name="spacing">20</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="hexpand">1</property>
                        <child>
                          <object class="GtkLabel" id="notifications_sound_switch_label">
                            <property name="halign">start</property>
                            <property name="label" translatable="1">Notification sounds</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="notifications_sound_switch_desc">
                            <property name="halign">start</property>
                            <property name="label" translatable="1">Play the system sound for a recognized or failed attempt.</property>
                            <property name="wrap">1</property>
                    <property name="max-width-chars">70</property>
                            <property name="max_width_chars">48</property>
                            <style>
                              <class name="dim-label" />
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSwitch" id="notifications_sound_switch">
                        <property name="halign">center</property>
                        <property name="focusable">1</property>
                        <property name="valign">center</property>
                        <signal name="state-set" handler="on_notifications_sound_state_set" swapped="no" />
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="notifications_details_switch_row">
                    <property name="spacing">20</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="hexpand">1</property>
                        <child>
                          <object class="GtkLabel" id="notifications_details_switch_label">
                            <property name="halign">start</property>
                            <property name="label" translatable="1">Include diagnostics</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="notifications_details_switch_desc">
                            <property name="halign">start</property>
                            <property name="label" translatable="1">Add the model, certainty vs. threshold, frames, camera and timing to each card. Useful when reporting a problem.</property>
                            <property name="wrap">1</property>
                    <property name="max-width-chars">70</property>
                            <property name="max_width_chars">48</property>
                            <style>
                              <class name="dim-label" />
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSwitch" id="notifications_details_switch">
                        <property name="halign">center</property>
                        <property name="focusable">1</property>
                        <property name="valign">center</property>
                        <signal name="state-set" handler="on_notifications_details_state_set" swapped="no" />
                      </object>
                    </child>
                  </object>
                </child>
                  </object>
                </child>
              </object>
            </property>
            <property name="tab">
              <object class="GtkLabel" id="notificationstab">
                <property name="label" translatable="1">Notifications</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkNotebookPage">
            <property name="child">
              <object class="GtkBox" id="keyringbox">
                <property name="margin-start">20</property>
                <property name="margin-end">20</property>
                <property name="margin_top">10</property>
                <property name="margin_bottom">30</property>
                <property name="orientation">vertical</property>
                <property name="spacing">20</property>
                
                
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="halign">center</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">18</property>
                    <property name="margin-bottom">14</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">dialog-password-symbolic</property>
                        <property name="pixel-size">56</property>
                        <property name="margin-bottom">4</property>
                        <style>
                          <class name="dim-label" />
                          <class name="uh-page-icon" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="keyring_title">
                        <property name="label" translatable="1">Keyring / KWallet Auto-Unlock</property>
                        <property name="justify">center</property>
                        <property name="wrap">1</property>
                        <property name="max-width-chars">40</property>
                        <attributes>
                          <attribute name="weight" value="bold" />
                          <attribute name="scale" value="1.4" />
                        </attributes>
                        <style>
                          <class name="uh-page-title" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="keyring_desc">
                        <property name="label" translatable="1">Enable face authentication to automatically unlock your login keyring or KWallet on login. This securely stores your password sealed in the TPM when available, or encrypted with AES-256-GCM using a root-only master key. Face auth sets PAM_AUTHTOK for pam_gnome_keyring or pam_kwallet5 depending on your desktop.</property>
                        <property name="justify">center</property>
                        <property name="wrap">1</property>
                        <property name="max-width-chars">60</property>
                        <style>
                          <class name="dim-label" />
                          <class name="uh-page-hint" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="keyring_card">
                    <property name="orientation">vertical</property>
                    <property name="spacing">14</property>
                    <property name="halign">center</property>
                    <property name="width-request">520</property>
                    
                <style>
                  <class name="uh-card" />
                </style>
                <child>
                  <object class="GtkBox" id="keyring_status_box">
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkLabel" id="keyring_status_title">
                        <property name="halign">center</property>
                        <property name="label" translatable="1">Current Status:</property>
                        <attributes>
                          <attribute name="weight" value="bold" />
                        </attributes>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="keyring_status_label">
                        <property name="halign">center</property>
                        <property name="label" translatable="1">Checking...</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="keyring_button_box">
                    <property name="halign">center</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkButton" id="keyring_enable_button">
                        <property name="label" translatable="1">Enable Auto-Unlock</property>
                        <property name="focusable">1</property>
                        <signal name="clicked" handler="on_keyring_enable" swapped="no" />
                        <style>
                          <class name="suggested-action" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="keyring_disable_button">
                        <property name="label" translatable="1">Disable Auto-Unlock</property>
                        <property name="focusable">1</property>
                        <signal name="clicked" handler="on_keyring_disable" swapped="no" />
                        <style>
                          <class name="destructive-action" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                  </object>
                </child>
              </object>
            </property>
            <property name="tab">
              <object class="GtkLabel" id="keyringtab">

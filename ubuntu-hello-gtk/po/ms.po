#: src/onboarding.py:446
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Checking TPM hardware and tools..."
msgstr ""
"Ubuntu Hello boleh membuka kunci {} anda secara automatik menggunakan "
"pengesahan muka (dompet yang dikesan: {}).\n"
"\n"
"<b>Status TPM:</b> Menyemak perkakasan dan alatan TPM..."

#: src/onboarding.py:466
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected. Installing <i>tpm2-tools</i> "
"automatically..."
msgstr ""
"Ubuntu Hello boleh membuka kunci {} anda secara automatik menggunakan "
"pengesahan muka (dompet yang dikesan: {}).\n"
"\n"
"<b>Status TPM:</b> Perkakasan TPM dikesan. Memasang <i>tpm2-tools</i> secara "
"automatik..."

#: src/onboarding.py:478
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Hardware TPM 2.0 active. Your password will be securely "
"sealed inside the TPM."
msgstr ""
"Ubuntu Hello boleh membuka kunci {} anda secara automatik menggunakan "
"pengesahan muka (dompet yang dikesan: {}).\n"
"\n"
"<b>Status TPM:</b> Perkakasan TPM 2.0 aktif. Kata laluan anda akan dimeterai "
"dengan selamat di dalam TPM."

#: src/onboarding.py:480
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected, but automatic installation of "
"<i>tpm2-tools</i> failed. Run <code>sudo apt install tpm2-tools</code>. "
"Falling back to software-based credential caching."
msgstr ""
"Ubuntu Hello boleh membuka kunci {} anda secara automatik menggunakan "
"pengesahan muka (dompet yang dikesan: {}).\n"
"\n"
"<b>Status TPM:</b> Perkakasan TPM dikesan, tetapi pemasangan automatik "
"<i>tpm2-tools</i> gagal. Jalankan <code>sudo apt install tpm2-tools</code>. "
"Kembali kepada caching kelayakan berasaskan perisian."

#: src/onboarding.py:482
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> No TPM hardware detected. Using software-based credential "
"caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello boleh membuka kunci {} anda secara automatik menggunakan "
"pengesahan muka (dompet yang dikesan: {}).\n"
"\n"
"<b>Status TPM:</b> Tiada perkakasan TPM dikesan. Menggunakan caching "
"kelayakan berasaskan perisian (AES-256-GCM)."


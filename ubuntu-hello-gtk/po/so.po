msgstr "Kamarada la doortay lama furi karo"

#: src/onboarding.py:624
msgid "Try to select another one"
msgstr "Isku day inaad doorato mid kale"

#: src/onboarding.py:639
msgid ""
"Please visit\n<a href=\"https://github.com/EmixamPP/linux-enable-ir-em"
"itter\">https://github.com/EmixamPP/linux-enable-ir-emitter</a>\nto en"
"able your ir emitter"
msgstr ""
"Fadlan booqo\n<a href=\"https://github.com/EmixamPP/linux-enable-ir-em"
"itter\">https://github.com/EmixamPP/linux-enable-ir-emitter</a>\nsi aa"
"d awood ugu yeelatid ir emitter-kaaga"


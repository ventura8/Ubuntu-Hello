msgstr "Kaamarooyinka mareegaha lagama helin nidaamka"

#: src/onboarding.py:386
msgid ""
"Please configure your camera yourself if you are sure a compatible cam"
"era is connected"
msgstr ""
"Fadlan isku habbee kamaradaada haddii aad hubto in kamarad ku habbooni"
" ay ku xidhan tahay"

#: src/onboarding.py:478
msgid "No, camera can't be opened"
msgstr "Maya, kamarad lama furi karo"

#: src/onboarding.py:490
msgid "No, not an infrared camera"
msgstr "Maya, maaha kamarad infrared ah"

#: src/onboarding.py:494
msgid "Yes, compatible infrared camera"
msgstr "Haa, kamarad infrared ah oo ku habboon"


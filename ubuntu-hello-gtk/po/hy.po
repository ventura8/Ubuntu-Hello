"Չհաջողվեց միացնել ստեղնաշարի ապակողպումը. ժամանակն ավարտվել է, երբ սպասվում "
"է ստեղնաշարի միացմանը (keyring enable)"

#: src/onboarding.py:946
msgid "Keyring Unlocking Error"
msgstr "Ստեղնաշարի ապակողպման սխալ"

#: src/onboarding.py:957
msgid "Error reading radio buttons"
msgstr "Չհաջողվեց կարդալ ռադիո կոճակները"

#: src/onboarding.py:1021
msgid "Could not save the security settings, but setup is otherwise complete."
msgstr ""
"Չհաջողվեց պահպանել անվտանգության կարգավորումները, սակայն կարգավորման մնացած "
"մասն ավարտված է։"

#: src/authsticky.py:110
msgid "Loading...  "
msgstr "Բեռնվում է..."

#: src/authsticky.py:128
msgid "Ubuntu Hello Authentication"
msgstr "Ubuntu Hello Նույնականացում"

#: src/tab_models.py:22
msgid "Confirm Model Creation"
msgstr "Հաստատեք մոդելի ստեղծումը"

#: src/tab_models.py:23 src/tab_models.py:89 src/tab_keyring.py:17

msgstr "Չհաջողվեց ընտրել տեսախցիկը"

#: src/onboarding.py:624
msgid "The selected camera cannot be opened"
msgstr "Ընտրված տեսախցիկը հնարավոր չէ բացել"

#: src/onboarding.py:624
msgid "Try to select another one"
msgstr "Փորձեք ընտրել մեկ ուրիշը"

#: src/onboarding.py:639
msgid ""
"Please visit\n<a href=\"https://github.com/EmixamPP/linux-enable-ir-em"
"itter\">https://github.com/EmixamPP/linux-enable-ir-emitter</a>\nto en"
"able your ir emitter"
msgstr ""
"Խնդրում ենք այցելել\n<a href=\"https://github.com/EmixamPP/linux-enabl"
"e-ir-emitter\">https://github.com/EmixamPP/linux-enable-ir-emitter</a>"
"\nձեր ir արտանետիչը միացնելու համար"

#: src/onboarding.py:704
msgid "Setup lighting 1"
msgstr "Լուսավորման կարգավորում 1"

#: src/onboarding.py:705
msgid "Setup lighting 2"
msgstr "Լուսավորության կարգավորում 2"

#: src/onboarding.py:723
msgid "Can't save face model"
msgstr "Չհաջողվեց պահպանել դեմքի մոդելը"

#: src/onboarding.py:728 src/onboarding.py:775
msgid "Scan second model"
msgstr "Երկրորդ մոդելի սկանավորում"


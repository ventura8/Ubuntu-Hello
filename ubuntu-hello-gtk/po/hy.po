#: src/main.ui:771 src/onboarding.ui:759
msgid "Keyring / KWallet Auto-Unlock"
msgstr "Keyring / KWallet Ավտոմատ բացում"

#: src/main.ui:786
msgid ""
"Enable face authentication to automatically unlock your login keyring or "
"KWallet on login. This securely stores your password sealed in the TPM when "
"available, or encrypted with AES-256-GCM using a root-only master key. Face "
"auth sets PAM_AUTHTOK for pam_gnome_keyring or pam_kwallet5 depending on "
"your desktop."
msgstr ""
"Միացրեք դեմքի նույնականացումը՝ ձեր մուտքի բանալին ավտոմատ բացելու համար կամ "
"KWallet մուտք գործելու ժամանակ: Սա ապահով կերպով պահում է ձեր գաղտնաբառը, "
"որը կնքված է TPM-ում, երբ առկա է, կամ գաղտնագրված է AES-256-GCM-ով, "
"օգտագործելով միայն root-ի համար նախատեսված հիմնական բանալի: Դեմքի "
"վավերացումը սահմանում է PAM_AUTHTOK pam_gnome_keyring կամ pam_kwallet5 "
"համար՝ կախված ձեր աշխատասեղանից:"


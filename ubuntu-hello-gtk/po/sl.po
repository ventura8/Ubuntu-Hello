#: src/onboarding.py:446
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Checking TPM hardware a"
"nd tools..."
msgstr ""
"Ubuntu Hello lahko samodejno odklene vaš {} z uporabo preverjanja pris"
"tnosti obraza (zaznana denarnica: {}).\n\n<b>Stanje TPM:</b> Preverjan"
"je strojne opreme in orodij TPM ..."

#: src/onboarding.py:466
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected. "
"Installing <i>tpm2-tools</i> automatically..."
msgstr ""
"Ubuntu Hello lahko samodejno odklene vaš {} z uporabo preverjanja pris"
"tnosti obraza (zaznana denarnica: {}).\n\n<b>Stanje TPM:</b> zaznana s"
"trojna oprema TPM. Samodejna namestitev <i>tpm2-tools</i> ..."

#: src/onboarding.py:478
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Hardware TPM 2.0 active"
". Your password will be securely sealed inside the TPM."
msgstr ""
"Ubuntu Hello lahko samodejno odklene vaš {} z uporabo preverjanja pris"
"tnosti obraza (zaznana denarnica: {}).\n\n<b>Stanje TPM:</b> Strojna o"
"prema TPM 2.0 je aktivna. Vaše geslo bo varno zapečateno znotraj TPM."

#: src/onboarding.py:480
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected, "
"but automatic installation of <i>tpm2-tools</i> failed. Run <code>sudo"
" apt install tpm2-tools</code>. Falling back to software-based credent"
"ial caching."
msgstr ""
"Ubuntu Hello lahko samodejno odklene vaš {} z uporabo preverjanja pris"
"tnosti obraza (zaznana denarnica: {}).\n\n<b>Stanje TPM:</b> zaznana s"
"trojna oprema TPM, vendar samodejna namestitev <i>tpm2-tools</i> ni us"
"pela. Zaženite <code>sudo apt install tpm2-tools</code>. Vrnitev na pr"
"ogramsko predpomnjenje poverilnic."

#: src/onboarding.py:482
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> No TPM hardware detecte"
"d. Using software-based credential caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello lahko samodejno odklene vaš {} z uporabo preverjanja pris"
"tnosti obraza (zaznana denarnica: {}).\n\n<b>Stanje TPM:</b> Ni zaznan"
"e strojne opreme TPM. Uporaba programskega predpomnjenja poverilnic (A"
"ES-256-GCM)."


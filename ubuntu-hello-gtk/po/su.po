msgstr "Coba pasang deui cv2"

#: src/onboarding.py:386
msgid "No webcams found on system"
msgstr "Taya webcams kapanggih dina sistem"

#: src/onboarding.py:386
msgid ""
"Please configure your camera yourself if you are sure a compatible cam"
"era is connected"
msgstr ""
"Mangga ngonpigurasikeun kaméra anjeun sorangan lamun anjeun yakin kamé"
"ra cocog disambungkeun"

#: src/onboarding.py:478
msgid "No, camera can't be opened"
msgstr "Henteu, kaméra teu tiasa dibuka"

#: src/onboarding.py:490
msgid "No, not an infrared camera"
msgstr "Henteu, sanés kaméra infra red"

#: src/onboarding.py:494
msgid "Yes, compatible infrared camera"
msgstr "Sumuhun, kaméra infra red cocog"

#: src/onboarding.py:519
msgid "Camera identifier or path"
msgstr "Identifier kaméra atawa jalur"

#: src/onboarding.py:519
msgid "Recommended"
msgstr "Dianjurkeun"


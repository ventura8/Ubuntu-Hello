msgstr "Coba pasang deui cv2"

#: src/onboarding.py:382
msgid "No webcams found on system"
msgstr "Taya webcams kapanggih dina sistem"

#: src/onboarding.py:382
msgid ""
"Please configure your camera yourself if you are sure a compatible camera is "
"connected"
msgstr ""
"Mangga ngonpigurasikeun kaméra anjeun sorangan lamun anjeun yakin kaméra "

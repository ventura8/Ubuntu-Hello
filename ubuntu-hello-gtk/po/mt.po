#: src/onboarding.py:446
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Checking TPM hardware and tools..."
msgstr ""
"Ubuntu Hello tista' awtomatikament tiftaħ il-{} tiegħek billi tuża l-"
"awtentikazzjoni tal-wiċċ (kartiera skoperta: {}).\n"
"\n"
"<b>Status TPM:</b> Tiċċekkja l-ħardwer u l-għodod tat-TPM..."

#: src/onboarding.py:466
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected. Installing <i>tpm2-tools</i> "
"automatically..."
msgstr ""
"Ubuntu Hello tista' awtomatikament tiftaħ il-{} tiegħek billi tuża l-"
"awtentikazzjoni tal-wiċċ (kartiera skoperta: {}).\n"
"\n"
"<b>Status TPM:</b> Ħardwer TPM misjub. Installazzjoni ta' <i>tpm2-tools</i> "
"awtomatikament..."

#: src/onboarding.py:478
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Hardware TPM 2.0 active. Your password will be securely "
"sealed inside the TPM."
msgstr ""
"Ubuntu Hello tista' awtomatikament tiftaħ il-{} tiegħek billi tuża l-"
"awtentikazzjoni tal-wiċċ (kartiera skoperta: {}).\n"
"\n"
"<b>Status TPM:</b> Ħardwer TPM 2.0 attiv. Il-password tiegħek se tkun "
"issiġillata b'mod sigur ġewwa t-TPM."

#: src/onboarding.py:480
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected, but automatic installation of "
"<i>tpm2-tools</i> failed. Run <code>sudo apt install tpm2-tools</code>. "
"Falling back to software-based credential caching."
msgstr ""
"Ubuntu Hello tista' awtomatikament tiftaħ il-{} tiegħek billi tuża l-"
"awtentikazzjoni tal-wiċċ (kartiera skoperta: {}).\n"
"\n"
"<b>Status TPM:</b> Instab ħardwer TPM, iżda l-installazzjoni awtomatika ta' "
"<i>tpm2-tools</i> falliet. Mexxi <code>sudo apt install tpm2-tools</code>. "
"Jaqa 'lura għall-caching tal-kredenzjali bbażat fuq softwer."

#: src/onboarding.py:482
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> No TPM hardware detected. Using software-based credential "
"caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello tista' awtomatikament tiftaħ il-{} tiegħek billi tuża l-"
"awtentikazzjoni tal-wiċċ (kartiera skoperta: {}).\n"
"\n"
"<b>Status TPM:</b> L-ebda ħardwer TPM misjub. Bl-użu ta' caching ta' "
"kredenzjali bbażat fuq softwer (AES-256-GCM)."


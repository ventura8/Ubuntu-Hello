#: src/window.py:122
msgid "ID"
msgstr "ID"

#: src/window.py:122
msgid "Created"
msgstr "ສ້າງແລ້ວ"

#: src/window.py:122
msgid "Label"
msgstr "ປ້າຍກຳກັບ"

#: src/window.py:228
msgid "Automatic"
msgstr "ອັດຕະໂນມັດ"

#: src/onboarding.py:206 src/onboarding.ui:293
msgid "Adding your face models"
msgstr "ການເພີ່ມຮູບແບບໃບຫນ້າຂອງທ່ານ"

#: src/onboarding.py:209 src/onboarding.ui:309
msgid ""
"Ubuntu Hello records your face from a few angles in about a minute: keep "
"your face inside the preview and follow the prompts (look straight, turn "
"slightly left and right, chin up and down). Afterwards a second, optional "
"scan — with glasses, different facial hair or other lighting — makes "
"recognition even more reliable at any time of day."
msgstr ""
"Ubuntu Hello ບັນທຶກໃບໜ້າຂອງທ່ານຈາກຫຼາຍມຸມພາຍໃນປະມານໜຶ່ງນາທີ: ໃຫ້ໃບໜ້າຢູ່ໃນກອບຕົວຢ່າງ ແລະ "
"ເຮັດຕາມຄຳແນະນຳ (ເບິ່ງຊື່ໆ, ຫັນຊ້າຍຂວາເລັກນ້ອຍ, ເງີຍ ແລະ ກົ້ມຄາງ). ຫຼັງຈາກນັ້ນ "
"ການສະແກນຄັ້ງທີສອງທີ່ເປັນທາງເລືອກ — ໃສ່ແວ່ນຕາ, ໜວດເຄົາຕ່າງກັນ ຫຼື ແສງອື່ນ — "
"ເຮັດໃຫ້ການຈົດຈຳເຊື່ອຖືໄດ້ຫຼາຍຂຶ້ນໃນທຸກເວລາຂອງມື້."

#: src/onboarding.py:212 src/onboarding.py:652 src/onboarding.py:757
#: src/onboarding.ui:335
msgid "Please look directly into the camera"
msgstr "ກະລຸນາເບິ່ງໂດຍກົງໃນກ້ອງຖ່າຍຮູບ"

#: src/onboarding.py:215 src/onboarding.py:705 src/onboarding.ui:370
msgid "Start face scan"
msgstr "ເລີ່ມການສະແກນໃບໜ້າ"

#: src/onboarding.py:279
msgid ""
"Datafiles have already been downloaded!\n"
"Click Next to continue"
msgstr ""
"ໄຟລ໌ຂໍ້ມູນໄດ້ຖືກດາວໂຫຼດແລ້ວ!\n"
"ຄລິກຕໍ່ໄປເພື່ອສືບຕໍ່"

#: src/onboarding.py:316
msgid "Error while downloading datafiles"
msgstr "ເກີດຄວາມຜິດພາດໃນລະຫວ່າງການດາວໂຫຼດໄຟລ໌ຂໍ້ມູນ"

#: src/onboarding.py:319
msgid ""
"Done!\n"
"Click Next to continue"
msgstr ""
"ສຳເລັດແລ້ວ!\n"
"ຄລິກຕໍ່ໄປເພື່ອສືບຕໍ່"

#: src/onboarding.py:371 src/onboarding.py:564
msgid "Error while importing OpenCV2"
msgstr "ຜິດພາດໃນຂະນະທີ່ນໍາເຂົ້າ OpenCV2"

#: src/onboarding.py:371 src/onboarding.py:564
msgid "Try reinstalling cv2"
msgstr "ລອງຕິດຕັ້ງຄືນໃໝ່ cv2"

#: src/onboarding.py:382
msgid "No webcams found on system"
msgstr "ບໍ່ພົບ webcams ໃນລະບົບ"

#: src/onboarding.py:382
msgid ""
"Please configure your camera yourself if you are sure a compatible camera is "
"connected"
msgstr "ກະລຸນາຕັ້ງຄ່າກ້ອງຖ່າຍຮູບຂອງທ່ານເອງຖ້າທ່ານແນ່ໃຈວ່າກ້ອງຖ່າຍຮູບທີ່ເຂົ້າກັນໄດ້ເຊື່ອມຕໍ່ກັນ"

#: src/onboarding.py:455
msgid "No, camera can't be opened"
msgstr "ບໍ່, ກ້ອງບໍ່ສາມາດເປີດໄດ້"

#: src/onboarding.py:467
msgid "No, not an infrared camera"
msgstr "ບໍ່, ບໍ່ແມ່ນກ້ອງອິນຟາເຣດ"

#: src/onboarding.py:471
msgid "Yes, compatible infrared camera"
msgstr "ແມ່ນແລ້ວ, ກ້ອງອິນຟາເລດເຂົ້າກັນໄດ້"

#: src/onboarding.py:488
msgid "Camera identifier or path"
msgstr "ຕົວລະບຸກ້ອງຖ່າຍຮູບ ຫຼືເສັ້ນທາງ"

#: src/onboarding.py:488
msgid "Recommended"
msgstr "ແນະນຳ"

#: src/onboarding.py:568 src/onboarding.py:607
msgid "Error selecting camera"
msgstr "ເລືອກກ້ອງຖ່າຍຮູບຜິດພາດ"

#: src/onboarding.py:582
msgid "The selected camera cannot be opened"
msgstr "ບໍ່ສາມາດເປີດກ້ອງທີ່ເລືອກໄດ້"

#: src/onboarding.py:582
msgid "Try to select another one"
msgstr "ພະຍາຍາມເລືອກອັນອື່ນ"

#: src/onboarding.py:597
msgid ""
"Please visit\n"
"<a href=\"https://github.com/EmixamPP/linux-enable-ir-emitter\">https://"
"github.com/EmixamPP/linux-enable-ir-emitter</a>\n"
"to enable your ir emitter"
msgstr ""
"ກະລຸນາໄປຢ້ຽມຢາມ\n"
"<a href=\"https://github.com/EmixamPP/linux-enable-ir-emitter\">https://"
"github.com/EmixamPP/linux-enable-ir-emitter</a>\n"
"ເພື່ອເປີດໃຊ້ ir emitter ຂອງທ່ານ"

#: src/onboarding.py:665
msgid "Setup lighting 1"
msgstr "ການຕັ້ງຄ່າ ແສງ 1"

#: src/onboarding.py:666
msgid "Setup lighting 2"
msgstr "ການຕັ້ງຄ່າ ແສງ 2"

#: src/onboarding.py:707
msgid "Can't save face model"
msgstr "ບໍ່ສາມາດບັນທຶກຮູບແບບໃບໜ້າໄດ້"

#: src/onboarding.py:712 src/onboarding.py:759
msgid "Scan second model"
msgstr "ສະແກນໂມເດວທີສອງ"

#: src/onboarding.py:718
msgid "Couldn't record the second model"
msgstr "ບໍ່ສາມາດບັນທຶກໂມເດວທີສອງໄດ້"

#: src/onboarding.py:719
msgid ""
"Your first model is saved, so face login already works. The room must still "
"be bright enough to see your face — change the light rather than turning it "
"off — then try again, or skip and add a model later from Settings."
msgstr ""
"ຮູບແບບທໍາອິດຂອງທ່ານຖືກບັນທຶກໄວ້, ດັ່ງນັ້ນການເຂົ້າສູ່ລະບົບດ້ວຍໃບຫນ້າເຮັດວຽກຢູ່ແລ້ວ. "
"ຫ້ອງຍັງຕ້ອງມີຄວາມສະຫວ່າງພໍທີ່ຈະເຫັນໜ້າຂອງເຈົ້າ — ປ່ຽນແສງແທນທີ່ຈະປິດມັນ — ຈາກນັ້ນລອງອີກຄັ້ງ ຫຼືຂ້າມໄປ "
"ແລະເພີ່ມຕົວແບບໃນພາຍຫຼັງຈາກການຕັ້ງຄ່າ."

#: src/onboarding.py:753
msgid "Second scan: glasses, facial hair or different lighting"
msgstr "ການສະແກນຄັ້ງທີສອງ: ແວ່ນຕາ, ໜວດເຄົາ ຫຼື ແສງທີ່ຕ່າງກັນ"

#: src/onboarding.py:755
msgid ""
"First model saved: face login already works. A second model makes "
"recognition more reliable when something changes: put on the glasses you "
"sometimes wear (or take them off), or record it with different facial hair, "
"and change the light — turn a lamp on or off, move away from the window. "
"Keep your face clearly visible and press Scan again; the same short guided "
"capture follows."
msgstr ""
"ບັນທຶກແບບຈຳລອງທຳອິດແລ້ວ: ການເຂົ້າສູ່ລະບົບດ້ວຍໃບໜ້າໃຊ້ໄດ້ແລ້ວ. "
"ແບບຈຳລອງທີສອງເຮັດໃຫ້ການຈົດຈຳເຊື່ອຖືໄດ້ຫຼາຍຂຶ້ນເມື່ອມີສິ່ງໃດປ່ຽນແປງ: ໃສ່ແວ່ນຕາທີ່ທ່ານໃສ່ບາງຄັ້ງ (ຫຼື "
"ຖອດອອກ), ບັນທຶກດ້ວຍໜວດເຄົາທີ່ຕ່າງກັນ, ແລະ ປ່ຽນແສງ — ເປີດ ຫຼື ປິດໂຄມໄຟ, ຍ້າຍອອກຈາກປ່ອງຢ້ຽມ. "
"ໃຫ້ໃບໜ້າເຫັນຊັດເຈນ ແລ້ວກົດສະແກນອີກຄັ້ງ; ການບັນທຶກແບບມີຄຳແນະນຳສັ້ນໆແບບດຽວກັນຈະຕາມມາ."

#: src/onboarding.py:797
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Checking TPM hardware and tools..."
msgstr ""
"Ubuntu Helloສາມາດປົດລັອກ {} ຂອງທ່ານໂດຍອັດຕະໂນມັດດ້ວຍການພິສູດຢືນຢັນໃບໜ້າ "
"(ກະເປົາເງິນທີ່ກວດພົບ: {}).\n"
"\n"
"<b>ສະຖານະ TPM:</b> ກຳລັງກວດສອບຮາດແວ TPM ແລະເຄື່ອງມື..."

#: src/onboarding.py:817
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected. Installing <i>tpm2-tools</i> "
"automatically..."
msgstr ""
"Ubuntu Helloສາມາດປົດລັອກ {} ຂອງທ່ານໂດຍອັດຕະໂນມັດດ້ວຍການພິສູດຢືນຢັນໃບໜ້າ "
"(ກະເປົາເງິນທີ່ກວດພົບ: {}).\n"
"\n"
"<b>ສະຖານະ TPM:</b> ກວດພົບຮາດແວ TPM. ກຳລັງຕິດຕັ້ງ <i>tpm2-tools</i> ໂດຍອັດຕະໂນມັດ..."

#: src/onboarding.py:829
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Hardware TPM 2.0 active. Your password will be securely "
"sealed inside the TPM."
msgstr ""
"Ubuntu Helloສາມາດປົດລັອກ {} ຂອງທ່ານໂດຍອັດຕະໂນມັດດ້ວຍການພິສູດຢືນຢັນໃບໜ້າ "
"(ກະເປົາເງິນທີ່ກວດພົບ: {}).\n"
"\n"
"<b>ສະຖານະ TPM:</b> ຮາດແວ TPM 2.0 ເຮັດວຽກຢູ່. "
"ລະຫັດຜ່ານຂອງທ່ານຈະຖືກປະທັບຕາຢ່າງປອດໄພພາຍໃນ TPM."

#: src/onboarding.py:831
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected, but automatic installation of "
"<i>tpm2-tools</i> failed. Run <code>sudo apt install tpm2-tools</code>. "
"Falling back to software-based credential caching."
msgstr ""
"Ubuntu Helloສາມາດປົດລັອກ {} ຂອງທ່ານໂດຍອັດຕະໂນມັດດ້ວຍການພິສູດຢືນຢັນໃບໜ້າ "
"(ກະເປົາເງິນທີ່ກວດພົບ: {}).\n"
"\n"
"<b>ສະຖານະ TPM:</b> ກວດພົບຮາດແວ TPM, ແຕ່ການຕິດຕັ້ງອັດຕະໂນມັດ <i>tpm2-tools</i> "
"ລົ້ມເຫລວ. ແລ່ນ <code>sudo apt install tpm2-tools</code>. "
"ກັບຄືນໄປຫາການເກັບຂໍ້ມູນການຮັບຮອງຈາກຊອບແວ."

#: src/onboarding.py:833
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> No TPM hardware detected. Using software-based credential "
"caching (AES-256-GCM)."
msgstr ""
"Ubuntu Helloສາມາດປົດລັອກ {} ຂອງທ່ານໂດຍອັດຕະໂນມັດດ້ວຍການພິສູດຢືນຢັນໃບໜ້າ "
"(ກະເປົາເງິນທີ່ກວດພົບ: {}).\n"
"\n"
"<b>ສະຖານະ TPM:</b> ບໍ່ພົບຮາດແວ TPM. ການ​ນໍາ​ໃຊ້​ການ​ຖານ​ຄວາມ​ຈໍາ​ທີ່​ອີງ​ໃສ່​ຊອບ​ແວ (AES-256-GCM​)​."

#: src/onboarding.py:895 src/tab_keyring.py:134
msgid "Failed to disable keyring unlocking: {}"
msgstr "ລົ້ມເຫລວໃນການປິດການປົດລັອກກະແຈ: {}"

#: src/onboarding.py:901
msgid "Could not identify non-root system user for keyring unlocking"
msgstr "ບໍ່ສາມາດລະບຸຜູ້ໃຊ້ລະບົບທີ່ບໍ່ແມ່ນ root ສຳລັບການປົດລັອກ keyring ໄດ້"

#: src/onboarding.py:914 src/tab_keyring.py:82
msgid "Password cannot be empty"
msgstr "ລະຫັດຜ່ານບໍ່ສາມາດຫວ່າງເປົ່າໄດ້"

#: src/onboarding.py:918 src/tab_keyring.py:86
msgid "Incorrect password for user {}"
msgstr "ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງສຳລັບຜູ້ໃຊ້ {}"

#: src/onboarding.py:930 src/tab_keyring.py:98
msgid "unknown error"
msgstr "ຄວາມຜິດພາດທີ່ບໍ່ຮູ້ຈັກ"

#: src/onboarding.py:931 src/onboarding.py:940 src/tab_keyring.py:103
msgid "Failed to enable keyring unlocking: {}"
msgstr "ເປີດໃຊ້ການປົດລັອກກະແຈບໍ່ສຳເລັດ: {}"

#: src/onboarding.py:934
msgid "Failed to enable keyring unlocking: ubuntu-hello executable not found"
msgstr "ບໍ່ສາມາດເປີດໃຊ້ການປົດລັອກ keyring ໄດ້: ບໍ່ພົບໄຟລ໌ປະຕິບັດການ ubuntu-hello"

#: src/onboarding.py:937
msgid ""
"Failed to enable keyring unlocking: timed out waiting for keyring enable"
msgstr "ບໍ່ສາມາດເປີດໃຊ້ການປົດລັອກ keyring ໄດ້: ໝົດເວລາລໍຖ້າ keyring enable"

#: src/onboarding.py:946
msgid "Keyring Unlocking Error"
msgstr "ການປົດລັອກກະແຈຜິດພາດ"


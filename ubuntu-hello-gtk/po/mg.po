msgstr "Hadisoana teo am-panafarana OpenCV2"

#: src/onboarding.py:371 src/onboarding.py:564
msgid "Try reinstalling cv2"
msgstr "Andramo apetraka indray ny cv2"

#: src/onboarding.py:382
msgid "No webcams found on system"
msgstr "Tsy misy webcam hita ao amin'ny rafitra"

#: src/onboarding.py:382
msgid ""
"Please configure your camera yourself if you are sure a compatible camera is "
"connected"
msgstr ""
"Ampifandraiso azafady ny fakantsarinao raha azonao antoka fa misy fakantsary "
"mifanentana mifandray"

#: src/onboarding.py:455
msgid "No, camera can't be opened"
msgstr "Tsia, tsy azo sokafana ny fakan-tsary"

#: src/onboarding.py:467
msgid "No, not an infrared camera"
msgstr "Tsia, tsy fakan-tsary infrarouge"

#: src/onboarding.py:471
msgid "Yes, compatible infrared camera"
msgstr "Eny, fakan-tsary infrarouge mifanentana"

#: src/onboarding.py:488
msgid "Camera identifier or path"
msgstr "Famantarana fakan-tsary na lalana"

#: src/onboarding.py:488
msgid "Recommended"
msgstr "soso-kevitra"

#: src/onboarding.py:568 src/onboarding.py:607
msgid "Error selecting camera"
msgstr "Hadisoana nisafidianana fakantsary"

#: src/onboarding.py:582
msgid "The selected camera cannot be opened"
msgstr "Tsy azo sokafana ny fakantsary voafantina"

#: src/onboarding.py:582
msgid "Try to select another one"
msgstr "Miezaha mifidy iray hafa"

#: src/onboarding.py:597
msgid ""
"Please visit\n"
"<a href=\"https://github.com/EmixamPP/linux-enable-ir-emitter\">https://"
"github.com/EmixamPP/linux-enable-ir-emitter</a>\n"
"to enable your ir emitter"
msgstr ""
"Tsidiho azafady\n"
"<a href=\"https://github.com/EmixamPP/linux-enable-ir-emitter\">https://"
"github.com/EmixamPP/linux-enable-ir-emitter</a>\n"
"mba hahafahan'ny ir emitter anao"

#: src/onboarding.py:665
msgid "Setup lighting 1"
msgstr "Fametrahana jiro 1"

#: src/onboarding.py:666
msgid "Setup lighting 2"
msgstr "Fametrahana jiro 2"

#: src/onboarding.py:707
msgid "Can't save face model"
msgstr "Tsy afaka mitahiry endrika endrika"

#: src/onboarding.py:712 src/onboarding.py:759
msgid "Scan second model"
msgstr "Scan modely faharoa"

#: src/onboarding.py:718
msgid "Couldn't record the second model"
msgstr "Tsy afaka nandrakitra ny maodely faharoa"

#: src/onboarding.py:719
msgid ""
"Your first model is saved, so face login already works. The room must still "
"be bright enough to see your face — change the light rather than turning it "
"off — then try again, or skip and add a model later from Settings."
msgstr ""
"Voatahiry ny maodely voalohany anao, ka efa mandeha ny fidirana amin'ny "
"tarehy. Tsy maintsy mbola mazava tsara ny efitrano mba hahitanao ny tavanao "
"— ovay ny jiro fa tsy hamono azy — dia andramo indray, na tsidiho ary ampio "
"modely avy eo amin'ny Settings."

#: src/onboarding.py:753
msgid "Second scan: glasses, facial hair or different lighting"
msgstr "Fanadihadiana faharoa: solomaso, volombava na hazavana hafa"

#: src/onboarding.py:755
msgid ""
"First model saved: face login already works. A second model makes "
"recognition more reliable when something changes: put on the glasses you "
"sometimes wear (or take them off), or record it with different facial hair, "
"and change the light — turn a lamp on or off, move away from the window. "
"Keep your face clearly visible and press Scan again; the same short guided "
"capture follows."
msgstr ""
"Voatahiry ny maodely voalohany: efa mandeha ny fidirana amin'ny tarehy. Ny "
"maodely faharoa dia mampitombo ny fahatokisana ny famantarana rehefa misy "
"miova: ataovy ny solomaso izay anaovanao indraindray (na esory), raketo "
"miaraka amin'ny volombava hafa, ary ovay ny hazavana — ampirehero na vonoy "
"ny jiro, mihataha amin'ny varavarankely. Tazomy hita mazava ny tarehinao ary "
"tsindrio indray ny Scan; manaraka ny fandraketana fohy voatarika mitovy."

#: src/onboarding.py:797
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Checking TPM hardware and tools..."
msgstr ""
"Ubuntu Hello dia afaka manokatra ho azy ny {} amin'ny alàlan'ny fanamarinana "
"endrika (kitapom-bola hita: {}).\n"
"\n"
"<b>Satan'ny TPM:</b> Mijery fitaovana sy fitaovana TPM..."

#: src/onboarding.py:817
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected. Installing <i>tpm2-tools</i> "
"automatically..."
msgstr ""
"Ubuntu Hello dia afaka manokatra ho azy ny {} amin'ny alàlan'ny fanamarinana "
"endrika (kitapom-bola hita: {}).\n"
"\n"
"<b>Sata TPM:</b> TPM fitaovana hita. Mametraka <i>tpm2-tools</i> ho azy..."

#: src/onboarding.py:829
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Hardware TPM 2.0 active. Your password will be securely "
"sealed inside the TPM."
msgstr ""
"Ubuntu Hello dia afaka manokatra ho azy ny {} amin'ny alàlan'ny fanamarinana "
"endrika (kitapom-bola hita: {}).\n"
"\n"
"<b>Sata TPM:</b> Hardware TPM 2.0 mavitrika. Ho voaisy tombo-kase tsara ao "
"anatin'ny TPM ny tenimiafinao."

#: src/onboarding.py:831
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected, but automatic installation of "
"<i>tpm2-tools</i> failed. Run <code>sudo apt install tpm2-tools</code>. "
"Falling back to software-based credential caching."
msgstr ""
"Ubuntu Hello dia afaka manokatra ho azy ny {} amin'ny alàlan'ny fanamarinana "
"endrika (kitapom-bola hita: {}).\n"
"\n"
"<b>Satan'ny TPM:</b> Hita ny fitaovana TPM, saingy tsy nahomby ny "
"fametrahana <i>tpm2-tools</i> mandeha ho azy. Alefaso ny <code>sudo apt "
"install tpm2-tools</code>. Miverina amin'ny caching fahazoan-dàlana "
"mifototra amin'ny rindrambaiko."

#: src/onboarding.py:833
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> No TPM hardware detected. Using software-based credential "
"caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello dia afaka manokatra ho azy ny {} amin'ny alàlan'ny fanamarinana "
"endrika (kitapom-bola hita: {}).\n"
"\n"
"<b>Sata TPM:</b> Tsy misy fitaovana TPM hita. Mampiasa caching fahazoan-"
"dàlana mifototra amin'ny rindrambaiko (AES-256-GCM)."


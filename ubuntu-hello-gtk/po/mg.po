msgstr ""
"Efa nalaina ny angona!\nTsindrio Manaraka raha hanohy"

#: src/onboarding.py:324
msgid "Error while downloading datafiles"
msgstr "Hadisoana teo am-pisintonana fisie data"

#: src/onboarding.py:327
msgid ""
"Done!\nClick Next to continue"
msgstr ""
"Vita!\nTsindrio Manaraka raha hanohy"

#: src/onboarding.py:379 src/onboarding.py:606
msgid "Error while importing OpenCV2"
msgstr "Hadisoana teo am-panafarana OpenCV2"

#: src/onboarding.py:379 src/onboarding.py:606

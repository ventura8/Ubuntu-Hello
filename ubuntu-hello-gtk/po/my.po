#: src/window.py:99
msgid "Created"
msgstr "ဖန်တီးခဲ့သည်။"

#: src/window.py:99
msgid "Label"
msgstr "တံဆိပ်"

#: src/window.py:204
msgid "Automatic"
msgstr "အလိုအလျောက်"

#: src/onboarding.py:169 src/onboarding.ui:246
msgid "Adding your face models"
msgstr "သင့်မျက်နှာပုံစံများကို ထည့်သွင်းခြင်း။"

#: src/onboarding.py:172 src/onboarding.ui:262
msgid ""
"Ubuntu Hello will scan your face twice: once now, and once more in different "
"lighting (for example evening lamps instead of daylight), so it recognises "
"you reliably at any time of day. Press Scan to record the first model."
msgstr ""
"Ubuntu Hello သည် သင့်မျက်နှာကို နှစ်ကြိမ်စကင်န်ဖတ်ပါမည်- ယခုတစ်ကြိမ်၊ နှင့် အခြားအလင်းရောင်များတွင် "
"တစ်ကြိမ် (ဥပမာ နေ့အလင်းရောင်အစား ညနေမီးများ) ဖြစ်သောကြောင့် ၎င်းသည် သင့်အား နေ့၏အချိန်တိုင်းတွင် "
"ယုံကြည်စိတ်ချစွာ အသိအမှတ်ပြုပါသည်။ ပထမဆုံး မော်ဒယ်ကို မှတ်တမ်းတင်ရန် Scan ကို နှိပ်ပါ။"

#: src/onboarding.py:175 src/onboarding.py:630 src/onboarding.py:712
#: src/tab_models.py:39 src/onboarding.ui:288
msgid "Please look directly into the camera"
msgstr "ကျေးဇူးပြု၍ ကင်မရာကို တိုက်ရိုက်ကြည့်ရှုပါ။"

#: src/onboarding.py:178 src/onboarding.py:660 src/onboarding.ui:323
msgid "Start face scan"
msgstr "မျက်နှာစကင်န်ကို စတင်ပါ။"

#: src/onboarding.py:242
msgid ""
"Datafiles have already been downloaded!\n"
"Click Next to continue"
msgstr ""
"ဒေတာဖိုင်များကို ဒေါင်းလုဒ်လုပ်ပြီးပါပြီ။\n"
"ရှေ့ဆက်ရန် Next ကိုနှိပ်ပါ။"

#: src/onboarding.py:279
msgid "Error while downloading datafiles"
msgstr "ဒေတာဖိုင်များကို ဒေါင်းလုဒ်လုပ်နေစဉ် အမှားအယွင်းရှိသည်။"

#: src/onboarding.py:282
msgid ""
"Done!\n"
"Click Next to continue"
msgstr ""
"ပြီးပြီ။\n"
"ရှေ့ဆက်ရန် Next ကိုနှိပ်ပါ။"

#: src/onboarding.py:334 src/onboarding.py:542
msgid "Error while importing OpenCV2"
msgstr "OpenCV2 ထည့်သွင်းစဉ် အမှားအယွင်း"

#: src/onboarding.py:334 src/onboarding.py:542
msgid "Try reinstalling cv2"
msgstr "cv2 ကို ပြန်လည်ထည့်သွင်းကြည့်ပါ။"

#: src/onboarding.py:341
msgid "No webcams found on system"
msgstr "စနစ်တွင် ဝဘ်ကင်မရာများ မတွေ့ပါ။"

#: src/onboarding.py:341
msgid ""
"Please configure your camera yourself if you are sure a compatible camera is "
"connected"
msgstr "တွဲဖက်သုံးနိုင်သောကင်မရာကို ချိတ်ဆက်ထားကြောင်း သေချာပါက သင့်ကင်မရာကို သင်ကိုယ်တိုင် စီစဉ်သတ်မှတ်ပါ။"

#: src/onboarding.py:433
msgid "No, camera can't be opened"
msgstr "မဟုတ်ပါ၊ ကင်မရာကို ဖွင့်၍မရပါ။"

#: src/onboarding.py:445
msgid "No, not an infrared camera"
msgstr "အနီအောက်ရောင်ခြည် ကင်မရာ မဟုတ်ပါ။"

#: src/onboarding.py:449
msgid "Yes, compatible infrared camera"
msgstr "ဟုတ်ကဲ့၊ တွဲဖက်သုံးနိုင်သော အနီအောက်ရောင်ခြည် ကင်မရာ"

#: src/onboarding.py:466
msgid "Camera identifier or path"
msgstr "ကင်မရာအမှတ်အသား သို့မဟုတ် လမ်းကြောင်း"

#: src/onboarding.py:466
msgid "Recommended"
msgstr "အကြံပြုသည်။"

#: src/onboarding.py:546 src/onboarding.py:585
msgid "Error selecting camera"
msgstr "ကင်မရာကို ရွေးချယ်ရာတွင် အမှားအယွင်းရှိနေသည်။"

#: src/onboarding.py:560
msgid "The selected camera cannot be opened"
msgstr "ရွေးချယ်ထားသော ကင်မရာကို ဖွင့်၍မရပါ။"

#: src/onboarding.py:560
msgid "Try to select another one"
msgstr "နောက်ထပ်တစ်ခုကို ရွေးကြည့်ပါ။"

#: src/onboarding.py:575
msgid ""
"Please visit\n"
"<a href=\"https://github.com/EmixamPP/linux-enable-ir-emitter\">https://"
"github.com/EmixamPP/linux-enable-ir-emitter</a>\n"
"to enable your ir emitter"
msgstr ""
"သွားရောက်ကြည့်ရှုပေးပါ။\n"
"<a href=\"https://github.com/EmixamPP/linux-enable-ir-emitter\">https://"
"github.com/EmixamPP/linux-enable-ir-emitter</a>\n"
"သင်၏ ir emitter ကိုဖွင့်ရန်"

#: src/onboarding.py:643
msgid "Setup lighting 1"
msgstr "စနစ်ထည့်သွင်းခြင်း အလင်း ၁"

#: src/onboarding.py:644
msgid "Setup lighting 2"
msgstr "စနစ်ထည့်သွင်းခြင်း အလင်း ၂"

#: src/onboarding.py:662
msgid "Can't save face model"
msgstr "မျက်နှာပုံစံကို သိမ်းဆည်း၍မရပါ။"

#: src/onboarding.py:667 src/onboarding.py:714
msgid "Scan second model"
msgstr "ဒုတိယမော်ဒယ်ကို စကင်ဖတ်ရန်"

#: src/onboarding.py:673
msgid "Couldn't record the second model"
msgstr "ဒုတိယမော်ဒယ်ကို မှတ်တမ်းတင်၍ မရပါ"

#: src/onboarding.py:674
msgid ""
"Your first model is saved, so face login already works. The room must still "
"be bright enough to see your face — change the light rather than turning it "
"off — then try again, or skip and add a model later from Settings."
msgstr ""
"သင်၏ပထမမော်ဒယ်ကို သိမ်းဆည်းထားသောကြောင့် မျက်နှာဖြင့် အကောင့်ဝင်ခြင်း အလုပ်ဖြစ်နေပါပြီ။ အခန်းသည် "
"သင့်မျက်နှာကို မြင်နိုင်လောက်အောင် တောက်ပနေရမည် — ၎င်းကို ပိတ်မည့်အစား မီးကိုပြောင်းပါ — ထို့နောက် "
"ထပ်စမ်းကြည့်ပါ သို့မဟုတ် ကျော်ပြီး ဆက်တင်များမှ မော်ဒယ်ကို နောက်မှထည့်ပါ။"

#: src/onboarding.py:708
msgid "Second scan: different lighting"
msgstr "ဒုတိယစကင်န်- မတူညီသောအလင်းရောင်"

#: src/onboarding.py:710
msgid ""
"First model saved. Now change the light — for example turn a lamp on or off, "
"move away from the window, or use the other room light — keep your face "
"clearly visible, then press Scan again."
msgstr ""
"ပထမမော်ဒယ်ကို သိမ်းထားတယ်။ ယခုအလင်းကိုပြောင်းပါ — ဥပမာ မီးခွက်ကိုဖွင့် သို့မဟုတ် ပိတ်ပါ၊ ပြတင်းပေါက်မှ "
"ရွှေ့ပါ သို့မဟုတ် အခြားအခန်းမီးကို အသုံးပြုပါ — သင့်မျက်နှာကို ရှင်းရှင်းလင်းလင်းမြင်အောင်ထားကာ စကင်န်ကို "
"ထပ်နှိပ်ပါ။"

#: src/onboarding.py:752
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Checking TPM hardware and tools..."
msgstr ""
"Ubuntu Hello သည် မျက်နှာအထောက်အထားစိစစ်ခြင်း (တွေ့ရှိထားသော ပိုက်ဆံအိတ်- {}) ကို အသုံးပြု၍ သင်၏ {} "
"ကို အလိုအလျောက် လော့ခ်ဖွင့်နိုင်ပါသည်။\n"
"\n"
"<b>TPM အခြေအနေ-</b> TPM ဟာ့ဒ်ဝဲနှင့် ကိရိယာများကို စစ်ဆေးနေသည်..."

#: src/onboarding.py:772
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected. Installing <i>tpm2-tools</i> "
"automatically..."
msgstr ""
"Ubuntu Hello သည် မျက်နှာအထောက်အထားစိစစ်ခြင်း (တွေ့ရှိထားသော ပိုက်ဆံအိတ်- {}) ကို အသုံးပြု၍ သင်၏ {} "
"ကို အလိုအလျောက် လော့ခ်ဖွင့်နိုင်ပါသည်။\n"
"\n"
"<b>TPM အခြေအနေ-</b> TPM ဟာ့ဒ်ဝဲကို တွေ့ရှိခဲ့သည်။ <i>tpm2-tools</i> အလိုအလျောက် ထည့်သွင်းနေသည်..."

#: src/onboarding.py:784
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Hardware TPM 2.0 active. Your password will be securely "
"sealed inside the TPM."
msgstr ""
"Ubuntu Hello သည် မျက်နှာအထောက်အထားစိစစ်ခြင်း (တွေ့ရှိထားသော ပိုက်ဆံအိတ်- {}) ကို အသုံးပြု၍ သင်၏ {} "
"ကို အလိုအလျောက် လော့ခ်ဖွင့်နိုင်ပါသည်။\n"
"\n"
"<b>TPM အခြေအနေ-</b> ဟာ့ဒ်ဝဲ TPM 2.0 အသက်ဝင်သည်။ သင့်စကားဝှက်ကို TPM တွင် လုံခြုံစွာ "
"တံဆိပ်ခတ်ထားပါမည်။"

#: src/onboarding.py:786
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected, but automatic installation of "
"<i>tpm2-tools</i> failed. Run <code>sudo apt install tpm2-tools</code>. "
"Falling back to software-based credential caching."
msgstr ""
"Ubuntu Hello သည် မျက်နှာအထောက်အထားစိစစ်ခြင်း (တွေ့ရှိထားသော ပိုက်ဆံအိတ်- {}) ကို အသုံးပြု၍ သင်၏ {} "
"ကို အလိုအလျောက် လော့ခ်ဖွင့်နိုင်ပါသည်။\n"
"\n"
"<b>TPM အခြေအနေ-</b> TPM ဟာ့ဒ်ဝဲကို တွေ့ရှိသော်လည်း <i>tpm2-tools</i> အလိုအလျောက် ထည့်သွင်းခြင်း "
"မအောင်မြင်ပါ။ <code>sudo apt install tpm2-tools</code> ကိုဖွင့်ပါ။ ဆော့ဖ်ဝဲလ်အခြေခံ "
"အထောက်အထား သိမ်းဆည်းခြင်းသို့ ပြန်ရောက်သွားသည်။"

#: src/onboarding.py:788
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> No TPM hardware detected. Using software-based credential "
"caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello သည် မျက်နှာအထောက်အထားစိစစ်ခြင်း (တွေ့ရှိထားသော ပိုက်ဆံအိတ်- {}) ကို အသုံးပြု၍ သင်၏ {} "
"ကို အလိုအလျောက် လော့ခ်ဖွင့်နိုင်ပါသည်။\n"
"\n"
"<b>TPM အခြေအနေ-</b> TPM ဟာ့ဒ်ဝဲကို ရှာမတွေ့ပါ။ ဆော့ဖ်ဝဲအခြေခံ အထောက်အထား သိမ်းဆည်းခြင်း "
"(AES-256-GCM) ကို အသုံးပြုခြင်း။"


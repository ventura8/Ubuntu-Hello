#: src/main.ui:913
msgid "Automatic follows the system language. Changes apply immediately."
msgstr "အလိုအလျောက်သည် စနစ်ဘာသာစကားကို လိုက်နာသည်။ ပြောင်းလဲမှုများ ချက်ချင်း အကျိုးသက်ရောက်သည်။"

#: src/main.ui:936 src/main.ui:956

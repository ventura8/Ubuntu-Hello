msgstr "Ubuntu Hello సెటప్ హెచ్చరిక"

#: src/onboarding.py:1011
msgid "Could not save certainty preference, but setup is otherwise complete."
msgstr "నిశ్చయ ప్రాధాన్యతను సేవ్ చేయడం సాధ్యపడలేదు, అయితే సెటప్ పూర్తయింది."

#: src/onboarding.py:1030 src/tab_models.py:64 src/tab_models.py:92
#: src/tab_notifications.py:60
msgid "Ubuntu Hello Error"
msgstr "Ubuntu Hello లోపం"

#: src/authsticky.py:107
msgid "Loading...  "
msgstr "లోడ్ అవుతోంది..."

#: src/authsticky.py:123
msgid "Ubuntu Hello Authentication"
msgstr "Ubuntu Hello ప్రమాణీకరణ"

#: src/tab_models.py:20
msgid "Confirm Model Creation"
msgstr "మోడల్ సృష్టిని నిర్ధారించండి"

#: src/tab_models.py:21

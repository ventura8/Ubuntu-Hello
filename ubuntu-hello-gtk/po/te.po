"\n"

#: src/tab_models.py:72
#, python-brace-format
msgid "Are you sure you want to delete model {id} ({name})?"
msgstr "మీరు మోడల్ {id} ({name})ని ఖచ్చితంగా తొలగించాలనుకుంటున్నారా?"


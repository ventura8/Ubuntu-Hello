msgid "Please enter a name for the new model, 24 characters max"
msgstr "దయచేసి కొత్త మోడల్‌కు గరిష్టంగా 24 అక్షరాలు ఉండే పేరును నమోదు చేయండి"

#: src/tab_models.py:28
msgid "Model name:"
msgstr "మోడల్ పేరు:"

#: src/tab_models.py:38

#: src/onboarding.py:169 src/onboarding.ui:246
msgid "Adding your face models"
msgstr "Legger til ansiktsmodeller"

#: src/onboarding.py:172 src/onboarding.ui:262
msgid ""
"Ubuntu Hello will scan your face twice: once now, and once more in different "
"lighting (for example evening lamps instead of daylight), so it recognises "
"you reliably at any time of day. Press Scan to record the first model."
msgstr ""
"Ubuntu Hello vil skanne ansiktet ditt to ganger: én gang nå, og én gang til "
"i annen belysning (for eksempel kveldslamper i stedet for dagslys), slik at "
"den gjenkjenner deg pålitelig når som helst på dagen. Trykk Skann for å ta "
"opp den første modellen."

#: src/onboarding.py:175 src/onboarding.py:630 src/onboarding.py:712
#: src/tab_models.py:39 src/onboarding.ui:288
msgid "Please look directly into the camera"
msgstr "Vennligst se direkte inn i kameraet"

#: src/onboarding.py:178 src/onboarding.py:660 src/onboarding.ui:323
msgid "Start face scan"
msgstr "Start ansiktsskanning"

#: src/onboarding.py:242
msgid ""
"Datafiles have already been downloaded!\n"
"Click Next to continue"
msgstr ""
"Datafiler er allerede lastet ned!\n"
"Klikk Neste for å fortsette"

#: src/onboarding.py:279
msgid "Error while downloading datafiles"
msgstr "Feil under nedlasting av datafiler"

#: src/onboarding.py:282
msgid ""
"Done!\n"
"Click Next to continue"
msgstr ""
"Ferdig!\n"
"Klikk Neste for å fortsette"

#: src/onboarding.py:334 src/onboarding.py:542
msgid "Error while importing OpenCV2"
msgstr "Feil under import av OpenCV2"

#: src/onboarding.py:334 src/onboarding.py:542

#: src/onboarding.py:446
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Checking TPM hardware a"
"nd tools..."
msgstr ""
"Ubuntu Hello kan låse opp {} automatisk ved hjelp av ansiktsautentiser"
"ing (oppdaget lommebok: {}).\n\n<b>TPM-status:</b> Kontrollerer TPM-ma"
"skinvare og -verktøy..."

#: src/onboarding.py:466
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected. "
"Installing <i>tpm2-tools</i> automatically..."
msgstr ""
"Ubuntu Hello kan låse opp {} automatisk ved hjelp av ansiktsautentiser"
"ing (oppdaget lommebok: {}).\n\n<b>TPM-status:</b> TPM-maskinvare oppd"
"aget. Installerer <i>tpm2-tools</i> automatisk..."

#: src/onboarding.py:478
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Hardware TPM 2.0 active"
". Your password will be securely sealed inside the TPM."
msgstr ""
"Ubuntu Hello kan låse opp {} automatisk ved hjelp av ansiktsautentiser"
"ing (oppdaget lommebok: {}).\n\n<b>TPM-status:</b> Maskinvare TPM 2.0 "
"aktiv. Passordet ditt vil være sikkert forseglet inne i TPM."

#: src/onboarding.py:480
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected, "
"but automatic installation of <i>tpm2-tools</i> failed. Run <code>sudo"
" apt install tpm2-tools</code>. Falling back to software-based credent"
"ial caching."
msgstr ""
"Ubuntu Hello kan låse opp {} automatisk ved hjelp av ansiktsautentiser"
"ing (oppdaget lommebok: {}).\n\n<b>TPM-status:</b> TPM-maskinvare oppd"
"aget, men automatisk installasjon av <i>tpm2-tools</i> mislyktes. Kjør"
" <code>sudo apt install tpm2-tools</code>. Faller tilbake til programv"
"arebasert påloggingsbufring."

#: src/onboarding.py:482
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> No TPM hardware detecte"
"d. Using software-based credential caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello kan låse opp {} automatisk ved hjelp av ansiktsautentiser"
"ing (oppdaget lommebok: {}).\n\n<b>TPM-status:</b> Ingen TPM-maskinvar"
"e oppdaget. Bruker programvarebasert påloggingsbufring (AES-256-GCM)."


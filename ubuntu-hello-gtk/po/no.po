msgstr "Prøv å installere cv2 på nytt"

#: src/onboarding.py:386
msgid "No webcams found on system"
msgstr "Ingen webkameraer funnet på systemet"

#: src/onboarding.py:386
msgid ""
"Please configure your camera yourself if you are sure a compatible cam"
"era is connected"
msgstr ""
"Vennligst konfigurer kameraet selv hvis du er sikker på at et kompatib"
"elt kamera er tilkoblet"

#: src/onboarding.py:478
msgid "No, camera can't be opened"
msgstr "Nei, kameraet kan ikke åpnes"

#: src/onboarding.py:490
msgid "No, not an infrared camera"
msgstr "Nei, ikke et infrarødt kamera"

#: src/onboarding.py:494
msgid "Yes, compatible infrared camera"
msgstr "Ja, kompatibelt infrarødt kamera"

#: src/onboarding.py:519
msgid "Camera identifier or path"
msgstr "Kameraidentifikator eller -bane"

#: src/onboarding.py:519

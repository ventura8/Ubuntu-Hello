msgstr ""
"Kérjük, konfigurálja saját maga a kamerát, ha biztos benne, hogy kompa"
"tibilis kamera van csatlakoztatva"

#: src/onboarding.py:478
msgid "No, camera can't be opened"
msgstr "Nem, a kamerát nem lehet kinyitni"

#: src/onboarding.py:490
msgid "No, not an infrared camera"
msgstr "Nem, nem infrakamera"

#: src/onboarding.py:494
msgid "Yes, compatible infrared camera"
msgstr "Igen, kompatibilis infrakamera"

#: src/onboarding.py:519
msgid "Camera identifier or path"
msgstr "Kameraazonosító vagy elérési út"

#: src/onboarding.py:519

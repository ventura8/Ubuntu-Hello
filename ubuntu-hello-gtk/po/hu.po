msgstr "A kiválasztott kamera nem nyitható meg"

#: src/onboarding.py:624
msgid "Try to select another one"
msgstr "Próbáljon másikat választani"

#: src/onboarding.py:639
msgid ""
"Please visit\n<a href=\"https://github.com/EmixamPP/linux-enable-ir-em"
"itter\">https://github.com/EmixamPP/linux-enable-ir-emitter</a>\nto en"
"able your ir emitter"
msgstr ""
"Kérjük látogassa meg\n<a href=\"https://github.com/EmixamPP/linux-enab"
"le-ir-emitter\">https://github.com/EmixamPP/linux-enable-ir-emitter</a"
">\nhogy engedélyezze az ir-kibocsátóját"


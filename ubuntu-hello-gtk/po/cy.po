msgid ""
"Please visit\n<a href=\"https://github.com/EmixamPP/linux-enable-ir-em"
"itter\">https://github.com/EmixamPP/linux-enable-ir-emitter</a>\nto en"
"able your ir emitter"
msgstr ""
"Ymwelwch\n<a href=\"https://github.com/EmixamPP/linux-enable-ir-emitte"
"r\">https://github.com/EmixamPP/linux-enable-ir-emitter</a>\ni alluogi"
" eich allyrrydd ir"


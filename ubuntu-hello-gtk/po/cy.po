#: src/onboarding.py:446
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Checking TPM hardware a"
"nd tools..."
msgstr ""
"Gall Ubuntu Hello ddatgloi eich {} yn awtomatig gan ddefnyddio dilysia"
"d wyneb (waled canfyddedig: {}).\n\n<b>Statws TPM:</b> Wrthi'n gwirio "
"caledwedd ac offer TPM..."

#: src/onboarding.py:466
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected. "
"Installing <i>tpm2-tools</i> automatically..."
msgstr ""
"Gall Ubuntu Hello ddatgloi eich {} yn awtomatig gan ddefnyddio dilysia"
"d wyneb (waled canfyddedig: {}).\n\n<b>Statws TPM:</b> Wedi canfod cal"
"edwedd TPM. Yn gosod <i>tpm2-tools</i> yn awtomatig..."

#: src/onboarding.py:478
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Hardware TPM 2.0 active"
". Your password will be securely sealed inside the TPM."
msgstr ""
"Gall Ubuntu Hello ddatgloi eich {} yn awtomatig gan ddefnyddio dilysia"
"d wyneb (waled canfyddedig: {}).\n\n<b>Statws TPM:</b> Caledwedd TPM 2"
".0 yn weithredol. Bydd eich cyfrinair yn cael ei selio'n ddiogel y tu "
"mewn i'r TPM."

#: src/onboarding.py:480
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected, "
"but automatic installation of <i>tpm2-tools</i> failed. Run <code>sudo"
" apt install tpm2-tools</code>. Falling back to software-based credent"
"ial caching."
msgstr ""
"Gall Ubuntu Hello ddatgloi eich {} yn awtomatig gan ddefnyddio dilysia"
"d wyneb (waled canfyddedig: {}).\n\n<b>Statws TPM:</b> Wedi canfod cal"
"edwedd TPM, ond methodd gosod <i>tpm2-tools</i> yn awtomatig. Rhedeg <"
"code>sudo apt install tpm2-tools</code>. Syrthio'n ôl i caching creden"
"tial seiliedig ar feddalwedd."

#: src/onboarding.py:482
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> No TPM hardware detecte"
"d. Using software-based credential caching (AES-256-GCM)."
msgstr ""
"Gall Ubuntu Hello ddatgloi eich {} yn awtomatig gan ddefnyddio dilysia"
"d wyneb (waled canfyddedig: {}).\n\n<b>Statws TPM:</b> Dim caledwedd T"
"PM wedi'i ganfod. Defnyddio caching credential seiliedig ar feddalwedd"
" (AES-256-GCM)."


msgstr ""
"Datové soubory již byly staženy!\nPokračujte kliknutím na Další"

#: src/onboarding.py:324
msgid "Error while downloading datafiles"
msgstr "Chyba při stahování datových souborů"

#: src/onboarding.py:327
msgid ""
"Done!\nClick Next to continue"
msgstr ""

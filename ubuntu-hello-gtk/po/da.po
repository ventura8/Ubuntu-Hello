#: src/onboarding.py:707
msgid "Can't save face model"
msgstr "Ansigtsmodellen kan ikke gemmes"

#: src/onboarding.py:712 src/onboarding.py:759
msgid "Scan second model"
msgstr "Scan anden model"

#: src/onboarding.py:718
msgid "Couldn't record the second model"
msgstr "Kunne ikke optage den anden model"

#: src/onboarding.py:719
msgid ""
"Your first model is saved, so face login already works. The room must still "
"be bright enough to see your face — change the light rather than turning it "
"off — then try again, or skip and add a model later from Settings."
msgstr ""
"Din første model er gemt, så ansigtslogin virker allerede. Rummet skal "
"stadig være lyst nok til at se dit ansigt – skift lyset i stedet for at "
"slukke det – prøv så igen, eller spring over og tilføj en model senere fra "
"Indstillinger."

#: src/onboarding.py:753
msgid "Second scan: glasses, facial hair or different lighting"
msgstr "Anden scanning: briller, skæg eller anden belysning"

#: src/onboarding.py:755
msgid ""
"First model saved: face login already works. A second model makes "
"recognition more reliable when something changes: put on the glasses you "
"sometimes wear (or take them off), or record it with different facial hair, "
"and change the light — turn a lamp on or off, move away from the window. "
"Keep your face clearly visible and press Scan again; the same short guided "
"capture follows."
msgstr ""
"Første model gemt: login med ansigtet virker allerede. En anden model gør "
"genkendelsen mere pålidelig, når noget ændrer sig: tag de briller på, du "
"nogle gange bruger (eller tag dem af), optag den med andet skæg, og skift "
"lyset — tænd eller sluk en lampe, gå væk fra vinduet. Hold ansigtet tydeligt "
"synligt og tryk på Scan igen; den samme korte guidede optagelse følger."

#: src/onboarding.py:797
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Checking TPM hardware and tools..."
msgstr ""
"Ubuntu Hello kan automatisk låse din {} op ved hjælp af ansigtsgodkendelse "
"(registreret tegnebog: {}).\n"
"\n"
"<b>TPM-status:</b> Kontrollerer TPM-hardware og -værktøjer..."

#: src/onboarding.py:817
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected. Installing <i>tpm2-tools</i> "
"automatically..."
msgstr ""
"Ubuntu Hello kan automatisk låse din {} op ved hjælp af ansigtsgodkendelse "
"(registreret tegnebog: {}).\n"
"\n"
"<b>TPM-status:</b> TPM-hardware fundet. Installerer <i>tpm2-tools</i> "
"automatisk..."

#: src/onboarding.py:829
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Hardware TPM 2.0 active. Your password will be securely "
"sealed inside the TPM."
msgstr ""
"Ubuntu Hello kan automatisk låse din {} op ved hjælp af ansigtsgodkendelse "
"(registreret tegnebog: {}).\n"
"\n"
"<b>TPM-status:</b> Hardware TPM 2.0 aktiv. Din adgangskode vil være sikkert "
"forseglet inde i TPM."

#: src/onboarding.py:831
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected, but automatic installation of "
"<i>tpm2-tools</i> failed. Run <code>sudo apt install tpm2-tools</code>. "
"Falling back to software-based credential caching."
msgstr ""
"Ubuntu Hello kan automatisk låse din {} op ved hjælp af ansigtsgodkendelse "
"(registreret tegnebog: {}).\n"
"\n"
"<b>TPM-status:</b> TPM-hardware fundet, men automatisk installation af "
"<i>tpm2-tools</i> mislykkedes. Kør <code>sudo apt install tpm2-tools</code>. "
"Falder tilbage til softwarebaseret legitimationscaching."

#: src/onboarding.py:833
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> No TPM hardware detected. Using software-based credential "
"caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello kan automatisk låse din {} op ved hjælp af ansigtsgodkendelse "
"(registreret tegnebog: {}).\n"
"\n"
"<b>TPM-status:</b> Ingen TPM-hardware fundet. Brug af softwarebaseret "
"legitimationscaching (AES-256-GCM)."


#: src/onboarding.py:446
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Checking TPM hardware a"
"nd tools..."
msgstr ""
"Ubuntu Hello kan automatisk låse din {} op ved hjælp af ansigtsgodkend"
"else (registreret tegnebog: {}).\n\n<b>TPM-status:</b> Kontrollerer TP"
"M-hardware og -værktøjer..."

#: src/onboarding.py:466
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected. "
"Installing <i>tpm2-tools</i> automatically..."
msgstr ""
"Ubuntu Hello kan automatisk låse din {} op ved hjælp af ansigtsgodkend"
"else (registreret tegnebog: {}).\n\n<b>TPM-status:</b> TPM-hardware fu"
"ndet. Installerer <i>tpm2-tools</i> automatisk..."

#: src/onboarding.py:478
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Hardware TPM 2.0 active"
". Your password will be securely sealed inside the TPM."
msgstr ""
"Ubuntu Hello kan automatisk låse din {} op ved hjælp af ansigtsgodkend"
"else (registreret tegnebog: {}).\n\n<b>TPM-status:</b> Hardware TPM 2."
"0 aktiv. Din adgangskode vil være sikkert forseglet inde i TPM."

#: src/onboarding.py:480
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected, "
"but automatic installation of <i>tpm2-tools</i> failed. Run <code>sudo"
" apt install tpm2-tools</code>. Falling back to software-based credent"
"ial caching."
msgstr ""
"Ubuntu Hello kan automatisk låse din {} op ved hjælp af ansigtsgodkend"
"else (registreret tegnebog: {}).\n\n<b>TPM-status:</b> TPM-hardware fu"
"ndet, men automatisk installation af <i>tpm2-tools</i> mislykkedes. Kø"
"r <code>sudo apt install tpm2-tools</code>. Falder tilbage til softwar"
"ebaseret legitimationscaching."

#: src/onboarding.py:482
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> No TPM hardware detecte"
"d. Using software-based credential caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello kan automatisk låse din {} op ved hjælp af ansigtsgodkend"
"else (registreret tegnebog: {}).\n\n<b>TPM-status:</b> Ingen TPM-hardw"
"are fundet. Brug af softwarebaseret legitimationscaching (AES-256-GCM)"
"."


msgstr "സജ്ജീകരണം പൂർത്തിയാക്കുക"

#: ubuntu-hello-gtk.desktop.in
msgid "Windows Hello style facial authentication"
msgstr "Windows Hello ശൈലിയിലുള്ള മുഖ പ്രാമാണീകരണം"

#: ubuntu-hello-gtk.desktop.in
msgid "face;recognition;authentication;security;lock;"
msgstr "മുഖം, തിരിച്ചറിയൽ, ആധികാരികത ഉറപ്പാക്കൽ, സുരക്ഷ;"

#: src/onboarding.ui:52
msgid "Setup is done!"
msgstr "སྒྲིག་འཇུག་ལེགས་གྲུབ།"

#: src/onboarding.ui:68
msgid ""
"We're done! Ubuntu Hello is now active on this computer. Try doing anything "
"you would normally have to type your password for to authenticate, like "
"running a command with sudo. If you enabled keyring auto-unlock, your login "
"keyring or KWallet will also be unlocked automatically on login.\n"
"\n"
"You can open the Ubuntu Hello Configurator later on to change more advanced "
"settings or add additional models. Press Finish below to close this window "
"and open the Ubuntu Hello Configurator. "
msgstr ""
"ལེགས་གྲུབ། ད་ནི་ Ubuntu Hello གློག་ཀླད་འདིའི་སྟེང་ལས་འགུལ་ཅན་དུ་གྱུར་སོང་། སྤྱིར་བཏང་ར་སྤྲོད་ཆེད་"
"གསང་ཚིག་འབྲི་དགོས་པའི་བྱ་བ་གང་རུང་ཞིག་ཚོད་ལྟ་བྱོས། དཔེར་ན་ sudo དང་མཉམ་དུ་བརྡ་སྦྱོར་ཞིག་སྤྱོད་པ་ལྟ་"
"བུ། གལ་ཏེ་ཁྱེད་ཀྱིས་ལྡེ་མིག་སྒྲོག་རང་འགུལ་སྒོ་འབྱེད་སྤྱོད་རུང་བཟོས་ཡོད་ན། ནང་འཇུག་སྐབས་ཁྱེད་ཀྱི་ནང་འཇུག་ལྡེ་"
"མིག་སྒྲོག་གམ་ KWallet ཡང་རང་འགུལ་གྱིས་སྒོ་ཕྱེ་འགྲོ།\n"
"\n"
"རྗེས་སུ་ Ubuntu Hello Configurator ཕྱེ་ནས་མཐོ་རིམ་གྱི་སྒྲིག་འགོད་བསྒྱུར་བའམ་དཔེ་དབྱིབས་ཁ་སྣོན་བྱེད་"
"ཆོག སྒེའུ་ཁུང་འདི་བརྒྱབ་ནས་ Ubuntu Hello Configurator འབྱེད་པར་གཤམ་གྱི་མཇུག་སྒྲིལ་མཐེབ་ལ་མནོན། "

#: src/onboarding.ui:105
msgid "Setting a certainty policy"
msgstr "ངེས་ཚད་ཀྱི་སྲིད་ཇུས་སྒྲིག་འགོད་བྱེད་པ།"

#: src/onboarding.ui:121
msgid ""
"Because of changes in angles, distance, and other factors a face match is "
"never exactly the same as the stored face model. On this page you can set "
"how strict Ubuntu Hello should be."
msgstr ""
"ཟུར་ཁུག་དང་། བར་ཐག གཞན་ཡང་རྐྱེན་སྣ་ཚོགས་འགྱུར་བའི་རྐྱེན་གྱིས། གདོང་པའི་མཐུན་ཚད་ནི་ནམ་ཡང་གསོག་འཇོག་"
"བྱས་པའི་གདོང་པའི་དཔེ་དབྱིབས་དང་ཧ་ཅང་གཅིག་མཚུངས་མི་ཡོང་། ཤོག་ངོས་འདིའི་སྟེང་ནས་ Ubuntu Hello ག་"
"ཚོད་དམ་པོ་ཡིན་དགོས་མིན་སྒྲིག་འགོད་བྱེད་ཐུབ།"

#: src/onboarding.ui:160
msgid ""
"The most forgiving match and the quickest to let you in. Choose this if "
"convenience matters more than strictness."
msgstr "མཐུན་ཚད་ཆེས་ལྷོད་པོ་དང་ཁྱེད་ནང་འཇུག་ཆེས་མགྱོགས་པ། དམ་ཚད་ལས་སྟབས་བདེ་གལ་ཆེ་ན་འདི་འདེམས།"

#: src/onboarding.ui:191
msgid ""
"A strict match that still logs you in quickly. It may not recognise you at a "
"sharp angle or from further away."
msgstr ""
"མཐུན་ཚད་དམ་པོ་ཞིག་ཡིན་ཡང་ཁྱེད་མགྱོགས་པོར་ནང་འཇུག་བྱེད་ཐུབ། ཟུར་ཁུག་རྣོ་པོ་ནས་སམ་ཐག་རིང་ནས་ཁྱེད་ངོས་"
"འཛིན་མི་ཐུབ་སྲིད།"

#: src/onboarding.ui:223
msgid "The strictest match, with no extra step when you log in. Recommended."
msgstr "མཐུན་ཚད་ཆེས་དམ་པོ། ནང་འཇུག་སྐབས་གོ་རིམ་ལྷག་མ་མེད། ངོས་སྦྱོར་བྱས་པ།"

#: src/onboarding.ui:379
msgid "Skip for now"
msgstr "ད་ལྟའི་ཆར་གོ་བརྒལ།"

#: src/onboarding.ui:384
msgid ""
"You can add more face models later from Settings or with: sudo ubuntu-hello "
"add"
msgstr ""
"རྗེས་སུ་སྒྲིག་འགོད་ནང་ནས་སམ་ sudo ubuntu-hello add སྤྱད་དེ་གདོང་པའི་དཔེ་དབྱིབས་མང་བ་སྣོན་ཆོག"

#: src/onboarding.ui:403 src/onboarding.ui:531
msgid "Configuring webcam"
msgstr "དྲ་ཐོག་པར་ཆས་སྒྲིག་འགོད་བྱེད་བཞིན་པ།"

#: src/onboarding.ui:435
msgid "Is the infrared emitter flashing ?"
msgstr "དམར་འོག་འོད་འགྱེད་ཆས་འོད་འཕྲོ་བཞིན་འདུག་གམ།"

#: src/onboarding.ui:447
msgid ""
"Look at the camera you selected: an infrared camera shows a small light that "
"blinks while Ubuntu Hello tests it. This tells us whether it can see your "
"face in the dark."
msgstr ""
"ཁྱེད་ཀྱིས་བདམས་པའི་པར་ཆས་ལ་ལྟོས། Ubuntu Hello ཡིས་ཚོད་ལྟ་བྱེད་བཞིན་པའི་སྐབས་སུ་དམར་འོག་པར་ཆས་"
"ཤིག་ལ་འོད་ཆུང་ཆུང་ཞིག་འགུལ་འཕྲོ་བྱེད་པ་མཐོང་། འདིས་མུན་ནག་ནང་དུ་དེས་ཁྱེད་ཀྱི་གདོང་པ་མཐོང་ཐུབ་བམ་མིན་"
"སྟོན།"

#: src/onboarding.ui:481
msgid "Yes, it flashes"
msgstr "ཡིན། འོད་འཕྲོ་བཞིན་འདུག"

#: src/onboarding.ui:507
msgid "No, nothing flashes"
msgstr "མིན། གང་ཡང་འོད་མི་འཕྲོ།"

#: src/onboarding.ui:547
msgid ""
"Ubuntu Hello will search your system automatically for any available "
"cameras, so make sure your webcam is connected. After detection a list of "
"usable webcams will be shown. Pick the one you want to use and click Next."
msgstr ""
"Ubuntu Hello ཡིས་ཁྱེད་ཀྱི་མ་ལག་ནང་སྤྱོད་རུང་བའི་པར་ཆས་ཡོད་མེད་རང་འགུལ་གྱིས་འཚོལ་བས། ཁྱེད་ཀྱི་དྲ་"
"ཐོག་པར་ཆས་སྦྲེལ་ཡོད་པ་ངེས་པར་བྱོས། ཚོར་འཛིན་རྗེས་སུ་སྤྱོད་རུང་བའི་དྲ་ཐོག་པར་ཆས་ཀྱི་ཐོ་གཞུང་ཞིག་མངོན། "
"ཁྱེད་ཀྱིས་སྤྱོད་འདོད་པ་དེ་བདམས་ནས་རྗེས་མ་ལ་ནོན།"

#: src/onboarding.ui:566
msgid "Testing your webcams, please wait..."
msgstr "ཁྱེད་ཀྱི་དྲ་ཐོག་པར་ཆས་རྣམས་ཚོད་ལྟ་བྱེད་བཞིན་པས་སྒུག་རོགས..."

#: src/onboarding.ui:613
msgid "Downloading data files"
msgstr "གཞི་གྲངས་ཡིག་ཆ་ཕབ་ལེན་བྱེད་བཞིན་པ།"

#: src/onboarding.ui:629
msgid ""
"Ubuntu Hello needs three pre trained facial recognition datasets to be able "
"to recognise you, which will be downloaded now. You can see the download "
"progress below."
msgstr ""
"Ubuntu Hello ཡིས་ཁྱེད་ངོས་འཛིན་ཐུབ་པར་སྔོན་ནས་སྦྱོང་བརྡར་བྱས་པའི་གདོང་པ་ངོས་འཛིན་གྱི་གཞི་གྲངས་ཚོགས་"
"གསུམ་དགོས་ཤིང་། དེ་དག་ད་ལྟ་ཕབ་ལེན་བྱེད་རྒྱུ་ཡིན། ཕབ་ལེན་གྱི་འཕེལ་རིམ་གཤམ་དུ་མཐོང་ཐུབ།"

#: src/onboarding.ui:653
msgid "Starting download..."
msgstr "ཕབ་ལེན་འགོ་འཛུགས་བཞིན་པ..."

#: src/onboarding.ui:697
msgid "Welcome to Ubuntu Hello!"
msgstr "Ubuntu Hello ལ་དགའ་བསུ་ཞུ།"

#: src/onboarding.ui:709
msgid "Version"
msgstr "པར་གཞི།"

#: src/onboarding.ui:723
msgid ""
"This wizard will walk you through the setup process and automatically "
"configure Ubuntu Hello for you. Press next to continue."
msgstr ""
"ལམ་སྟོན་འདིས་ཁྱེད་ལ་སྒྲིག་འཇུག་གི་བརྒྱུད་རིམ་ངོ་སྤྲོད་བྱེད་ཅིང་། ཁྱེད་ཀྱི་ཆེད་དུ་ Ubuntu Hello རང་འགུལ་"
"གྱིས་སྒྲིག་འགོད་བྱེད། མུ་མཐུད་པར་རྗེས་མ་ལ་མནོན།"

#: src/onboarding.ui:775
msgid ""
"Ubuntu Hello can automatically unlock your login keyring or KWallet using "
"face authentication, preventing password prompts after logging in."
msgstr ""
"Ubuntu Hello ཡིས་གདོང་པའི་ར་སྤྲོད་སྤྱད་དེ་ཁྱེད་ཀྱི་ནང་འཇུག་ལྡེ་མིག་སྒྲོག་གམ་ KWallet རང་འགུལ་གྱིས་སྒོ་"
"འབྱེད་ཐུབ་པས། ནང་འཇུག་རྗེས་ཀྱི་གསང་ཚིག་རེ་སྐུལ་རྣམས་མེད་པར་བཟོ།"

#: src/onboarding.ui:787
msgid "Enable automatic keyring/KWallet unlocking"
msgstr "རང་འགུལ་ལྡེ་མིག་སྒྲོག/KWallet སྒོ་འབྱེད་སྤྱོད་རུང་བཟོ།"

#: src/onboarding.ui:815
msgid "Confirm password"
msgstr "གསང་ཚིག་གཏན་འཁེལ།"

#: src/onboarding.ui:872
msgid "Back"
msgstr "ཕྱིར་ལོག"

#: src/onboarding.ui:907
msgid "Finish setup"
msgstr "སྒྲིག་འཇུག་མཇུག་སྒྲིལ།"

#: src/onboarding.ui:934
msgid "Next"
msgstr "རྗེས་མ།"

#: ubuntu-hello-gtk.desktop.in
msgid "Windows Hello style facial authentication"
msgstr "Windows Hello ལྟ་བུའི་གདོང་པའི་ར་སྤྲོད།"

#: ubuntu-hello-gtk.desktop.in
msgid "face;recognition;authentication;security;lock;"
msgstr "གདོང་པ;ངོས་འཛིན;ར་སྤྲོད;བདེ་འཇགས;སྒོ་ལྕགས;"

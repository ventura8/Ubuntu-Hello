#: src/onboarding.py:56 src/tab_keyring.py:35 src/onboarding.glade:176
msgid "Password"
msgstr "கடவுச்சொல்"

#: src/onboarding.py:214 src/onboarding.glade:448
msgid "Adding your face models"
msgstr "உங்கள் முக மாதிரிகளைச் சேர்த்தல்"

#: src/onboarding.py:217 src/onboarding.glade:467
msgid ""
"Ubuntu Hello will scan your face twice: once now, and once more in dif"
"ferent lighting (for example evening lamps instead of daylight), so it"
" recognises you reliably at any time of day. Press Scan to record the "
"first model."
msgstr ""
"Ubuntu Hello உங்கள் முகத்தை இரண்டு முறை ஸ்கேன் செய்யும்: இப்போது ஒருமு"
"றை, மேலும் ஒருமுறை வெவ்வேறு விளக்குகளில் (உதாரணமாக பகல் வெளிச்சத்திற்க"
"ுப் பதிலாக மாலை விளக்குகள்), எனவே இது நாளின் எந்த நேரத்திலும் உங்களை ந"
"ம்பகத்தன்மையுடன் அங்கீகரிக்கும். முதல் மாதிரியை பதிவு செய்ய ஸ்கேன் அழு"
"த்தவும்."

#: src/onboarding.py:220 src/onboarding.py:691 src/onboarding.py:773
#: src/tab_models.py:44 src/onboarding.glade:497
msgid "Please look directly into the camera"
msgstr "கேமராவை நேரடியாகப் பார்க்கவும்"

#: src/onboarding.py:223 src/onboarding.py:721 src/onboarding.glade:519
msgid "Start face scan"
msgstr "முகத்தை ஸ்கேன் செய்யத் தொடங்கவும்"

#: src/onboarding.py:287
msgid ""
"Datafiles have already been downloaded!\nClick Next to continue"
msgstr ""
"தரவு கோப்புகள் ஏற்கனவே பதிவிறக்கம் செய்யப்பட்டுள்ளன!\nதொடர அடுத்து என்"
"பதைக் கிளிக் செய்யவும்"

#: src/onboarding.py:324
msgid "Error while downloading datafiles"
msgstr "தரவுக் கோப்புகளைப் பதிவிறக்குவதில் பிழை"

#: src/onboarding.py:327
msgid ""
"Done!\nClick Next to continue"
msgstr ""
"முடிந்தது!\nதொடர அடுத்து என்பதைக் கிளிக் செய்யவும்"

#: src/onboarding.py:379 src/onboarding.py:606
msgid "Error while importing OpenCV2"
msgstr "OpenCV2 இறக்குமதி செய்யும் போது பிழை"

#: src/onboarding.py:379 src/onboarding.py:606
msgid "Try reinstalling cv2"
msgstr "cv2 ஐ மீண்டும் நிறுவ முயற்சிக்கவும்"

#: src/onboarding.py:386
msgid "No webcams found on system"
msgstr "கணினியில் வெப்கேம்கள் எதுவும் இல்லை"

#: src/onboarding.py:386
msgid ""
"Please configure your camera yourself if you are sure a compatible cam"
"era is connected"
msgstr ""
"இணக்கமான கேமரா இணைக்கப்பட்டிருப்பதை உறுதிசெய்தால், உங்கள் கேமராவை நீங்"
"களே உள்ளமைக்கவும்"

#: src/onboarding.py:478
msgid "No, camera can't be opened"
msgstr "இல்லை, கேமராவைத் திறக்க முடியாது"

#: src/onboarding.py:490
msgid "No, not an infrared camera"
msgstr "இல்லை, அகச்சிவப்பு கேமரா அல்ல"

#: src/onboarding.py:494
msgid "Yes, compatible infrared camera"
msgstr "ஆம், இணக்கமான அகச்சிவப்பு கேமரா"

#: src/onboarding.py:519
msgid "Camera identifier or path"
msgstr "கேமரா அடையாளங்காட்டி அல்லது பாதை"

#: src/onboarding.py:519
msgid "Recommended"
msgstr "பரிந்துரைக்கப்படுகிறது"

#: src/onboarding.py:610 src/onboarding.py:646
msgid "Error selecting camera"
msgstr "கேமராவைத் தேர்ந்தெடுப்பதில் பிழை"

#: src/onboarding.py:624
msgid "The selected camera cannot be opened"
msgstr "தேர்ந்தெடுக்கப்பட்ட கேமராவைத் திறக்க முடியாது"

#: src/onboarding.py:624
msgid "Try to select another one"
msgstr "இன்னொன்றைத் தேர்ந்தெடுக்க முயற்சிக்கவும்"

#: src/onboarding.py:639
msgid ""
"Please visit\n<a href=\"https://github.com/EmixamPP/linux-enable-ir-em"
"itter\">https://github.com/EmixamPP/linux-enable-ir-emitter</a>\nto en"
"able your ir emitter"
msgstr ""
"பார்வையிடவும்\n<a href=\"https://github.com/EmixamPP/linux-enable-ir-e"
"mitter\">https://github.com/EmixamPP/linux-enable-ir-emitter</a>\nஉங்க"
"ளின் உமிழ்ப்பானை இயக்க"

#: src/onboarding.py:704
msgid "Setup lighting 1"
msgstr "அமைப்பு வெளிச்சம் 1"

#: src/onboarding.py:705
msgid "Setup lighting 2"
msgstr "அமைப்பு வெளிச்சம் 2"

#: src/onboarding.py:723
msgid "Can't save face model"
msgstr "முக மாதிரியைச் சேமிக்க முடியவில்லை"

#: src/onboarding.py:728 src/onboarding.py:775
msgid "Scan second model"
msgstr "இரண்டாவது மாதிரியை ஸ்கேன் செய்"

#: src/onboarding.py:734
msgid "Couldn't record the second model"
msgstr "இரண்டாவது மாதிரியைப் பதிவு செய்ய முடியவில்லை"

#: src/onboarding.py:735
msgid ""
"Your first model is saved, so face login already works. The room must "
"still be bright enough to see your face — change the light rather than"
" turning it off — then try again, or skip and add a model later from S"
"ettings."
msgstr ""
"உங்கள் முதல் மாடல் சேமிக்கப்பட்டது, எனவே முக உள்நுழைவு ஏற்கனவே வேலை செ"
"ய்கிறது. உங்கள் முகத்தைப் பார்க்கும் அளவுக்கு அறை இன்னும் பிரகாசமாக இர"
"ுக்க வேண்டும் — ஒளியை அணைக்காமல் மாற்றவும் — பிறகு மீண்டும் முயலவும் அ"
"ல்லது அமைப்புகளில் இருந்து மாடலைத் தவிர்த்து பின்னர் சேர்க்கவும்."

#: src/onboarding.py:769
msgid "Second scan: different lighting"
msgstr "இரண்டாவது ஸ்கேன்: வெவ்வேறு விளக்குகள்"

#: src/onboarding.py:771
msgid ""
"First model saved. Now change the light — for example turn a lamp on o"
"r off, move away from the window, or use the other room light — keep y"
"our face clearly visible, then press Scan again."
msgstr ""
"முதல் மாடல் சேமிக்கப்பட்டது. இப்போது ஒளியை மாற்றவும் - எடுத்துக்காட்டா"
"க விளக்கை ஆன் அல்லது ஆஃப் செய்யவும், ஜன்னலுக்கு வெளியே நகர்த்தவும் அல்"
"லது மற்ற அறையின் வெளிச்சத்தைப் பயன்படுத்தவும் - உங்கள் முகத்தை தெளிவாக"
"த் தெரியும்படி வைத்து, மீண்டும் ஸ்கேன் அழுத்தவும்."

#: src/onboarding.py:805
msgid "Ubuntu Hello Setup"
msgstr "Ubuntu Hello அமைப்பு"

#: src/onboarding.py:818
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Checking TPM hardware a"
"nd tools..."
msgstr ""
"முக அங்கீகாரத்தைப் பயன்படுத்தி Ubuntu Hello தானாகவே உங்கள் {}ஐத் திறக்"
"கலாம் (கண்டறியப்பட்ட பணப்பை: {}).\n\n<b>TPM நிலை:</b> TPM வன்பொருள் மற"
"்றும் கருவிகளைச் சரிபார்க்கிறது..."

#: src/onboarding.py:838
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected. "
"Installing <i>tpm2-tools</i> automatically..."
msgstr ""
"முக அங்கீகாரத்தைப் பயன்படுத்தி Ubuntu Hello தானாகவே உங்கள் {}ஐத் திறக்"
"கலாம் (கண்டறியப்பட்ட பணப்பை: {}).\n\n<b>TPM நிலை:</b> TPM வன்பொருள் கண"
"்டறியப்பட்டது. <i>tpm2-tools</i> ஐ தானாக நிறுவுகிறது..."

#: src/onboarding.py:850
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Hardware TPM 2.0 active"
". Your password will be securely sealed inside the TPM."
msgstr ""
"முக அங்கீகாரத்தைப் பயன்படுத்தி Ubuntu Hello தானாகவே உங்கள் {}ஐத் திறக்"
"கலாம் (கண்டறியப்பட்ட பணப்பை: {}).\n\n<b>TPM நிலை:</b> வன்பொருள் TPM 2."
"0 செயலில் உள்ளது. உங்கள் கடவுச்சொல் TPM க்குள் பாதுகாப்பாக சீல் வைக்கப"
"்படும்."

#: src/onboarding.py:852
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected, "
"but automatic installation of <i>tpm2-tools</i> failed. Run <code>sudo"
" apt install tpm2-tools</code>. Falling back to software-based credent"
"ial caching."
msgstr ""
"முக அங்கீகாரத்தைப் பயன்படுத்தி Ubuntu Hello தானாகவே உங்கள் {}ஐத் திறக்"
"கலாம் (கண்டறியப்பட்ட பணப்பை: {}).\n\n<b>TPM நிலை:</b> TPM வன்பொருள் கண"
"்டறியப்பட்டது, ஆனால் <i>tpm2-tools</i> இன் தானியங்கி நிறுவல் தோல்வியடை"
"ந்தது. <code>sudo apt install tpm2-tools</code>ஐ இயக்கவும். மென்பொருள்"
" அடிப்படையிலான நற்சான்றிதழ் கேச்சிங்கிற்கு மீண்டும் வீழ்ச்சி."

#: src/onboarding.py:854
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> No TPM hardware detecte"
"d. Using software-based credential caching (AES-256-GCM)."
msgstr ""
"முக அங்கீகாரத்தைப் பயன்படுத்தி Ubuntu Hello தானாகவே உங்கள் {}ஐத் திறக்"
"கலாம் (கண்டறியப்பட்ட பணப்பை: {}).\n\n<b>TPM நிலை:</b> TPM வன்பொருள் எத"
"ுவும் கண்டறியப்படவில்லை. மென்பொருள் அடிப்படையிலான நற்சான்றிதழ் தேக்ககத"
"்தைப் பயன்படுத்துதல் (AES-256-GCM)."


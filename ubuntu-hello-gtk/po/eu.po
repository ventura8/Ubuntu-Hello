#: src/onboarding.py:446
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Checking TPM hardware a"
"nd tools..."
msgstr ""
"Ubuntu Hello-k automatikoki desblokea dezake zure {} aurpegiko autenti"
"fikazioa erabiliz (hautsitako zorroa: {}).\n\n<b>TPM egoera:</b> TPM h"
"ardwarea eta tresnak egiaztatzen..."

#: src/onboarding.py:466
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected. "
"Installing <i>tpm2-tools</i> automatically..."
msgstr ""
"Ubuntu Hello-k automatikoki desblokea dezake zure {} aurpegiko autenti"
"fikazioa erabiliz (hautsitako zorroa: {}).\n\n<b>TPM egoera:</b> TPM h"
"ardwarea detektatu da. <i>tpm2-tools</i> automatikoki instalatzen..."

#: src/onboarding.py:478
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Hardware TPM 2.0 active"
". Your password will be securely sealed inside the TPM."
msgstr ""
"Ubuntu Hello-k automatikoki desblokea dezake zure {} aurpegiko autenti"
"fikazioa erabiliz (hautsitako zorroa: {}).\n\n<b>TPM egoera:</b> Hardw"
"are TPM 2.0 aktiboa. Zure pasahitza modu seguruan itxiko da TPM barrua"
"n."

#: src/onboarding.py:480
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected, "
"but automatic installation of <i>tpm2-tools</i> failed. Run <code>sudo"
" apt install tpm2-tools</code>. Falling back to software-based credent"
"ial caching."
msgstr ""
"Ubuntu Hello-k automatikoki desblokea dezake zure {} aurpegiko autenti"
"fikazioa erabiliz (hautsitako zorroa: {}).\n\n<b>TPM egoera:</b> TPM h"
"ardwarea detektatu da, baina <i>tpm2-tools</i>ren instalazio automatik"
"oak huts egin du. Exekutatu <code>sudo apt install tpm2-tools</code>. "
"Softwarean oinarritutako kredentzialen cachean itzultzea."

#: src/onboarding.py:482
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> No TPM hardware detecte"
"d. Using software-based credential caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello-k automatikoki desblokea dezake zure {} aurpegiko autenti"
"fikazioa erabiliz (hautsitako zorroa: {}).\n\n<b>TPM egoera:</b> ez da"
" detektatu TPM hardwarerik. Softwarean oinarritutako kredentzialen cac"
"hea erabiliz (AES-256-GCM)."


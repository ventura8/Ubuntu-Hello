#: src/onboarding.py:36 src/tab_keyring.py:15
msgid "Enable Keyring/KWallet Unlocking"
msgstr "ਕੀਰਿੰਗ/KWallet ਅਨਲੌਕਿੰਗ ਚਾਲੂ ਕਰੋ"

#: src/onboarding.py:49 src/tab_keyring.py:28
msgid "Enter password for user <b>{}</b> to unlock {} ({}):"
msgstr "{} ({}) ਨੂੰ ਅਨਲੌਕ ਕਰਨ ਲਈ <b>{}</b> ਉਪਭੋਗਤਾ ਲਈ ਪਾਸਵਰਡ ਦਾਖਲ ਕਰੋ:"

#: src/onboarding.py:56 src/tab_keyring.py:35 src/onboarding.glade:176
msgid "Password"
msgstr "ਪਾਸਵਰਡ"

#: src/onboarding.py:214 src/onboarding.glade:448
msgid "Adding your face models"
msgstr "ਤੁਹਾਡੇ ਚਿਹਰੇ ਦੇ ਮਾਡਲ ਸ਼ਾਮਲ ਕੀਤੇ ਜਾ ਰਹੇ ਹਨ"

#: src/onboarding.py:217 src/onboarding.glade:467
msgid ""
"Ubuntu Hello will scan your face twice: once now, and once more in dif"
"ferent lighting (for example evening lamps instead of daylight), so it"
" recognises you reliably at any time of day. Press Scan to record the "
"first model."
msgstr ""
"Ubuntu Hello ਤੁਹਾਡੇ ਚਿਹਰੇ ਨੂੰ ਦੋ ਵਾਰ ਸਕੈਨ ਕਰੇਗਾ: ਇੱਕ ਵਾਰ ਹੁਣ, ਅਤੇ ਇੱਕ "
"ਵਾਰ ਹੋਰ ਵੱਖ-ਵੱਖ ਰੋਸ਼ਨੀ ਵਿੱਚ (ਉਦਾਹਰਨ ਲਈ ਦਿਨ ਦੇ ਰੋਸ਼ਨੀ ਦੀ ਬਜਾਏ ਸ਼ਾਮ ਦੇ ਦ"
"ੀਵੇ), ਇਸ ਲਈ ਇਹ ਤੁਹਾਨੂੰ ਦਿਨ ਦੇ ਕਿਸੇ ਵੀ ਸਮੇਂ ਭਰੋਸੇਯੋਗ ਤੌਰ 'ਤੇ ਪਛਾਣਦਾ ਹੈ।"
" ਪਹਿਲੇ ਮਾਡਲ ਨੂੰ ਰਿਕਾਰਡ ਕਰਨ ਲਈ ਸਕੈਨ ਦਬਾਓ।"

#: src/onboarding.py:220 src/onboarding.py:691 src/onboarding.py:773
#: src/tab_models.py:44 src/onboarding.glade:497
msgid "Please look directly into the camera"
msgstr "ਕਿਰਪਾ ਕਰਕੇ ਸਿੱਧੇ ਕੈਮਰੇ ਵਿੱਚ ਦੇਖੋ"

#: src/onboarding.py:223 src/onboarding.py:721 src/onboarding.glade:519
msgid "Start face scan"
msgstr "ਚਿਹਰਾ ਸਕੈਨ ਸ਼ੁਰੂ ਕਰੋ"

#: src/onboarding.py:287
msgid ""
"Datafiles have already been downloaded!\nClick Next to continue"
msgstr ""
"ਡੇਟਾਫਾਈਲਾਂ ਪਹਿਲਾਂ ਹੀ ਡਾਊਨਲੋਡ ਕੀਤੀਆਂ ਜਾ ਚੁੱਕੀਆਂ ਹਨ!\nਜਾਰੀ ਰੱਖਣ ਲਈ ਅੱਗੇ "
"'ਤੇ ਕਲਿੱਕ ਕਰੋ"

#: src/onboarding.py:324
msgid "Error while downloading datafiles"
msgstr "ਡਾਟਾ ਫਾਈਲਾਂ ਨੂੰ ਡਾਊਨਲੋਡ ਕਰਨ ਦੌਰਾਨ ਗਲਤੀ"

#: src/onboarding.py:327
msgid ""
"Done!\nClick Next to continue"
msgstr ""
"ਹੋ ਗਿਆ!\nਜਾਰੀ ਰੱਖਣ ਲਈ ਅੱਗੇ 'ਤੇ ਕਲਿੱਕ ਕਰੋ"

#: src/onboarding.py:379 src/onboarding.py:606
msgid "Error while importing OpenCV2"
msgstr "OpenCV2 ਆਯਾਤ ਕਰਨ ਦੌਰਾਨ ਤਰੁੱਟੀ"

#: src/onboarding.py:379 src/onboarding.py:606
msgid "Try reinstalling cv2"
msgstr "cv2 ਨੂੰ ਮੁੜ ਸਥਾਪਿਤ ਕਰਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰੋ"

#: src/onboarding.py:386
msgid "No webcams found on system"
msgstr "ਸਿਸਟਮ 'ਤੇ ਕੋਈ ਵੈਬਕੈਮ ਨਹੀਂ ਮਿਲੇ"

#: src/onboarding.py:386
msgid ""
"Please configure your camera yourself if you are sure a compatible cam"
"era is connected"
msgstr ""
"ਕਿਰਪਾ ਕਰਕੇ ਆਪਣੇ ਕੈਮਰੇ ਨੂੰ ਖੁਦ ਕੌਂਫਿਗਰ ਕਰੋ ਜੇਕਰ ਤੁਹਾਨੂੰ ਯਕੀਨ ਹੈ ਕਿ ਇੱਕ "
"ਅਨੁਕੂਲ ਕੈਮਰਾ ਕਨੈਕਟ ਹੈ"

#: src/onboarding.py:478
msgid "No, camera can't be opened"
msgstr "ਨਹੀਂ, ਕੈਮਰਾ ਖੋਲ੍ਹਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ"

#: src/onboarding.py:490
msgid "No, not an infrared camera"
msgstr "ਨਹੀਂ, ਇਨਫਰਾਰੈੱਡ ਕੈਮਰਾ ਨਹੀਂ"

#: src/onboarding.py:494
msgid "Yes, compatible infrared camera"
msgstr "ਹਾਂ, ਅਨੁਕੂਲ ਇਨਫਰਾਰੈੱਡ ਕੈਮਰਾ"

#: src/onboarding.py:519
msgid "Camera identifier or path"
msgstr "ਕੈਮਰਾ ਪਛਾਣਕਰਤਾ ਜਾਂ ਮਾਰਗ"

#: src/onboarding.py:519
msgid "Recommended"
msgstr "ਸਿਫ਼ਾਰਿਸ਼ ਕੀਤੀ"

#: src/onboarding.py:610 src/onboarding.py:646
msgid "Error selecting camera"
msgstr "ਕੈਮਰਾ ਚੁਣਨ ਵਿੱਚ ਤਰੁੱਟੀ"

#: src/onboarding.py:624
msgid "The selected camera cannot be opened"
msgstr "ਚੁਣਿਆ ਕੈਮਰਾ ਖੋਲ੍ਹਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ ਹੈ"

#: src/onboarding.py:624
msgid "Try to select another one"
msgstr "ਕੋਈ ਹੋਰ ਚੁਣਨ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰੋ"

#: src/onboarding.py:639
msgid ""
"Please visit\n<a href=\"https://github.com/EmixamPP/linux-enable-ir-em"
"itter\">https://github.com/EmixamPP/linux-enable-ir-emitter</a>\nto en"
"able your ir emitter"
msgstr ""
"ਕਿਰਪਾ ਕਰਕੇ ਵਿਜ਼ਿਟ ਕਰੋ\n<a href=\"https://github.com/EmixamPP/linux-ena"
"ble-ir-emitter\">https://github.com/EmixamPP/linux-enable-ir-emitter</"
"a>\nਤੁਹਾਡੇ ir emitter ਨੂੰ ਯੋਗ ਕਰਨ ਲਈ"

#: src/onboarding.py:704
msgid "Setup lighting 1"
msgstr "ਸੈੱਟਅੱਪ ਰੋਸ਼ਨੀ 1"

#: src/onboarding.py:705
msgid "Setup lighting 2"
msgstr "ਸੈੱਟਅੱਪ ਰੋਸ਼ਨੀ 2"

#: src/onboarding.py:723
msgid "Can't save face model"
msgstr "ਚਿਹਰੇ ਦਾ ਮਾਡਲ ਰੱਖਿਅਤ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ"

#: src/onboarding.py:728 src/onboarding.py:775
msgid "Scan second model"
msgstr "ਦੂਜਾ ਮਾਡਲ ਸਕੈਨ ਕਰੋ"

#: src/onboarding.py:734
msgid "Couldn't record the second model"
msgstr "ਦੂਜਾ ਮਾਡਲ ਰਿਕਾਰਡ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਿਆ"

#: src/onboarding.py:735
msgid ""
"Your first model is saved, so face login already works. The room must "
"still be bright enough to see your face — change the light rather than"
" turning it off — then try again, or skip and add a model later from S"
"ettings."
msgstr ""
"ਤੁਹਾਡਾ ਪਹਿਲਾ ਮਾਡਲ ਸੁਰੱਖਿਅਤ ਕੀਤਾ ਗਿਆ ਹੈ, ਇਸ ਲਈ ਚਿਹਰਾ ਲੌਗਇਨ ਪਹਿਲਾਂ ਹੀ ਕੰ"
"ਮ ਕਰਦਾ ਹੈ। ਤੁਹਾਡਾ ਚਿਹਰਾ ਦੇਖਣ ਲਈ ਕਮਰਾ ਅਜੇ ਵੀ ਚਮਕਦਾਰ ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ — ਰੋ"
"ਸ਼ਨੀ ਨੂੰ ਬੰਦ ਕਰਨ ਦੀ ਬਜਾਏ ਬਦਲੋ — ਫਿਰ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ, ਜਾਂ ਛੱਡੋ ਅਤੇ ਸ"
"ੈਟਿੰਗਾਂ ਤੋਂ ਬਾਅਦ ਵਿੱਚ ਇੱਕ ਮਾਡਲ ਸ਼ਾਮਲ ਕਰੋ।"

#: src/onboarding.py:769
msgid "Second scan: different lighting"
msgstr "ਦੂਜਾ ਸਕੈਨ: ਵੱਖਰੀ ਰੋਸ਼ਨੀ"

#: src/onboarding.py:771
msgid ""
"First model saved. Now change the light — for example turn a lamp on o"
"r off, move away from the window, or use the other room light — keep y"
"our face clearly visible, then press Scan again."
msgstr ""
"ਪਹਿਲਾ ਮਾਡਲ ਸੁਰੱਖਿਅਤ ਕੀਤਾ ਗਿਆ। ਹੁਣ ਰੋਸ਼ਨੀ ਬਦਲੋ — ਉਦਾਹਰਨ ਲਈ ਇੱਕ ਲੈਂਪ ਨੂੰ"
" ਚਾਲੂ ਜਾਂ ਬੰਦ ਕਰੋ, ਖਿੜਕੀ ਤੋਂ ਦੂਰ ਚਲੇ ਜਾਓ, ਜਾਂ ਦੂਜੇ ਕਮਰੇ ਦੀ ਰੋਸ਼ਨੀ ਦੀ ਵ"
"ਰਤੋਂ ਕਰੋ — ਆਪਣੇ ਚਿਹਰੇ ਨੂੰ ਸਾਫ਼-ਸਾਫ਼ ਦਿਖਣਯੋਗ ਰੱਖੋ, ਫਿਰ ਸਕੈਨ ਨੂੰ ਦੁਬਾਰਾ "
"ਦਬਾਓ।"

#: src/onboarding.py:805
msgid "Ubuntu Hello Setup"
msgstr "Ubuntu Hello ਸੈੱਟਅੱਪ"

#: src/onboarding.py:818
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Checking TPM hardware a"
"nd tools..."
msgstr ""
"Ubuntu Hello ਚਿਹਰਾ ਪ੍ਰਮਾਣਿਕਤਾ (ਪਛਾਣਿਆ ਵਾਲਿਟ: {}) ਦੀ ਵਰਤੋਂ ਕਰਕੇ ਤੁਹਾਡੇ "
"{} ਨੂੰ ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਅਨਲੌਕ ਕਰ ਸਕਦਾ ਹੈ।\n\n<b>TPM ਸਥਿਤੀ:</b> TPM ਹਾਰਡ"
"ਵੇਅਰ ਅਤੇ ਟੂਲਸ ਦੀ ਜਾਂਚ ਕੀਤੀ ਜਾ ਰਹੀ ਹੈ..."

#: src/onboarding.py:838
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected. "
"Installing <i>tpm2-tools</i> automatically..."
msgstr ""
"Ubuntu Hello ਚਿਹਰਾ ਪ੍ਰਮਾਣਿਕਤਾ (ਪਛਾਣਿਆ ਵਾਲਿਟ: {}) ਦੀ ਵਰਤੋਂ ਕਰਕੇ ਤੁਹਾਡੇ "
"{} ਨੂੰ ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਅਨਲੌਕ ਕਰ ਸਕਦਾ ਹੈ।\n\n<b>TPM ਸਥਿਤੀ:</b> TPM ਹਾਰਡ"
"ਵੇਅਰ ਖੋਜਿਆ ਗਿਆ। <i>tpm2-tools</i> ਨੂੰ ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਸਥਾਪਤ ਕੀਤਾ ਜਾ ਰਿ"
"ਹਾ ਹੈ..."

#: src/onboarding.py:850
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Hardware TPM 2.0 active"
". Your password will be securely sealed inside the TPM."
msgstr ""
"Ubuntu Hello ਚਿਹਰਾ ਪ੍ਰਮਾਣਿਕਤਾ (ਪਛਾਣਿਆ ਵਾਲਿਟ: {}) ਦੀ ਵਰਤੋਂ ਕਰਕੇ ਤੁਹਾਡੇ "
"{} ਨੂੰ ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਅਨਲੌਕ ਕਰ ਸਕਦਾ ਹੈ।\n\n<b>TPM ਸਥਿਤੀ:</b> ਹਾਰਡਵੇਅਰ"
" TPM 2.0 ਕਿਰਿਆਸ਼ੀਲ। ਤੁਹਾਡਾ ਪਾਸਵਰਡ TPM ਦੇ ਅੰਦਰ ਸੁਰੱਖਿਅਤ ਰੂਪ ਨਾਲ ਸੀਲ ਕੀਤ"
"ਾ ਜਾਵੇਗਾ।"

#: src/onboarding.py:852
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected, "
"but automatic installation of <i>tpm2-tools</i> failed. Run <code>sudo"
" apt install tpm2-tools</code>. Falling back to software-based credent"
"ial caching."
msgstr ""
"Ubuntu Hello ਚਿਹਰਾ ਪ੍ਰਮਾਣਿਕਤਾ (ਪਛਾਣਿਆ ਵਾਲਿਟ: {}) ਦੀ ਵਰਤੋਂ ਕਰਕੇ ਤੁਹਾਡੇ "
"{} ਨੂੰ ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਅਨਲੌਕ ਕਰ ਸਕਦਾ ਹੈ।\n\n<b>TPM ਸਥਿਤੀ:</b> TPM ਹਾਰਡ"
"ਵੇਅਰ ਖੋਜਿਆ ਗਿਆ, ਪਰ <i>tpm2-tools</i> ਦੀ ਸਵੈਚਲਿਤ ਸਥਾਪਨਾ ਅਸਫਲ ਰਹੀ। <code"
">sudo apt install tpm2-tools</code> ਚਲਾਓ। ਸੌਫਟਵੇਅਰ-ਅਧਾਰਿਤ ਕ੍ਰੈਡੈਂਸ਼ੀਅਲ"
" ਕੈਚਿੰਗ 'ਤੇ ਵਾਪਸ ਆਉਣਾ।"

#: src/onboarding.py:854
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> No TPM hardware detecte"
"d. Using software-based credential caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello ਚਿਹਰਾ ਪ੍ਰਮਾਣਿਕਤਾ (ਪਛਾਣਿਆ ਵਾਲਿਟ: {}) ਦੀ ਵਰਤੋਂ ਕਰਕੇ ਤੁਹਾਡੇ "
"{} ਨੂੰ ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਅਨਲੌਕ ਕਰ ਸਕਦਾ ਹੈ।\n\n<b>TPM ਸਥਿਤੀ:</b> ਕੋਈ TPM "
"ਹਾਰਡਵੇਅਰ ਨਹੀਂ ਲੱਭਿਆ। ਸੌਫਟਵੇਅਰ-ਅਧਾਰਿਤ ਕ੍ਰੈਡੈਂਸ਼ੀਅਲ ਕੈਚਿੰਗ (AES-256-GCM)"
" ਦੀ ਵਰਤੋਂ ਕਰਨਾ।"

#: src/onboarding.py:916 src/tab_keyring.py:166
msgid "Failed to disable keyring unlocking: {}"
msgstr "ਕੀਰਿੰਗ ਅਨਲੌਕਿੰਗ ਨੂੰ ਅਸਮਰੱਥ ਬਣਾਉਣ ਵਿੱਚ ਅਸਫਲ: {}"

#: src/onboarding.py:922
msgid "Could not identify non-root system user for keyring unlocking"
msgstr "ਕੀਰਿੰਗ ਅਨਲੌਕਿੰਗ ਲਈ ਗੈਰ-ਰੂਟ ਸਿਸਟਮ ਉਪਭੋਗਤਾ ਦੀ ਪਛਾਣ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕੀ ਹੈ"

#: src/onboarding.py:935 src/tab_keyring.py:91
msgid "Password cannot be empty"
msgstr "ਪਾਸਵਰਡ ਖਾਲੀ ਨਹੀਂ ਹੋ ਸਕਦਾ"

#: src/onboarding.py:939 src/tab_keyring.py:99
msgid "Incorrect password for user {}"
msgstr "ਉਪਭੋਗਤਾ {} ਲਈ ਗਲਤ ਪਾਸਵਰਡ"

#: src/onboarding.py:951 src/tab_keyring.py:113
msgid "unknown error"
msgstr "ਅਗਿਆਤ ਗਲਤੀ"

#: src/onboarding.py:952 src/onboarding.py:961 src/tab_keyring.py:124
msgid "Failed to enable keyring unlocking: {}"
msgstr "ਕੀਰਿੰਗ ਅਨਲੌਕਿੰਗ ਨੂੰ ਸਮਰੱਥ ਬਣਾਉਣ ਵਿੱਚ ਅਸਫਲ: {}"

#: src/onboarding.py:955
msgid "Failed to enable keyring unlocking: ubuntu-hello executable not found"
msgstr ""
"ਕੀਰਿੰਗ ਅਨਲੌਕ ਚਾਲੂ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਿਆ: ubuntu-hello ਐਗਜ਼ੀਕਿਊਟੇਬਲ ਨਹੀਂ ਮਿ"
"ਲਿਆ"

#: src/onboarding.py:958
msgid "Failed to enable keyring unlocking: timed out waiting for keyring enable"
msgstr "ਕੀਰਿੰਗ ਅਨਲੌਕ ਚਾਲੂ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਿਆ: ਚਾਲੂ ਹੋਣ ਦੀ ਉਡੀਕ ਵਿੱਚ ਸਮਾਂ ਖ਼ਤਮ"

#: src/onboarding.py:968
msgid "Keyring Unlocking Error"
msgstr "ਕੀਰਿੰਗ ਅਨਲੌਕ ਕਰਨ ਵਿੱਚ ਗਲਤੀ"

#: src/onboarding.py:983
msgid "Error reading radio buttons"
msgstr "ਰੇਡੀਓ ਬਟਨਾਂ ਨੂੰ ਪੜ੍ਹਨ ਵਿੱਚ ਤਰੁੱਟੀ"

#: src/onboarding.py:1010
msgid "Ubuntu Hello Setup Warning"
msgstr "Ubuntu Hello ਸੈੱਟਅੱਪ ਚੇਤਾਵਨੀ"

#: src/onboarding.py:1011
msgid "Could not save certainty preference, but setup is otherwise complete."
msgstr ""

msgid "Error while downloading datafiles"
msgstr "Pogreška prilikom preuzimanja podatkovnih datoteka"

#: src/onboarding.py:282
msgid ""
"Done!\n"
"Click Next to continue"
msgstr ""
"Gotovo!\n"
"Pritisnite Dalje za nastavak"


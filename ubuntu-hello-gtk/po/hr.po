msgstr "Omogući automatsko otključavanje"

#: src/main.ui:862
msgid "Keyring"
msgstr "Privjesak za ključeve"

#: src/main.ui:898
msgid "Display language"
msgstr "Jezik prikaza"

#: src/main.ui:913
msgid "Automatic follows the system language. Changes apply immediately."
msgstr "Automatski prati jezik sustava. Promjene se primjenjuju odmah."


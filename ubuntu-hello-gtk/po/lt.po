"Click Next to continue"
msgstr ""
"Duomenų failai jau atsisiųsti!\n"
"Spustelėkite Pirmyn, kad tęstumėte"

#: src/onboarding.py:316
msgid "Error while downloading datafiles"
msgstr "Atsisiunčiant duomenų failus įvyko klaida"

#: src/onboarding.py:319
msgid ""
"Done!\n"
"Click Next to continue"
msgstr ""
"Atlikta!\n"
"Spustelėkite Pirmyn, kad tęstumėte"


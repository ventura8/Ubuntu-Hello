msgstr "Raktų pakabukas"

#: src/main.ui:898
msgid "Display language"
msgstr "Sąsajos kalba"

#: src/main.ui:913
msgid "Automatic follows the system language. Changes apply immediately."
msgstr "Automatinė seka sistemos kalbą. Pakeitimai pritaikomi iškart."

#: src/main.ui:936 src/main.ui:956
msgid "Language"
msgstr "Kalba"

#: src/main.ui:977
msgid "Ubuntu Hello"
msgstr "Ubuntu Hello"

#: src/main.ui:990
msgid "Facial authentication for Linux"
msgstr "Veido autentifikavimas, skirtas Linux"

#: src/main.ui:999

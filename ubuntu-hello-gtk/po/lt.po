#: src/onboarding.py:446
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Checking TPM hardware a"
"nd tools..."
msgstr ""
"Ubuntu Hello gali automatiškai atrakinti {} naudodamas veido autentifi"
"kavimą (aptikta piniginė: {}).\n\n<b>TPM būsena:</b> tikrinama TPM apa"
"ratinė įranga ir įrankiai..."

#: src/onboarding.py:466
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected. "
"Installing <i>tpm2-tools</i> automatically..."
msgstr ""
"Ubuntu Hello gali automatiškai atrakinti {} naudodamas veido autentifi"
"kavimą (aptikta piniginė: {}).\n\n<b>TPM būsena:</b> aptikta TPM apara"
"tinė įranga. Automatiškai diegiamas <i>tpm2-tools</i>..."

#: src/onboarding.py:478
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Hardware TPM 2.0 active"
". Your password will be securely sealed inside the TPM."
msgstr ""
"Ubuntu Hello gali automatiškai atrakinti {} naudodamas veido autentifi"
"kavimą (aptikta piniginė: {}).\n\n<b>TPM būsena:</b> aparatinės įrango"
"s TPM 2.0 aktyvi. Jūsų slaptažodis bus saugiai užplombuotas TPM viduje"
"."

#: src/onboarding.py:480
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected, "
"but automatic installation of <i>tpm2-tools</i> failed. Run <code>sudo"
" apt install tpm2-tools</code>. Falling back to software-based credent"
"ial caching."
msgstr ""
"Ubuntu Hello gali automatiškai atrakinti {} naudodamas veido autentifi"
"kavimą (aptikta piniginė: {}).\n\n<b>TPM būsena:</b> aptikta TPM apara"
"tinė įranga, bet nepavyko automatiškai įdiegti <i>tpm2-tools</i>. Pale"
"iskite <code>sudo apt install tpm2-tools</code>. Grįžimas prie program"
"inės įrangos kredencialų kaupimo talpykloje."

#: src/onboarding.py:482
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> No TPM hardware detecte"
"d. Using software-based credential caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello gali automatiškai atrakinti {} naudodamas veido autentifi"
"kavimą (aptikta piniginė: {}).\n\n<b>TPM būsena:</b> TPM aparatinė įra"
"nga neaptikta. Naudojant programinės įrangos kredencialų kaupimą talpy"
"kloje (AES-256-GCM)."


#: src/onboarding.py:446
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Checking TPM hardware and tools..."
msgstr ""
"Ubuntu Hello inogona kuvhura otomatiki {} yako uchishandisa huchokwadi "
"hwechiso (wallet yakawanikwa: {}).\n"
"\n"
"<b>TPM Status:</b> Kutarisa TPM hardware uye maturusi..."

#: src/onboarding.py:466
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected. Installing <i>tpm2-tools</i> "
"automatically..."
msgstr ""
"Ubuntu Hello inogona kuvhura otomatiki {} yako uchishandisa huchokwadi "
"hwechiso (wallet yakawanikwa: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware yaonekwa. Kuisa <i>tpm2-tools</i> "
"otomatiki..."

#: src/onboarding.py:478
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Hardware TPM 2.0 active. Your password will be securely "
"sealed inside the TPM."
msgstr ""
"Ubuntu Hello inogona kuvhura otomatiki {} yako uchishandisa huchokwadi "
"hwechiso (wallet yakawanikwa: {}).\n"
"\n"
"<b>TPM Status:</b> Hardware TPM 2.0 inoshanda. Password yako ichavharwa "
"zvakachengeteka mukati meTPM."

#: src/onboarding.py:480
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected, but automatic installation of "
"<i>tpm2-tools</i> failed. Run <code>sudo apt install tpm2-tools</code>. "
"Falling back to software-based credential caching."
msgstr ""
"Ubuntu Hello inogona kuvhura otomatiki {} yako uchishandisa huchokwadi "
"hwechiso (wallet yakawanikwa: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware yaonekwa, asi kuiswa kwe<i>tpm2-tools</i> "
"otomatiki kwatadza. Mhanya <code>sudo apt install tpm2-tools</code>. "
"Kudzokera kune software-based credential caching."

#: src/onboarding.py:482
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> No TPM hardware detected. Using software-based credential "
"caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello inogona kuvhura otomatiki {} yako uchishandisa huchokwadi "
"hwechiso (wallet yakawanikwa: {}).\n"
"\n"
"<b>TPM Status:</b> Hapana TPM hardware yaonekwa. Kushandisa software-based "
"credential caching (AES-256-GCM)."


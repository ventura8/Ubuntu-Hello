#: src/main.glade:20
msgctxt "Window title"
msgid "Ubuntu Hello Configuration"
msgstr "Ubuntu Hello Διαμόρφωση"

#: src/main.glade:27
msgid "Ubuntu Hello Configuration"
msgstr "Ubuntu Hello Διαμόρφωση"

#: src/main.glade:35

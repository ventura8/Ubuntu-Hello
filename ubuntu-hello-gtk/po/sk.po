msgstr "Skúste preinštalovať cv2"

#: src/onboarding.py:386
msgid "No webcams found on system"
msgstr "V systéme sa nenašli žiadne webové kamery"

#: src/onboarding.py:386
msgid ""
"Please configure your camera yourself if you are sure a compatible cam"
"era is connected"
msgstr ""
"Ak ste si istí, že je pripojená kompatibilná kamera, nakonfigurujte si"
" kameru sami"

#: src/onboarding.py:478
msgid "No, camera can't be opened"
msgstr "Nie, fotoaparát sa nedá otvoriť"

#: src/onboarding.py:490
msgid "No, not an infrared camera"
msgstr "Nie, nie infračervená kamera"

#: src/onboarding.py:494
msgid "Yes, compatible infrared camera"
msgstr "Áno, kompatibilná infračervená kamera"

#: src/onboarding.py:519
msgid "Camera identifier or path"
msgstr "Identifikátor kamery alebo cesta"

#: src/onboarding.py:519
msgid "Recommended"
msgstr "Odporúčané"


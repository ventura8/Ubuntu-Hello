msgstr "ʻAʻole, ʻaʻole hiki ke wehe ʻia ka pahupaʻikiʻi"

#: src/onboarding.py:467
msgid "No, not an infrared camera"
msgstr "ʻAʻole, ʻaʻole kahi pahupaʻikiʻi infrared"

#: src/onboarding.py:471
msgid "Yes, compatible infrared camera"
msgstr "ʻAe, pahupaʻikiʻi infrared kūpono"

#: src/onboarding.py:488
msgid "Camera identifier or path"
msgstr "Mea hōʻike pahupaʻikiʻi a i ʻole ala"

#: src/onboarding.py:488
msgid "Recommended"
msgstr "Paipai ʻia"

#: src/onboarding.py:568 src/onboarding.py:607
msgid "Error selecting camera"
msgstr "Ua hewa ke koho ʻana i ka pahupaʻikiʻi"

#: src/onboarding.py:582

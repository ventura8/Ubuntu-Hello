msgstr ""
"Kamera Ubuntu Hello wykorzystuje Twoją twarz i umożliwia podgląd na żywo."

#: src/main.ui:300
msgid "Camera ID:"
msgstr "Identyfikator kamery:"

#: src/main.ui:315

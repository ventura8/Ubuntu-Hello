msgstr ""
"Datoteke podataka su već preuzete!\n"
"Kliknite na Next za nastavak"

#: src/onboarding.py:316
msgid "Error while downloading datafiles"
msgstr "Greška prilikom preuzimanja datoteka sa podacima"

#: src/onboarding.py:319

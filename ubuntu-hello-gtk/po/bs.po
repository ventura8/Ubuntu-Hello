msgid "Error while downloading datafiles"
msgstr "Greška prilikom preuzimanja datoteka sa podacima"

#: src/onboarding.py:327
msgid ""
"Done!\nClick Next to continue"
msgstr ""
"Gotovo!\nKliknite na Next za nastavak"


msgstr "Na sistemu nije pronađena nijedna web kamera"

#: src/onboarding.py:386
msgid ""
"Please configure your camera yourself if you are sure a compatible cam"
"era is connected"
msgstr ""
"Molimo konfigurirajte svoju kameru sami ako ste sigurni da je kompatib"
"ilna kamera povezana"

#: src/onboarding.py:478
msgid "No, camera can't be opened"
msgstr "Ne, kamera se ne može otvoriti"

#: src/onboarding.py:490

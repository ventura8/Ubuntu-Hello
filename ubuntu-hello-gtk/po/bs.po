#: src/onboarding.py:446
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Checking TPM hardware and tools..."
msgstr ""
"Ubuntu Hello može automatski otključati vaš {} koristeći autentifikaciju "
"licem (otkriveni novčanik: {}).\n"
"\n"
"<b>TPM status:</b> Provjera TPM hardvera i alata..."

#: src/onboarding.py:466
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected. Installing <i>tpm2-tools</i> "
"automatically..."
msgstr ""
"Ubuntu Hello može automatski otključati vaš {} koristeći autentifikaciju "
"licem (otkriveni novčanik: {}).\n"
"\n"
"<b>TPM status:</b> Otkriven je TPM hardver. Automatsko instaliranje <i>tpm2-"
"tools</i>..."

#: src/onboarding.py:478
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Hardware TPM 2.0 active. Your password will be securely "
"sealed inside the TPM."
msgstr ""
"Ubuntu Hello može automatski otključati vaš {} koristeći autentifikaciju "
"licem (otkriveni novčanik: {}).\n"
"\n"
"<b>TPM status:</b> Hardverski TPM 2.0 aktivan. Vaša lozinka će biti sigurno "
"zapečaćena unutar TPM-a."

#: src/onboarding.py:480
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected, but automatic installation of "
"<i>tpm2-tools</i> failed. Run <code>sudo apt install tpm2-tools</code>. "
"Falling back to software-based credential caching."
msgstr ""
"Ubuntu Hello može automatski otključati vaš {} koristeći autentifikaciju "
"licem (otkriveni novčanik: {}).\n"
"\n"
"<b>TPM status:</b> TPM hardver je otkriven, ali automatska instalacija "
"<i>tpm2-tools</i> nije uspjela. Pokrenite <code>sudo apt install tpm2-tools</"
"code>. Vraćanje na softversko keširanje vjerodajnica."

#: src/onboarding.py:482
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> No TPM hardware detected. Using software-based credential "
"caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello može automatski otključati vaš {} koristeći autentifikaciju "
"licem (otkriveni novčanik: {}).\n"
"\n"
"<b>TPM status:</b> Nije otkriven TPM hardver. Korištenje softverskog "
"keširanja vjerodajnica (AES-256-GCM)."


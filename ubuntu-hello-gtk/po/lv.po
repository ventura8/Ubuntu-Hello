#: src/onboarding.py:382
msgid "No webcams found on system"
msgstr "Sistēmā nav atrasta neviena tīmekļa kamera"

#: src/onboarding.py:382
msgid ""
"Please configure your camera yourself if you are sure a compatible camera is "

msgid "Error while downloading datafiles"
msgstr "Lejupielādējot datu failus, radās kļūda"

#: src/onboarding.py:327
msgid ""
"Done!\nClick Next to continue"
msgstr ""
"Gatavs!\nNoklikšķiniet uz Tālāk, lai turpinātu"


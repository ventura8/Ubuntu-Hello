"Click Next to continue"
msgstr ""
"Datu faili jau ir lejupielādēti!\n"
"Noklikšķiniet uz Tālāk, lai turpinātu"

#: src/onboarding.py:316
msgid "Error while downloading datafiles"
msgstr "Lejupielādējot datu failus, radās kļūda"


msgstr "באַשטעטיקן מאָדעל קרעאַטיאָן"

#: src/tab_models.py:23 src/tab_models.py:89 src/tab_keyring.py:17
#: src/tab_keyring.py:114 src/onboarding.ui:848
msgid "Cancel"
msgstr "באָטל מאַכן"

#: src/tab_models.py:24 src/main.ui:186
msgid "Add"
msgstr "לייג"

#: src/tab_models.py:25
msgid "Please enter a name for the new model, 24 characters max"
msgstr "ביטע אַרייַן אַ נאָמען פֿאַר די נייַע מאָדעל, מאַקסימום 24 אותיות"

#: src/tab_models.py:29
msgid "Model name:"
msgstr "מאָדעל נאָמען:"

#: src/tab_models.py:39
msgid "Creating Model"
msgstr "שאפן מאָדעל"

#: src/tab_models.py:40
msgid ""
"Keep your face inside the camera view and follow the prompts; this takes "
"about a minute."
msgstr ""
"האַלט דאָס פּנים אין דער קאַמערע־זעונג און פֿאָלגט די אָנווײַזונגען; דאָס נעמט אַרום אַ "
"מינוט."

#: src/tab_models.py:41 src/enroll.py:24
msgid "Look straight at the camera"
msgstr "קוקט גלײַך אין דער קאַמערע"

#: src/tab_models.py:70
msgid ""
"Error while adding model, error code {}: \n"
"\n"
msgstr ""
"טעות בשעת אַדינג מאָדעל, טעות קאָד {}:\n"
"\n"

#: src/tab_models.py:88
#, python-brace-format
msgid "Are you sure you want to delete model {id} ({name})?"
msgstr "זענט איר זיכער אַז איר ווילט ויסמעקן די מאָדעל {id} ({name})?"

#: src/tab_models.py:89 src/main.ui:212
msgid "Delete"
msgstr "ויסמעקן"

#: src/tab_models.py:97
msgid ""
"Error while deleting model, error code {}: \n"
"\n"
msgstr ""
"טעות בשעת דיליטינג מאָדעל, טעות קאָד {}:\n"
"\n"

#: src/enroll.py:25
msgid "Turn your head slightly to the left"
msgstr "דרייט דעם קאָפּ אַ ביסל אויף לינקס"

#: src/enroll.py:26
msgid "Turn your head slightly to the right"
msgstr "דרייט דעם קאָפּ אַ ביסל אויף רעכטס"

#: src/enroll.py:27
msgid "Tilt your chin up a little"
msgstr "הייבט דעם קין אַ ביסל אַרויף"

#: src/enroll.py:28
msgid "Tilt your chin down a little"
msgstr "לאָזט דעם קין אַ ביסל אַראָפּ"

#: src/enroll.py:39
#, python-brace-format
msgid "Recording… {count} of {total}"
msgstr "רעקאָרדירט… {count} פֿון {total}"


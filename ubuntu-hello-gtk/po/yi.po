msgid "Enable Keyring/KWallet Unlocking"
msgstr "אַקטיווירן דאָס אויפֿשליסן פֿון Keyring/KWallet"

#: src/tab_keyring.py:18
msgid "OK"
msgstr "גוט"

#: src/tab_keyring.py:23
msgid "Enter password for user <b>{}</b> to unlock {} ({}):"
msgstr "אַרייַן פּאַראָל פֿאַר באַניצער <b>{}</b> צו ופשליסן {} ({}):"


msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Checking TPM hardware a"
"nd tools..."
msgstr ""
"Ubuntu Hello kan jou {} outomaties ontsluit met gesigstawing (bespeurd"
"e beursie: {}).\n\n<b>TPM-status:</b> Gaan tans TPM-hardeware en -nuts"
"goed na..."

#: src/onboarding.py:466
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected. "
"Installing <i>tpm2-tools</i> automatically..."
msgstr ""
"Ubuntu Hello kan jou {} outomaties ontsluit met gesigstawing (bespeurd"
"e beursie: {}).\n\n<b>TPM-status:</b> TPM-hardeware bespeur. Installee"
"r tans <i>tpm2-tools</i> outomaties..."

#: src/onboarding.py:478
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Hardware TPM 2.0 active"
". Your password will be securely sealed inside the TPM."
msgstr ""
"Ubuntu Hello kan jou {} outomaties ontsluit met gesigstawing (bespeurd"
"e beursie: {}).\n\n<b>TPM-status:</b> Hardeware TPM 2.0 aktief. Jou wa"
"gwoord sal veilig binne die TPM verseël wees."

#: src/onboarding.py:480
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected, "
"but automatic installation of <i>tpm2-tools</i> failed. Run <code>sudo"
" apt install tpm2-tools</code>. Falling back to software-based credent"
"ial caching."
msgstr ""
"Ubuntu Hello kan jou {} outomaties ontsluit met gesigstawing (bespeurd"
"e beursie: {}).\n\n<b>TPM-status:</b> TPM-hardeware bespeur, maar outo"
"matiese installering van <i>tpm2-tools</i> het misluk. Begin <code>sud"
"o apt install tpm2-tools</code>. Terugval na sagteware-gebaseerde gelo"
"ofsbriewe-kas."

#: src/onboarding.py:482
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> No TPM hardware detecte"
"d. Using software-based credential caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello kan jou {} outomaties ontsluit met gesigstawing (bespeurd"
"e beursie: {}).\n\n<b>TPM-status:</b> Geen TPM-hardeware bespeur nie. "
"Gebruik sagteware-gebaseerde geloofsbriewe-kas (AES-256-GCM)."


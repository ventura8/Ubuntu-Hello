"confirm that you are really there."
msgstr ""
"Quam accurate vultus tuus congruere debeat, et num Ubuntu Hello te roget ut "
"te vere adesse confirmes."

#: src/main.ui:657
msgid "Face match strictness"
msgstr "Severitas congruentiae vultus"

#: src/main.ui:665 src/onboarding.ui:151
msgid "Fast"
msgstr "Ieiunium"

#: src/main.ui:672 src/onboarding.ui:182

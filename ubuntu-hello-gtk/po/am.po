#: src/window.py:99
msgid "ID"
msgstr "ID"

#: src/window.py:99
msgid "Created"
msgstr "ተፈጠረ"

#: src/window.py:99
msgid "Label"
msgstr "መለያ"

#: src/window.py:204
msgid "Automatic"
msgstr "አውቶማቲክ"

#: src/onboarding.py:169 src/onboarding.ui:246
msgid "Adding your face models"
msgstr "የፊትዎን ሞዴሎች በማከል ላይ"

#: src/onboarding.py:172 src/onboarding.ui:262
msgid ""
"Ubuntu Hello will scan your face twice: once now, and once more in different "
"lighting (for example evening lamps instead of daylight), so it recognises "
"you reliably at any time of day. Press Scan to record the first model."
msgstr ""
"Ubuntu Hello ፊትዎን ሁለት ጊዜ ይቃኛል፡ አንድ ጊዜ አሁን እና አንድ ጊዜ በተለያዩ መብራቶች (ለምሳሌ ከቀን "
"ብርሃን ይልቅ የምሽት መብራቶች)፣ ስለዚህ በቀን ውስጥ በማንኛውም ጊዜ በአስተማማኝ ሁኔታ ይገነዘባል። የመጀመሪያውን "
"ሞዴል ለመቅዳት ቅኝትን ይጫኑ።"

#: src/onboarding.py:175 src/onboarding.py:630 src/onboarding.py:712
#: src/tab_models.py:39 src/onboarding.ui:288
msgid "Please look directly into the camera"
msgstr "እባክዎን በቀጥታ ወደ ካሜራው ይመልከቱ"

#: src/onboarding.py:178 src/onboarding.py:660 src/onboarding.ui:323
msgid "Start face scan"
msgstr "የፊት ቅኝትን ጀምር"

#: src/onboarding.py:242
msgid ""
"Datafiles have already been downloaded!\n"
"Click Next to continue"
msgstr ""
"የውሂብ ፋይሎች አስቀድመው ወርደዋል!\n"
"ለመቀጠል ቀጣይ የሚለውን ጠቅ ያድርጉ"

#: src/onboarding.py:279
msgid "Error while downloading datafiles"
msgstr "የውሂብ ፋይሎችን በማውረድ ላይ ሳለ ስህተት"

#: src/onboarding.py:282
msgid ""
"Done!\n"
"Click Next to continue"
msgstr ""
"ተከናውኗል!\n"
"ለመቀጠል ቀጣይ የሚለውን ጠቅ ያድርጉ"

#: src/onboarding.py:334 src/onboarding.py:542
msgid "Error while importing OpenCV2"
msgstr "⟦OCV2ን በማስመጣት ላይ ሳለ ስህተት"

#: src/onboarding.py:334 src/onboarding.py:542
msgid "Try reinstalling cv2"
msgstr "cv2 እንደገና ለመጫን ይሞክሩ"

#: src/onboarding.py:341
msgid "No webcams found on system"
msgstr "በሲስተሙ ላይ ምንም የድር ካሜራዎች አልተገኙም።"

#: src/onboarding.py:341
msgid ""
"Please configure your camera yourself if you are sure a compatible camera is "
"connected"
msgstr "ተኳኋኝ ካሜራ መገናኘቱን እርግጠኛ ከሆኑ እባክዎ ካሜራዎን እራስዎ ያዋቅሩት"

#: src/onboarding.py:433
msgid "No, camera can't be opened"
msgstr "አይ፣ ካሜራ ሊከፈት አይችልም።"

#: src/onboarding.py:445
msgid "No, not an infrared camera"
msgstr "አይ፣ ኢንፍራሬድ ካሜራ አይደለም።"

#: src/onboarding.py:449
msgid "Yes, compatible infrared camera"
msgstr "አዎ፣ ተስማሚ የኢንፍራሬድ ካሜራ"

#: src/onboarding.py:466
msgid "Camera identifier or path"
msgstr "የካሜራ መለያ ወይም መንገድ"

#: src/onboarding.py:466
msgid "Recommended"
msgstr "የሚመከር"

#: src/onboarding.py:546 src/onboarding.py:585
msgid "Error selecting camera"
msgstr "ካሜራ መምረጥ ላይ ስህተት"

#: src/onboarding.py:560
msgid "The selected camera cannot be opened"
msgstr "የተመረጠው ካሜራ ሊከፈት አይችልም።"

#: src/onboarding.py:560
msgid "Try to select another one"
msgstr "ሌላ ለመምረጥ ይሞክሩ"

#: src/onboarding.py:575
msgid ""
"Please visit\n"
"<a href=\"https://github.com/EmixamPP/linux-enable-ir-emitter\">https://"
"github.com/EmixamPP/linux-enable-ir-emitter</a>\n"
"to enable your ir emitter"
msgstr ""
"እባክዎን ይጎብኙ\n"
"<a href=\"https://github.com/EmixamPP/linux-enable-ir-emitter\">https://"
"github.com/EmixamPP/linux-enable-ir-emitter</a>\n"
"የእርስዎን ኢር ኢሚተር ለማንቃት"

#: src/onboarding.py:643
msgid "Setup lighting 1"
msgstr "የመብራት አቀማመጥ 1"

#: src/onboarding.py:644
msgid "Setup lighting 2"
msgstr "የመብራት አቀማመጥ 2"

#: src/onboarding.py:662
msgid "Can't save face model"
msgstr "የፊት ሞዴልን ማስቀመጥ አልተቻለም"

#: src/onboarding.py:667 src/onboarding.py:714
msgid "Scan second model"
msgstr "ሁለተኛውን ሞዴል ይቃኙ"

#: src/onboarding.py:673
msgid "Couldn't record the second model"
msgstr "ሁለተኛውን ሞዴል መቅዳት አልተቻለም"

#: src/onboarding.py:674
msgid ""
"Your first model is saved, so face login already works. The room must still "
"be bright enough to see your face — change the light rather than turning it "
"off — then try again, or skip and add a model later from Settings."
msgstr ""
"የመጀመሪያው ሞዴልህ ተቀምጧል፣ ስለዚህ የመልክ መግቢያ አስቀድሞ ይሰራል። ፊትዎን ለማየት ክፍሉ አሁንም በቂ ብሩህ መሆን "
"አለበት - መብራቱን ከማጥፋት ይልቅ ይለውጡ - ከዚያ እንደገና ይሞክሩ ወይም ይዝለሉ እና ከቅንብሮች በኋላ ሞዴል ያክሉ።"

#: src/onboarding.py:708
msgid "Second scan: different lighting"
msgstr "ሁለተኛ ቅኝት: የተለያዩ መብራቶች"

#: src/onboarding.py:710
msgid ""
"First model saved. Now change the light — for example turn a lamp on or off, "
"move away from the window, or use the other room light — keep your face "
"clearly visible, then press Scan again."
msgstr ""
"የመጀመሪያው ሞዴል ተቀምጧል። አሁን መብራቱን ይቀይሩ - ለምሳሌ መብራትን ያብሩ ወይም ያጥፉ, ከመስኮቱ ይራቁ, ወይም "
"የሌላውን ክፍል ብርሃን ይጠቀሙ - ፊትዎን በግልጽ እንዲታይ ያድርጉት, ከዚያ እንደገና ስካንን ይጫኑ."

#: src/onboarding.py:752
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Checking TPM hardware and tools..."
msgstr ""
"Ubuntu Hello የፊት ማረጋገጫን (የተገኘ የኪስ ቦርሳ፡ {}) በመጠቀም የእርስዎን {} በራስ ሰር መክፈት "
"ይችላል።\n"
"\n"
"<b>TPM ሁኔታ፡</b> TPM ሃርድዌር እና መሳሪያዎች በመፈተሽ ላይ..."

#: src/onboarding.py:772
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected. Installing <i>tpm2-tools</i> "
"automatically..."
msgstr ""
"Ubuntu Hello የፊት ማረጋገጫን (የተገኘ የኪስ ቦርሳ፡ {}) በመጠቀም የእርስዎን {} በራስ ሰር መክፈት "
"ይችላል።\n"
"\n"
"<b>TPM ሁኔታ፡</b> TPM ሃርድዌር ተገኝቷል። <i>tpm2-tools</i>ን በራስ ሰር በመጫን ላይ..."

#: src/onboarding.py:784
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Hardware TPM 2.0 active. Your password will be securely "
"sealed inside the TPM."
msgstr ""
"Ubuntu Hello የፊት ማረጋገጫን (የተገኘ የኪስ ቦርሳ፡ {}) በመጠቀም የእርስዎን {} በራስ ሰር መክፈት "
"ይችላል።\n"
"\n"
"<b>TPM ሁኔታ፡</b> ሃርድዌር TPM 2.0 ገቢር ነው። የይለፍ ቃልዎ በ TPM ውስጥ ደህንነቱ በተጠበቀ ሁኔታ "
"ይዘጋል።"

#: src/onboarding.py:786
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected, but automatic installation of "
"<i>tpm2-tools</i> failed. Run <code>sudo apt install tpm2-tools</code>. "
"Falling back to software-based credential caching."
msgstr ""
"Ubuntu Hello የፊት ማረጋገጫን (የተገኘ የኪስ ቦርሳ፡ {}) በመጠቀም የእርስዎን {} በራስ ሰር መክፈት "
"ይችላል።\n"
"\n"
"<b>TPM ሁኔታ፡</b> TPM ሃርድዌር ተገኝቷል፣ ነገር ግን የ<i>tpm2-tools</i> በራስ ሰር መጫን "
"አልተሳካም። <code>sudo apt install tpm2-tools</code>ን ያሂዱ። ወደ ሶፍትዌር-ተኮር ምስክርነት "
"መሸጎጫ መመለስ።"

#: src/onboarding.py:788
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> No TPM hardware detected. Using software-based credential "
"caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello የፊት ማረጋገጫን (የተገኘ የኪስ ቦርሳ፡ {}) በመጠቀም የእርስዎን {} በራስ ሰር መክፈት "
"ይችላል።\n"
"\n"
"<b>TPM ሁኔታ፡</b> ምንም የ TPM ሃርድዌር አልተገኘም። በሶፍትዌር ላይ የተመሰረተ ምስክርነት መሸጎጫ "
"(AES-256-GCM) በመጠቀም።"

#: src/onboarding.py:850 src/tab_keyring.py:134
msgid "Failed to disable keyring unlocking: {}"
msgstr "የቁልፍ መክፈቻን ማሰናከል አልተሳካም: {}"

#: src/onboarding.py:856
msgid "Could not identify non-root system user for keyring unlocking"
msgstr "ለቁልፍ መክፈቻ ስር ያልሆነውን የስርዓት ተጠቃሚ መለየት አልተቻለም"

#: src/onboarding.py:869 src/tab_keyring.py:82
msgid "Password cannot be empty"
msgstr "የይለፍ ቃል ባዶ ሊሆን አይችልም።"

#: src/onboarding.py:873 src/tab_keyring.py:86
msgid "Incorrect password for user {}"
msgstr "የተሳሳተ የይለፍ ቃል ለተጠቃሚ {}"

#: src/onboarding.py:885 src/tab_keyring.py:98
msgid "unknown error"
msgstr "ያልታወቀ ስህተት"

#: src/onboarding.py:886 src/onboarding.py:895 src/tab_keyring.py:103
msgid "Failed to enable keyring unlocking: {}"
msgstr "የቁልፍ መክፈቻን ማንቃት አልተሳካም፦ {}"

#: src/onboarding.py:889
msgid "Failed to enable keyring unlocking: ubuntu-hello executable not found"
msgstr "የቁልፍ መክፈቻን ማንቃት አልተሳካም፡ ubuntu-hello executable አልተገኘም።"

#: src/onboarding.py:892
msgid ""
"Failed to enable keyring unlocking: timed out waiting for keyring enable"
msgstr "የቁልፍ መክፈቻን ማንቃት አልተሳካም፡ ቁልፍን ማንቃትን መጠበቅ ጊዜው አልፎበታል።"

#: src/onboarding.py:901
msgid "Keyring Unlocking Error"
msgstr "የመክፈት ስህተት"

#: src/onboarding.py:914
msgid "Error reading radio buttons"
msgstr "የሬዲዮ አዝራሮችን ማንበብ ላይ ስህተት"

#: src/onboarding.py:940
msgid "Could not save certainty preference, but setup is otherwise complete."
msgstr "ምርጫን በእርግጠኝነት ማስቀመጥ አልተቻለም፣ ግን ማዋቀሩ ያለበለዚያ ተጠናቋል።"

#: src/authsticky.py:110
msgid "Loading...  "
msgstr "በመጫን ላይ..."

#: src/authsticky.py:128
msgid "Ubuntu Hello Authentication"
msgstr "Ubuntu Hello ማረጋገጫ"

#: src/tab_models.py:21
msgid "Confirm Model Creation"
msgstr "ሞዴል መፍጠርን ያረጋግጡ"

#: src/tab_models.py:22 src/tab_models.py:73 src/tab_keyring.py:17
#: src/tab_keyring.py:114 src/onboarding.ui:796
msgid "Cancel"
msgstr "ሰርዝ"

#: src/tab_models.py:23 src/main.ui:181
msgid "Add"
msgstr "አክል"

#: src/tab_models.py:24
msgid "Please enter a name for the new model, 24 characters max"
msgstr "እባክዎ ለአዲሱ ሞዴል ስም ያስገቡ፣ ቢበዛ 24 ቁምፊዎች"

#: src/tab_models.py:28
msgid "Model name:"
msgstr "የሞዴል ስም፡-"

#: src/tab_models.py:38
msgid "Creating Model"
msgstr "ሞዴል መፍጠር"

#: src/tab_models.py:58
msgid ""
"Error while adding model, error code {}: \n"
"\n"
msgstr ""
"ሞዴል በማከል ላይ ስህተት፣ የስህተት ኮድ {}:\n"
"\n"

#: src/tab_models.py:72
#, python-brace-format
msgid "Are you sure you want to delete model {id} ({name})?"
msgstr "እርግጠኛ ነዎት ሞዴል {id} ({name}) መሰረዝ ይፈልጋሉ?"

#: src/tab_models.py:73 src/main.ui:207
msgid "Delete"
msgstr "ሰርዝ"

#: src/tab_models.py:81
msgid ""
"Error while deleting model, error code {}: \n"
"\n"
msgstr ""

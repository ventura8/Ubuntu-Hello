#: src/onboarding.py:214 src/onboarding.glade:448
msgid "Adding your face models"
msgstr "اپنے چہرے کے ماڈلز کو شامل کرنا"

#: src/onboarding.py:217 src/onboarding.glade:467
msgid ""
"Ubuntu Hello will scan your face twice: once now, and once more in dif"
"ferent lighting (for example evening lamps instead of daylight), so it"
" recognises you reliably at any time of day. Press Scan to record the "
"first model."
msgstr ""
"Ubuntu Hello آپ کے چہرے کو دو بار اسکین کرے گا: ایک بار اب، اور ایک با"
"ر پھر مختلف روشنی میں (مثال کے طور پر دن کی روشنی کے بجائے شام کے لیمپ"
")، تاکہ یہ دن کے کسی بھی وقت آپ کو قابل اعتماد طریقے سے پہچان سکے۔ پہل"
"ے ماڈل کو ریکارڈ کرنے کے لیے اسکین کو دبائیں۔"

#: src/onboarding.py:220 src/onboarding.py:691 src/onboarding.py:773
#: src/tab_models.py:44 src/onboarding.glade:497
msgid "Please look directly into the camera"
msgstr "براہ کرم براہ راست کیمرے میں دیکھیں"

#: src/onboarding.py:223 src/onboarding.py:721 src/onboarding.glade:519
msgid "Start face scan"
msgstr "چہرہ اسکین شروع کریں۔"

#: src/onboarding.py:287
msgid ""
"Datafiles have already been downloaded!\nClick Next to continue"
msgstr ""
"ڈیٹا فائلز پہلے ہی ڈاؤن لوڈ ہو چکی ہیں!\nجاری رکھنے کے لیے اگلا پر کلک"
" کریں۔"

#: src/onboarding.py:324
msgid "Error while downloading datafiles"
msgstr "ڈیٹا فائلز ڈاؤن لوڈ کرتے وقت خرابی۔"

#: src/onboarding.py:327
msgid ""
"Done!\nClick Next to continue"
msgstr ""
"ہو گیا!\nجاری رکھنے کے لیے اگلا پر کلک کریں۔"

#: src/onboarding.py:379 src/onboarding.py:606
msgid "Error while importing OpenCV2"
msgstr "OpenCV2 درآمد کرتے وقت خرابی"

#: src/onboarding.py:379 src/onboarding.py:606
msgid "Try reinstalling cv2"
msgstr "cv2 دوبارہ انسٹال کرنے کی کوشش کریں"

#: src/onboarding.py:386
msgid "No webcams found on system"
msgstr "سسٹم پر کوئی ویب کیمز نہیں ملے"

#: src/onboarding.py:386
msgid ""
"Please configure your camera yourself if you are sure a compatible cam"
"era is connected"
msgstr ""
"اگر آپ کو یقین ہے کہ ایک مطابقت پذیر کیمرہ منسلک ہے تو براہ کرم اپنے ک"
"یمرے کو خود ترتیب دیں۔"

#: src/onboarding.py:478
msgid "No, camera can't be opened"
msgstr "نہیں، کیمرہ نہیں کھولا جا سکتا"

#: src/onboarding.py:490
msgid "No, not an infrared camera"
msgstr "نہیں، اورکت کیمرہ نہیں۔"

#: src/onboarding.py:494
msgid "Yes, compatible infrared camera"
msgstr "جی ہاں، ہم آہنگ اورکت کیمرہ"

#: src/onboarding.py:519
msgid "Camera identifier or path"
msgstr "کیمرہ شناخت کنندہ یا راستہ"

#: src/onboarding.py:519
msgid "Recommended"
msgstr "تجویز کردہ"

#: src/onboarding.py:610 src/onboarding.py:646
msgid "Error selecting camera"
msgstr "کیمرہ منتخب کرنے میں خرابی۔"

#: src/onboarding.py:624
msgid "The selected camera cannot be opened"
msgstr "منتخب کیمرہ نہیں کھولا جا سکتا"

#: src/onboarding.py:624
msgid "Try to select another one"
msgstr "ایک اور کو منتخب کرنے کی کوشش کریں۔"

#: src/onboarding.py:639
msgid ""
"Please visit\n<a href=\"https://github.com/EmixamPP/linux-enable-ir-em"
"itter\">https://github.com/EmixamPP/linux-enable-ir-emitter</a>\nto en"
"able your ir emitter"
msgstr ""
"ملاحظہ فرمائیں\n<a href=\"https://github.com/EmixamPP/linux-enable-ir-"
"emitter\">https://github.com/EmixamPP/linux-enable-ir-emitter</a>\nاپن"
"ے IR emitter کو فعال کرنے کے لیے"

#: src/onboarding.py:704
msgid "Setup lighting 1"
msgstr "سیٹ اپ روشنی 1"

#: src/onboarding.py:705
msgid "Setup lighting 2"
msgstr "سیٹ اپ روشنی 2"

#: src/onboarding.py:723
msgid "Can't save face model"
msgstr "چہرے کا ماڈل محفوظ نہیں کیا جا سکتا"

#: src/onboarding.py:728 src/onboarding.py:775
msgid "Scan second model"
msgstr "دوسرا ماڈل اسکین کریں"

#: src/onboarding.py:734
msgid "Couldn't record the second model"
msgstr "دوسرا ماڈل ریکارڈ نہیں ہو سکا"

#: src/onboarding.py:735
msgid ""
"Your first model is saved, so face login already works. The room must "
"still be bright enough to see your face — change the light rather than"
" turning it off — then try again, or skip and add a model later from S"
"ettings."
msgstr ""
"آپ کا پہلا ماڈل محفوظ ہو گیا ہے، لہذا چہرہ لاگ ان پہلے ہی کام کرتا ہے۔"
" کمرہ اب بھی اتنا روشن ہونا چاہیے کہ آپ کا چہرہ دیکھ سکے — روشنی کو آف"
" کرنے کے بجائے اسے تبدیل کریں — پھر دوبارہ کوشش کریں، یا چھوڑیں اور بع"
"د میں سیٹنگز سے ماڈل شامل کریں۔"

#: src/onboarding.py:769
msgid "Second scan: different lighting"
msgstr "دوسرا اسکین: مختلف لائٹنگ"

#: src/onboarding.py:771
msgid ""
"First model saved. Now change the light — for example turn a lamp on o"
"r off, move away from the window, or use the other room light — keep y"
"our face clearly visible, then press Scan again."
msgstr ""
"پہلا ماڈل محفوظ ہو گیا۔ اب روشنی کو تبدیل کریں — مثال کے طور پر لیمپ ک"
"و آن یا آف کریں، کھڑکی سے دور جائیں، یا دوسرے کمرے کی روشنی کا استعمال"
" کریں — اپنے چہرے کو واضح طور پر دکھائی دیں، پھر دوبارہ سکین کو دبائیں"
"۔"

#: src/onboarding.py:805
msgid "Ubuntu Hello Setup"
msgstr "Ubuntu Hello سیٹ اپ"

#: src/onboarding.py:818
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Checking TPM hardware a"
"nd tools..."
msgstr ""
"Ubuntu Hello چہرے کی توثیق کا استعمال کرتے ہوئے آپ کے {} کو خودکار طور"
" پر غیر مقفل کر سکتا ہے (پتہ چلا والیٹ: {})۔\n\n<b>TPM اسٹیٹس:</b> TPM"
" ہارڈویئر اور ٹولز چیک ہو رہا ہے..."

#: src/onboarding.py:838
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected. "
"Installing <i>tpm2-tools</i> automatically..."
msgstr ""
"Ubuntu Hello چہرے کی توثیق کا استعمال کرتے ہوئے آپ کے {} کو خودکار طور"
" پر غیر مقفل کر سکتا ہے (پتہ چلا والیٹ: {})۔\n\n<b>TPM اسٹیٹس:</b> TPM"
" ہارڈویئر کا پتہ چلا۔ انسٹال ہو رہا ہے <i>tpm2-tools</i> خود بخود..."

#: src/onboarding.py:850
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Hardware TPM 2.0 active"
". Your password will be securely sealed inside the TPM."
msgstr ""
"Ubuntu Hello چہرے کی توثیق کا استعمال کرتے ہوئے آپ کے {} کو خودکار طور"
" پر غیر مقفل کر سکتا ہے (پتہ چلا والیٹ: {})۔\n\n<b>TPM حیثیت:</b> ہارڈ"
" ویئر TPM 2.0 فعال۔ آپ کا پاس ورڈ TPM کے اندر محفوظ طریقے سے سیل کر دی"
"ا جائے گا۔"

#: src/onboarding.py:852
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected, "
"but automatic installation of <i>tpm2-tools</i> failed. Run <code>sudo"
" apt install tpm2-tools</code>. Falling back to software-based credent"
"ial caching."
msgstr ""
"Ubuntu Hello چہرے کی توثیق کا استعمال کرتے ہوئے آپ کے {} کو خودکار طور"
" پر غیر مقفل کر سکتا ہے (پتہ چلا والیٹ: {})۔\n\n<b>TPM حیثیت:</b> TPM "
"ہارڈویئر کا پتہ چلا، لیکن <i>tpm2-tools</i> کی خودکار تنصیب ناکام ہو گ"
"ئی۔ چلائیں <code>sudo apt install tpm2-tools</code>۔ سافٹ ویئر پر مبنی"
" اسناد کیشنگ پر واپس آنا"

#: src/onboarding.py:854
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> No TPM hardware detecte"
"d. Using software-based credential caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello چہرے کی توثیق کا استعمال کرتے ہوئے آپ کے {} کو خودکار طور"
" پر غیر مقفل کر سکتا ہے (پتہ چلا والیٹ: {})۔\n\n<b>TPM اسٹیٹس:</b> کوئ"
"ی TPM ہارڈویئر نہیں ملا۔ سافٹ ویئر پر مبنی اسناد کیشنگ (AES-256-GCM) ک"
"ا استعمال۔"


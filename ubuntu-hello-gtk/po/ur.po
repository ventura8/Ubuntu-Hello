#: src/onboarding.py:169 src/onboarding.ui:246
msgid "Adding your face models"
msgstr "اپنے چہرے کے ماڈلز کو شامل کرنا"

#: src/onboarding.py:172 src/onboarding.ui:262
msgid ""
"Ubuntu Hello will scan your face twice: once now, and once more in different "
"lighting (for example evening lamps instead of daylight), so it recognises "
"you reliably at any time of day. Press Scan to record the first model."
msgstr ""
"Ubuntu Hello آپ کے چہرے کو دو بار اسکین کرے گا: ایک بار اب، اور ایک بار پھر "
"مختلف روشنی میں (مثال کے طور پر دن کی روشنی کے بجائے شام کے لیمپ)، تاکہ یہ "
"دن کے کسی بھی وقت آپ کو قابل اعتماد طریقے سے پہچان سکے۔ پہلے ماڈل کو ریکارڈ "
"کرنے کے لیے اسکین کو دبائیں۔"

#: src/onboarding.py:175 src/onboarding.py:630 src/onboarding.py:712
#: src/tab_models.py:39 src/onboarding.ui:288
msgid "Please look directly into the camera"
msgstr "براہ کرم براہ راست کیمرے میں دیکھیں"

#: src/onboarding.py:178 src/onboarding.py:660 src/onboarding.ui:323
msgid "Start face scan"
msgstr "چہرہ اسکین شروع کریں۔"

#: src/onboarding.py:242
msgid ""
"Datafiles have already been downloaded!\n"
"Click Next to continue"
msgstr ""
"ڈیٹا فائلز پہلے ہی ڈاؤن لوڈ ہو چکی ہیں!\n"
"جاری رکھنے کے لیے اگلا پر کلک کریں۔"

#: src/onboarding.py:279
msgid "Error while downloading datafiles"
msgstr "ڈیٹا فائلز ڈاؤن لوڈ کرتے وقت خرابی۔"

#: src/onboarding.py:282
msgid ""
"Done!\n"
"Click Next to continue"
msgstr ""
"ہو گیا!\n"
"جاری رکھنے کے لیے اگلا پر کلک کریں۔"

#: src/onboarding.py:334 src/onboarding.py:542
msgid "Error while importing OpenCV2"
msgstr "OpenCV2 درآمد کرتے وقت خرابی"

#: src/onboarding.py:334 src/onboarding.py:542
msgid "Try reinstalling cv2"
msgstr "cv2 دوبارہ انسٹال کرنے کی کوشش کریں"

#: src/onboarding.py:341
msgid "No webcams found on system"
msgstr "سسٹم پر کوئی ویب کیمز نہیں ملے"

#: src/onboarding.py:341
msgid ""
"Please configure your camera yourself if you are sure a compatible camera is "
"connected"
msgstr ""
"اگر آپ کو یقین ہے کہ ایک مطابقت پذیر کیمرہ منسلک ہے تو براہ کرم اپنے کیمرے "
"کو خود ترتیب دیں۔"

#: src/onboarding.py:433
msgid "No, camera can't be opened"
msgstr "نہیں، کیمرہ نہیں کھولا جا سکتا"

#: src/onboarding.py:445
msgid "No, not an infrared camera"
msgstr "نہیں، اورکت کیمرہ نہیں۔"

#: src/onboarding.py:449
msgid "Yes, compatible infrared camera"
msgstr "جی ہاں، ہم آہنگ اورکت کیمرہ"

#: src/onboarding.py:466
msgid "Camera identifier or path"
msgstr "کیمرہ شناخت کنندہ یا راستہ"

#: src/onboarding.py:466
msgid "Recommended"
msgstr "تجویز کردہ"

#: src/onboarding.py:546 src/onboarding.py:585
msgid "Error selecting camera"
msgstr "کیمرہ منتخب کرنے میں خرابی۔"

#: src/onboarding.py:560
msgid "The selected camera cannot be opened"
msgstr "منتخب کیمرہ نہیں کھولا جا سکتا"

#: src/onboarding.py:560
msgid "Try to select another one"
msgstr "ایک اور کو منتخب کرنے کی کوشش کریں۔"

#: src/onboarding.py:575
msgid ""
"Please visit\n"
"<a href=\"https://github.com/EmixamPP/linux-enable-ir-emitter\">https://"
"github.com/EmixamPP/linux-enable-ir-emitter</a>\n"
"to enable your ir emitter"
msgstr ""
"ملاحظہ فرمائیں\n"
"<a href=\"https://github.com/EmixamPP/linux-enable-ir-emitter\">https://"
"github.com/EmixamPP/linux-enable-ir-emitter</a>\n"
"اپنے IR emitter کو فعال کرنے کے لیے"

#: src/onboarding.py:643
msgid "Setup lighting 1"
msgstr "سیٹ اپ روشنی 1"

#: src/onboarding.py:644
msgid "Setup lighting 2"
msgstr "سیٹ اپ روشنی 2"

#: src/onboarding.py:662
msgid "Can't save face model"
msgstr "چہرے کا ماڈل محفوظ نہیں کیا جا سکتا"

#: src/onboarding.py:667 src/onboarding.py:714
msgid "Scan second model"
msgstr "دوسرا ماڈل اسکین کریں"

#: src/onboarding.py:673
msgid "Couldn't record the second model"
msgstr "دوسرا ماڈل ریکارڈ نہیں ہو سکا"

#: src/onboarding.py:674
msgid ""
"Your first model is saved, so face login already works. The room must still "
"be bright enough to see your face — change the light rather than turning it "
"off — then try again, or skip and add a model later from Settings."
msgstr ""
"آپ کا پہلا ماڈل محفوظ ہو گیا ہے، لہذا چہرہ لاگ ان پہلے ہی کام کرتا ہے۔ کمرہ "
"اب بھی اتنا روشن ہونا چاہیے کہ آپ کا چہرہ دیکھ سکے — روشنی کو آف کرنے کے "
"بجائے اسے تبدیل کریں — پھر دوبارہ کوشش کریں، یا چھوڑیں اور بعد میں سیٹنگز سے "
"ماڈل شامل کریں۔"

#: src/onboarding.py:708
msgid "Second scan: different lighting"
msgstr "دوسرا اسکین: مختلف لائٹنگ"

#: src/onboarding.py:710
msgid ""
"First model saved. Now change the light — for example turn a lamp on or off, "
"move away from the window, or use the other room light — keep your face "
"clearly visible, then press Scan again."
msgstr ""
"پہلا ماڈل محفوظ ہو گیا۔ اب روشنی کو تبدیل کریں — مثال کے طور پر لیمپ کو آن "
"یا آف کریں، کھڑکی سے دور جائیں، یا دوسرے کمرے کی روشنی کا استعمال کریں — "
"اپنے چہرے کو واضح طور پر دکھائی دیں، پھر دوبارہ سکین کو دبائیں۔"

#: src/onboarding.py:752
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Checking TPM hardware and tools..."
msgstr ""
"Ubuntu Hello چہرے کی توثیق کا استعمال کرتے ہوئے آپ کے {} کو خودکار طور پر "
"غیر مقفل کر سکتا ہے (پتہ چلا والیٹ: {})۔\n"
"\n"
"<b>TPM اسٹیٹس:</b> TPM ہارڈویئر اور ٹولز چیک ہو رہا ہے..."

#: src/onboarding.py:772
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected. Installing <i>tpm2-tools</i> "
"automatically..."
msgstr ""
"Ubuntu Hello چہرے کی توثیق کا استعمال کرتے ہوئے آپ کے {} کو خودکار طور پر "
"غیر مقفل کر سکتا ہے (پتہ چلا والیٹ: {})۔\n"
"\n"
"<b>TPM اسٹیٹس:</b> TPM ہارڈویئر کا پتہ چلا۔ انسٹال ہو رہا ہے <i>tpm2-tools</"
"i> خود بخود..."

#: src/onboarding.py:784
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Hardware TPM 2.0 active. Your password will be securely "
"sealed inside the TPM."
msgstr ""
"Ubuntu Hello چہرے کی توثیق کا استعمال کرتے ہوئے آپ کے {} کو خودکار طور پر "
"غیر مقفل کر سکتا ہے (پتہ چلا والیٹ: {})۔\n"
"\n"
"<b>TPM حیثیت:</b> ہارڈ ویئر TPM 2.0 فعال۔ آپ کا پاس ورڈ TPM کے اندر محفوظ "
"طریقے سے سیل کر دیا جائے گا۔"

#: src/onboarding.py:786
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected, but automatic installation of "
"<i>tpm2-tools</i> failed. Run <code>sudo apt install tpm2-tools</code>. "
"Falling back to software-based credential caching."
msgstr ""
"Ubuntu Hello چہرے کی توثیق کا استعمال کرتے ہوئے آپ کے {} کو خودکار طور پر "
"غیر مقفل کر سکتا ہے (پتہ چلا والیٹ: {})۔\n"
"\n"
"<b>TPM حیثیت:</b> TPM ہارڈویئر کا پتہ چلا، لیکن <i>tpm2-tools</i> کی خودکار "
"تنصیب ناکام ہو گئی۔ چلائیں <code>sudo apt install tpm2-tools</code>۔ سافٹ "
"ویئر پر مبنی اسناد کیشنگ پر واپس آنا"

#: src/onboarding.py:788
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> No TPM hardware detected. Using software-based credential "
"caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello چہرے کی توثیق کا استعمال کرتے ہوئے آپ کے {} کو خودکار طور پر "
"غیر مقفل کر سکتا ہے (پتہ چلا والیٹ: {})۔\n"
"\n"
"<b>TPM اسٹیٹس:</b> کوئی TPM ہارڈویئر نہیں ملا۔ سافٹ ویئر پر مبنی اسناد کیشنگ "
"(AES-256-GCM) کا استعمال۔"


msgstr "Royn at seta cv2 upp av nýggjum"

#: src/onboarding.py:382
msgid "No webcams found on system"
msgstr "Eingi vevmyndatól funnin í skipanini"

#: src/onboarding.py:382
msgid ""
"Please configure your camera yourself if you are sure a compatible camera is "
"connected"
msgstr ""
"Set vinarliga myndatólið upp sjálvur, um tú ert vísur í, at eitt samsvarandi "
"myndatól er tilsluttað"

#: src/onboarding.py:455
msgid "No, camera can't be opened"
msgstr "Nei, myndatólið kann ikki latast upp"

#: src/onboarding.py:467
msgid "No, not an infrared camera"
msgstr "Nei, ikki eitt infrareytt myndatól"

#: src/onboarding.py:471
msgid "Yes, compatible infrared camera"
msgstr "Ja, eitt samsvarandi infrareytt myndatól"

#: src/onboarding.py:488
msgid "Camera identifier or path"
msgstr "Eyðkenni ella leið á myndatólinum"

#: src/onboarding.py:488
msgid "Recommended"
msgstr "Viðmælt"

#: src/onboarding.py:568 src/onboarding.py:607
msgid "Error selecting camera"
msgstr "Villa við vali av myndatóli"

#: src/onboarding.py:582
msgid "The selected camera cannot be opened"
msgstr "Tað valda myndatólið kann ikki latast upp"

#: src/onboarding.py:582
msgid "Try to select another one"
msgstr "Royn at velja eitt annað"

#: src/onboarding.py:597
msgid ""
"Please visit\n"
"<a href=\"https://github.com/EmixamPP/linux-enable-ir-emitter\">https://"
"github.com/EmixamPP/linux-enable-ir-emitter</a>\n"
"to enable your ir emitter"
msgstr ""
"Vitja vinarliga\n"
"<a href=\"https://github.com/EmixamPP/linux-enable-ir-emitter\">https://"
"github.com/EmixamPP/linux-enable-ir-emitter</a>\n"
"fyri at virkja ir-sendaran hjá tær"

#: src/onboarding.py:665
msgid "Setup lighting 1"
msgstr "Uppsetingarlýsing 1"

#: src/onboarding.py:666
msgid "Setup lighting 2"
msgstr "Uppsetingarlýsing 2"

#: src/onboarding.py:707
msgid "Can't save face model"
msgstr "Kann ikki goyma andlitsmodellið"

#: src/onboarding.py:712 src/onboarding.py:759
msgid "Scan second model"
msgstr "Skanna annað modellið"

#: src/onboarding.py:718
msgid "Couldn't record the second model"
msgstr "Kundi ikki taka upp annað modellið"

#: src/onboarding.py:719
msgid ""
"Your first model is saved, so face login already works. The room must still "
"be bright enough to see your face — change the light rather than turning it "
"off — then try again, or skip and add a model later from Settings."
msgstr ""
"Fyrsta modellið hjá tær er goymt, so innritan við andliti riggar longu. Men "
"rúmið má framvegis vera bjart nóg mikið til at síggja andlitið — broyt "
"heldur lýsingina enn at sløkkja hana — og royn so aftur, ella loyp uppum og "
"legg eitt modell afturat seinni í Stillingum."

#: src/onboarding.py:753
msgid "Second scan: glasses, facial hair or different lighting"
msgstr "Onnur skanning: gleraugu, skegg ella onnur lýsing"

#: src/onboarding.py:755
msgid ""
"First model saved: face login already works. A second model makes "
"recognition more reliable when something changes: put on the glasses you "
"sometimes wear (or take them off), or record it with different facial hair, "
"and change the light — turn a lamp on or off, move away from the window. "
"Keep your face clearly visible and press Scan again; the same short guided "
"capture follows."
msgstr ""
"Fyrsta modellið er goymt: innritan við andliti riggar longu. Eitt annað "
"modell ger, at Ubuntu Hello kennir teg aftur við størri vissu, tá ið okkurt "
"broytist: set á teg tey gleraugini, sum tú av og á brúkar (ella tak tey av), "
"ella tak eitt modell upp við øðrum skeggi, og broyt lýsingina — kveik ella "
"sløkk eina lampu, flyt teg burtur frá vindeyganum. Hav andlitið væl sjónligt "
"og trýst á Skanna aftur; so kemur sama stutta, leidda upptøkan."

#: src/onboarding.py:797
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Checking TPM hardware and tools..."
msgstr ""
"Ubuntu Hello kann sjálvvirkandi læsa {} upp við andlitsváttan (funnið veski: "
"{}).\n"
"\n"
"<b>TPM-støða:</b> Kannar TPM-tólbúnað og -amboð..."

#: src/onboarding.py:817
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected. Installing <i>tpm2-tools</i> "
"automatically..."
msgstr ""
"Ubuntu Hello kann sjálvvirkandi læsa {} upp við andlitsváttan (funnið veski: "
"{}).\n"
"\n"
"<b>TPM-støða:</b> TPM-tólbúnaður funnin. Setur <i>tpm2-tools</i> upp "
"sjálvvirkandi..."

#: src/onboarding.py:829
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Hardware TPM 2.0 active. Your password will be securely "
"sealed inside the TPM."
msgstr ""
"Ubuntu Hello kann sjálvvirkandi læsa {} upp við andlitsváttan (funnið veski: "
"{}).\n"
"\n"
"<b>TPM-støða:</b> TPM 2.0 í tólbúnaðinum er virkin. Loyniorðið hjá tær "
"verður trygt innsiglað inni í TPM."

#: src/onboarding.py:831
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected, but automatic installation of "
"<i>tpm2-tools</i> failed. Run <code>sudo apt install tpm2-tools</code>. "
"Falling back to software-based credential caching."
msgstr ""
"Ubuntu Hello kann sjálvvirkandi læsa {} upp við andlitsváttan (funnið veski: "
"{}).\n"
"\n"
"<b>TPM-støða:</b> TPM-tólbúnaður funnin, men sjálvvirkandi uppseting av "
"<i>tpm2-tools</i> miseydnaðist. Koyr <code>sudo apt install tpm2-tools</"
"code>. Fellur aftur til software-baseraða mellumgoymslu av "
"innritanarupplýsingum."

#: src/onboarding.py:833
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> No TPM hardware detected. Using software-based credential "
"caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello kann sjálvvirkandi læsa {} upp við andlitsváttan (funnið veski: "
"{}).\n"
"\n"
"<b>TPM-støða:</b> Eingin TPM-tólbúnaður funnin. Brúkar software-baseraða "
"mellumgoymslu av innritanarupplýsingum (AES-256-GCM)."


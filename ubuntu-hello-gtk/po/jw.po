#: src/onboarding.py:446
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Checking TPM hardware and tools..."
msgstr ""
"Ubuntu Hello bisa mbukak kunci {} kanthi otomatis nggunakake otentikasi "
"pasuryan (dompet sing dideteksi: {}).\n"
"\n"
"<b>Status TPM:</b> Priksa hardware lan alat TPM..."

#: src/onboarding.py:466
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected. Installing <i>tpm2-tools</i> "
"automatically..."
msgstr ""
"Ubuntu Hello bisa mbukak kunci {} kanthi otomatis nggunakake otentikasi "
"pasuryan (dompet sing dideteksi: {}).\n"
"\n"
"<b>Status TPM:</b> TPM hardware dideteksi. Nginstal <i>tpm2-tools</i> kanthi "
"otomatis..."

#: src/onboarding.py:478
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Hardware TPM 2.0 active. Your password will be securely "
"sealed inside the TPM."
msgstr ""
"Ubuntu Hello bisa mbukak kunci {} kanthi otomatis nggunakake otentikasi "
"pasuryan (dompet sing dideteksi: {}).\n"
"\n"
"<b>Status TPM:</b> Hardware TPM 2.0 aktif. Tembung sandhi sampeyan bakal "
"disegel kanthi aman ing TPM."

#: src/onboarding.py:480
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected, but automatic installation of "
"<i>tpm2-tools</i> failed. Run <code>sudo apt install tpm2-tools</code>. "
"Falling back to software-based credential caching."
msgstr ""
"Ubuntu Hello bisa mbukak kunci {} kanthi otomatis nggunakake otentikasi "
"pasuryan (dompet sing dideteksi: {}).\n"
"\n"
"<b>Status TPM:</b> Perangkat keras TPM dideteksi, nanging instalasi otomatis "
"<i>tpm2-tools</i> gagal. Jalanake <code>sudo apt install tpm2-tools</code>. "
"Mudhun bali menyang caching kredensial basis piranti lunak."

#: src/onboarding.py:482
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> No TPM hardware detected. Using software-based credential "
"caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello bisa mbukak kunci {} kanthi otomatis nggunakake otentikasi "
"pasuryan (dompet sing dideteksi: {}).\n"
"\n"
"<b>Status TPM:</b> Ora ana hardware TPM sing dideteksi. Nggunakake caching "
"kredensial basis piranti lunak (AES-256-GCM)."


msgid ""
"Please visit\n<a href=\"https://github.com/EmixamPP/linux-enable-ir-em"
"itter\">https://github.com/EmixamPP/linux-enable-ir-emitter</a>\nto en"
"able your ir emitter"
msgstr ""
"Por favor visite\n<a href=\"https://github.com/EmixamPP/linux-enable-i"
"r-emitter\">https://github.com/EmixamPP/linux-enable-ir-emitter</a>\np"
"ara activar o seu emisor ir"


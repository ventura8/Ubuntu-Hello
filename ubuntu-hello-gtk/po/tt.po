msgid ""
"Datafiles have already been downloaded!\n"
"Click Next to continue"
msgstr ""
"Мәгълүмат файллары йөкләнде инде!\n"
"Алга таба басыгыз"

#: src/onboarding.py:316
msgid "Error while downloading datafiles"
msgstr "Мәгълүмат файлларын йөкләгәндә хата"

#: src/onboarding.py:319
msgid ""
"Done!\n"
"Click Next to continue"
msgstr ""
"Булды!\n"
"Алга таба басыгыз"


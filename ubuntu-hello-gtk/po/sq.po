msgstr "Gabim gjatë importimit të OpenCV2"

#: src/onboarding.py:379 src/onboarding.py:606
msgid "Try reinstalling cv2"
msgstr "Provoni të riinstaloni cv2"

#: src/onboarding.py:386
msgid "No webcams found on system"
msgstr "Nuk u gjet asnjë webcam në sistem"

#: src/onboarding.py:386
msgid ""
"Please configure your camera yourself if you are sure a compatible cam"
"era is connected"
msgstr ""
"Ju lutemi konfiguroni vetë kamerën tuaj nëse jeni i sigurt se është li"
"dhur një kamerë e përputhshme"

#: src/onboarding.py:478
msgid "No, camera can't be opened"
msgstr "Jo, kamera nuk mund të hapet"

#: src/onboarding.py:490
msgid "No, not an infrared camera"
msgstr "Jo, jo një aparat fotografik infra të kuqe"

#: src/onboarding.py:494
msgid "Yes, compatible infrared camera"
msgstr "Po, kamera e përputhshme me rreze infra të kuqe"

#: src/onboarding.py:519
msgid "Camera identifier or path"
msgstr "Identifikuesi ose shtegu i kamerës"

#: src/onboarding.py:519
msgid "Recommended"
msgstr "Rekomanduar"

#: src/onboarding.py:610 src/onboarding.py:646

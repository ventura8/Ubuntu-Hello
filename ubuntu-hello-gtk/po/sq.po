#: src/onboarding.py:446
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Checking TPM hardware a"
"nd tools..."
msgstr ""
"Ubuntu Hello mund të zhbllokojë automatikisht {} tuaj duke përdorur vë"
"rtetimin e fytyrës (portofoli i zbuluar: {}).\n\n<b>Statusi TPM:</b> P"
"o kontrollon pajisjen dhe mjetet e TPM..."

#: src/onboarding.py:466
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected. "
"Installing <i>tpm2-tools</i> automatically..."
msgstr ""
"Ubuntu Hello mund të zhbllokojë automatikisht {} tuaj duke përdorur vë"
"rtetimin e fytyrës (portofoli i zbuluar: {}).\n\n<b>Statusi TPM:</b> U"
" zbulua hardueri TPM. Po instalohet automatikisht <i>tpm2-tools</i>..."

#: src/onboarding.py:478
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Hardware TPM 2.0 active"
". Your password will be securely sealed inside the TPM."
msgstr ""
"Ubuntu Hello mund të zhbllokojë automatikisht {} tuaj duke përdorur vë"
"rtetimin e fytyrës (portofoli i zbuluar: {}).\n\n<b>Statusi TPM:</b> H"
"ardware TPM 2.0 aktiv. Fjalëkalimi juaj do të vuloset në mënyrë të sig"
"urt brenda TPM."

#: src/onboarding.py:480
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected, "
"but automatic installation of <i>tpm2-tools</i> failed. Run <code>sudo"
" apt install tpm2-tools</code>. Falling back to software-based credent"
"ial caching."
msgstr ""
"Ubuntu Hello mund të zhbllokojë automatikisht {} tuaj duke përdorur vë"
"rtetimin e fytyrës (portofoli i zbuluar: {}).\n\n<b>Statusi TPM:</b> U"
" zbulua hardueri TPM, por instalimi automatik i <i>tpm2-tools</i> dësh"
"toi. Ekzekutoni <code>sudo apt install tpm2-tools</code>. Rikthimi te "
"ruajtja e kredencialeve të bazuara në softuer."

#: src/onboarding.py:482
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> No TPM hardware detecte"
"d. Using software-based credential caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello mund të zhbllokojë automatikisht {} tuaj duke përdorur vë"
"rtetimin e fytyrës (portofoli i zbuluar: {}).\n\n<b>Statusi TPM:</b> N"
"uk u zbulua asnjë pajisje TPM. Përdorimi i ruajtjes së kredencialeve t"
"ë bazuara në softuer (AES-256-GCM)."


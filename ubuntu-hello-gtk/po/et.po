#: src/onboarding.py:446
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Checking TPM hardware and tools..."
msgstr ""
"Ubuntu Hello saab teie {} automaatselt avada, kasutades näo autentimist "
"(tuvastatud rahakott: {}).\n"
"\n"
"<b>TPM-i olek:</b> TPM-i riistvara ja tööriistade kontrollimine..."

#: src/onboarding.py:466
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected. Installing <i>tpm2-tools</i> "
"automatically..."
msgstr ""
"Ubuntu Hello saab teie {} automaatselt avada, kasutades näo autentimist "
"(tuvastatud rahakott: {}).\n"
"\n"
"<b>TPM-i olek:</b> tuvastati TPM-i riistvara. <i>tpm2-tools</i> automaatne "
"installimine..."

#: src/onboarding.py:478
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> Hardware TPM 2.0 active. Your password will be securely "
"sealed inside the TPM."
msgstr ""
"Ubuntu Hello saab teie {} automaatselt avada, kasutades näo autentimist "
"(tuvastatud rahakott: {}).\n"
"\n"
"<b>TPM-i olek:</b> riistvara TPM 2.0 aktiivne. Teie parool on TPM-is "
"turvaliselt suletud."

#: src/onboarding.py:480
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> TPM hardware detected, but automatic installation of "
"<i>tpm2-tools</i> failed. Run <code>sudo apt install tpm2-tools</code>. "
"Falling back to software-based credential caching."
msgstr ""
"Ubuntu Hello saab teie {} automaatselt avada, kasutades näo autentimist "
"(tuvastatud rahakott: {}).\n"
"\n"
"<b>TPM-i olek:</b> TPM-i riistvara tuvastati, kuid <i>tpm2-tools</i> "
"automaatne installimine ebaõnnestus. Käivitage <code>sudo apt install tpm2-"
"tools</code>. Naasmine tarkvarapõhise mandaadi vahemällu."

#: src/onboarding.py:482
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authentication "
"(detected wallet: {}).\n"
"\n"
"<b>TPM Status:</b> No TPM hardware detected. Using software-based credential "
"caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello saab teie {} automaatselt avada, kasutades näo autentimist "
"(tuvastatud rahakott: {}).\n"
"\n"
"<b>TPM-i olek:</b> TPM-i riistvara ei tuvastatud. Tarkvarapõhise mandaadi "
"vahemällu (AES-256-GCM) kasutamine."


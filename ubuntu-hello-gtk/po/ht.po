#: src/onboarding.py:446
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Checking TPM hardware a"
"nd tools..."
msgstr ""
"Ubuntu Hello ka debloke {} ou otomatikman lè l sèvi avèk otantifikasyo"
"n figi (bous detekte: {}).\n\n<b>Estati TPM:</b> Tcheke pyès ki nan ko"
"npitè ak zouti TPM..."

#: src/onboarding.py:466
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected. "
"Installing <i>tpm2-tools</i> automatically..."
msgstr ""
"Ubuntu Hello ka debloke {} ou otomatikman lè l sèvi avèk otantifikasyo"
"n figi (bous detekte: {}).\n\n<b>Estati TPM:</b> Materyèl TPM detekte."
" Enstale <i>tpm2-tools</i> otomatikman..."

#: src/onboarding.py:478
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> Hardware TPM 2.0 active"
". Your password will be securely sealed inside the TPM."
msgstr ""
"Ubuntu Hello ka debloke {} ou otomatikman lè l sèvi avèk otantifikasyo"
"n figi (bous detekte: {}).\n\n<b>Estati TPM:</b> Materyèl TPM 2.0 akti"
"f. Modpas ou a pral byen sele andedan TPM la."

#: src/onboarding.py:480
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> TPM hardware detected, "
"but automatic installation of <i>tpm2-tools</i> failed. Run <code>sudo"
" apt install tpm2-tools</code>. Falling back to software-based credent"
"ial caching."
msgstr ""
"Ubuntu Hello ka debloke {} ou otomatikman lè l sèvi avèk otantifikasyo"
"n figi (bous detekte: {}).\n\n<b>Estati TPM:</b> TPM pyès ki nan konpi"
"tè detekte, men enstalasyon otomatik <i>tpm2-tools</i> echwe. Kouri <c"
"ode>sudo apt install tpm2-tools</code>. Tonbe tounen nan lojisyèl ki b"
"aze sou kachèt kalifikasyon."

#: src/onboarding.py:482
msgid ""
"Ubuntu Hello can automatically unlock your {} using face authenticatio"
"n (detected wallet: {}).\n\n<b>TPM Status:</b> No TPM hardware detecte"
"d. Using software-based credential caching (AES-256-GCM)."
msgstr ""
"Ubuntu Hello ka debloke {} ou otomatikman lè l sèvi avèk otantifikasyo"
"n figi (bous detekte: {}).\n\n<b>Estati TPM:</b> Pa gen pyès ki nan ko"
"npitè TPM detekte. Sèvi ak kachèt kalifikasyon ki baze sou lojisyèl (A"
"ES-256-GCM)."


# syntax=docker/dockerfile:1.27.0
# Arch Linux packaging image (pinned base-devel weekly tag)
FROM archlinux:base-devel-20260906.0.587075

RUN pacman -Syu --noconfirm \
    && pacman -S --noconfirm \
    meson ninja cmake boost openssl pam libinih libevdev \
    gettext python python-pip python-numpy python-opencv python-cryptography python-pillow \
    curl bzip2 v4l-utils tpm2-tools polkit pkgconf git \
    && pacman -Scc --noconfirm

WORKDIR /src
COPY . /src

RUN if id -u builduser >/dev/null 2>&1; then \
      userdel -r builduser 2>/dev/null || true; \
    fi; \
    useradd -m -u 1000 builduser

CMD ["./scripts/release-arch.sh"]

# syntax=docker/dockerfile:1.26.0
# PPA / debian packaging image — Ubuntu 26.04 (resolute)
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
# Apt packages are distro-locked by ubuntu:26.04 (no floating apt versions).

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential debhelper meson ninja-build \
    python3 python3-dev python3-cryptography \
    pkg-config libpam0g-dev libinih-dev libevdev-dev \
    libssl-dev libboost-all-dev cmake g++ \
    devscripts dput gpg dpkg-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src

CMD ["./scripts/ppa-docker.sh"]

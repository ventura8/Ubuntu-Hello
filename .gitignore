# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
# Local Meson / packaging / CI staging (e.g. build-appimage/, build-ci-*, build-flatpak*)
build-*/
builddir/
builddir-*/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
packaging/snap/ubuntu-hello-src.tar.gz
# uh_create_source_tarball mktemp leftovers next to the snap source tarball
packaging/snap/.ubuntu-hello-src.tar.gz.*
packaging/snap/.uh-src-*/
packaging/snap/.craft/
packaging/snap/stage/
packaging/snap/prime/
packaging/snap/overlay/
packaging/snap/*.snap
packaging/arch/ubuntu-hello/src/
packaging/arch/ubuntu-hello/pkg/
packaging/arch/ubuntu-hello/*.tar.gz
packaging/arch/ubuntu-hello/*.pkg.tar.zst
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec
!packaging/rpm/**/*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Translations
*.mo
# Keep *.pot committed (templates); only ignore compiled catalogs

# Django stuff:
*.log
local_settings.py

# Agent workstream progress (keep logs/README.md; ignore log files)
/logs/*.log

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# dotenv
.env


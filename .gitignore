.mypy_cache/

# generated models
/ubuntu-hello/src/models

# snapshots
/ubuntu-hello/src/snapshots

# Local .deb output from scripts/ppa-docker.sh / CI packaging jobs
/artifacts/

# Debian packaging build trees (keep control, rules, *.install, maintainer scripts)
debian/.debhelper/
debian/tmp/
debian/files
debian/debhelper-build-stamp
debian/*.substvars
debian/*.debhelper.log
debian/ubuntu-hello/
debian/ubuntu-hello-gtk/


#!/usr/bin/env bash
# Runs on snap install and every refresh. A store install must not touch PAM on its
# own: the host is only changed after the user runs `sudo linux-ubuntu-hello.host-install`.
# From then on this is what delivers refreshes to the host copy that PAM actually loads.
set -euo pipefail

# shellcheck source=/dev/null
. "$(dirname "${BASH_SOURCE[0]}")/../host-state.sh"

uh_snap_lock

[[ -f "$(uh_snap_marker)" ]] || exit 0
if uh_native_package_owns_host; then
	exit 0
fi

# Hooks have a timeout and no session, so no package installs, no dlib source
# build and no setup wizard.
export UH_SKIP_HOST_DEPS=1
export UH_DLIB_PIP_SKIP=1
export UH_SKIP_ONBOARD=1
"${SNAP}/usr/share/ubuntu-hello/install-host.sh" --install

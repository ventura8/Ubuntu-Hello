msgstr "Күні:"

#: src/compare.py:114
msgid "Scan time: "
msgstr "Сканерлеу уақыты:"

#: src/compare.py:115
msgid "Frames: "
msgstr "Жақтаулар:"

#: src/compare.py:116
msgid "Hostname: "
msgstr "Хост аты:"

#: src/compare.py:117
msgid "Best certainty value: "
msgstr "Ең жақсы сенімділік мәні:"

#: src/compare.py:214

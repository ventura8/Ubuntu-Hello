#: src/cli/add.py:23
msgid ""
"\n"
"Can't import the dlib module, check the output of"
msgstr ""
"\n"
"dlib модулін импорттау мүмкін емес, шығысын тексеріңіз"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "Бет үлгісі қалтасы табылмады, біреуі жасалды"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine slightly"
msgstr ""
"ЕСКЕРТПЕ: Әрбір қосымша модель бетті тану қозғалтқышын аздап баяулатады"

#: src/cli/add.py:70
msgid "Press Ctrl+C to cancel\n"
msgstr "Бас тарту үшін Ctrl+C пернелер тіркесімін басыңыз\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "Пайдаланушы үшін бет үлгісін қосу"

#: src/cli/add.py:88
msgid "Model #"
msgstr "Үлгі №"

#: src/cli/add.py:92
#, python-format
msgid "Using default label \"%s\" because of -y flag"
msgstr "-y жалауына байланысты әдепкі \"%s\" белгісін пайдалану"

#: src/cli/add.py:95
msgid "Enter a label for this new model [{}]: "
msgstr "Осы жаңа модель үшін белгіні енгізіңіз [{}]:"

#: src/cli/add.py:103
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "ЕСКЕРТУ: Үлгі атынан заңсыз «,» таңбасын жою"

#: src/cli/add.py:117
msgid ""
"\n"
"Please look straight into the camera"
msgstr ""
"\n"
"Тіке камераға қараңыз"

#: src/cli/add.py:182
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "Камера тек қара жақтауларды көрді - ИК эмитент жұмыс істей ме?"

#: src/cli/add.py:187
msgid "No face detected, aborting"
msgstr "Бет анықталмады, тоқтатылуда"

#: src/cli/add.py:192
msgid "Multiple faces detected, aborting"
msgstr "Бірнеше бет анықталды, тоқтатылуда"

#: src/cli/add.py:214
msgid ""
"\n"
"Scan complete\n"
"Added a new model to "
msgstr ""
"\n"
"Сканерлеу аяқталды\n"
"Жаңа үлгі қосылды"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr ""
"Әзірге ешқандай үлгілер жасалмаған, егер олар жоқ болса, оларды тазалау "
"мүмкін емес"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} үлгілері жоқ немесе олар әлдеқашан тазартылған"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "Бұл барлық үлгілерді тазартады"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "Жалғастыруды қалайсыз ба [y/N]:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\n"
"Interpreting as a \"NO\", aborting"
msgstr ""
"\n"
"«ЖОҚ» деп түсіндіру, тоқтату"

#: src/cli/clear.py:37
msgid ""
"\n"
"Models cleared"
msgstr ""
"\n"
"Модельдер тазартылды"

#: src/cli/config.py:32
#, python-brace-format
msgid "Opening config.ini in {editor}"
msgstr "config.ini {editor} ішінде ашылуда"

#: src/cli/config.py:38
#, python-brace-format
msgid "Failed to open editor: {error}"
msgstr "Редакторды ашу мүмкін болмады: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "Қате: сәйкес мәтін өңдегіші табылмады."

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr ""
"\"nano\" немесе \"vi\" орнатыңыз немесе EDITOR ортасының айнымалы мәнін "
"орнатыңыз."

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello config' "
"to preserve your EDITOR variable."
msgstr ""
"Егер сіз осы пәрменді sudo көмегімен іске қосып жатсаңыз, EDITOR айнымалы "
"мәнін сақтау үшін «sudo -E ubuntu-hello конфигурациясын» қолданып көріңіз."

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "Аргумент ретінде 0 (қосу) немесе 1 (өшіру) қосыңыз"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr "Аргумент ретінде тек 0 (қосу) немесе 1 (өшіру) пайдаланыңыз"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "Өшіру опциясы әлдеқашан орнатылған"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Hello өшірілді"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Hello қосылды"

#: src/cli/keyring.py:31
msgid "Usage: keyring [enable|disable]"
msgstr "Қолданылуы: кілттер [қосу|өшіру]"

#: src/cli/keyring.py:48
msgid "Enter password for user {} to unlock {} ({}): "
msgstr "{} ({}) құлпын ашу үшін {} пайдаланушысының құпия сөзін енгізіңіз:"

#: src/cli/keyring.py:50
msgid "Password cannot be empty"
msgstr "Құпия сөз бос болмауы керек"

#: src/cli/keyring.py:53
msgid "Confirm password: "
msgstr "Құпия сөзді Растау:"

#: src/cli/keyring.py:55
msgid "Passwords do not match"
msgstr "Құпия сөздер сәйкес келмейді"

#: src/cli/keyring.py:64
msgid "TPM hardware detected. Auto-installing tpm2-tools..."
msgstr ""
"TPM аппараттық құралы анықталды. tpm2-tools автоматты түрде орнатылуда..."

#: src/cli/keyring.py:73
msgid "TPM hardware active. Sealing password in TPM..."
msgstr "TPM аппараттық құралы белсенді. TPM жүйесінде құпия сөзді мөрлеу..."

#: src/cli/keyring.py:99
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} using TPM "
"(wallet: {})."
msgstr ""
"Кілт/KWallet құлпын ашу TPM (әмиян: {}) арқылы {} пайдаланушысы үшін сәтті "
"қосылды."

#: src/cli/keyring.py:101
msgid "Failed to seal password to TPM: {}"
msgstr "TPM құпия сөзін жабу мүмкін болмады: {}"

#: src/cli/keyring.py:105
msgid "No TPM active. Using software-based credential caching..."
msgstr ""
"Белсенді TPM жоқ. Бағдарламаға негізделген тіркелгі деректерін кэштеуді "
"пайдалану..."

#: src/cli/keyring.py:121
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} (Software "
"Caching, wallet: {})."
msgstr ""
"Keyring/KWallet құлпын ашу {} пайдаланушысы үшін сәтті қосылды "
"(Бағдарламалық құралды кэштеу, әмиян: {})."

#: src/cli/keyring.py:123
msgid "Failed to enable keyring unlocking: {}"
msgstr "Кілттердің құлпын ашуды қосу мүмкін болмады: {}"

#: src/cli/keyring.py:134
msgid "Failed to disable keyring unlocking: {}"
msgstr "Кілттердің құлпын ашу өшірілмеді: {}"

#: src/cli/keyring.py:137
msgid "Keyring/KWallet unlocking disabled for user {}."
msgstr "Кілт/KWallet құлпын ашу {} пайдаланушысы үшін өшірілген."

#: src/cli/keyring.py:139
msgid "Keyring/KWallet unlocking was not enabled for user {}."
msgstr "Кілт/KWallet құлпын ашу {} пайдаланушысы үшін қосылмаған."

#: src/cli/keyring.py:142
msgid "Invalid action. Use 'enable' or 'disable'."
msgstr "Жарамсыз әрекет. «Қосу» немесе «өшіру» опциясын пайдаланыңыз."

#: src/cli/list.py:17 src/cli/remove.py:25
msgid "Face models have not been initialized yet, please run:"
msgstr "Бет үлгілері әлі инициализацияланған жоқ, іске қосыңыз:"

#: src/cli/list.py:29 src/cli/remove.py:36
msgid "No face model known for the user {}, please run:"
msgstr "{} пайдаланушыға белгілі бет үлгісі жоқ, келесіні іске қосыңыз:"

#: src/cli/list.py:35
msgid "Known face models for {}:"
msgstr "{} үшін белгілі бет үлгілері:"

#: src/cli/list.py:36
msgid "ID  Date                 Label[0m"
msgstr "Идентификатор күні белгісі [0м"

#: src/cli/remove.py:16
msgid "Please add the ID of the model you want to remove as an argument"
msgstr "Аргумент ретінде жойғыңыз келетін үлгінің идентификаторын қосыңыз"

#: src/cli/remove.py:17 src/cli/set.py:18
msgid "For example:"
msgstr "Мысалы:"

#: src/cli/remove.py:19
msgid "You can find the IDs by running:"
msgstr "Идентификаторларды іске қосу арқылы табуға болады:"

#: src/cli/remove.py:52
#, python-brace-format
msgid "This will remove the model called \"{label}\" for {user}"
msgstr "Бұл {user} үшін \"{label}\" деп аталатын үлгіні жояды."

#: src/cli/remove.py:69
#, python-brace-format
msgid "No model with ID {id} exists for {user}"
msgstr "{user} үшін {id} идентификаторы бар үлгі жоқ"

#: src/cli/remove.py:75
msgid "Removed last model, ubuntu-hello disabled for user"
msgstr "Соңғы үлгі жойылды, пайдаланушы үшін ubuntu-hello өшірілді"

#: src/cli/remove.py:89
msgid "Removed model {}"
msgstr "Жойылған үлгі {}"

#: src/cli/set.py:17
msgid ""
"Please add a setting you would like to change and the value to set it to"
msgstr "Өзгерткіңіз келетін параметрді және оған орнатылатын мәнді қосыңыз"

#: src/cli/set.py:37
msgid "Could not find a \"{}\" config option to set"
msgstr "Орнату үшін \"{}\" конфигурация опциясы табылмады"

#: src/cli/set.py:44
msgid "Config option updated"
msgstr "Конфигурация опциясы жаңартылды"

#: src/cli/snap.py:43
msgid "GENERATED SNAPSHOT"
msgstr "ЖАСАЛҒАН СУРЕТ"

#: src/cli/snap.py:45
msgid "Dark threshold config: "
msgstr "Қараңғы шек конфигурациясы:"

#: src/cli/snap.py:46
msgid "Certainty config: "
msgstr "Сенімділік конфигурациясы:"

#: src/cli/snap.py:50
msgid "Generated snapshot saved as"
msgstr "Жасалған сурет ретінде сақталды"

#: src/cli/test.py:23
msgid ""
"Ubuntu Hello has been configured to use a recorder which doesn't support the "
"test command yet, aborting"
msgstr ""
"Ubuntu Hello сынақ пәрменіне әлі қолдау көрсетпейтін жазу құрылғысын "
"пайдалану үшін конфигурацияланған, тоқтатылады"

#: src/cli/test.py:34
msgid ""
"\n"
"Opening a window with a test feed\n"
"\n"
"Press ctrl+C in this terminal to quit\n"
"Click on the image to enable or disable slow mode\n"
msgstr ""
"\n"
"Сынақ арнасы бар терезені ашу\n"

msgstr "Іске қосылуда..."

#: src/compare.py:262
msgid "Identifying you..."
msgstr "Сізді анықтауда..."

#: src/compare.py:285
msgid "FAILED"
msgstr "СӘТСІЗ"

#: src/compare.py:288 src/cli/add.py:184
msgid "All frames were too dark, please check dark_threshold in config"
msgstr ""
"Барлық кадрлар тым қараңғы болды, конфигурацияда dark_threshold параметрін "
"тексеріңіз"

#: src/compare.py:289 src/cli/add.py:185
#, python-brace-format
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "Орташа қараңғылық: {avg}, шегі: {threshold}"

#: src/compare.py:386
msgid "Time spent"
msgstr "Өткізілген уақыт"

#: src/compare.py:387
msgid "Starting up"
msgstr "Іске қосу"

#: src/compare.py:388
#, python-format
msgid "  Open cam + load libs: %dms"
msgstr "Камераны ашыңыз + жүктеу дискілері: %dms"

#: src/compare.py:389
msgid "  Opening the camera"
msgstr "Камераны ашу"

#: src/compare.py:390
msgid "  Importing recognition libs"
msgstr "Тану кітапханаларын импорттау"

#: src/compare.py:391
msgid "Searching for known face"
msgstr "Белгілі бет ізделуде"

#: src/compare.py:392
msgid "Total time"
msgstr "Жалпы уақыт"

#: src/compare.py:394
msgid ""
"\n"
"Resolution"
msgstr ""
"\n"
"Ажыратымдылық"

#: src/compare.py:396
#, python-format
msgid "  Native: %dx%d"
msgstr "Жергілікті: %dx%d"

#: src/compare.py:399
#, python-format
msgid "  Used: %dx%d"
msgstr "Қолданылған: %dx%d"

#: src/compare.py:402
#, python-format
msgid ""
"\n"
"Frames searched: %d (%.2f fps)"
msgstr ""
"\n"
"Ізденген кадрлар: %d (%.2f кадр/сек)"

#: src/compare.py:403
#, python-format
msgid "Black frames ignored: %d "
msgstr "Қара жақтаулар еленбеді: %d"

#: src/compare.py:404
#, python-format
msgid "Dark frames ignored: %d "
msgstr "Қараңғы жақтаулар еленбеді: %d"

#: src/compare.py:405
#, python-format
msgid "Certainty of winning frame: %.3f"
msgstr "Жеңімпаз кадрдың сенімділігі: %.3f"

#: src/compare.py:407
#, python-format
msgid "Winning model: %d (\"%s\")"
msgstr "Жеңімпаз модель: %d («%s»)"

#: src/compare.py:411
msgid "SUCCESSFUL"
msgstr "СӘТТІ"

#: src/wallet_backend.py:62 src/wallet_backend.py:72
msgid "KWallet"
msgstr "KWallet"

#: src/wallet_backend.py:64
msgid "GNOME Keyring"
msgstr "GNOME Keyring"

#: src/wallet_backend.py:65
msgid "None"
msgstr "None"

#: src/wallet_backend.py:74

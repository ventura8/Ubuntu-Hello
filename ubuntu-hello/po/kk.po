#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "Сәтсіздік, күту уақыты аяқталды"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "Бетті анықтау кескіні тым күңгірт"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "Белгісіз қате:"

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "Анықталған бет %s"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr ""
"Enter пернесін жіберуге рұқсаттар жеткіліксіз, оның орнына пайдаланушы"
" оны басқанша күтуде"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr ""
"Enter пернесін жіберу мүмкін болмады, оның орнына пайдаланушы оны басу"
"ын күтуде"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "Бет аутентификациясына әрекеттену"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "Пайдаланушы анықталмады, --user жалаушасын пайдаланыңыз"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello бет аутентификациясына арналған пәрмен жолы интерфейсі."

#: src/cli.py:35
msgid "command"
msgstr "пәрмен"

#: src/cli.py:35
msgid "arguments"
msgstr "аргументтер"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"Қолдау үшін кіріңіз\nhttps://github.com/ventura8/ubuntu-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"Орындалатын пәрмен опциясы келесілердің бірі болуы мүмкін: қосу, тазал"
"ау, конфигурациялау, өшіру, кілттеу, тізімдеу, жою, суретке түсіру, ор"
"нату, сынақ немесе нұсқа."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "Қосу, өшіру, жою және орнату пәрмендері үшін қосымша аргументтер."

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "Пайдалану үшін пайдаланушы тіркелгісін орнатыңыз."

#: src/cli.py:60
msgid "Skip all questions."
msgstr "Барлық сұрақтарды өткізіп жіберіңіз."

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "Машинаға қолайлы шығарылымды басып шығару."

#: src/cli.py:72
msgid "With keyring restore: restore sealed login passwords for all users."
msgstr "With keyring restore: restore sealed login passwords for all users."

#: src/cli.py:80
msgid "Show this help message and exit."
msgstr "Осы анықтама хабарын көрсетіп, шығыңыз."

#: src/cli.py:84
msgid "current active user: "
msgstr "ағымдағы белсенді пайдаланушы:"

#: src/cli.py:94
msgid "Invalid username format"
msgstr "Пайдаланушы аты пішімі жарамсыз"

#: src/cli.py:104
msgid ""
"Please run this command as root:\n"
msgstr ""
"Бұл пәрменді түбір ретінде іске қосыңыз:\n"

#: src/cli.py:110
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr ""
"Ubuntu-hello пәрмендерін түбір ретінде іске қосу мүмкін емес, осы пәрм"
"енді --user жалаушасымен іске қосыңыз"

#: src/compare.py:128 src/cli/add.py:32
msgid "Data files have not been downloaded, please run the following commands:"
msgstr "Деректер файлдары жүктелмеді, келесі пәрмендерді орындаңыз:"

#: src/compare.py:154
msgid " LOGIN"
msgstr "КІРУ"

#: src/compare.py:155 src/cli/snap.py:44
msgid "Date: "
msgstr "Күні:"

#: src/compare.py:156
msgid "Scan time: "
msgstr "Сканерлеу уақыты:"

#: src/compare.py:157
msgid "Frames: "
msgstr "Жақтаулар:"

#: src/compare.py:158
msgid "Hostname: "
msgstr "Хост аты:"

#: src/compare.py:159
msgid "Best certainty value: "
msgstr "Ең жақсы сенімділік мәні:"

#: src/compare.py:266
msgid "Starting up..."
msgstr "Іске қосылуда..."

#: src/compare.py:319
msgid "Identifying you..."
msgstr "Сізді анықтауда..."

#: src/compare.py:351
msgid "FAILED"
msgstr "СӘТСІЗ"

#: src/compare.py:354 src/cli/add.py:188
msgid "All frames were too dark, please check dark_threshold in config"
msgstr ""
"Барлық кадрлар тым қараңғы болды, конфигурацияда dark_threshold параме"
"трін тексеріңіз"

#: src/compare.py:355 src/cli/add.py:189
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "Орташа қараңғылық: {avg}, шегі: {threshold}"

#: src/compare.py:456
msgid "Time spent"
msgstr "Өткізілген уақыт"

#: src/compare.py:457
msgid "Starting up"
msgstr "Іске қосу"

#: src/compare.py:458
msgid "  Open cam + load libs: %dms"
msgstr "Камераны ашыңыз + жүктеу дискілері: %dms"

#: src/compare.py:459
msgid "  Opening the camera"
msgstr "Камераны ашу"

#: src/compare.py:460
msgid "  Importing recognition libs"
msgstr "Тану кітапханаларын импорттау"

#: src/compare.py:461
msgid "Searching for known face"
msgstr "Белгілі бет ізделуде"

#: src/compare.py:462
msgid "Total time"
msgstr "Жалпы уақыт"

#: src/compare.py:464
msgid ""
"\nResolution"
msgstr ""
"\nАжыратымдылық"

#: src/compare.py:466
msgid "  Native: %dx%d"
msgstr "Жергілікті: %dx%d"

#: src/compare.py:469
msgid "  Used: %dx%d"
msgstr "Қолданылған: %dx%d"

#: src/compare.py:472
msgid ""
"\nFrames searched: %d (%.2f fps)"
msgstr ""
"\nІзденген кадрлар: %d (%.2f кадр/сек)"

#: src/compare.py:473
msgid "Black frames ignored: %d "
msgstr "Қара жақтаулар еленбеді: %d"

#: src/compare.py:474
msgid "Dark frames ignored: %d "
msgstr "Қараңғы жақтаулар еленбеді: %d"

#: src/compare.py:475
msgid "Certainty of winning frame: %.3f"
msgstr "Жеңімпаз кадрдың сенімділігі: %.3f"

#: src/compare.py:477
msgid "Winning model: %d (\"%s\")"
msgstr "Жеңімпаз модель: %d («%s»)"

#: src/compare.py:481
msgid "SUCCESSFUL"
msgstr "СӘТТІ"

#: src/wallet_backend.py:62 src/wallet_backend.py:72
msgid "KWallet"
msgstr "KWallet"

#: src/wallet_backend.py:64
msgid "GNOME Keyring"
msgstr "GNOME Keyring"

#: src/wallet_backend.py:65
msgid "None"
msgstr "None"

#: src/wallet_backend.py:74
msgid "login keyring"
msgstr "кіру кілттері"

#: src/wallet_backend.py:75
msgid "login keyring or KWallet"
msgstr "кіру кілті немесе KWallet"

#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\ndlib модулін импорттау мүмкін емес, шығысын тексеріңіз"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "Бет үлгісі қалтасы табылмады, біреуі жасалды"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr "ЕСКЕРТПЕ: Әрбір қосымша модель бетті тану қозғалтқышын аздап баяулатады"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"Бас тарту үшін Ctrl+C пернелер тіркесімін басыңыз\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "Пайдаланушы үшін бет үлгісін қосу"

#: src/cli/add.py:88
msgid "Model #"
msgstr "Үлгі №"

#: src/cli/add.py:93
msgid "Using default label \"%s\" because of -y flag"
msgstr "-y жалауына байланысты әдепкі \"%s\" белгісін пайдалану"

#: src/cli/add.py:97
msgid "Enter a label for this new model [{}]: "
msgstr "Осы жаңа модель үшін белгіні енгізіңіз [{}]:"

#: src/cli/add.py:107
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "ЕСКЕРТУ: Үлгі атынан заңсыз «,» таңбасын жою"

#: src/cli/add.py:121
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nТіке камераға қараңыз"

#: src/cli/add.py:186
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "Камера тек қара жақтауларды көрді - ИК эмитент жұмыс істей ме?"

#: src/cli/add.py:191
msgid "No face detected, aborting"
msgstr "Бет анықталмады, тоқтатылуда"

#: src/cli/add.py:196
msgid "Multiple faces detected, aborting"
msgstr "Бірнеше бет анықталды, тоқтатылуда"

#: src/cli/add.py:218
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nСканерлеу аяқталды\nЖаңа үлгі қосылды"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr ""
"Әзірге ешқандай үлгілер жасалмаған, егер олар жоқ болса, оларды тазала"
"у мүмкін емес"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} үлгілері жоқ немесе олар әлдеқашан тазартылған"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "Бұл барлық үлгілерді тазартады"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "Жалғастыруды қалайсыз ба [y/N]:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\n«ЖОҚ» деп түсіндіру, тоқтату"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nМодельдер тазартылды"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "config.ini {editor} ішінде ашылуда"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "Редакторды ашу мүмкін болмады: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "Қате: сәйкес мәтін өңдегіші табылмады."

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr ""
"\"nano\" немесе \"vi\" орнатыңыз немесе EDITOR ортасының айнымалы мәні"
"н орнатыңыз."

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."
msgstr ""
"Егер сіз осы пәрменді sudo көмегімен іске қосып жатсаңыз, EDITOR айным"
"алы мәнін сақтау үшін «sudo -E ubuntu-hello конфигурациясын» қолданып "
"көріңіз."

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "Аргумент ретінде 0 (қосу) немесе 1 (өшіру) қосыңыз"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr "Аргумент ретінде тек 0 (қосу) немесе 1 (өшіру) пайдаланыңыз"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "Өшіру опциясы әлдеқашан орнатылған"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Hello өшірілді"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Hello қосылды"

#: src/cli/keyring.py:32 src/cli/keyring.py:148
msgid "Usage: keyring [enable|disable|restore [--all]]"
msgstr "Қолданылуы: кілттер [қосу|өшіру|қалпына келтіру] [--all]"

#: src/cli/keyring.py:49
msgid "Enter password for user {} to unlock {} ({}): "
msgstr "{} ({}) құлпын ашу үшін {} пайдаланушысының құпия сөзін енгізіңіз:"

#: src/cli/keyring.py:51
msgid "Password cannot be empty"
msgstr "Құпия сөз бос болмауы керек"

#: src/cli/keyring.py:54
msgid "Confirm password: "
msgstr "Құпия сөзді Растау:"

#: src/cli/keyring.py:56
msgid "Passwords do not match"
msgstr "Құпия сөздер сәйкес келмейді"

#: src/cli/keyring.py:65
msgid "TPM hardware detected. Auto-installing tpm2-tools..."
msgstr ""
"TPM аппараттық құралы анықталды. tpm2-tools автоматты түрде орнатылуда"
"..."

#: src/cli/keyring.py:74
msgid "TPM hardware active. Sealing password in TPM..."
msgstr "TPM аппараттық құралы белсенді. TPM жүйесінде құпия сөзді мөрлеу..."

#: src/cli/keyring.py:100
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} using TPM ("
"wallet: {})."
msgstr ""
"Кілт/KWallet құлпын ашу TPM (әмиян: {}) арқылы {} пайдаланушысы үшін с"
"әтті қосылды."

#: src/cli/keyring.py:102
msgid "Failed to seal password to TPM: {}"
msgstr "TPM құпия сөзін жабу мүмкін болмады: {}"

#: src/cli/keyring.py:106
msgid "No TPM active. Using software-based credential caching..."
msgstr ""
"Белсенді TPM жоқ. Бағдарламаға негізделген тіркелгі деректерін кэштеуд"
"і пайдалану..."

#: src/cli/keyring.py:122
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} (Software C"
"aching, wallet: {})."
msgstr ""
"Keyring/KWallet құлпын ашу {} пайдаланушысы үшін сәтті қосылды (Бағдар"
"ламалық құралды кэштеу, әмиян: {})."

#: src/cli/keyring.py:124
msgid "Failed to enable keyring unlocking: {}"
msgstr "Кілттердің құлпын ашуды қосу мүмкін болмады: {}"

#: src/cli/keyring.py:135
msgid "Failed to disable keyring unlocking: {}"
msgstr "Кілттердің құлпын ашу өшірілмеді: {}"

#: src/cli/keyring.py:138
msgid "Keyring/KWallet unlocking disabled for user {}."
msgstr "Кілт/KWallet құлпын ашу {} пайдаланушысы үшін өшірілген."

#: src/cli/keyring.py:140
msgid "Keyring/KWallet unlocking was not enabled for user {}."
msgstr "Кілт/KWallet құлпын ашу {} пайдаланушысы үшін қосылмаған."

#: src/cli/keyring.py:153
msgid "No sealed login passwords found; nothing to restore."
msgstr "Мөрленген кіру құпиясөздері табылмады; қалпына келтіретін ештеңе жоқ."

#: src/cli/keyring.py:155
msgid "Restored login wallet password for {} user(s)."
msgstr "{} пайдаланушының кіру әмиянының құпиясөзі қалпына келтірілді."

#: src/cli/keyring.py:157
msgid "Could not restore login wallet password for {} user(s)."
msgstr ""
"{} пайдаланушының кіру әмиянының құпиясөзін қалпына келтіру мүмкін бол"
"мады."

#: src/cli/keyring.py:158
msgid ""
"If prompts persist, set the login keyring or KWallet password in Seaho"
"rse / System Settings."
msgstr ""
"Сұраулар жалғасса, Seahorse / Жүйе параметрлерінде кіру кілттерінің не"
"месе KWallet құпиясөзін орнатыңыз."

#: src/cli/keyring.py:161
msgid "Restored login wallet password for user {}."
msgstr "{} пайдаланушысының кіру әмиянының құпиясөзі қалпына келтірілді."

#: src/cli/keyring.py:163
msgid "Could not restore login wallet password for user {}."
msgstr ""
"{} пайдаланушысының кіру әмиянының құпиясөзін қалпына келтіру мүмкін б"
"олмады."

#: src/cli/keyring.py:167
msgid "Invalid action. Use 'enable', 'disable', or 'restore'."
msgstr "Жарамсыз әрекет. «қосу», «өшіру» немесе «қалпына келтіру» пайдаланыңыз."

#: src/cli/list.py:17 src/cli/remove.py:25
msgid "Face models have not been initialized yet, please run:"
msgstr "Бет үлгілері әлі инициализацияланған жоқ, іске қосыңыз:"

#: src/cli/list.py:29 src/cli/remove.py:36
msgid "No face model known for the user {}, please run:"
msgstr "{} пайдаланушыға белгілі бет үлгісі жоқ, келесіні іске қосыңыз:"

#: src/cli/list.py:35
msgid "Known face models for {}:"
msgstr "{} үшін белгілі бет үлгілері:"

#: src/cli/list.py:36
msgid "ID  Date                 Label[0m"
msgstr "Идентификатор күні белгісі [0м"

#: src/cli/remove.py:16
msgid "Please add the ID of the model you want to remove as an argument"
msgstr "Аргумент ретінде жойғыңыз келетін үлгінің идентификаторын қосыңыз"

#: src/cli/remove.py:17 src/cli/set.py:18
msgid "For example:"
msgstr "Мысалы:"

#: src/cli/remove.py:19
msgid "You can find the IDs by running:"
msgstr "Идентификаторларды іске қосу арқылы табуға болады:"

#: src/cli/remove.py:52
msgid "This will remove the model called \"{label}\" for {user}"
msgstr "Бұл {user} үшін \"{label}\" деп аталатын үлгіні жояды."

#: src/cli/remove.py:69
msgid "No model with ID {id} exists for {user}"
msgstr "{user} үшін {id} идентификаторы бар үлгі жоқ"

#: src/cli/remove.py:75
msgid "Removed last model, ubuntu-hello disabled for user"
msgstr "Соңғы үлгі жойылды, пайдаланушы үшін ubuntu-hello өшірілді"

#: src/cli/remove.py:89
msgid "Removed model {}"
msgstr "Жойылған үлгі {}"

#: src/cli/set.py:17
msgid "Please add a setting you would like to change and the value to set it to"
msgstr "Өзгерткіңіз келетін параметрді және оған орнатылатын мәнді қосыңыз"

#: src/cli/set.py:37
msgid "Could not find a \"{}\" config option to set"

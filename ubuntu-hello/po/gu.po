#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr ""
"હજી સુધી કોઈ મૉડલ બનાવેલ નથી, જો તેઓ અસ્તિત્વમાં ન હોય તો તેને સાફ કરી"
" શકતા નથી"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} પાસે કોઈ મોડલ નથી અથવા તે પહેલાથી જ સાફ થઈ ગયા છે"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "આ માટેના તમામ મોડલ્સ સાફ થઈ જશે"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "શું તમે [y/N] ચાલુ રાખવા માંગો છો:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\n\"ના\" તરીકે અર્થઘટન કરી રહ્યું છે, અવ્યવસ્થિત કરી રહ્યું છે"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nમૉડલ્સ સાફ"

#: src/cli/config.py:32

#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "דורכפאַל, טיימאַוט ריטשט"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "די בילד פון די פּנים דיטעקשאַן איז אויך טונקל"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "אומבאַקאַנט טעות:"

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "יידענאַפייד פּנים ווי %s"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr ""
"ניט גענוגיק פּערמישאַנז צו שיקן אַרייַן דרוק, ווארטן פֿאַר באַניצער צו"
" דריקן עס אַנשטאָט"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr ""
"ניט אַנדערש צו שיקן אַרייַן דרוק, ווארטן פֿאַר באַניצער צו דריקן עס אַ"
"נשטאָט"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "פּרווון פאַסיאַל אָטענטאַקיישאַן"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "קען נישט באַשטימען באַניצער, ביטע נוצן די --user פאָן"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "באַפֿעלן שורה צובינד פֿאַר Ubuntu Hello פּנים אָטענטאַקיישאַן."

#: src/cli.py:35
msgid "command"
msgstr "באַפֿעלן"

#: src/cli.py:35
msgid "arguments"
msgstr "אַרגומענטן"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"פֿאַר שטיצן ביטע באַזוכן\nhttps://github.com/ventura8/ubuntu-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"די באַפֿעלן אָפּציע צו ויספירן קענען זיין איינער פון די פאלגענדע: לייג"
"ן, קלאָר, קאָנפיג, דיסייבאַל, קיירינג, רשימה, אַראָפּנעמען, מאָמענטביל"
"ד, שטעלן, פּרובירן אָדער ווערסיע."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr ""
"אַפּשאַנאַל אַרגומענטן פֿאַר די לייגן, דיסייבאַל, אַראָפּנעמען און שטע"
"לן קאַמאַנדז."

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "שטעלן די באַניצער חשבון צו נוצן."

#: src/cli.py:60
msgid "Skip all questions."
msgstr "האָפּקען אַלע שאלות."

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "דרוק מאַשין-פרייַנדלעך רעזולטאַט."

#: src/cli.py:74
msgid "Show this help message and exit."
msgstr "ווייַזן דעם הילף אָנזאָג און אַרויסגאַנג."

#: src/cli.py:78
msgid "current active user: "
msgstr "יעצטיגע אקטיווע באנוצער:"

#: src/cli.py:88
msgid "Invalid username format"
msgstr "אומגילטיק באנוצער נאמען פֿאָרמאַט"

#: src/cli.py:98
msgid ""
"Please run this command as root:\n"
msgstr ""
"ביטע לויפן דעם באַפֿעל ווי וואָרצל:\n"

#: src/cli.py:104
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr ""
"קענען ניט לויפן ובונטו-העלא קאַמאַנדז ווי וואָרצל, ביטע לויפן דעם באַפ"
"ֿעל מיט די -- באַניצער פאָן"

#: src/compare.py:128 src/cli/add.py:32
msgid "Data files have not been downloaded, please run the following commands:"
msgstr "דאַטן טעקעס זענען נישט דאַונלאָודיד, ביטע לויפן די פאלגענדע קאַמאַנדז:"

#: src/compare.py:154
msgid " LOGIN"
msgstr "לאָגין"

#: src/compare.py:155 src/cli/snap.py:44
msgid "Date: "
msgstr "טאָג:"

#: src/compare.py:156
msgid "Scan time: "
msgstr "סקאַן צייט:"

#: src/compare.py:157
msgid "Frames: "
msgstr "ראַמען:"

#: src/compare.py:158
msgid "Hostname: "
msgstr "האָסט נאָמען:"

#: src/compare.py:159
msgid "Best certainty value: "
msgstr "בעסטער זיכערקייט ווערט:"

#: src/compare.py:259
msgid "Starting up..."
msgstr "אָנהייב אַרויף ..."

#: src/compare.py:312
msgid "Identifying you..."
msgstr "ידענטיפיצירן איר ..."

#: src/compare.py:344
msgid "FAILED"
msgstr "FAILED"

#: src/compare.py:347 src/cli/add.py:184
msgid "All frames were too dark, please check dark_threshold in config"
msgstr "אַלע ראָמען זענען געווען צו טונקל, ביטע טשעק dark_threshold אין קאָנפיג"

#: src/compare.py:348 src/cli/add.py:185
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "דורכשניטלעך פינצטערניש: {avg}, שוועל: {threshold}"

#: src/compare.py:449
msgid "Time spent"
msgstr "צייט פארבראכט"

#: src/compare.py:450
msgid "Starting up"
msgstr "סטאַרטינג אַרויף"

#: src/compare.py:451
msgid "  Open cam + load libs: %dms"
msgstr "עפֿן קאַם + מאַסע ליבס: %dms"

#: src/compare.py:452
msgid "  Opening the camera"
msgstr "עפן די אַפּאַראַט"

#: src/compare.py:453
msgid "  Importing recognition libs"
msgstr "ימפּאָרטינג דערקענונג ליבס"

#: src/compare.py:454
msgid "Searching for known face"
msgstr "זוכן פֿאַר באקאנט פּנים"

#: src/compare.py:455
msgid "Total time"
msgstr "גאַנץ צייט"

#: src/compare.py:457
msgid ""
"\nResolution"
msgstr ""
"\nהאַכלאָטע"

#: src/compare.py:459
msgid "  Native: %dx%d"
msgstr "געבוירן: %dx%d"

#: src/compare.py:462
msgid "  Used: %dx%d"
msgstr "געוויינט: %dx%d"

#: src/compare.py:465
msgid ""
"\nFrames searched: %d (%.2f fps)"
msgstr ""
"\nגעזוכט ראָמען: %d (%.2f fps)"

#: src/compare.py:466
msgid "Black frames ignored: %d "
msgstr "שוואַרץ ראָמען איגנאָרירט: %d"

#: src/compare.py:467
msgid "Dark frames ignored: %d "
msgstr "טונקל ראָמען איגנאָרירט: %d"

#: src/compare.py:468
msgid "Certainty of winning frame: %.3f"
msgstr "זיכערקייט פון ווינינג ראַם: %.3f"

#: src/compare.py:470
msgid "Winning model: %d (\"%s\")"
msgstr "געווינער מאָדעל: %d (\"%s\")"

#: src/compare.py:474
msgid "SUCCESSFUL"
msgstr "געראָטן"

#: src/wallet_backend.py:62 src/wallet_backend.py:72
msgid "KWallet"
msgstr "KWallet"

#: src/wallet_backend.py:64
msgid "GNOME Keyring"
msgstr "GNOME Keyring"

#: src/wallet_backend.py:65
msgid "None"
msgstr "None"

#: src/wallet_backend.py:74
msgid "login keyring"
msgstr "לאָגין שליסלרינג"

#: src/wallet_backend.py:75
msgid "login keyring or KWallet"
msgstr "לאָגין שליסל רינג אָדער KWallet"

#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\nקענען ניט אַרייַנפיר די dlib מאָדולע, קאָנטראָלירן די רעזולטאַט פון"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "קיין פּנים מאָדעל טעקע געפונען, קריייטינג איינער"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr ""
"נאָטיץ: יעדער נאָך מאָדעל סלאָוז אַראָפּ די פּנים דערקענונג מאָטאָר אַ"
" ביסל"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"דרוק קטרל + C צו באָטל מאַכן\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "אַדינג פּנים מאָדעל פֿאַר די באַניצער"

#: src/cli/add.py:88
msgid "Model #"
msgstr "מאָדעל #"

#: src/cli/add.py:92
msgid "Using default label \"%s\" because of -y flag"
msgstr "ניצן פעליקייַט פירמע \"%s\" ווייַל פון -י פאָן"

#: src/cli/add.py:95
msgid "Enter a label for this new model [{}]: "
msgstr "אַרייַן אַ פירמע פֿאַר דעם נייַע מאָדעל [{}]:"

#: src/cli/add.py:103
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "נאָטיץ: רימוווינג ומלעגאַל כאַראַקטער \",\" פֿון מאָדעל נאָמען"

#: src/cli/add.py:117
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nביטע קוק גלייך אין די אַפּאַראַט"

#: src/cli/add.py:182
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "קאַמעראַ געזען בלויז שוואַרץ ראָמען - איז יר עמיטטער ארבעטן?"

#: src/cli/add.py:187
msgid "No face detected, aborting"
msgstr "קיין פּנים דיטעקטאַד, אַבאָרטינג"

#: src/cli/add.py:192
msgid "Multiple faces detected, aborting"
msgstr "קייפל פנימער דיטעקטאַד, אַבאָרטינג"

#: src/cli/add.py:214
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nסקאַן גאַנץ\nצוגעגעבן אַ נייַע מאָדעל צו"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr ""
"קיין מאָדעלס באשאפן נאָך, קענען נישט ויסמעקן זיי אויב זיי טאָן ניט עקס"
"יסטירן"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} האט קיין מאָדעלס אָדער זיי זענען שוין קלירד"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "דאָס וועט ויסמעקן אַלע מאָדעלס"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "צי איר ווילן צו פאָרזעצן [י/ען]:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\nינטערפּריטינג ווי אַ \"ניין\", אַבאָרטינג"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nמאָדעלס קלירד"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "עפן config.ini אין {editor}"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "ניט אַנדערש צו עפענען רעדאַקטאָר: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "טעות: קען נישט געפֿינען אַ פּאַסיק טעקסט רעדאַקטאָר."

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr ""
"ביטע ינסטאַלירן 'נאַנאָ' אָדער 'ווי', אָדער שטעלן די EDITOR סוויווע בי"
"יַטעוודיק."

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."
msgstr ""
"אויב איר לויפן דעם באַפֿעל מיט sudo, פּרוּווט 'sudo -E ubuntu-hello co"
"nfig' צו ופהיטן דיין EDITOR בייַטעוודיק."

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "ביטע לייגן אַ 0 (געבן) אָדער אַ 1 (דיסייבאַל) ווי אַן אַרגומענט"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr "ביטע נוצן בלויז 0 (געבן) אָדער 1 (דיסייבאַל) ווי אַן אַרגומענט"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "די דיסייבאַל אָפּציע איז שוין באַשטימט צו"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Hello איז פאַרקריפּלט"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Hello איז ענייבאַלד"

#: src/cli/keyring.py:32 src/cli/keyring.py:157
msgid "Usage: keyring [enable|disable|restore [--all]]"
msgstr "באַניץ: שליסלרינג [געבן|דיסאַבלע|צוריקשטעלן] [--all]"

#: src/cli/keyring.py:49
msgid "Enter password for user {} to unlock {} ({}): "
msgstr "אַרייַן פּאַראָל פֿאַר באַניצער {} צו ופשליסן {} ({}):"

#: src/cli/keyring.py:51
msgid "Password cannot be empty"
msgstr "שפּריכוואָרט קען נישט זיין ליידיק"

#: src/cli/keyring.py:54
msgid "Confirm password: "
msgstr "באַשטעטיקן פּאַראָל:"

#: src/cli/keyring.py:56
msgid "Passwords do not match"
msgstr "פּאַסווערדז טאָן ניט גלייַכן"

#: src/cli/keyring.py:65
msgid "TPM hardware detected. Auto-installing tpm2-tools..."
msgstr "TPM ייַזנוואַרג דיטעקטאַד. אַוטאָ-ינסטאַלירן tpm2-tools ..."

#: src/cli/keyring.py:74
msgid "TPM hardware active. Sealing password in TPM..."
msgstr "טפּם ייַזנוואַרג אַקטיוו. סילינג פּאַראָל אין TPM ..."

#: src/cli/keyring.py:100
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} using TPM ("
"wallet: {})."
msgstr ""
"אַנלאַקינג קיירינג / KWallet הצלחה ענייבאַלד פֿאַר באַניצער {} ניצן טפ"
"ּם (בייַטל: {})."

#: src/cli/keyring.py:102
msgid "Failed to seal password to TPM: {}"
msgstr "ניט אַנדערש צו פּלאָמבע פּאַראָל צו TPM: {}"

#: src/cli/keyring.py:106
msgid "No TPM active. Using software-based credential caching..."
msgstr "קיין TPM אַקטיוו. ניצן ווייכווארג-באזירט קראַדענטשאַל קאַטשינג ..."

#: src/cli/keyring.py:122
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} (Software C"
"aching, wallet: {})."
msgstr ""
"קיירינג / KWallet אַנלאַקינג הצלחה ענייבאַלד פֿאַר באַניצער {} (סאָפטו"
"ואַרע קאַטשינג, בייַטל: {})."

#: src/cli/keyring.py:124
msgid "Failed to enable keyring unlocking: {}"
msgstr "ניט אַנדערש צו געבן אַנלאַקינג שליסלרינג: {}"

#: src/cli/keyring.py:135
msgid "Failed to disable keyring unlocking: {}"
msgstr "ניט אַנדערש צו דיסייבאַל אַנלאַקינג שליסל: {}"

#: src/cli/keyring.py:138
msgid "Keyring/KWallet unlocking disabled for user {}."
msgstr "אַנלאַקינג שליסלרינג / KWallet פאַרקריפּלט פֿאַר באַניצער {}."

#: src/cli/keyring.py:140
msgid "Keyring/KWallet unlocking was not enabled for user {}."
msgstr "אַנלאַקינג קיירינג / KWallet איז נישט ענייבאַלד פֿאַר באַניצער {}."

#: src/cli/keyring.py:149
msgid "No sealed login passwords found; nothing to restore."
msgstr "קיין פֿאַרזיגלטע לאָגין פּאַראָלן געפֿונען; נישטס צו צוריקשטעלן."

#: src/cli/keyring.py:151
msgid "Restored login wallet password for {} user(s)."
msgstr "צוריקגעשטעלט לאָגין בייַטל פּאַראָל פֿאַר {} באַניצער(ס)."

#: src/cli/keyring.py:153
msgid "Could not restore login wallet password for {} user(s)."
msgstr "נישט געקענט צוריקשטעלן לאָגין בייַטל פּאַראָל פֿאַר {} באַניצער(ס)."

#: src/cli/keyring.py:154
msgid ""
"If prompts persist, set the login keyring or KWallet password in Seaho"
"rse / System Settings."
msgstr ""
"אויב פּראָמפּטן בלייבן, שטעלט די לאָגין שליסלרינג אָדער KWallet פּאַרא"
"ָל אין Seahorse / סיסטעם סעטטינגס."

#: src/cli/keyring.py:161
msgid "Restored login wallet password for user {}."
msgstr "צוריקגעשטעלט לאָגין בייַטל פּאַראָל פֿאַר באַניצער {}."


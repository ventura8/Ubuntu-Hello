#: src/pam/main.cc:109
msgid "Failure, timeout reached"
msgstr "דורכפאַל, טיימאַוט ריטשט"

#: src/pam/main.cc:116
msgid "Face detection image too dark"
msgstr "די בילד פון די פּנים דיטעקשאַן איז אויך טונקל"

#: src/pam/main.cc:125
msgid "Unknown error: "
msgstr "אומבאַקאַנט טעות:"

#: src/pam/main.cc:161
#, c-format
msgid "Identified face as %s"
msgstr "יידענאַפייד פּנים ווי %s"

#: src/pam/main.cc:446
msgid ""
"Insufficient permissions to send Enter press, waiting for user to press it "
"instead"
msgstr ""
"ניט גענוגיק פּערמישאַנז צו שיקן אַרייַן דרוק, ווארטן פֿאַר באַניצער צו דריקן עס "
"אַנשטאָט"

#: src/pam/main.cc:465 src/pam/main.cc:470
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr "ניט אַנדערש צו שיקן אַרייַן דרוק, ווארטן פֿאַר באַניצער צו דריקן עס אַנשטאָט"

#: src/pam/main.cc:596
msgid "Attempting facial authentication"
msgstr "פּרווון פאַסיאַל אָטענטאַקיישאַן"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "קען נישט באַשטימען באַניצער, ביטע נוצן די --user פאָן"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "באַפֿעלן שורה צובינד פֿאַר Ubuntu Hello פּנים אָטענטאַקיישאַן."

#: src/cli.py:35
msgid "command"
msgstr "באַפֿעלן"

#: src/cli.py:35
msgid "arguments"
msgstr "אַרגומענטן"

#: src/cli.py:36
msgid ""
"For support please visit\n"
"https://github.com/ventura8/ubuntu-hello"
msgstr ""
"פֿאַר שטיצן ביטע באַזוכן\n"
"https://github.com/ventura8/ubuntu-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear, "
"config, disable, keyring, list, remove, snapshot, set, test or version."
msgstr ""
"די באַפֿעל־אָפּציע, וואָס מע דאַרף אויספֿירן, קען זײַן איינע פֿון די פֿאָלגנדיקע: add, "
"clear, config, disable, keyring, list, remove, snapshot, set, test אָדער "
"version."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "אָפּציאָנעלע אַרגומענטן פֿאַר די באַפֿעלן add, disable, remove און set."

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "שטעלן די באַניצער חשבון צו נוצן."

#: src/cli.py:60
msgid "Skip all questions."
msgstr "האָפּקען אַלע שאלות."

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "דרוק מאַשין-פרייַנדלעך רעזולטאַט."

#: src/cli.py:72
msgid "With keyring restore: restore sealed login passwords for all users."
msgstr ""
"מיט keyring restore: שטעלט צוריק די פֿאַרזיגלטע אַרײַנלאָגיר־פּאַראָלן פֿאַר אַלע "
"באַניצער."

#: src/cli.py:80
msgid "Show this help message and exit."
msgstr "ווייַזן דעם הילף אָנזאָג און אַרויסגאַנג."

#: src/cli.py:84
msgid "current active user: "
msgstr "יעצטיגע אקטיווע באנוצער:"

#: src/cli.py:94
msgid "Invalid username format"
msgstr "אומגילטיק באנוצער נאמען פֿאָרמאַט"

#: src/cli.py:104
msgid "Please run this command as root:\n"
msgstr "זײַט אַזוי גוט און פֿירט אויס דעם באַפֿעל ווי root:\n"

#: src/cli.py:110
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with the --"
"user flag"
msgstr ""
"מען קען ניט לויפן ubuntu-hello באַפֿעלן ווי root, ביטע לויף דעם באַפֿעל מיט דער "
"--user פאָן"

#: src/compare.py:283 src/cli/add.py:34
msgid "Data files have not been downloaded, please run the following commands:"
msgstr "דאַטן טעקעס זענען נישט דאַונלאָודיד, ביטע לויפן די פאלגענדע קאַמאַנדז:"

#: src/compare.py:313
msgid " LOGIN"
msgstr " אָנמעלדונג"

#: src/compare.py:314 src/cli/snap.py:44
msgid "Date: "
msgstr "טאָג:"

#: src/compare.py:315
msgid "Scan time: "
msgstr "סקאַן צייט:"

#: src/compare.py:316
msgid "Frames: "
msgstr "ראַמען:"

#: src/compare.py:317
msgid "Hostname: "
msgstr "האָסט נאָמען:"

#: src/compare.py:318
msgid "Best certainty value: "
msgstr "בעסטער זיכערקייט ווערט:"

#: src/compare.py:482
msgid "Starting up..."
msgstr "אָנהייב אַרויף ..."

#: src/compare.py:514
msgid "Face recognition could not start: {}"
msgstr "מען האָט נישט געקענט אָנהייבן די פּנים־דערקענונג: {}"

#: src/compare.py:550
msgid "Identifying you..."
msgstr "ידענטיפיצירן איר ..."

#: src/compare.py:582
msgid "FAILED"
msgstr "דורכגעפֿאַלן"

#: src/compare.py:585 src/cli/add.py:230
msgid "All frames were too dark, please check dark_threshold in config"
msgstr "אַלע ראָמען זענען געווען צו טונקל, ביטע טשעק dark_threshold אין קאָנפיג"

#: src/compare.py:586 src/cli/add.py:231
#, python-brace-format
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "דורכשניטלעך פינצטערניש: {avg}, שוועל: {threshold}"

#: src/compare.py:709
msgid "Time spent"
msgstr "צייט פארבראכט"

#: src/compare.py:710
msgid "Starting up"
msgstr "הייבט זיך אָן"

#: src/compare.py:711
#, python-format
msgid "  Open cam + load libs: %dms"
msgstr "  עפֿענען קאַמערע + לאָדן ביבליאָטעקן: %dms"

#: src/compare.py:712
msgid "  Opening the camera"
msgstr "עפן די אַפּאַראַט"

#: src/compare.py:713
msgid "  Importing recognition libs"
msgstr "ימפּאָרטינג דערקענונג ליבס"

#: src/compare.py:714
msgid "Searching for known face"
msgstr "זוכן פֿאַר באקאנט פּנים"

#: src/compare.py:715
msgid "Total time"
msgstr "גאַנץ צייט"

#: src/compare.py:717
msgid ""
"\n"
"Resolution"
msgstr ""
"\n"
"האַכלאָטע"

#: src/compare.py:719
#, python-format
msgid "  Native: %dx%d"
msgstr "געבוירן: %dx%d"

#: src/compare.py:722
#, python-format
msgid "  Used: %dx%d"
msgstr "געוויינט: %dx%d"

#: src/compare.py:725
#, python-format
msgid ""
"\n"
"Frames searched: %d (%.2f fps)"
msgstr ""
"\n"
"געזוכט ראָמען: %d (%.2f fps)"

#: src/compare.py:726
#, python-format
msgid "Black frames ignored: %d "
msgstr "שוואַרץ ראָמען איגנאָרירט: %d"

#: src/compare.py:727
#, python-format
msgid "Dark frames ignored: %d "
msgstr "טונקל ראָמען איגנאָרירט: %d"

#: src/compare.py:728
#, python-format
msgid "Certainty of winning frame: %.3f"
msgstr "זיכערקייט פון ווינינג ראַם: %.3f"

#: src/compare.py:730
#, python-format
msgid "Winning model: %d (\"%s\")"
msgstr "געווינער מאָדעל: %d (\"%s\")"

#: src/compare.py:745
msgid "SUCCESSFUL"
msgstr "געראָטן"

#: src/enroll_capture.py:22
msgid "Look straight at the camera"
msgstr "קוקט גלײַך אין דער קאַמערע"

#: src/enroll_capture.py:23
msgid "Turn your head slightly to the left"
msgstr "דרייט דעם קאָפּ אַ ביסל אויף לינקס"

#: src/enroll_capture.py:24
msgid "Turn your head slightly to the right"
msgstr "דרייט דעם קאָפּ אַ ביסל אויף רעכטס"

#: src/enroll_capture.py:25
msgid "Tilt your chin up a little"
msgstr "הייבט דעם קין אַ ביסל אַרויף"

#: src/enroll_capture.py:26
msgid "Tilt your chin down a little"
msgstr "לאָזט דעם קין אַ ביסל אַראָפּ"

#: src/enroll_capture.py:27
msgid "Look straight at the camera again"
msgstr "קוקט ווידער גלײַך אין דער קאַמערע"

#: src/notify.py:375
msgid "sudo"
msgstr "sudo"

#: src/notify.py:377
msgid "su"
msgstr "su"

#: src/notify.py:379

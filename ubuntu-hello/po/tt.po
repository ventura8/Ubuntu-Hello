#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear, "
"config, disable, keyring, list, remove, snapshot, set, test or version."
msgstr ""
"Үтәләсе боерык варианты түбәндәгеләрнең берсе булырга мөмкин: add, clear, "
"config, disable, keyring, list, remove, snapshot, set, test яки version."

#: src/cli.py:48

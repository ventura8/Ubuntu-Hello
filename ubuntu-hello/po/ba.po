#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello йөҙ буйынса аутентификацияһының команда юлы интерфейсы."

#: src/cli.py:35
msgid "command"
msgstr "команда"

#: src/cli.py:35
msgid "arguments"
msgstr "аргументтар"

#: src/cli.py:36
msgid ""
"For support please visit\n"
"https://github.com/ventura8/ubuntu-hello"
msgstr ""
"Ярҙам өсөн, зинһар, түбәндәге һылтанмаға инегеҙ:\n"
"https://github.com/ventura8/ubuntu-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear, "
"config, disable, keyring, list, remove, snapshot, set, test or version."
msgstr ""
"Башҡарыла торған команда варианты, түбәндәгеләрҙең береһе булыуы мөмкин: "
"add, clear, config, disable, keyring, list, remove, snapshot, set, test йәки "
"version."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr ""
"add, disable, remove һәм set командалары өсөн мәжбүри булмаған аргументтар."

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "Ҡулланыласы ҡулланыусы иҫәп яҙмаһын күрһәтергә."


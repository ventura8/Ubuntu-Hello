#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "தோல்வி, காலக்கெடுவை அடைந்தது"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "முகம் கண்டறிதல் படம் மிகவும் இருட்டாக உள்ளது"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "அறியப்படாத பிழை:"

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "%s என அடையாளம் காணப்பட்ட முகம்"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr ""
"Enter விசையை அனுப்ப போதுமான அனுமதிகள் இல்லை, அதற்கு பதிலாக பயனர் அதை அ"
"ழுத்தும் வரை காத்திருக்கிறது"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr ""
"Enter விசையை அனுப்புவதில் தோல்வி, அதற்கு பதிலாக பயனர் அதை அழுத்தும் வர"
"ை காத்திருக்கிறது"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "முக அங்கீகரிப்பு முயற்சி"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr ""
"பயனரைத் தீர்மானிக்க முடியவில்லை, தயவுசெய்து --user கொடியைப் பயன்படுத்த"
"வும்"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello முக அங்கீகாரத்திற்கான கட்டளை வரி இடைமுகம்."

#: src/cli.py:35
msgid "command"
msgstr "கட்டளை"

#: src/cli.py:35
msgid "arguments"
msgstr "வாதங்கள்"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"ஆதரவிற்கு தயவுசெய்து பார்வையிடவும்\nhttps://github.com/ventura8/ubuntu"
"-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"இயக்குவதற்கான கட்டளை விருப்பமானது பின்வருவனவற்றில் ஒன்றாக இருக்கலாம்: "
"சேர், தெளிவு, கட்டமைப்பு, முடக்கு, கீரிங், பட்டியல், நீக்குதல், ஸ்னாப்"
"ஷாட், செட், டெஸ்ட் அல்லது பதிப்பு."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "கட்டளைகளைச் சேர், முடக்கு, அகற்று மற்றும் அமைவுக்கான விருப்ப வாதங்கள்."

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "பயன்படுத்த பயனர் கணக்கை அமைக்கவும்."

#: src/cli.py:60
msgid "Skip all questions."
msgstr "எல்லா கேள்விகளையும் தவிர்க்கவும்."

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "அச்சு இயந்திரத்திற்கு ஏற்ற வெளியீடு."

#: src/cli.py:74
msgid "Show this help message and exit."
msgstr "இந்த உதவி செய்தியைக் காட்டி வெளியேறவும்."

#: src/cli.py:78
msgid "current active user: "
msgstr "தற்போதைய செயலில் உள்ள பயனர்:"

#: src/cli.py:88
msgid "Invalid username format"
msgstr "தவறான பயனர்பெயர் வடிவம்"

#: src/cli.py:98
msgid ""
"Please run this command as root:\n"
msgstr ""
"இந்த கட்டளையை ரூட்டாக இயக்கவும்:\n"

#: src/cli.py:104
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr ""
"ubuntu-hello கட்டளைகளை ரூட்டாக இயக்க முடியாது, தயவுசெய்து இந்த கட்டளைய"
"ை --user கொடியுடன் இயக்கவும்"

#: src/compare.py:128 src/cli/add.py:32
msgid "Data files have not been downloaded, please run the following commands:"
msgstr ""
"தரவு கோப்புகள் பதிவிறக்கம் செய்யப்படவில்லை, தயவுசெய்து பின்வரும் கட்டள"
"ைகளை இயக்கவும்:"

#: src/compare.py:154
msgid " LOGIN"
msgstr "உள்நுழைக"

#: src/compare.py:155 src/cli/snap.py:44
msgid "Date: "
msgstr "தேதி:"

#: src/compare.py:156
msgid "Scan time: "
msgstr "ஸ்கேன் நேரம்:"

#: src/compare.py:157
msgid "Frames: "
msgstr "சட்டங்கள்:"

#: src/compare.py:158
msgid "Hostname: "
msgstr "ஹோஸ்ட் பெயர்:"

#: src/compare.py:159
msgid "Best certainty value: "
msgstr "சிறந்த உறுதி மதிப்பு:"

#: src/compare.py:259
msgid "Starting up..."
msgstr "துவங்குகிறது..."

#: src/compare.py:312
msgid "Identifying you..."
msgstr "உன்னை அடையாளம் கண்டுகொள்வது..."

#: src/compare.py:344
msgid "FAILED"
msgstr "தோல்வியடைந்தது"

#: src/compare.py:347 src/cli/add.py:184
msgid "All frames were too dark, please check dark_threshold in config"
msgstr ""
"அனைத்து பிரேம்களும் மிகவும் இருட்டாக இருந்தன, தயவுசெய்து config இல் da"
"rk_threshold ஐச் சரிபார்க்கவும்"

#: src/compare.py:348 src/cli/add.py:185
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "சராசரி இருள்: {avg}, வரம்பு: {threshold}"

#: src/compare.py:449
msgid "Time spent"
msgstr "செலவழித்த நேரம்"

#: src/compare.py:450
msgid "Starting up"
msgstr "தொடங்குதல்"

#: src/compare.py:451
msgid "  Open cam + load libs: %dms"
msgstr "கேம் + லோட் லிப்களைத் திற: %dms"

#: src/compare.py:452
msgid "  Opening the camera"
msgstr "கேமராவைத் திறக்கிறது"

#: src/compare.py:453
msgid "  Importing recognition libs"
msgstr "அங்கீகார லிப்களை இறக்குமதி செய்கிறது"

#: src/compare.py:454
msgid "Searching for known face"
msgstr "தெரிந்த முகத்தைத் தேடுகிறது"

#: src/compare.py:455
msgid "Total time"
msgstr "மொத்த நேரம்"

#: src/compare.py:457
msgid ""
"\nResolution"
msgstr ""
"\nதீர்மானம்"

#: src/compare.py:459
msgid "  Native: %dx%d"
msgstr "பூர்வீகம்: %dx%d"

#: src/compare.py:462
msgid "  Used: %dx%d"
msgstr "பயன்படுத்தப்பட்டது: %dx%d"

#: src/compare.py:465
msgid ""
"\nFrames searched: %d (%.2f fps)"
msgstr ""
"\nதேடப்பட்ட பிரேம்கள்: %d (%.2f fps)"

#: src/compare.py:466
msgid "Black frames ignored: %d "
msgstr "கருப்பு சட்டங்கள் புறக்கணிக்கப்பட்டது: %d"

#: src/compare.py:467
msgid "Dark frames ignored: %d "
msgstr "டார்க் பிரேம்கள் புறக்கணிக்கப்பட்டது: %d"

#: src/compare.py:468
msgid "Certainty of winning frame: %.3f"
msgstr "வெற்றி பெறும் சட்டத்தின் உறுதி: %.3f"

#: src/compare.py:470
msgid "Winning model: %d (\"%s\")"
msgstr "வென்ற மாதிரி: %d (\"%s\")"

#: src/compare.py:474
msgid "SUCCESSFUL"
msgstr "வெற்றிகரமானது"

#: src/wallet_backend.py:62 src/wallet_backend.py:72
msgid "KWallet"
msgstr "KWallet"

#: src/wallet_backend.py:64
msgid "GNOME Keyring"
msgstr "GNOME Keyring"

#: src/wallet_backend.py:65
msgid "None"
msgstr "None"

#: src/wallet_backend.py:74
msgid "login keyring"
msgstr "உள்நுழைவு கீரிங்"

#: src/wallet_backend.py:75
msgid "login keyring or KWallet"
msgstr "உள்நுழைவு விசை அல்லது KWallet"

#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\ndlib தொகுதியை இறக்குமதி செய்ய முடியவில்லை, இதன் வெளியீட்டைச் சரிபார்"
"க்கவும்"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "முக மாதிரி கோப்புறை எதுவும் இல்லை, ஒன்றை உருவாக்குகிறது"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr ""
"அறிவிப்பு: ஒவ்வொரு கூடுதல் மாடலும் முகம் அடையாளம் காணும் இயந்திரத்தை ச"
"ிறிது குறைக்கிறது"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"ரத்து செய்ய Ctrl+C ஐ அழுத்தவும்\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "பயனருக்கான முக மாதிரியைச் சேர்க்கிறது"

#: src/cli/add.py:88
msgid "Model #"
msgstr "மாதிரி #"

#: src/cli/add.py:92
msgid "Using default label \"%s\" because of -y flag"
msgstr "-y கொடியின் காரணமாக \"%s\" என்ற இயல்புநிலை லேபிளைப் பயன்படுத்துகிறது"

#: src/cli/add.py:95
msgid "Enter a label for this new model [{}]: "
msgstr "இந்த புதிய மாடலுக்கான லேபிளை உள்ளிடவும் [{}]:"

#: src/cli/add.py:103
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "அறிவிப்பு: மாதிரிப் பெயரிலிருந்து \",\" என்ற சட்டவிரோத எழுத்தை அகற்றுதல்"

#: src/cli/add.py:117
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nதயவுசெய்து கேமராவை நேராகப் பாருங்கள்"

#: src/cli/add.py:182
msgid "Camera saw only black frames - is IR emitter working?"
msgstr ""
"கேமரா கருப்பு பிரேம்களை மட்டுமே பார்த்தது - ஐஆர் எமிட்டர் வேலை செய்கிற"
"தா?"

#: src/cli/add.py:187
msgid "No face detected, aborting"
msgstr "முகம் கண்டறியப்படவில்லை, கருக்கலைப்பு"

#: src/cli/add.py:192
msgid "Multiple faces detected, aborting"
msgstr "பல முகங்கள் கண்டறியப்பட்டன, கருக்கலைப்பு"

#: src/cli/add.py:214
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nஸ்கேன் முடிந்தது\nஒரு புதிய மாடல் சேர்க்கப்பட்டது"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr ""
"இதுவரை எந்த மாதிரியும் உருவாக்கப்படவில்லை, அவை இல்லாவிட்டால் அவற்றை அழ"
"ிக்க முடியாது"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{}க்கு மாதிரிகள் இல்லை அல்லது அவை ஏற்கனவே அழிக்கப்பட்டுவிட்டன"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "இது அனைத்து மாடல்களையும் அழிக்கும்"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "[y/N] தொடர விரும்புகிறீர்களா:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\n\"இல்லை\" என விளக்குவது, கருக்கலைப்பு"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nமாதிரிகள் அழிக்கப்பட்டன"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "config.ini ஐ {editor} இல் திறக்கிறது"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "எடிட்டரைத் திறக்க முடியவில்லை: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "பிழை: பொருத்தமான உரை திருத்தியைக் கண்டுபிடிக்க முடியவில்லை."

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr ""
"தயவுசெய்து 'nano' அல்லது 'vi' ஐ நிறுவவும் அல்லது EDITOR சூழல் மாறியை அ"
"மைக்கவும்."

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."
msgstr ""
"நீங்கள் இந்த கட்டளையை sudo உடன் இயக்கினால், உங்கள் எடிட்டர் மாறியைப் ப"
"ாதுகாக்க 'sudo -E ubuntu-hello config' ஐ முயற்சிக்கவும்."

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "0 (இயக்க) அல்லது 1 (முடக்கு) ஐ ஒரு வாதமாகச் சேர்க்கவும்"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr "0 (இயக்கு) அல்லது 1 (முடக்கு) ஐ மட்டும் வாதமாகப் பயன்படுத்தவும்"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "முடக்கு விருப்பம் ஏற்கனவே அமைக்கப்பட்டுள்ளது"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Hello முடக்கப்பட்டுள்ளது"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Hello இயக்கப்பட்டது"

#: src/cli/keyring.py:32 src/cli/keyring.py:157
msgid "Usage: keyring [enable|disable|restore [--all]]"
msgstr "பயன்பாடு: கீரிங் [இயக்கு|முடக்கு|மீட்டமை] [--all]"

#: src/cli/keyring.py:49
msgid "Enter password for user {} to unlock {} ({}): "
msgstr "{} ({})ஐத் திறக்க, பயனரின் கடவுச்சொல்லை உள்ளிடவும் {}:"

#: src/cli/keyring.py:51
msgid "Password cannot be empty"
msgstr "கடவுச்சொல் காலியாக இருக்கக்கூடாது"

#: src/cli/keyring.py:54
msgid "Confirm password: "
msgstr "கடவுச்சொல்லை உறுதிப்படுத்தவும்:"

#: src/cli/keyring.py:56
msgid "Passwords do not match"
msgstr "கடவுச்சொற்கள் பொருந்தவில்லை"

#: src/cli/keyring.py:65
msgid "TPM hardware detected. Auto-installing tpm2-tools..."
msgstr "TPM வன்பொருள் கண்டறியப்பட்டது. தானாக நிறுவுகிறது tpm2-tools..."

#: src/cli/keyring.py:74
msgid "TPM hardware active. Sealing password in TPM..."
msgstr "TPM வன்பொருள் செயலில் உள்ளது. TPM இல் கடவுச்சொல்லை சீல் செய்கிறது..."

#: src/cli/keyring.py:100
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} using TPM ("

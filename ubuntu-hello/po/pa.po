#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "ਅਸਫਲਤਾ, ਸਮਾਂ ਸਮਾਪਤ ਹੋ ਗਿਆ"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "ਚਿਹਰਾ ਪਛਾਣ ਚਿੱਤਰ ਬਹੁਤ ਗੂੜ੍ਹਾ ਹੈ"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "ਅਗਿਆਤ ਤਰੁੱਟੀ:"

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "%s ਵਜੋਂ ਪਛਾਣਿਆ ਚਿਹਰਾ"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr ""
"ਐਂਟਰ ਦਬਾਓ ਭੇਜਣ ਲਈ ਨਾਕਾਫ਼ੀ ਅਨੁਮਤੀਆਂ, ਇਸਦੀ ਬਜਾਏ ਉਪਭੋਗਤਾ ਨੂੰ ਦਬਾਉਣ ਦੀ ਉਡੀ"
"ਕ ਕੀਤੀ ਜਾ ਰਹੀ ਹੈ"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr ""
"ਐਂਟਰ ਦਬਾਓ ਭੇਜਣ ਵਿੱਚ ਅਸਫਲ, ਇਸਦੀ ਬਜਾਏ ਉਪਭੋਗਤਾ ਇਸਨੂੰ ਦਬਾਉਣ ਦੀ ਉਡੀਕ ਕਰ ਰਿਹ"
"ਾ ਹੈ"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "ਚਿਹਰੇ ਦੀ ਪ੍ਰਮਾਣਿਕਤਾ ਦੀ ਕੋਸ਼ਿਸ਼ ਕੀਤੀ ਜਾ ਰਹੀ ਹੈ"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "ਉਪਭੋਗਤਾ ਦਾ ਪਤਾ ਨਹੀਂ ਲਗਾਇਆ ਜਾ ਸਕਿਆ, ਕਿਰਪਾ ਕਰਕੇ --user ਫਲੈਗ ਦੀ ਵਰਤੋਂ ਕਰੋ"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello ਚਿਹਰੇ ਦੀ ਪ੍ਰਮਾਣਿਕਤਾ ਲਈ ਕਮਾਂਡ ਲਾਈਨ ਇੰਟਰਫੇਸ।"

#: src/cli.py:35
msgid "command"
msgstr "ਹੁਕਮ"

#: src/cli.py:35
msgid "arguments"
msgstr "ਦਲੀਲਾਂ"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"ਸਹਾਇਤਾ ਲਈ ਕਿਰਪਾ ਕਰਕੇ ਵੇਖੋ\nhttps://github.com/ventura8/ubuntu-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"ਚਲਾਉਣ ਲਈ ਕਮਾਂਡ ਵਿਕਲਪ, ਇਹਨਾਂ ਵਿੱਚੋਂ ਇੱਕ ਹੋ ਸਕਦਾ ਹੈ: ਐਡ, ਕਲੀਅਰ, ਸੰਰਚਨਾ, "
"ਅਯੋਗ, ਕੀਰਿੰਗ, ਸੂਚੀ, ਹਟਾਓ, ਸਨੈਪਸ਼ਾਟ, ਸੈੱਟ, ਟੈਸਟ ਜਾਂ ਸੰਸਕਰਣ।"

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "ਐਡ, ਅਸਮਰੱਥ, ਹਟਾਉਣ ਅਤੇ ਕਮਾਂਡਾਂ ਸੈੱਟ ਕਰਨ ਲਈ ਵਿਕਲਪਿਕ ਆਰਗੂਮੈਂਟਸ।"

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "ਵਰਤਣ ਲਈ ਉਪਭੋਗਤਾ ਖਾਤਾ ਸੈੱਟ ਕਰੋ।"

#: src/cli.py:60
msgid "Skip all questions."
msgstr "ਸਾਰੇ ਸਵਾਲ ਛੱਡੋ।"

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "ਪ੍ਰਿੰਟ ਮਸ਼ੀਨ-ਅਨੁਕੂਲ ਆਉਟਪੁੱਟ."

#: src/cli.py:74
msgid "Show this help message and exit."
msgstr "ਇਹ ਮਦਦ ਸੁਨੇਹਾ ਦਿਖਾਓ ਅਤੇ ਬਾਹਰ ਨਿਕਲੋ।"

#: src/cli.py:78
msgid "current active user: "
msgstr "ਮੌਜੂਦਾ ਸਰਗਰਮ ਉਪਭੋਗਤਾ:"

#: src/cli.py:88
msgid "Invalid username format"
msgstr "ਅਵੈਧ ਉਪਭੋਗਤਾ ਨਾਮ ਫਾਰਮੈਟ"

#: src/cli.py:98
msgid ""
"Please run this command as root:\n"
msgstr ""
"ਕਿਰਪਾ ਕਰਕੇ ਇਸ ਕਮਾਂਡ ਨੂੰ ਰੂਟ ਵਜੋਂ ਚਲਾਓ:\n"

#: src/cli.py:104
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr ""
"ubuntu-hello ਕਮਾਂਡਾਂ ਨੂੰ ਰੂਟ ਵਜੋਂ ਨਹੀਂ ਚਲਾਇਆ ਜਾ ਸਕਦਾ, ਕਿਰਪਾ ਕਰਕੇ ਇਸ ਕਮ"
"ਾਂਡ ਨੂੰ --user ਫਲੈਗ ਨਾਲ ਚਲਾਓ"

#: src/compare.py:128 src/cli/add.py:32
msgid "Data files have not been downloaded, please run the following commands:"
msgstr ""
"ਡਾਟਾ ਫਾਈਲਾਂ ਡਾਊਨਲੋਡ ਨਹੀਂ ਕੀਤੀਆਂ ਗਈਆਂ ਹਨ, ਕਿਰਪਾ ਕਰਕੇ ਹੇਠਾਂ ਦਿੱਤੀਆਂ ਕਮਾਂ"
"ਡਾਂ ਚਲਾਓ:"

#: src/compare.py:154
msgid " LOGIN"
msgstr "ਲਾਗਿਨ"


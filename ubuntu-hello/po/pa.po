#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\ndlib ਮੋਡੀਊਲ ਨੂੰ ਆਯਾਤ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ਹੈ, ਦੀ ਆਉਟਪੁੱਟ ਦੀ ਜਾਂਚ ਕਰੋ"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "ਕੋਈ ਚਿਹਰਾ ਮਾਡਲ ਫੋਲਡਰ ਨਹੀਂ ਮਿਲਿਆ, ਇੱਕ ਬਣਾ ਰਿਹਾ ਹੈ"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr ""
"ਨੋਟਿਸ: ਹਰੇਕ ਵਾਧੂ ਮਾਡਲ ਚਿਹਰੇ ਦੀ ਪਛਾਣ ਕਰਨ ਵਾਲੇ ਇੰਜਣ ਨੂੰ ਥੋੜ੍ਹਾ ਹੌਲੀ ਕਰ ਦ"
"ਿੰਦਾ ਹੈ"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"ਰੱਦ ਕਰਨ ਲਈ Ctrl+C ਦਬਾਓ\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "ਉਪਭੋਗਤਾ ਲਈ ਚਿਹਰੇ ਦਾ ਮਾਡਲ ਸ਼ਾਮਲ ਕਰਨਾ"

#: src/cli/add.py:88
msgid "Model #"
msgstr "ਮਾਡਲ #"

#: src/cli/add.py:92
msgid "Using default label \"%s\" because of -y flag"
msgstr "-y ਫਲੈਗ ਦੇ ਕਾਰਨ ਡਿਫੌਲਟ ਲੇਬਲ \"%s\" ਦੀ ਵਰਤੋਂ ਕਰਨਾ"

#: src/cli/add.py:95
msgid "Enter a label for this new model [{}]: "
msgstr "ਇਸ ਨਵੇਂ ਮਾਡਲ [{}] ਲਈ ਇੱਕ ਲੇਬਲ ਦਾਖਲ ਕਰੋ:"

#: src/cli/add.py:103
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "ਨੋਟਿਸ: ਮਾਡਲ ਨਾਮ ਤੋਂ ਗੈਰ-ਕਾਨੂੰਨੀ ਅੱਖਰ \",\" ਹਟਾਉਣਾ"

#: src/cli/add.py:117
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nਕਿਰਪਾ ਕਰਕੇ ਸਿੱਧੇ ਕੈਮਰੇ ਵਿੱਚ ਦੇਖੋ"

#: src/cli/add.py:182
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "ਕੈਮਰੇ ਨੇ ਸਿਰਫ ਕਾਲੇ ਫਰੇਮਾਂ ਨੂੰ ਦੇਖਿਆ - ਕੀ IR ਐਮੀਟਰ ਕੰਮ ਕਰ ਰਿਹਾ ਹੈ?"

#: src/cli/add.py:187
msgid "No face detected, aborting"
msgstr "ਕੋਈ ਚਿਹਰਾ ਨਹੀਂ ਮਿਲਿਆ, ਅਧੂਰਾ ਛੱਡਿਆ ਜਾ ਰਿਹਾ ਹੈ"

#: src/cli/add.py:192
msgid "Multiple faces detected, aborting"
msgstr "ਕਈ ਚਿਹਰਿਆਂ ਦਾ ਪਤਾ ਲਗਾਇਆ ਗਿਆ, ਅਧੂਰਾ ਛੱਡਿਆ ਜਾ ਰਿਹਾ ਹੈ"

#: src/cli/add.py:214
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nਸਕੈਨ ਪੂਰਾ ਹੋਇਆ\nਵਿੱਚ ਇੱਕ ਨਵਾਂ ਮਾਡਲ ਸ਼ਾਮਲ ਕੀਤਾ ਗਿਆ"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr ""
"ਅਜੇ ਤੱਕ ਕੋਈ ਮਾਡਲ ਨਹੀਂ ਬਣਾਏ ਗਏ, ਜੇਕਰ ਉਹ ਮੌਜੂਦ ਨਹੀਂ ਹਨ ਤਾਂ ਉਹਨਾਂ ਨੂੰ ਸਾਫ"
"਼ ਨਹੀਂ ਕਰ ਸਕਦੇ"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} ਦਾ ਕੋਈ ਮਾਡਲ ਨਹੀਂ ਹੈ ਜਾਂ ਉਹ ਪਹਿਲਾਂ ਹੀ ਕਲੀਅਰ ਕੀਤੇ ਜਾ ਚੁੱਕੇ ਹਨ"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "ਇਹ ਲਈ ਸਾਰੇ ਮਾਡਲਾਂ ਨੂੰ ਸਾਫ਼ ਕਰ ਦੇਵੇਗਾ"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "ਕੀ ਤੁਸੀਂ [y/N] ਜਾਰੀ ਰੱਖਣਾ ਚਾਹੁੰਦੇ ਹੋ:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\n\"ਨਹੀਂ\" ਵਜੋਂ ਵਿਆਖਿਆ ਕਰਨਾ, ਅਧੂਰਾ ਛੱਡਣਾ"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nਮਾਡਲ ਕਲੀਅਰ ਕੀਤੇ ਗਏ"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "config.ini ਨੂੰ {editor} ਵਿੱਚ ਖੋਲ੍ਹਿਆ ਜਾ ਰਿਹਾ ਹੈ"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "ਸੰਪਾਦਕ ਖੋਲ੍ਹਣ ਵਿੱਚ ਅਸਫਲ: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "ਗਲਤੀ: ਢੁਕਵਾਂ ਟੈਕਸਟ ਐਡੀਟਰ ਨਹੀਂ ਲੱਭ ਸਕਿਆ।"

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr ""
"ਕਿਰਪਾ ਕਰਕੇ 'ਨੈਨੋ' ਜਾਂ 'vi' ਇੰਸਟਾਲ ਕਰੋ, ਜਾਂ EDITOR ਵਾਤਾਵਰਣ ਵੇਰੀਏਬਲ ਸੈੱਟ"
" ਕਰੋ।"

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."
msgstr ""
"ਜੇਕਰ ਤੁਸੀਂ ਇਸ ਕਮਾਂਡ ਨੂੰ sudo ਨਾਲ ਚਲਾ ਰਹੇ ਹੋ, ਤਾਂ ਆਪਣੇ EDITOR ਵੇਰੀਏਬਲ ਨ"
"ੂੰ ਸੁਰੱਖਿਅਤ ਰੱਖਣ ਲਈ 'sudo -E ubuntu-hello config' ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "ਕਿਰਪਾ ਕਰਕੇ ਇੱਕ ਆਰਗੂਮੈਂਟ ਵਜੋਂ 0 (ਯੋਗ) ਜਾਂ 1 (ਅਯੋਗ) ਸ਼ਾਮਲ ਕਰੋ"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr "ਕਿਰਪਾ ਕਰਕੇ ਇੱਕ ਦਲੀਲ ਦੇ ਤੌਰ 'ਤੇ ਸਿਰਫ਼ 0 (ਯੋਗ) ਜਾਂ 1 (ਅਯੋਗ) ਦੀ ਵਰਤੋਂ ਕਰੋ"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "ਅਯੋਗ ਵਿਕਲਪ ਪਹਿਲਾਂ ਹੀ ਸੈੱਟ ਕੀਤਾ ਗਿਆ ਹੈ"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Hello ਨੂੰ ਅਯੋਗ ਕਰ ਦਿੱਤਾ ਗਿਆ ਹੈ"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Hello ਨੂੰ ਸਮਰੱਥ ਬਣਾਇਆ ਗਿਆ ਹੈ"

#: src/cli/keyring.py:32 src/cli/keyring.py:157
msgid "Usage: keyring [enable|disable|restore [--all]]"
msgstr "ਵਰਤੋਂ: ਕੀਰਿੰਗ [ਯੋਗ|ਅਯੋਗ|ਬਹਾਲ] [--all]"


#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "বিফলতা, সময়সীমা পোৱা গৈছে"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "মুখ ধৰা পেলোৱা ছবিখন অতি আন্ধাৰ"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "অজ্ঞাত ভুল:"

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "%s হিচাপে চিনাক্ত কৰা মুখখন।"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr ""
"Enter টিপক পঠিয়াবলৈ অপৰ্যাপ্ত অনুমতি, ব্যৱহাৰকাৰীয়ে ইয়াৰ পৰিবৰ্তে ই"
"য়াক টিপিবলৈ অপেক্ষা কৰি"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr ""
"Enter টিপক প্ৰেৰণ কৰাত ব্যৰ্থ, ব্যৱহাৰকাৰীয়ে ইয়াৰ পৰিবৰ্তে ইয়াক টিপ"
"িবলৈ অপেক্ষা কৰি"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "মুখৰ প্ৰমাণীকৰণৰ প্ৰয়াস কৰা"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "ব্যৱহাৰকাৰী নিৰ্ধাৰণ কৰিব পৰা নগ'ল, অনুগ্ৰহ কৰি --user ফ্লেগ ব্যৱহাৰ কৰক"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello মুখ প্ৰমাণীকৰণৰ বাবে আদেশ শাৰী আন্তঃপৃষ্ঠ।"

#: src/cli.py:35
msgid "command"
msgstr "আদেশ"

#: src/cli.py:35
msgid "arguments"
msgstr "যুক্তিসমূহ"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"সমৰ্থনৰ বাবে অনুগ্ৰহ কৰি চাওক\n⟦উ০০০০⟧"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"এক্সিকিউট কৰিবলে আদেশ বিকল্প, নিম্নলিখিতৰ এটা হব পাৰে: যোগ কৰক, পৰিষ্ক"
"াৰ কৰক, বিন্যাস কৰক, নিষ্ক্ৰিয় কৰক, কিৰিং, তালিকাভুক্ত কৰক, আঁতৰাওক, "
"স্নেপশ্বট কৰক, সংহতি কৰক, পৰীক্ষা কৰক বা সংস্কৰণ ।"

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "যোগ, নিষ্ক্ৰিয়, আঁতৰোৱা আৰু নিৰ্ধাৰণ আদেশৰ বাবে বৈকল্পিক যুক্তি।"

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "ব্যৱহাৰ কৰিবলৈ ব্যৱহাৰকাৰী একাউণ্ট নিৰ্ধাৰণ কৰক।"

#: src/cli.py:60
msgid "Skip all questions."
msgstr "সকলো প্ৰশ্ন এৰি দিয়ক।"

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "মেচিন-বন্ধুত্বপূৰ্ণ আউটপুট প্ৰিন্ট কৰক।"

#: src/cli.py:72
msgid "With keyring restore: restore sealed login passwords for all users."
msgstr "With keyring restore: restore sealed login passwords for all users."

#: src/cli.py:80
msgid "Show this help message and exit."
msgstr "এই সহায় বাৰ্তা দেখুৱাওক আৰু প্ৰস্থান কৰক।"

#: src/cli.py:84
msgid "current active user: "
msgstr "বৰ্তমান সক্ৰিয় ব্যৱহাৰকাৰী:"

#: src/cli.py:94
msgid "Invalid username format"
msgstr "অবৈধ ব্যৱহাৰকাৰীনামৰ বিন্যাস"

#: src/cli.py:104
msgid ""
"Please run this command as root:\n"
msgstr ""
"অনুগ্ৰহ কৰি এই আদেশ root হিচাপে চলাওক:\n"

#: src/cli.py:110
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr ""
"ubuntu-hello আদেশসমূহ root হিচাপে চলাব নোৱাৰি, অনুগ্ৰহ কৰি এই আদেশ --u"
"ser ফ্লেগৰ সৈতে চলাওক"

#: src/compare.py:128 src/cli/add.py:32
msgid "Data files have not been downloaded, please run the following commands:"
msgstr ""
"ডাটা ফাইলসমূহ ডাউনল'ড কৰা হোৱা নাই, অনুগ্ৰহ কৰি নিম্নলিখিত আদেশসমূহ চল"
"াওক:"

#: src/compare.py:154
msgid " LOGIN"
msgstr "LOGIN কৰক"

#: src/compare.py:155 src/cli/snap.py:44
msgid "Date: "
msgstr "তাৰিখ:"

#: src/compare.py:156
msgid "Scan time: "
msgstr "স্কেন সময়:"

#: src/compare.py:157

msgid ""
"\n"
"Interpreting as a \"NO\", aborting"
msgstr ""
"\n"
"Тарҷума ҳамчун \"НЕ\", қатъ кардан"

#: src/cli/clear.py:37
msgid ""
"\n"
"Models cleared"
msgstr ""
"\n"
"Моделҳо тоза карда шуданд"

#: src/cli/config.py:32
#, python-brace-format
msgid "Opening config.ini in {editor}"
msgstr "Кушодани config.ini дар {editor}"

#: src/cli/config.py:38
#, python-brace-format
msgid "Failed to open editor: {error}"
msgstr "Муҳаррир кушода нашуд: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "Хатогӣ: Муҳаррири матнии мувофиқ пайдо карда нашуд."

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr ""
"Лутфан 'nano' ё 'vi' -ро насб кунед ё тағирёбандаи муҳити EDITOR-ро насб "
"кунед."

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello config' "
"to preserve your EDITOR variable."
msgstr ""
"Агар шумо ин фармонро бо sudo иҷро карда истода бошед, 'sudo -E ubuntu-hello "
"config' -ро санҷед, то тағирёбандаи EDITOR-и худро нигоҳ доред."

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "Лутфан ҳамчун аргумент 0 (фаъол) ё 1 (хомӯш кардан) илова кунед"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr ""
"Лутфан танҳо 0 (фаъол) ё 1 (хомӯш кардан) -ро ҳамчун далел истифода баред"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "Варианти ғайрифаъол аллакай ба танзим гузошта шудааст"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Hello ғайрифаъол карда шуд"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Hello фаъол карда шуд"

#: src/cli/keyring.py:36 src/cli/keyring.py:156
msgid "Usage:"
msgstr "Истифода:"

#: src/cli/keyring.py:53
msgid "Enter password for user {} to unlock {} ({}): "
msgstr "Барои кушодани {} ({}) паролро барои корбар {} ворид кунед:"

#: src/cli/keyring.py:55
msgid "Password cannot be empty"
msgstr "Рамз холӣ буда наметавонад"

#: src/cli/keyring.py:58
msgid "Confirm password: "
msgstr "Калидвожаро Тасдиқ Кунед:"

#: src/cli/keyring.py:60
msgid "Passwords do not match"
msgstr "Паролҳо мувофиқат намекунанд"

#: src/cli/keyring.py:69
msgid "TPM hardware detected. Auto-installing tpm2-tools..."
msgstr "Таҷҳизоти TPM ошкор шуд. Насбкунии худкор tpm2-tools..."

#: src/cli/keyring.py:78
msgid "TPM hardware active. Sealing password in TPM..."
msgstr "Сахтафзори TPM фаъол. Мӯҳр кардани парол дар TPM..."

#: src/cli/keyring.py:104
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} using TPM "
"(wallet: {})."
msgstr ""
"Кушодани калид/KWallet барои корбар {} бо истифода аз TPM (ҳамён: {}) "
"бомуваффақият фаъол карда шуд."

#: src/cli/keyring.py:106
msgid "Failed to seal password to TPM: {}"
msgstr "Паролро ба TPM мӯҳр зада натавонист: {}"

#: src/cli/keyring.py:110
msgid "No TPM active. Using software-based credential caching..."
msgstr "TPM фаъол нест. Истифодаи кэшкунии эътимоднома дар асоси нармафзор..."

#: src/cli/keyring.py:126
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} (Software "
"Caching, wallet: {})."
msgstr ""
"Кушодани калид/KWallet барои корбар {} бомуваффақият фаъол карда шуд "
"(Кэшкунии нармафзор, ҳамён: {})."

#: src/cli/keyring.py:128
msgid "Failed to enable keyring unlocking: {}"
msgstr "Кушодани қулфи калидҳоро фаъол карда натавонист: {}"

#: src/cli/keyring.py:139
msgid "Failed to disable keyring unlocking: {}"
msgstr "Хомӯш кардани қулфи калидҳо муяссар нашуд: {}"

#: src/cli/keyring.py:142
msgid "Keyring/KWallet unlocking disabled for user {}."
msgstr "Кушодани калид/KWallet барои корбар {} ғайрифаъол аст."

#: src/cli/keyring.py:144
msgid "Keyring/KWallet unlocking was not enabled for user {}."
msgstr "Кушодани калид/KWallet барои корбар {} фаъол карда нашудааст."

#: src/cli/keyring.py:161
msgid "No sealed login passwords found; nothing to restore."
msgstr "Рамзҳои вуруди мӯҳршуда ёфт нашуданд; барқарор кардан чизе нест."

#: src/cli/keyring.py:163
msgid "Restored login wallet password for {} user(s)."
msgstr "Рамзи ҳамёни вуруд барои {} корбар барқарор шуд."

#: src/cli/keyring.py:165
msgid "Could not restore login wallet password for {} user(s)."
msgstr "Рамзи ҳамёни вурудро барои {} корбар барқарор карда натавонистем."

#: src/cli/keyring.py:166
msgid ""
"If prompts persist, set the login keyring or KWallet password in Seahorse / "
"System Settings."
msgstr ""
"Агар дархостҳо идома ёбанд, рамзи ҳалқаи калидҳои вуруд ё KWallet-ро дар "

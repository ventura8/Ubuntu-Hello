#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr ""
"Корбарро муайян карда натавонистам, лутфан парчами --user -ро истифода баред"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Интерфейси сатри фармон барои Ubuntu Hello аутентификатсияи чеҳра."

#: src/cli.py:35
msgid "command"
msgstr "фармон"

#: src/cli.py:35
msgid "arguments"
msgstr "далелҳо"

#: src/cli.py:36
msgid ""
"For support please visit\n"
"https://github.com/ventura8/ubuntu-hello"
msgstr ""
"Барои дастгирӣ лутфан боздид кунед\n"
"https://github.com/ventura8/ubuntu-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear, "
"config, disable, keyring, list, remove, snapshot, set, test or version."
msgstr ""
"Имконоти фармон барои иҷро метавонад яке аз инҳо бошад: add, clear, config, "
"disable, keyring, list, remove, snapshot, set, test ё version."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "Далелҳои ихтиёрӣ барои фармонҳои add, disable, remove ва set."

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "Ҳисоби корбарро барои истифода таъин кунед."

#: src/cli.py:60
msgid "Skip all questions."
msgstr "Ҳама саволҳоро гузаред."

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "Баромади ба мошин мувофиқ чоп."

#: src/cli.py:72
msgid "With keyring restore: restore sealed login passwords for all users."
msgstr ""
"Бо «keyring restore»: барқарор кардани паролҳои мӯҳршудаи воридшавии ҳамаи "
"корбарон."

#: src/cli.py:80
msgid "Show this help message and exit."
msgstr "Ин паёми ёриро нишон диҳед ва бароед."

#: src/cli.py:84
msgid "current active user: "
msgstr "корбари фаъоли ҷорӣ:"

#: src/cli.py:94
msgid "Invalid username format"
msgstr "Формати номи корбар нодуруст"

#: src/cli.py:104
msgid "Please run this command as root:\n"
msgstr "Лутфан ин фармонро ҳамчун root иҷро кунед:\n"

#: src/cli.py:110
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with the --"
"user flag"
msgstr ""
"Фармонҳои ubuntu-hello-ро ҳамчун root иҷро кардан мумкин нест; лутфан ин "
"фармонро бо байрақи --user иҷро кунед"


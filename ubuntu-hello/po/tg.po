#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "Нокомӣ, ба охир расидани вақт"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "Тасвири муайянкунии чеҳра хеле торик"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "Хатои номаълум:"

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "Чеҳраи муайяншуда ҳамчун %s"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr ""
"Иҷозатҳои нокифоя барои ирсоли Enter-ро пахш кунед, интизори он ки кор"
"бар ба ҷои он пахш кунад"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr ""
"Фиристодани Enter -ро пахш карда натавонист, мунтазири он аст, ки корб"
"ар онро пахш кунад"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "Кӯшиши тасдиқи чеҳра"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr ""
"Корбарро муайян карда натавонистам, лутфан парчами --user -ро истифода"
" баред"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Интерфейси сатри фармон барои Ubuntu Hello аутентификатсияи чеҳра."

#: src/cli.py:35
msgid "command"
msgstr "фармон"

#: src/cli.py:35
msgid "arguments"
msgstr "далелҳо"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"Барои дастгирӣ лутфан боздид кунед\nhttps://github.com/ventura8/ubuntu"
"-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"Опсияи фармон барои иҷро метавонад яке аз инҳо бошад: илова кардан, то"
"за кардан, танзим кардан, ғайрифаъол кардан, калид кардан, рӯйхат кард"
"ан, хориҷ кардан, аксбардорӣ, танзим, санҷиш ё версия."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr ""
"Далелҳои ихтиёрӣ барои илова кардан, хомӯш кардан, хориҷ кардан ва таъ"
"ин кардани фармонҳо."

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "Ҳисоби корбарро барои истифода таъин кунед."

#: src/cli.py:60
msgid "Skip all questions."
msgstr "Ҳама саволҳоро гузаред."

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "Баромади ба мошин мувофиқ чоп."

#: src/cli.py:72
msgid "With keyring restore: restore sealed login passwords for all users."
msgstr "With keyring restore: restore sealed login passwords for all users."

#: src/cli.py:80
msgid "Show this help message and exit."
msgstr "Ин паёми ёриро нишон диҳед ва бароед."

#: src/cli.py:84
msgid "current active user: "
msgstr "корбари фаъоли ҷорӣ:"

#: src/cli.py:94
msgid "Invalid username format"
msgstr "Формати номи корбар нодуруст"

#: src/cli.py:104
msgid ""
"Please run this command as root:\n"
msgstr ""
"Лутфан ин фармонро ҳамчун реша иҷро кунед:\n"

#: src/cli.py:110
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr ""
"Фармонҳои ubuntu-hello ҳамчун реша иҷро карда намешаванд, лутфан ин фа"
"рмонро бо парчами --user иҷро кунед"

#: src/compare.py:128 src/cli/add.py:32

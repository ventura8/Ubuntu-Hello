msgid "Known face models for {}:"
msgstr "Моделҳои маълуми чеҳра барои {}:"

#: src/cli/list.py:36
msgid "ID  Date                 Label[0m"
msgstr "Нишони санаи ID [0m"

#: src/cli/remove.py:16
msgid "Please add the ID of the model you want to remove as an argument"
msgstr "Лутфан ID-и моделеро, ки мехоҳед хориҷ кунед, ҳамчун далел илова кунед"

#: src/cli/remove.py:17 src/cli/set.py:18
msgid "For example:"
msgstr "Барои намуна:"

#: src/cli/remove.py:19
msgid "You can find the IDs by running:"
msgstr "Шумо метавонед ID-ҳоро тавассути иҷро кардани:"

#: src/cli/remove.py:52
msgid "This will remove the model called \"{label}\" for {user}"
msgstr "Ин моделеро бо номи \"{label}\" барои {user} хориҷ мекунад"

#: src/cli/remove.py:69
msgid "No model with ID {id} exists for {user}"
msgstr "Ягон модели дорои ID {id} барои {user} вуҷуд надорад"

#: src/cli/remove.py:75
msgid "Removed last model, ubuntu-hello disabled for user"
msgstr ""
"Модели охирин хориҷ карда шуд, ubuntu-hello барои корбар ғайрифаъол ка"
"рда шудааст"

#: src/cli/remove.py:89
msgid "Removed model {}"
msgstr "Модели хориҷшуда {}"

#: src/cli/set.py:17
msgid "Please add a setting you would like to change and the value to set it to"
msgstr "Лутфан танзимотеро, ки мехоҳед тағир диҳед ва арзиши онро илова кунед"

#: src/cli/set.py:37
msgid "Could not find a \"{}\" config option to set"
msgstr "Параметри конфигуратсияи \"{}\" барои гузоштан пайдо карда нашуд"

#: src/cli/set.py:44
msgid "Config option updated"
msgstr "Опсияи конфигуратсия нав карда шуд"

#: src/cli/snap.py:43
msgid "GENERATED SNAPSHOT"
msgstr "НАВОРАИ ТАҲСИЛ ШУДА"

#: src/cli/snap.py:45
msgid "Dark threshold config: "
msgstr "Танзимоти ҳадди торик:"

#: src/cli/snap.py:46
msgid "Certainty config: "
msgstr "Танзимоти дақиқ:"

#: src/cli/snap.py:50
msgid "Generated snapshot saved as"
msgstr "Сурати тавлидшуда ҳамчун захира карда шуд"

#: src/cli/test.py:23
msgid ""
"Ubuntu Hello has been configured to use a recorder which doesn't suppo"
"rt the test command yet, aborting"
msgstr ""
"Ubuntu Hello барои истифодаи сабткунанда танзим шудааст, ки то ҳол фар"
"мони санҷишро дастгирӣ намекунад ва қатъ мешавад"

#: src/cli/test.py:34
msgid ""
"\nOpening a window with a test feed\n\nPress ctrl+C in this terminal t"

msgstr ""
"Ҳама чаҳорчӯба хеле торик буданд, лутфан dark_threshold дар танзимотро"
" санҷед"

#: src/compare.py:355 src/cli/add.py:189
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "Торикии миёна: {avg}, Ҳадди: {threshold}"

#: src/compare.py:456
msgid "Time spent"
msgstr "Вақти сарфшуда"

#: src/compare.py:457
msgid "Starting up"
msgstr "Оғоз кардан"

#: src/compare.py:458
msgid "  Open cam + load libs: %dms"
msgstr "Камераро кушоед + либерҳои боркунӣ: %dms"

#: src/compare.py:459
msgid "  Opening the camera"
msgstr "Кушодани камера"

#: src/compare.py:460
msgid "  Importing recognition libs"
msgstr "Воридоти libs эътироф"

#: src/compare.py:461
msgid "Searching for known face"
msgstr "Ҷустуҷӯи чеҳраи маълум"

#: src/compare.py:462
msgid "Total time"
msgstr "Вақти умумӣ"

#: src/compare.py:464
msgid ""
"\nResolution"
msgstr ""
"\nРезолюция"

#: src/compare.py:466
msgid "  Native: %dx%d"
msgstr "Забони аслӣ: %dx%d"

#: src/compare.py:469
msgid "  Used: %dx%d"
msgstr "Истифода бурда мешавад: %dx%d"

#: src/compare.py:472
msgid ""
"\nFrames searched: %d (%.2f fps)"
msgstr ""
"\nЧорчубаҳои ҷустуҷӯшуда: %d (%.2f fps)"

#: src/compare.py:473
msgid "Black frames ignored: %d "
msgstr "Чорчубаҳои сиёҳ нодида гирифта шуданд: %d"

#: src/compare.py:474
msgid "Dark frames ignored: %d "
msgstr "Чорчубаҳои торик нодида гирифта шуданд: %d"

#: src/compare.py:475
msgid "Certainty of winning frame: %.3f"
msgstr "Аниқии чаҳорчӯбаи ғолиб: %.3f"

#: src/compare.py:477
msgid "Winning model: %d (\"%s\")"
msgstr "Модели бурднок: %d (\"%s\")"


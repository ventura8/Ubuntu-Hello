#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "विफलता, समय समाप्त हो गया"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "चेहरे की पहचान करने वाली छवि बहुत गहरी है"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "अज्ञात त्रुटि:"

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "चेहरे की पहचान %s के रूप में की गई"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr ""
"एंटर प्रेस भेजने के लिए अपर्याप्त अनुमतियाँ, इसके बजाय उपयोगकर्ता द्वा"
"रा इसे दबाने की प्रतीक्षा की जा रही है"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr ""
"एंटर प्रेस भेजने में विफल, इसके बजाय उपयोगकर्ता द्वारा इसे दबाने की प्"
"रतीक्षा की जा रही है"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "चेहरे के प्रमाणीकरण का प्रयास किया जा रहा है"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr ""
"उपयोगकर्ता निर्धारित नहीं किया जा सका, कृपया --उपयोगकर्ता ध्वज का उपयो"
"ग करें"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello चेहरा प्रमाणीकरण के लिए कमांड लाइन इंटरफ़ेस।"

#: src/cli.py:35
msgid "command"
msgstr "आज्ञा"

#: src/cli.py:35
msgid "arguments"
msgstr "बहस"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"समर्थन के लिए कृपया जाएँ\nhttps://github.com/ventura8/ubuntu-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"निष्पादित करने के लिए कमांड विकल्प, निम्न में से एक हो सकता है: जोड़ें"
", साफ़ करें, कॉन्फ़िगर करें, अक्षम करें, कीरिंग, सूची, निकालें, स्नैपश"
"ॉट, सेट, परीक्षण या संस्करण।"

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "जोड़ने, अक्षम करने, हटाने और सेट करने के आदेशों के लिए वैकल्पिक तर्क।"

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "उपयोग करने के लिए उपयोगकर्ता खाता सेट करें."

#: src/cli.py:60
msgid "Skip all questions."
msgstr "सभी प्रश्न छोड़ें."

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "प्रिंट मशीन-अनुकूल आउटपुट।"

#: src/cli.py:74
msgid "Show this help message and exit."
msgstr "यह सहायता संदेश दिखाएँ और बाहर निकलें।"

#: src/cli.py:78
msgid "current active user: "
msgstr "वर्तमान सक्रिय उपयोगकर्ता:"

#: src/cli.py:88
msgid "Invalid username format"
msgstr "अमान्य उपयोक्तानाम प्रारूप"

#: src/cli.py:98
msgid ""
"Please run this command as root:\n"
msgstr ""
"कृपया इस कमांड को रूट के रूप में चलाएँ:\n"

#: src/cli.py:104
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr ""
"Ubuntu-hello कमांड को रूट के रूप में नहीं चला सकते, कृपया इस कमांड को "
"--user फ़्लैग के साथ चलाएँ"

#: src/compare.py:128 src/cli/add.py:32
msgid "Data files have not been downloaded, please run the following commands:"
msgstr "डेटा फ़ाइलें डाउनलोड नहीं की गई हैं, कृपया निम्नलिखित आदेश चलाएँ:"

#: src/compare.py:154
msgid " LOGIN"
msgstr "लॉग इन करें"

#: src/compare.py:155 src/cli/snap.py:44
msgid "Date: "
msgstr "तारीख:"

#: src/compare.py:156
msgid "Scan time: "
msgstr "स्कैन समय:"

#: src/compare.py:157
msgid "Frames: "
msgstr "फ़्रेम:"

#: src/compare.py:158
msgid "Hostname: "
msgstr "होस्टनाम:"

#: src/compare.py:159
msgid "Best certainty value: "
msgstr "सर्वोत्तम निश्चितता मूल्य:"

#: src/compare.py:259
msgid "Starting up..."
msgstr "शुरू..."

#: src/compare.py:312
msgid "Identifying you..."
msgstr "तुम्हें पहचान रहा हूँ..."

#: src/compare.py:344
msgid "FAILED"
msgstr "असफल"

#: src/compare.py:347 src/cli/add.py:184
msgid "All frames were too dark, please check dark_threshold in config"
msgstr ""
"सभी फ़्रेम बहुत गहरे रंग के थे, कृपया कॉन्फिग में डार्क_थ्रेसहोल्ड जां"
"चें"

#: src/compare.py:348 src/cli/add.py:185
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "औसत अंधेरा: {avg}, दहलीज: {threshold}"

#: src/compare.py:449
msgid "Time spent"
msgstr "समय बिताया"

#: src/compare.py:450
msgid "Starting up"
msgstr "शुरू"

#: src/compare.py:451
msgid "  Open cam + load libs: %dms"
msgstr "ओपन कैम + लोड लिब: %dms"

#: src/compare.py:452
msgid "  Opening the camera"
msgstr "कैमरा खोलना"

#: src/compare.py:453
msgid "  Importing recognition libs"
msgstr "मान्यता libs आयात करना"

#: src/compare.py:454
msgid "Searching for known face"
msgstr "जाने-पहचाने चेहरे की तलाश"

#: src/compare.py:455
msgid "Total time"
msgstr "कुल समय"

#: src/compare.py:457
msgid ""
"\nResolution"
msgstr ""
"\nसंकल्प"

#: src/compare.py:459
msgid "  Native: %dx%d"
msgstr "मूल निवासी: %dx%d"

#: src/compare.py:462
msgid "  Used: %dx%d"
msgstr "प्रयुक्त: %dx%d"

#: src/compare.py:465
msgid ""
"\nFrames searched: %d (%.2f fps)"
msgstr ""
"\nफ़्रेम खोजे गए: %d (%.2f एफपीएस)"

#: src/compare.py:466
msgid "Black frames ignored: %d "
msgstr "काले फ़्रेमों पर ध्यान नहीं दिया गया: %d"

#: src/compare.py:467
msgid "Dark frames ignored: %d "
msgstr "डार्क फ़्रेम को अनदेखा किया गया: %d"

#: src/compare.py:468
msgid "Certainty of winning frame: %.3f"
msgstr "विजेता फ्रेम की निश्चितता: %.3f"

#: src/compare.py:470
msgid "Winning model: %d (\"%s\")"
msgstr "विजेता मॉडल: %d (\"%s\")"

#: src/compare.py:474
msgid "SUCCESSFUL"
msgstr "सफल"

#: src/wallet_backend.py:62 src/wallet_backend.py:72
msgid "KWallet"
msgstr "KWallet"

#: src/wallet_backend.py:64
msgid "GNOME Keyring"
msgstr "GNOME Keyring"

#: src/wallet_backend.py:65
msgid "None"
msgstr "None"

#: src/wallet_backend.py:74
msgid "login keyring"
msgstr "लॉगिन कीरिंग"

#: src/wallet_backend.py:75
msgid "login keyring or KWallet"
msgstr "लॉगिन कीरिंग या KWallet"

#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\nDlib मॉड्यूल आयात नहीं कर सकता, आउटपुट की जाँच करें"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "कोई चेहरा मॉडल फ़ोल्डर नहीं मिला, एक बनाया जा रहा है"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr "सूचना: प्रत्येक अतिरिक्त मॉडल चेहरा पहचान इंजन को थोड़ा धीमा कर देता है"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"रद्द करने के लिए Ctrl+C दबाएँ\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "उपयोगकर्ता के लिए चेहरा मॉडल जोड़ा जा रहा है"

#: src/cli/add.py:88
msgid "Model #"
msgstr "नमूना #"

#: src/cli/add.py:92
msgid "Using default label \"%s\" because of -y flag"
msgstr "-y ध्वज के कारण डिफ़ॉल्ट लेबल \"%s\" का उपयोग करना"

#: src/cli/add.py:95
msgid "Enter a label for this new model [{}]: "
msgstr "इस नए मॉडल के लिए एक लेबल दर्ज करें [{}]:"

#: src/cli/add.py:103
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "सूचना: मॉडल नाम से अवैध अक्षर \",\" हटाया जा रहा है"

#: src/cli/add.py:117
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nकृपया सीधे कैमरे की ओर देखें"

#: src/cli/add.py:182
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "कैमरे ने केवल काले फ्रेम देखे - क्या आईआर एमिटर काम कर रहा है?"

#: src/cli/add.py:187
msgid "No face detected, aborting"
msgstr "कोई चेहरा नहीं मिला, निरस्त किया जा रहा है"

#: src/cli/add.py:192
msgid "Multiple faces detected, aborting"
msgstr "एकाधिक चेहरों का पता चला, निरस्त किया जा रहा है"

#: src/cli/add.py:214
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nपूरा स्कैन करें\nमें एक नया मॉडल जोड़ा गया"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr ""
"अभी तक कोई मॉडल नहीं बनाया गया है, यदि वे मौजूद नहीं हैं तो उन्हें साफ"
"़ नहीं किया जा सकता"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} का कोई मॉडल नहीं है या उन्हें पहले ही साफ़ कर दिया गया है"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "इससे सभी मॉडल साफ़ हो जायेंगे"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "क्या आप जारी रखना चाहते हैं [y/N]:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\n\"नहीं\" के रूप में व्याख्या करना, निरस्त करना"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nमॉडल साफ़ हो गए"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "{editor} में config.ini खोलना"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "संपादक खोलने में विफल: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "त्रुटि: उपयुक्त पाठ संपादक नहीं मिल सका।"

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr "कृपया 'नैनो' या 'vi' स्थापित करें, या EDITOR पर्यावरण चर सेट करें।"

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."
msgstr ""
"यदि आप इस कमांड को sudo के साथ चला रहे हैं, तो अपने EDITOR वेरिएबल को "
"संरक्षित करने के लिए 'sudo -E ubuntu-hello config' आज़माएँ।"

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "कृपया तर्क के रूप में 0 (सक्षम) या 1 (अक्षम) जोड़ें"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr "कृपया तर्क के रूप में केवल 0 (सक्षम) या 1 (अक्षम) का उपयोग करें"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "अक्षम विकल्प पहले ही सेट किया जा चुका है"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Hello अक्षम कर दिया गया है"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Hello सक्षम किया गया है"

#: src/cli/keyring.py:32 src/cli/keyring.py:157
msgid "Usage: keyring [enable|disable|restore [--all]]"
msgstr "उपयोग: कीरिंग [सक्षम|अक्षम|पुनर्स्थापित] [--all]"

#: src/cli/keyring.py:49
msgid "Enter password for user {} to unlock {} ({}): "
msgstr "{} ({}) को अनलॉक करने के लिए उपयोगकर्ता {} का पासवर्ड दर्ज करें:"

#: src/cli/keyring.py:51
msgid "Password cannot be empty"
msgstr "पासवर्ड खाली नहीं हो सकता"

#: src/cli/keyring.py:54
msgid "Confirm password: "
msgstr "पासवर्ड की पुष्टि कीजिये:"

#: src/cli/keyring.py:56
msgid "Passwords do not match"
msgstr "सांकेतिक शब्द मेल नहीं खाते"

#: src/cli/keyring.py:65
msgid "TPM hardware detected. Auto-installing tpm2-tools..."
msgstr "टीपीएम हार्डवेयर का पता चला। स्वत:-इंस्टॉलिंग tpm2-tools..."

#: src/cli/keyring.py:74
msgid "TPM hardware active. Sealing password in TPM..."
msgstr "टीपीएम हार्डवेयर सक्रिय। टीपीएम में पासवर्ड सील करना..."

#: src/cli/keyring.py:100
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} using TPM ("
"wallet: {})."
msgstr ""
"TPM (वॉलेट: {}) का उपयोग करके उपयोगकर्ता {} के लिए कीरिंग/KWallet अनलॉ"
"किंग सफलतापूर्वक सक्षम की गई।"

#: src/cli/keyring.py:102
msgid "Failed to seal password to TPM: {}"
msgstr "टीपीएम पर पासवर्ड सील करने में विफल: {}"

#: src/cli/keyring.py:106
msgid "No TPM active. Using software-based credential caching..."
msgstr ""
"कोई टीपीएम सक्रिय नहीं. सॉफ़्टवेयर-आधारित क्रेडेंशियल कैशिंग का उपयोग "
"करना..."

#: src/cli/keyring.py:122
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} (Software C"
"aching, wallet: {})."
msgstr ""
"उपयोगकर्ता {} के लिए कीरिंग/KWallet अनलॉकिंग सफलतापूर्वक सक्षम की गई ("
"सॉफ़्टवेयर कैशिंग, वॉलेट: {})।"

#: src/cli/keyring.py:124
msgid "Failed to enable keyring unlocking: {}"
msgstr "कीरिंग अनलॉकिंग सक्षम करने में विफल: {}"

#: src/cli/keyring.py:135
msgid "Failed to disable keyring unlocking: {}"
msgstr "कीरिंग अनलॉकिंग अक्षम करने में विफल: {}"

#: src/cli/keyring.py:138
msgid "Keyring/KWallet unlocking disabled for user {}."
msgstr "उपयोगकर्ता {} के लिए कीरिंग/KWallet अनलॉकिंग अक्षम है।"

#: src/cli/keyring.py:140
msgid "Keyring/KWallet unlocking was not enabled for user {}."
msgstr "उपयोगकर्ता {} के लिए कीरिंग/KWallet अनलॉकिंग सक्षम नहीं थी।"

#: src/cli/keyring.py:149
msgid "No sealed login passwords found; nothing to restore."
msgstr "कोई सीलबंद लॉगिन पासवर्ड नहीं मिला; पुनर्स्थापित करने के लिए कुछ नहीं।"

#: src/cli/keyring.py:151
msgid "Restored login wallet password for {} user(s)."
msgstr "{} उपयोगकर्ता(ओं) के लिए लॉगिन वॉलेट पासवर्ड पुनर्स्थापित किया गया।"

#: src/cli/keyring.py:153
msgid "Could not restore login wallet password for {} user(s)."
msgstr ""
"{} उपयोगकर्ता(ओं) के लिए लॉगिन वॉलेट पासवर्ड पुनर्स्थापित नहीं किया जा"
" सका।"

#: src/cli/keyring.py:154
msgid ""
"If prompts persist, set the login keyring or KWallet password in Seaho"
"rse / System Settings."
msgstr ""
"यदि संकेत बने रहें, तो Seahorse / सिस्टम सेटिंग्स में लॉगिन कीरिंग या "
"KWallet पासवर्ड सेट करें।"

#: src/cli/keyring.py:161
msgid "Restored login wallet password for user {}."
msgstr "उपयोगकर्ता {} के लिए लॉगिन वॉलेट पासवर्ड पुनर्स्थापित किया गया।"

#: src/cli/keyring.py:163
msgid "Could not restore login wallet password for user {}."
msgstr "उपयोगकर्ता {} के लिए लॉगिन वॉलेट पासवर्ड पुनर्स्थापित नहीं किया जा सका।"

#: src/cli/keyring.py:167
msgid "Invalid action. Use 'enable', 'disable', or 'restore'."
msgstr "अमान्य क्रिया. 'सक्षम', 'अक्षम' या 'पुनर्स्थापित' का उपयोग करें।"

#: src/cli/list.py:17 src/cli/remove.py:25
msgid "Face models have not been initialized yet, please run:"
msgstr "फेस मॉडल अभी तक प्रारंभ नहीं किए गए हैं, कृपया चलाएँ:"


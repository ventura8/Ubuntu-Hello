#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "പരാജയം, സമയപരിധി എത്തി"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "മുഖം തിരിച്ചറിയൽ ചിത്രം വളരെ ഇരുണ്ടതാണ്"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "അജ്ഞാത പിശക്:"

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "മുഖം %s ആയി തിരിച്ചറിഞ്ഞു"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr ""
"എൻ്റർ പ്രസ്സ് അയയ്‌ക്കുന്നതിന് അപര്യാപ്തമായ അനുമതികൾ, പകരം ഉപയോക്താവ് "
"അമർത്തുന്നതിനായി കാത്തിരിക്കുന്നു"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr ""
"എൻ്റർ അമർത്തുന്നത് അയയ്‌ക്കുന്നതിൽ പരാജയപ്പെട്ടു, പകരം ഉപയോക്താവ് അമർത"
"്തുന്നതിനായി കാത്തിരിക്കുന്നു"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "മുഖത്തിൻ്റെ ആധികാരികത ഉറപ്പാക്കാൻ ശ്രമിക്കുന്നു"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "ഉപയോക്താവിനെ നിർണ്ണയിക്കാൻ കഴിഞ്ഞില്ല, ദയവായി --user ഫ്ലാഗ് ഉപയോഗിക്കുക"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello മുഖം പ്രാമാണീകരണത്തിനുള്ള കമാൻഡ് ലൈൻ ഇൻ്റർഫേസ്."

#: src/cli.py:35
msgid "command"
msgstr "കമാൻഡ്"

#: src/cli.py:35
msgid "arguments"
msgstr "വാദങ്ങൾ"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"പിന്തുണയ്ക്കായി ദയവായി സന്ദർശിക്കുക\nhttps://github.com/ventura8/ubunt"
"u-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"എക്സിക്യൂട്ട് ചെയ്യാനുള്ള കമാൻഡ് ഓപ്‌ഷൻ ഇനിപ്പറയുന്നതിൽ ഒന്നായിരിക്കാം"
": ചേർക്കുക, ക്ലിയർ ചെയ്യുക, കോൺഫിഗർ ചെയ്യുക, പ്രവർത്തനരഹിതമാക്കുക, കീറ"
"ിംഗ്, ലിസ്റ്റ്, നീക്കം ചെയ്യുക, സ്നാപ്പ്ഷോട്ട്, സെറ്റ്, ടെസ്റ്റ് അല്ലെ"
"ങ്കിൽ പതിപ്പ്."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr ""
"ആഡ്, ഡിസേബിൾ, റിമൂവ്, സെറ്റ് കമാൻഡുകൾ എന്നിവയ്‌ക്കായുള്ള ഓപ്‌ഷണൽ ആർഗ്യ"
"ുമെൻ്റുകൾ."

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "ഉപയോഗിക്കുന്നതിന് ഉപയോക്തൃ അക്കൗണ്ട് സജ്ജമാക്കുക."

#: src/cli.py:60
msgid "Skip all questions."
msgstr "എല്ലാ ചോദ്യങ്ങളും ഒഴിവാക്കുക."

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "പ്രിൻ്റ് മെഷീൻ-സൗഹൃദ ഔട്ട്പുട്ട്."

#: src/cli.py:74
msgid "Show this help message and exit."
msgstr "ഈ സഹായ സന്ദേശം കാണിച്ച് പുറത്തുകടക്കുക."

#: src/cli.py:78
msgid "current active user: "
msgstr "നിലവിലെ സജീവ ഉപയോക്താവ്:"

#: src/cli.py:88
msgid "Invalid username format"
msgstr "അസാധുവായ ഉപയോക്തൃനാമ ഫോർമാറ്റ്"

#: src/cli.py:98
msgid ""
"Please run this command as root:\n"
msgstr ""
"ദയവായി ഈ കമാൻഡ് റൂട്ടായി പ്രവർത്തിപ്പിക്കുക:\n"

#: src/cli.py:104
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr ""
"ubuntu-hello കമാൻഡുകൾ റൂട്ടായി പ്രവർത്തിപ്പിക്കാൻ കഴിയില്ല, ദയവായി --u"
"ser ഫ്ലാഗ് ഉപയോഗിച്ച് ഈ കമാൻഡ് പ്രവർത്തിപ്പിക്കുക"

#: src/compare.py:128 src/cli/add.py:32
msgid "Data files have not been downloaded, please run the following commands:"
msgstr ""
"ഡാറ്റ ഫയലുകൾ ഡൗൺലോഡ് ചെയ്തിട്ടില്ല, ദയവായി ഇനിപ്പറയുന്ന കമാൻഡുകൾ പ്രവർ"
"ത്തിപ്പിക്കുക:"

#: src/compare.py:154
msgid " LOGIN"
msgstr "ലോഗിൻ"

#: src/compare.py:155 src/cli/snap.py:44
msgid "Date: "
msgstr "തീയതി:"

#: src/compare.py:156
msgid "Scan time: "
msgstr "സ്കാൻ സമയം:"

#: src/compare.py:157
msgid "Frames: "
msgstr "ഫ്രെയിമുകൾ:"

#: src/compare.py:158
msgid "Hostname: "
msgstr "ഹോസ്റ്റിൻ്റെ പേര്:"

#: src/compare.py:159
msgid "Best certainty value: "
msgstr "മികച്ച ഉറപ്പായ മൂല്യം:"

#: src/compare.py:259
msgid "Starting up..."
msgstr "ആരംഭിക്കുന്നു..."

#: src/compare.py:312
msgid "Identifying you..."
msgstr "നിങ്ങളെ തിരിച്ചറിയുന്നു..."

#: src/compare.py:344
msgid "FAILED"
msgstr "പരാജയപ്പെട്ടു"

#: src/compare.py:347 src/cli/add.py:184
msgid "All frames were too dark, please check dark_threshold in config"
msgstr ""
"എല്ലാ ഫ്രെയിമുകളും വളരെ ഇരുണ്ടതായിരുന്നു, കോൺഫിഗറിൽ ഇരുണ്ട_ത്രെഷോൾഡ് പ"
"രിശോധിക്കുക"

#: src/compare.py:348 src/cli/add.py:185
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "ശരാശരി ഇരുട്ട്: {avg}, ത്രെഷോൾഡ്: {threshold}"

#: src/compare.py:449
msgid "Time spent"
msgstr "ചെലവഴിച്ച സമയം"

#: src/compare.py:450
msgid "Starting up"
msgstr "ആരംഭിക്കുന്നു"

#: src/compare.py:451
msgid "  Open cam + load libs: %dms"
msgstr "ക്യാം + ലോഡ് ലിബുകൾ തുറക്കുക: %dms"

#: src/compare.py:452
msgid "  Opening the camera"
msgstr "ക്യാമറ തുറക്കുന്നു"

#: src/compare.py:453
msgid "  Importing recognition libs"
msgstr "തിരിച്ചറിയൽ ലിബുകൾ ഇറക്കുമതി ചെയ്യുന്നു"

#: src/compare.py:454
msgid "Searching for known face"
msgstr "അറിയാവുന്ന മുഖം തിരയുന്നു"

#: src/compare.py:455
msgid "Total time"
msgstr "ആകെ സമയം"

#: src/compare.py:457
msgid ""
"\nResolution"
msgstr ""
"\nറെസലൂഷൻ"

#: src/compare.py:459
msgid "  Native: %dx%d"
msgstr "സ്വദേശി: %dx%d"

#: src/compare.py:462
msgid "  Used: %dx%d"
msgstr "ഉപയോഗിച്ചത്: %dx%d"

#: src/compare.py:465
msgid ""
"\nFrames searched: %d (%.2f fps)"
msgstr ""
"\nഫ്രെയിമുകൾ തിരഞ്ഞു: %d (%.2f fps)"

#: src/compare.py:466
msgid "Black frames ignored: %d "
msgstr "കറുത്ത ഫ്രെയിമുകൾ അവഗണിച്ചു: %d"

#: src/compare.py:467
msgid "Dark frames ignored: %d "
msgstr "ഇരുണ്ട ഫ്രെയിമുകൾ അവഗണിച്ചു: %d"

#: src/compare.py:468
msgid "Certainty of winning frame: %.3f"
msgstr "വിജയിച്ച ഫ്രെയിമിൻ്റെ ഉറപ്പ്: %.3f"

#: src/compare.py:470
msgid "Winning model: %d (\"%s\")"
msgstr "വിജയിക്കുന്ന മോഡൽ: %d (\"%s\")"

#: src/compare.py:474
msgid "SUCCESSFUL"
msgstr "വിജയകരം"

#: src/wallet_backend.py:62 src/wallet_backend.py:72
msgid "KWallet"
msgstr "KWallet"

#: src/wallet_backend.py:64
msgid "GNOME Keyring"
msgstr "GNOME Keyring"

#: src/wallet_backend.py:65
msgid "None"
msgstr "None"

#: src/wallet_backend.py:74
msgid "login keyring"
msgstr "ലോഗിൻ കീറിംഗ്"

#: src/wallet_backend.py:75
msgid "login keyring or KWallet"
msgstr "ലോഗിൻ കീറിംഗ് അല്ലെങ്കിൽ KWallet"

#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\ndlib മൊഡ്യൂൾ ഇറക്കുമതി ചെയ്യാൻ കഴിയില്ല, ഇതിൻ്റെ ഔട്ട്പുട്ട് പരിശോധി"
"ക്കുക"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "മുഖം മോഡൽ ഫോൾഡറൊന്നും കണ്ടെത്തിയില്ല, ഒരെണ്ണം സൃഷ്‌ടിക്കുന്നു"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr "അറിയിപ്പ്: ഓരോ അധിക മോഡലും മുഖം തിരിച്ചറിയൽ എഞ്ചിൻ്റെ വേഗത കുറയ്ക്കുന്നു"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"റദ്ദാക്കാൻ Ctrl+C അമർത്തുക\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "ഉപയോക്താവിനായി മുഖം മോഡൽ ചേർക്കുന്നു"

#: src/cli/add.py:88
msgid "Model #"
msgstr "മോഡൽ #"

#: src/cli/add.py:92
msgid "Using default label \"%s\" because of -y flag"
msgstr "-y ഫ്ലാഗ് കാരണം ഡിഫോൾട്ട് ലേബൽ \"%s\" ഉപയോഗിക്കുന്നു"

#: src/cli/add.py:95
msgid "Enter a label for this new model [{}]: "
msgstr "ഈ പുതിയ മോഡലിനായി ഒരു ലേബൽ നൽകുക [{}]:"

#: src/cli/add.py:103
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr ""
"അറിയിപ്പ്: മോഡലിൻ്റെ പേരിൽ നിന്ന് \",\" നിയമവിരുദ്ധമായ പ്രതീകം നീക്കംച"
"െയ്യുന്നു"

#: src/cli/add.py:117
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nക്യാമറയിലേക്ക് നേരെ നോക്കൂ"

#: src/cli/add.py:182
msgid "Camera saw only black frames - is IR emitter working?"
msgstr ""
"ക്യാമറ കണ്ടത് കറുത്ത ഫ്രെയിമുകൾ മാത്രം - ഐആർ എമിറ്റർ പ്രവർത്തിക്കുന്നു"
"ണ്ടോ?"

#: src/cli/add.py:187
msgid "No face detected, aborting"
msgstr "മുഖം കണ്ടെത്തിയില്ല, അലസിപ്പിക്കുന്നു"

#: src/cli/add.py:192
msgid "Multiple faces detected, aborting"
msgstr "ഒന്നിലധികം മുഖങ്ങൾ കണ്ടെത്തി, അലസിപ്പിക്കുന്നു"

#: src/cli/add.py:214
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nസ്കാൻ പൂർത്തിയായി\nഒരു പുതിയ മോഡൽ ചേർത്തു"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr ""
"ഇതുവരെ മോഡലുകളൊന്നും സൃഷ്‌ടിച്ചിട്ടില്ല, അവ നിലവിലില്ലെങ്കിൽ അവ മായ്‌ക"
"്കാനാവില്ല"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} ന് മോഡലുകളൊന്നുമില്ല അല്ലെങ്കിൽ അവ ഇതിനകം മായ്‌ച്ചിരിക്കുന്നു"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "ഇത് എല്ലാ മോഡലുകളും മായ്‌ക്കും"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "നിങ്ങൾക്ക് [y/N] തുടരണോ:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\n\"ഇല്ല\" എന്ന് വ്യാഖ്യാനിക്കുന്നു, അലസിപ്പിക്കുന്നു"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nമോഡലുകൾ മായ്ച്ചു"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "{editor}-ൽ config.ini തുറക്കുന്നു"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "എഡിറ്റർ തുറക്കുന്നതിൽ പരാജയപ്പെട്ടു: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "പിശക്: അനുയോജ്യമായ ഒരു ടെക്സ്റ്റ് എഡിറ്റർ കണ്ടെത്താൻ കഴിഞ്ഞില്ല."

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr ""
"ദയവായി 'നാനോ' അല്ലെങ്കിൽ 'vi' ഇൻസ്റ്റാൾ ചെയ്യുക, അല്ലെങ്കിൽ EDITOR എൻവ"
"യോൺമെൻ്റ് വേരിയബിൾ സജ്ജമാക്കുക."

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."
msgstr ""
"നിങ്ങൾ ഈ കമാൻഡ് sudo ഉപയോഗിച്ചാണ് പ്രവർത്തിപ്പിക്കുന്നതെങ്കിൽ, നിങ്ങളു"
"ടെ എഡിറ്റർ വേരിയബിൾ സംരക്ഷിക്കുന്നതിന് 'sudo -E ubuntu-hello config' പ"
"രീക്ഷിക്കുക."

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr ""
"ഒരു ആർഗ്യുമെൻ്റായി 0 (പ്രാപ്തമാക്കുക) അല്ലെങ്കിൽ 1 (അപ്രാപ്തമാക്കുക) ച"
"േർക്കുക"

#: src/cli/disable.py:35

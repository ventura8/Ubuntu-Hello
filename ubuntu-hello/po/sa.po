#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "असफलता, समयसमाप्तिः प्राप्ता"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "मुखपरिचयप्रतिबिम्बम् अतीव अन्धकारमयम्"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "अज्ञातदोषः : १."

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "%s इति चिह्नितं मुखम् ।"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr ""
"Enter press प्रेषयितुं अपर्याप्ताः अनुमतिः, तस्य स्थाने उपयोक्तुः तस्य"
" नुदनस्य प्रतीक्षां कुर्वन्"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr ""
"Enter press प्रेषयितुं असफलः, तस्य स्थाने उपयोक्तुः तस्य नुदनस्य प्रती"
"क्षां कुर्वन्"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "मुखप्रमाणीकरणस्य प्रयासः"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr ""
"उपयोक्तारं निर्धारयितुं न शक्तवान्, कृपया --user ध्वजस्य उपयोगं कुर्वन"
"्तु"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello मुखप्रमाणीकरणस्य कृते आदेशपङ्क्ति-अन्तरफलकम् ।"

#: src/cli.py:35
msgid "command"
msgstr "आदेश"

#: src/cli.py:35
msgid "arguments"
msgstr "तर्काः"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"समर्थनार्थं कृपया पश्यन्तु\n⟦उ००००⟧ २."

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"निष्पादयितुं आदेशविकल्पः, निम्नलिखितयोः एकः भवितुम् अर्हति: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "add, disable, remove, set इति आदेशानां वैकल्पिकतर्काः ।"

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "उपयोक्तृलेखं उपयोक्तुं सेट् कुर्वन्तु ।"

#: src/cli.py:60
msgid "Skip all questions."
msgstr "सर्वे प्रश्नाः त्यजन्तु।"

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "मुद्रणयन्त्र-अनुकूलं उत्पादनम्।"

#: src/cli.py:74
msgid "Show this help message and exit."
msgstr "एतत् सहायतासन्देशं दर्शयित्वा निर्गच्छतु।"

#: src/cli.py:78
msgid "current active user: "
msgstr "वर्तमान सक्रियप्रयोक्ता : १."

#: src/cli.py:88
msgid "Invalid username format"
msgstr "अमान्यप्रयोक्तृनामस्वरूपम्"

#: src/cli.py:98
msgid ""
"Please run this command as root:\n"
msgstr ""
"कृपया एतत् आदेशं root इति चालयन्तु:\n"

#: src/cli.py:104
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr ""
"ubuntu-hello आदेशान् root रूपेण चालयितुं न शक्यते, कृपया --user ध्वजेन"
" सह एतत् आदेशं चालयन्तु"

#: src/compare.py:128 src/cli/add.py:32
msgid "Data files have not been downloaded, please run the following commands:"
msgstr "दत्तांशसञ्चिकाः अवतरणं न कृतवन्तः, कृपया निम्नलिखित आदेशान् चालयन्तु ।"

#: src/compare.py:154
msgid " LOGIN"
msgstr "LOGIN इति"

#: src/compare.py:155 src/cli/snap.py:44
msgid "Date: "
msgstr "दिनाङ्कः:"

#: src/compare.py:156
msgid "Scan time: "
msgstr "स्कैन् समयः : १."

#: src/compare.py:157
msgid "Frames: "
msgstr "फ्रेम्स : १."

#: src/compare.py:158
msgid "Hostname: "
msgstr "होस्टनाम : १."

#: src/compare.py:159
msgid "Best certainty value: "
msgstr "उत्तमं निश्चयमूल्यम् : १."

#: src/compare.py:259
msgid "Starting up..."
msgstr "आरम्भं कुर्वन्..."

#: src/compare.py:312
msgid "Identifying you..."
msgstr "भवतः परिचयं कृत्वा..."

#: src/compare.py:344
msgid "FAILED"
msgstr "असफल"

#: src/compare.py:347 src/cli/add.py:184
msgid "All frames were too dark, please check dark_threshold in config"
msgstr ""
"सर्वे फ्रेम्स अतीव अन्धकारमयाः आसन्, कृपया config मध्ये dark_threshold"
" इति परीक्ष्यताम्"

#: src/compare.py:348 src/cli/add.py:185
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "औसत अन्धकारः {avg}, दहलीजः {threshold}"

#: src/compare.py:449
msgid "Time spent"
msgstr "व्यतीतः समयः"

#: src/compare.py:450
msgid "Starting up"
msgstr "आरम्भः"

#: src/compare.py:451
msgid "  Open cam + load libs: %dms"
msgstr "ओपन कैम + लोड लिब्स: %dms"

#: src/compare.py:452
msgid "  Opening the camera"
msgstr "कॅमेरा उद्घाटयन्"

#: src/compare.py:453
msgid "  Importing recognition libs"
msgstr "मान्यता libs आयात करना"

#: src/compare.py:454
msgid "Searching for known face"
msgstr "ज्ञातं मुखं अन्वेष्य"

#: src/compare.py:455
msgid "Total time"
msgstr "कुल समय"

#: src/compare.py:457
msgid ""
"\nResolution"
msgstr ""
"\nप्रस्ताव"

#: src/compare.py:459
msgid "  Native: %dx%d"
msgstr "मूलनिवासी: %dx%d"

#: src/compare.py:462
msgid "  Used: %dx%d"
msgstr "प्रयुक्तः %dx%d"

#: src/compare.py:465
msgid ""
"\nFrames searched: %d (%.2f fps)"
msgstr ""
"\nअन्वेषणं कृतं फ्रेम्स: %d (%.2f fps)"

#: src/compare.py:466
msgid "Black frames ignored: %d "
msgstr "कृष्णचतुष्कोणाः उपेक्षिताः : %d ."

#: src/compare.py:467
msgid "Dark frames ignored: %d "
msgstr "अन्धकारमयचतुष्कोणाः उपेक्षिताः : %d ."

#: src/compare.py:468
msgid "Certainty of winning frame: %.3f"
msgstr "विजयी फ्रेमस्य निश्चयः : %.3f ."

#: src/compare.py:470
msgid "Winning model: %d (\"%s\")"
msgstr "विजेता मॉडलः %d (\"%s\")"

#: src/compare.py:474
msgid "SUCCESSFUL"
msgstr "सफल"

#: src/wallet_backend.py:62 src/wallet_backend.py:72
msgid "KWallet"
msgstr "KWallet"

#: src/wallet_backend.py:64
msgid "GNOME Keyring"
msgstr "GNOME Keyring"

#: src/wallet_backend.py:65
msgid "None"
msgstr "None"

#: src/wallet_backend.py:74
msgid "login keyring"
msgstr "login कीरिंग्"

#: src/wallet_backend.py:75
msgid "login keyring or KWallet"
msgstr "लॉगिन कीरिंग् अथवा KWallet ."

#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\ndlib मॉड्यूलम् आयातयितुं न शक्नोति, इत्यस्य आउटपुट् पश्यन्तु"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "न मुखप्रतिरूपपुटं लब्धम्, एकं निर्माय"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr "सूचना: प्रत्येकं अतिरिक्तं मॉडलं मुखपरिचयइञ्जिनं किञ्चित् मन्दं करोति"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"रद्दं कर्तुं Ctrl+C नुदन्तु\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "उपयोक्तुः कृते मुखप्रतिरूपं योजयित्वा"

#: src/cli/add.py:88
msgid "Model #"
msgstr "प्रतिकृति #"

#: src/cli/add.py:92
msgid "Using default label \"%s\" because of -y flag"
msgstr "-y ध्वजस्य कारणात् पूर्वनिर्धारितलेबलस्य \"%s\" इत्यस्य उपयोगः"

#: src/cli/add.py:95
msgid "Enter a label for this new model [{}]: "
msgstr "अस्य नूतनस्य मॉडलस्य [{}] लेबलं प्रविशन्तु:"

#: src/cli/add.py:103
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "सूचना: मॉडलनामतः अवैधवर्णं \",\" निष्कासयति"

#: src/cli/add.py:117
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nकृपया सीधा कॅमेरे पश्यन्तु"

#: src/cli/add.py:182
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "कॅमेरा केवलं कृष्णवर्णीयं फ्रेमं दृष्टवान् - IR emitter कार्यं करोति वा?"

#: src/cli/add.py:187
msgid "No face detected, aborting"
msgstr "न मुखं ज्ञातम्, गर्भपातं करोति"

#: src/cli/add.py:192
msgid "Multiple faces detected, aborting"
msgstr "बहुमुखाः ज्ञाताः, गर्भपातं कुर्वन्ति"

#: src/cli/add.py:214
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nस्कैन् सम्पूर्णम्\nनूतनं मॉडलं योजितवान्"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr ""
"अद्यापि कोऽपि आदर्शः न निर्मितः, यदि ते नास्ति तर्हि तान् स्वच्छं कर्त"
"ुं न शक्नुवन्ति"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} इत्यस्य मॉडल् नास्ति अथवा ते पूर्वमेव क्लियर कृताः सन्ति"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "एतेन सर्वाणि आदर्शानि स्वच्छानि भविष्यन्ति"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "किं भवन्तः अग्रे गन्तुं इच्छन्ति [y/N]:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\n\"NO\" इति व्याख्यां कुर्वन्, गर्भपातं कुर्वन्"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nमॉडल्स् स्वच्छाः"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "{editor} इत्यस्मिन् config.ini उद्घाटयति ।"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "सम्पादकं उद्घाटयितुं असफलम्: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "त्रुटिः : उपयुक्तं पाठसम्पादकं न लब्धम् ।"

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr ""
"कृपया 'nano' अथवा 'vi' संस्थापयन्तु, अथवा EDITOR वातावरणचरं सेट् कुर्व"
"न्तु ।"

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."
msgstr ""
"यदि भवान् sudo इत्यनेन सह एतत् आदेशं चालयति तर्हि स्वस्य EDITOR चरं रक"
"्षितुं 'sudo -E ubuntu-hello config' इति प्रयतस्व ।"

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "कृपया 0 (सक्षमम्) अथवा 1 (अक्षमम्) इति तर्करूपेण योजयन्तु"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr "कृपया केवलं 0 (सक्षमम्) अथवा 1 (अक्षमम्) इति तर्करूपेण उपयुज्यताम्"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "disable विकल्पः पूर्वमेव सेट् कृतः अस्ति"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Hello अक्षमम् अस्ति"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Hello सक्षमम् अस्ति"

#: src/cli/keyring.py:32 src/cli/keyring.py:157
msgid "Usage: keyring [enable|disable|restore [--all]]"
msgstr "उपयोगः: कीलीकरणम् [सक्षम|अक्षमम्|पुनःस्थापनम्] । [--all]"

#: src/cli/keyring.py:49
msgid "Enter password for user {} to unlock {} ({}): "
msgstr "{} ({}) अनलॉक् कर्तुं उपयोक्तुः {} कृते गुप्तशब्दं प्रविष्टं कुर्वन्तु:"

#: src/cli/keyring.py:51
msgid "Password cannot be empty"
msgstr "गुप्तशब्दः रिक्तः न भवितुम् अर्हति"

#: src/cli/keyring.py:54
msgid "Confirm password: "
msgstr "गुप्तशब्दस्य पुष्टिः कुर्वन्तु : १."

#: src/cli/keyring.py:56
msgid "Passwords do not match"
msgstr "गुप्तशब्दाः न मेलन्ति"

#: src/cli/keyring.py:65
msgid "TPM hardware detected. Auto-installing tpm2-tools..."
msgstr "TPM हार्डवेयरं ज्ञातम्। स्वतः स्थापना tpm2-tools..."

#: src/cli/keyring.py:74
msgid "TPM hardware active. Sealing password in TPM..."
msgstr "TPM हार्डवेयर सक्रियः अस्ति। TPM मध्ये गुप्तशब्दं सीलयति..."

#: src/cli/keyring.py:100
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} using TPM ("
"wallet: {})."
msgstr ""
"TPM (wallet: {}) इत्यस्य उपयोगेन उपयोक्तुः {} कृते कीरिंग्/KWallet अनल"
"ॉकिंग् सफलतया सक्षमम् अभवत् ।"

#: src/cli/keyring.py:102
msgid "Failed to seal password to TPM: {}"
msgstr "TPM प्रति गुप्तशब्दं मुद्रयितुं असफलम्: {}"

#: src/cli/keyring.py:106
msgid "No TPM active. Using software-based credential caching..."
msgstr "न TPM सक्रियः। सॉफ्टवेयर-आधारित-प्रमाणपत्र-सञ्चयस्य उपयोगेन..."

#: src/cli/keyring.py:122
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} (Software C"
"aching, wallet: {})."
msgstr ""
"उपयोक्तुः {} (सॉफ्टवेयर कैशिंग्, बटुआ: {}) कृते कीरिंग्/KWallet अनलॉकि"
"ंग् सफलतया सक्षमम्।"

#: src/cli/keyring.py:124
msgid "Failed to enable keyring unlocking: {}"
msgstr "कीरिंग् अनलॉकिंग् सक्षमं कर्तुं असफलम्: {}"

#: src/cli/keyring.py:135
msgid "Failed to disable keyring unlocking: {}"
msgstr "कीरिंग् अनलॉकिंग् निष्क्रियं कर्तुं असफलम्: {}"

#: src/cli/keyring.py:138
msgid "Keyring/KWallet unlocking disabled for user {}."
msgstr "उपयोक्तुः {} कृते कीरिंग्/KWallet अनलॉकिंग् अक्षमम्।"

#: src/cli/keyring.py:140
msgid "Keyring/KWallet unlocking was not enabled for user {}."
msgstr "उपयोक्तुः {} कृते कीरिंग्/KWallet अनलॉकिंग् सक्षमं नासीत् ।"

#: src/cli/keyring.py:149
msgid "No sealed login passwords found; nothing to restore."
msgstr "मुद्रितानि प्रवेशगुह्यपदानि न प्राप्तानि; पुनःस्थापयितुं किमपि नास्ति।"

#: src/cli/keyring.py:151
msgid "Restored login wallet password for {} user(s)."
msgstr "{} उपयोक्तॄणां कृते प्रवेशस्य कोशस्य गुह्यपदं पुनःस्थापितम्।"

#: src/cli/keyring.py:153
msgid "Could not restore login wallet password for {} user(s)."
msgstr "{} उपयोक्तॄणां कृते प्रवेशस्य कोशस्य गुह्यपदं पुनःस्थापयितुं न शक्यम्।"

#: src/cli/keyring.py:154
msgid ""
"If prompts persist, set the login keyring or KWallet password in Seaho"
"rse / System Settings."
msgstr ""
"यदि प्रश्नाः निरन्तरं भवन्ति तर्हि Seahorse / प्रणालीसेटिङ्ग्स् इत्यत्"
"र प्रवेशकीलीकरणस्य अथवा KWallet इत्यस्य गुह्यपदं स्थापयतु।"

#: src/cli/keyring.py:161
msgid "Restored login wallet password for user {}."
msgstr "उपयोक्तुः {} कृते प्रवेशस्य कोशस्य गुह्यपदं पुनःस्थापितम्।"

#: src/cli/keyring.py:163
msgid "Could not restore login wallet password for user {}."
msgstr "उपयोक्तुः {} कृते प्रवेशस्य कोशस्य गुह्यपदं पुनःस्थापयितुं न शक्यम्।"

#: src/cli/keyring.py:167
msgid "Invalid action. Use 'enable', 'disable', or 'restore'."
msgstr "अमान्यं कर्म। 'सक्षम', 'अक्षमम्' अथवा 'पुनःस्थापनम्' उपयुज्यताम्।"

#: src/cli/list.py:17 src/cli/remove.py:25
msgid "Face models have not been initialized yet, please run:"
msgstr "मुखस्य प्रतिरूपाः अद्यापि आरम्भं न कृतवन्तः, कृपया चालयन्तु:"


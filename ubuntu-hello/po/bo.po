#: src/pam/main.cc:109
msgid "Failure, timeout reached"
msgstr "ཕམ་ཉེས། དུས་ཡོལ་སླེབས་སོང་།"

#: src/pam/main.cc:116
msgid "Face detection image too dark"
msgstr "གདོང་པ་ཚོར་འཛིན་གྱི་པར་རིས་མུན་ནག་དྲགས།"

#: src/pam/main.cc:125

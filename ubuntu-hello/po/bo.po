msgid ""
"Insufficient permissions to send Enter press, waiting for user to press it "
"instead"
msgstr ""
"Enter མནོན་པའི་བརྡ་བསྐུར་བའི་དབང་ཚད་མི་འདང་། དེའི་ཚབ་ཏུ་སྤྱོད་མཁན་གྱིས་མནོན་པར་སྒུག་བཞིན་པ།"

#: src/pam/main.cc:465 src/pam/main.cc:470
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr "Enter མནོན་པའི་བརྡ་བསྐུར་མ་ཐུབ། དེའི་ཚབ་ཏུ་སྤྱོད་མཁན་གྱིས་མནོན་པར་སྒུག་བཞིན་པ།"

#: src/pam/main.cc:582
msgid "Attempting facial authentication"
msgstr "གདོང་པའི་ར་སྤྲོད་ཚོད་ལྟ་བྱེད་བཞིན་པ།"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "སྤྱོད་མཁན་ངོས་འཛིན་བྱེད་མ་ཐུབ། --user མཚོན་རྟགས་སྤྱོད་རོགས།"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello གདོང་པའི་ར་སྤྲོད་ཀྱི་བརྡ་སྦྱོར་ཐིག་གི་མཐུད་ངོས།"

#: src/cli.py:35
msgid "command"
msgstr "བརྡ་སྦྱོར"

#: src/cli.py:35
msgid "arguments"
msgstr "ཆ་རྐྱེན"

#: src/cli.py:36
msgid ""
"For support please visit\n"
"https://github.com/ventura8/ubuntu-hello"
msgstr ""
"རོགས་རམ་ཆེད་འདིར་གཟིགས་རོགས།\n"
"https://github.com/ventura8/ubuntu-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear, "
"config, disable, keyring, list, remove, snapshot, set, test or version."
msgstr ""
"ལག་བསྟར་བྱེད་རྒྱུའི་བརྡ་སྦྱོར་གྱི་འདེམས་གཞི་སྟེ། གཤམ་གསལ་ལས་གང་རུང་ཞིག་ཡིན་ཆོག add, clear, "
"config, disable, keyring, list, remove, snapshot, set, test ཡང་ན་ version།"

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "add, disable, remove དང་ set བརྡ་སྦྱོར་རྣམས་ཀྱི་གདམ་ཀའི་ཆ་རྐྱེན།"

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "སྤྱོད་རྒྱུའི་སྤྱོད་མཁན་གྱི་རྩིས་ཐོ་སྒྲིག་འགོད་བྱོས།"


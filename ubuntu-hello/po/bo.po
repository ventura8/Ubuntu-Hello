msgid "Skip all questions."
msgstr "དྲི་བ་ཚང་མ་གོ་བརྒལ།"

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "འཕྲུལ་ཆས་ཀྱིས་ངོས་འཛིན་བདེ་བའི་ཐོན་འབྲས་པར་འདེབས་བྱེད།"

#: src/cli.py:72
msgid "With keyring restore: restore sealed login passwords for all users."
msgstr ""
"keyring restore དང་མཉམ་དུ། སྤྱོད་མཁན་ཚང་མའི་རྒྱས་བཏབ་ནང་འཇུག་གསང་ཚིག་རྣམས་སོར་ཆུད་བྱེད།"

#: src/cli.py:80
msgid "Show this help message and exit."
msgstr "རོགས་རམ་གྱི་འཕྲིན་ཡིག་འདི་མངོན་ནས་ཕྱིར་འཐོན།"


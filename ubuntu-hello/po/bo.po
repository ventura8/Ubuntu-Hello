#: src/cli.py:110
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with the --"
"user flag"
msgstr ""
"ubuntu-hello གྱི་བརྡ་སྦྱོར་རྣམས་ root ཚུལ་དུ་སྤྱོད་མི་ཐུབ། བརྡ་སྦྱོར་འདི་ --user མཚོན་རྟགས་དང་མཉམ་"
"དུ་སྤྱོད་རོགས།"


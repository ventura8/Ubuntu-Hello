#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear, "
"config, disable, keyring, list, remove, snapshot, set, test or version."
msgstr ""
"אפשרות הפקודה לביצוע יכולה להיות אחת מהאפשרויות הבאות: add, clear, config, "
"disable, keyring, list, remove, snapshot, set, test או version."


#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "ವೈಫಲ್ಯ, ಸಮಯ ಮೀರಿದೆ"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "ಮುಖ ಪತ್ತೆ ಚಿತ್ರ ತುಂಬಾ ಗಾಢವಾಗಿದೆ"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "ಅಜ್ಞಾತ ದೋಷ:"

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "ಮುಖವನ್ನು %s ಎಂದು ಗುರುತಿಸಲಾಗಿದೆ"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr ""
"Enter ಪ್ರೆಸ್ ಅನ್ನು ಕಳುಹಿಸಲು ಸಾಕಷ್ಟು ಅನುಮತಿಗಳಿಲ್ಲ, ಬದಲಿಗೆ ಬಳಕೆದಾರರು ಅದನ"
"್ನು ಒತ್ತಲು ಕಾಯುತ್ತಿದ್ದಾರೆ"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr ""
"Enter ಪ್ರೆಸ್ ಅನ್ನು ಕಳುಹಿಸಲು ವಿಫಲವಾಗಿದೆ, ಬದಲಿಗೆ ಬಳಕೆದಾರರು ಅದನ್ನು ಒತ್ತಲು"
" ಕಾಯುತ್ತಿದ್ದಾರೆ"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "ಮುಖದ ದೃಢೀಕರಣವನ್ನು ಪ್ರಯತ್ನಿಸಲಾಗುತ್ತಿದೆ"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "ಬಳಕೆದಾರರನ್ನು ನಿರ್ಧರಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ, ದಯವಿಟ್ಟು --user ಧ್ವಜವನ್ನು ಬಳಸಿ"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello ಮುಖದ ದೃಢೀಕರಣಕ್ಕಾಗಿ ಕಮಾಂಡ್ ಲೈನ್ ಇಂಟರ್ಫೇಸ್."

#: src/cli.py:35
msgid "command"
msgstr "ಆಜ್ಞೆ"

#: src/cli.py:35
msgid "arguments"
msgstr "ವಾದಗಳು"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"ಬೆಂಬಲಕ್ಕಾಗಿ ದಯವಿಟ್ಟು ಭೇಟಿ ನೀಡಿ\nhttps://github.com/ventura8/ubuntu-hel"
"lo"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"ಕಾರ್ಯಗತಗೊಳಿಸಲು ಕಮಾಂಡ್ ಆಯ್ಕೆಯು ಈ ಕೆಳಗಿನವುಗಳಲ್ಲಿ ಒಂದಾಗಿರಬಹುದು: ಸೇರಿಸಿ, ತ"
"ೆರವುಗೊಳಿಸಿ, ಕಾನ್ಫಿಗರ್, ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ, ಕೀರಿಂಗ್, ಪಟ್ಟಿ, ತೆಗೆದುಹಾಕಿ, ಸ್"
"ನ್ಯಾಪ್‌ಶಾಟ್, ಸೆಟ್, ಪರೀಕ್ಷೆ ಅಥವಾ ಆವೃತ್ತಿ."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr ""
"ಆಜ್ಞೆಗಳನ್ನು ಸೇರಿಸಲು, ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು, ತೆಗೆದುಹಾಕಿ ಮತ್ತು ಹೊಂದಿಸಲು ಐಚ್ಛಿ"
"ಕ ವಾದಗಳು."

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "ಬಳಕೆದಾರ ಖಾತೆಯನ್ನು ಬಳಸಲು ಹೊಂದಿಸಿ."

#: src/cli.py:60
msgid "Skip all questions."
msgstr "ಎಲ್ಲಾ ಪ್ರಶ್ನೆಗಳನ್ನು ಬಿಟ್ಟುಬಿಡಿ."

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "ಯಂತ್ರ ಸ್ನೇಹಿ ಔಟ್‌ಪುಟ್ ಅನ್ನು ಮುದ್ರಿಸಿ."

#: src/cli.py:74
msgid "Show this help message and exit."
msgstr "ಈ ಸಹಾಯ ಸಂದೇಶವನ್ನು ತೋರಿಸಿ ಮತ್ತು ನಿರ್ಗಮಿಸಿ."

#: src/cli.py:78
msgid "current active user: "
msgstr "ಪ್ರಸ್ತುತ ಸಕ್ರಿಯ ಬಳಕೆದಾರ:"

#: src/cli.py:88
msgid "Invalid username format"
msgstr "ಅಮಾನ್ಯ ಬಳಕೆದಾರಹೆಸರು ಸ್ವರೂಪ"

#: src/cli.py:98
msgid ""
"Please run this command as root:\n"
msgstr ""
"ದಯವಿಟ್ಟು ಈ ಆಜ್ಞೆಯನ್ನು ರೂಟ್ ಆಗಿ ಚಲಾಯಿಸಿ:\n"

#: src/cli.py:104
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr ""
"ubuntu-hello ಆಜ್ಞೆಗಳನ್ನು ರೂಟ್ ಆಗಿ ಚಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ, ದಯವಿಟ್ಟು --user"
" ಧ್ವಜದೊಂದಿಗೆ ಈ ಆಜ್ಞೆಯನ್ನು ಚಲಾಯಿಸಿ"

#: src/compare.py:128 src/cli/add.py:32
msgid "Data files have not been downloaded, please run the following commands:"
msgstr ""
"ಡೇಟಾ ಫೈಲ್‌ಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲಾಗಿಲ್ಲ, ದಯವಿಟ್ಟು ಈ ಕೆಳಗಿನ ಆಜ್ಞೆಗಳನ್ನು ಚ"
"ಲಾಯಿಸಿ:"

#: src/compare.py:154
msgid " LOGIN"
msgstr "ಲಾಗಿನ್"

#: src/compare.py:155 src/cli/snap.py:44
msgid "Date: "
msgstr "ದಿನಾಂಕ:"

#: src/compare.py:156
msgid "Scan time: "
msgstr "ಸ್ಕ್ಯಾನ್ ಸಮಯ:"

#: src/compare.py:157
msgid "Frames: "
msgstr "ಚೌಕಟ್ಟುಗಳು:"

#: src/compare.py:158
msgid "Hostname: "
msgstr "ಹೋಸ್ಟ್ ಹೆಸರು:"

#: src/compare.py:159
msgid "Best certainty value: "
msgstr "ಅತ್ಯುತ್ತಮ ನಿಶ್ಚಿತ ಮೌಲ್ಯ:"

#: src/compare.py:259
msgid "Starting up..."
msgstr "ಪ್ರಾರಂಭಿಸಲಾಗುತ್ತಿದೆ..."

#: src/compare.py:312
msgid "Identifying you..."
msgstr "ನಿಮ್ಮನ್ನು ಗುರುತಿಸಲಾಗುತ್ತಿದೆ..."

#: src/compare.py:344
msgid "FAILED"
msgstr "ವಿಫಲವಾಗಿದೆ"

#: src/compare.py:347 src/cli/add.py:184
msgid "All frames were too dark, please check dark_threshold in config"
msgstr ""
"ಎಲ್ಲಾ ಫ್ರೇಮ್‌ಗಳು ತುಂಬಾ ಗಾಢವಾಗಿವೆ, ದಯವಿಟ್ಟು ಸಂರಚನೆಯಲ್ಲಿ ಡಾರ್ಕ್_ಥ್ರೆಶೋಲ್"
"ಡ್ ಅನ್ನು ಪರಿಶೀಲಿಸಿ"

#: src/compare.py:348 src/cli/add.py:185
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "ಸರಾಸರಿ ಕತ್ತಲೆ: {avg}, ಮಿತಿ: {threshold}"

#: src/compare.py:449
msgid "Time spent"
msgstr "ಸಮಯ ಕಳೆದಿದೆ"

#: src/compare.py:450
msgid "Starting up"
msgstr "ಪ್ರಾರಂಭಿಸಲಾಗುತ್ತಿದೆ"

#: src/compare.py:451
msgid "  Open cam + load libs: %dms"
msgstr "ಓಪನ್ ಕ್ಯಾಮ್ + ಲೋಡ್ ಲಿಬ್ಸ್: %dms"

#: src/compare.py:452
msgid "  Opening the camera"
msgstr "ಕ್ಯಾಮರಾ ತೆರೆಯಲಾಗುತ್ತಿದೆ"

#: src/compare.py:453
msgid "  Importing recognition libs"
msgstr "ಗುರುತಿಸುವಿಕೆ ಲಿಬ್‌ಗಳನ್ನು ಆಮದು ಮಾಡಿಕೊಳ್ಳಲಾಗುತ್ತಿದೆ"

#: src/compare.py:454
msgid "Searching for known face"
msgstr "ಪರಿಚಿತ ಮುಖವನ್ನು ಹುಡುಕಲಾಗುತ್ತಿದೆ"

#: src/compare.py:455
msgid "Total time"
msgstr "ಒಟ್ಟು ಸಮಯ"

#: src/compare.py:457
msgid ""
"\nResolution"
msgstr ""
"\nರೆಸಲ್ಯೂಶನ್"

#: src/compare.py:459
msgid "  Native: %dx%d"
msgstr "ಸ್ಥಳೀಯ: %dx%d"

#: src/compare.py:462
msgid "  Used: %dx%d"
msgstr "ಬಳಸಲಾಗಿದೆ: %dx%d"

#: src/compare.py:465
msgid ""
"\nFrames searched: %d (%.2f fps)"
msgstr ""
"\nಚೌಕಟ್ಟುಗಳನ್ನು ಹುಡುಕಲಾಗಿದೆ: %d (%.2f fps)"

#: src/compare.py:466
msgid "Black frames ignored: %d "
msgstr "ಕಪ್ಪು ಚೌಕಟ್ಟುಗಳನ್ನು ನಿರ್ಲಕ್ಷಿಸಲಾಗಿದೆ: %d"

#: src/compare.py:467
msgid "Dark frames ignored: %d "
msgstr "ಡಾರ್ಕ್ ಫ್ರೇಮ್‌ಗಳನ್ನು ನಿರ್ಲಕ್ಷಿಸಲಾಗಿದೆ: %d"

#: src/compare.py:468
msgid "Certainty of winning frame: %.3f"
msgstr "ಗೆಲ್ಲುವ ಚೌಕಟ್ಟಿನ ಖಚಿತತೆ: %.3f"

#: src/compare.py:470
msgid "Winning model: %d (\"%s\")"
msgstr "ವಿಜೇತ ಮಾದರಿ: %d (\"%s\")"

#: src/compare.py:474
msgid "SUCCESSFUL"
msgstr "ಯಶಸ್ವಿಯಾಗಿದೆ"

#: src/wallet_backend.py:62 src/wallet_backend.py:72
msgid "KWallet"
msgstr "KWallet"

#: src/wallet_backend.py:64
msgid "GNOME Keyring"
msgstr "GNOME Keyring"

#: src/wallet_backend.py:65
msgid "None"
msgstr "None"

#: src/wallet_backend.py:74
msgid "login keyring"
msgstr "ಲಾಗಿನ್ ಕೀರಿಂಗ್"

#: src/wallet_backend.py:75
msgid "login keyring or KWallet"
msgstr "ಲಾಗಿನ್ ಕೀರಿಂಗ್ ಅಥವಾ KWallet"

#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\ndlib ಮಾಡ್ಯೂಲ್ ಅನ್ನು ಆಮದು ಮಾಡಿಕೊಳ್ಳಲು ಸಾಧ್ಯವಿಲ್ಲ, ಇದರ ಔಟ್‌ಪುಟ್ ಪರಿಶೀಲ"
"ಿಸಿ"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "ಯಾವುದೇ ಮುಖದ ಮಾದರಿ ಫೋಲ್ಡರ್ ಕಂಡುಬಂದಿಲ್ಲ, ಒಂದನ್ನು ರಚಿಸಲಾಗುತ್ತಿದೆ"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr ""
"ಸೂಚನೆ: ಪ್ರತಿ ಹೆಚ್ಚುವರಿ ಮಾದರಿಯು ಮುಖ ಗುರುತಿಸುವಿಕೆ ಎಂಜಿನ್ ಅನ್ನು ಸ್ವಲ್ಪಮಟ್"
"ಟಿಗೆ ನಿಧಾನಗೊಳಿಸುತ್ತದೆ"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"ರದ್ದುಗೊಳಿಸಲು Ctrl+C ಒತ್ತಿರಿ\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "ಬಳಕೆದಾರರಿಗೆ ಮುಖದ ಮಾದರಿಯನ್ನು ಸೇರಿಸಲಾಗುತ್ತಿದೆ"

#: src/cli/add.py:88
msgid "Model #"
msgstr "ಮಾದರಿ #"

#: src/cli/add.py:92
msgid "Using default label \"%s\" because of -y flag"
msgstr "-y ಫ್ಲ್ಯಾಗ್‌ನಿಂದಾಗಿ \"%s\" ಡೀಫಾಲ್ಟ್ ಲೇಬಲ್ ಅನ್ನು ಬಳಸಲಾಗುತ್ತಿದೆ"

#: src/cli/add.py:95
msgid "Enter a label for this new model [{}]: "
msgstr "ಈ ಹೊಸ ಮಾದರಿಗಾಗಿ ಲೇಬಲ್ ಅನ್ನು ನಮೂದಿಸಿ [{}]:"

#: src/cli/add.py:103
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "ಸೂಚನೆ: ಮಾದರಿ ಹೆಸರಿನಿಂದ ಅಕ್ರಮ ಅಕ್ಷರ \",\" ತೆಗೆದುಹಾಕಲಾಗುತ್ತಿದೆ"

#: src/cli/add.py:117
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nದಯವಿಟ್ಟು ನೇರವಾಗಿ ಕ್ಯಾಮರಾದಲ್ಲಿ ನೋಡಿ"

#: src/cli/add.py:182
msgid "Camera saw only black frames - is IR emitter working?"
msgstr ""
"ಕ್ಯಾಮೆರಾ ಕಪ್ಪು ಚೌಕಟ್ಟುಗಳನ್ನು ಮಾತ್ರ ನೋಡಿದೆ - ಐಆರ್ ಎಮಿಟರ್ ಕಾರ್ಯನಿರ್ವಹಿಸು"
"ತ್ತಿದೆಯೇ?"

#: src/cli/add.py:187
msgid "No face detected, aborting"
msgstr "ಯಾವುದೇ ಮುಖ ಪತ್ತೆಯಾಗಿಲ್ಲ, ಸ್ಥಗಿತಗೊಳಿಸಲಾಗುತ್ತಿದೆ"

#: src/cli/add.py:192
msgid "Multiple faces detected, aborting"
msgstr "ಬಹು ಮುಖಗಳನ್ನು ಪತ್ತೆಹಚ್ಚಲಾಗಿದೆ, ಸ್ಥಗಿತಗೊಳಿಸಲಾಗುತ್ತಿದೆ"

#: src/cli/add.py:214
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nಸ್ಕ್ಯಾನ್ ಪೂರ್ಣಗೊಂಡಿದೆ\nಗೆ ಹೊಸ ಮಾದರಿಯನ್ನು ಸೇರಿಸಲಾಗಿದೆ"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr ""
"ಯಾವುದೇ ಮಾದರಿಗಳನ್ನು ಇನ್ನೂ ರಚಿಸಲಾಗಿಲ್ಲ, ಅವುಗಳು ಅಸ್ತಿತ್ವದಲ್ಲಿಲ್ಲದಿದ್ದರೆ ಅ"
"ವುಗಳನ್ನು ತೆರವುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} ಯಾವುದೇ ಮಾದರಿಗಳನ್ನು ಹೊಂದಿಲ್ಲ ಅಥವಾ ಅವುಗಳನ್ನು ಈಗಾಗಲೇ ತೆರವುಗೊಳಿಸಲಾಗಿದೆ"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "ಇದು ಎಲ್ಲಾ ಮಾದರಿಗಳನ್ನು ತೆರವುಗೊಳಿಸುತ್ತದೆ"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "ನೀವು [y/N] ಮುಂದುವರಿಸಲು ಬಯಸುವಿರಾ:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\n\"ಇಲ್ಲ\" ಎಂದು ಅರ್ಥೈಸುವುದು, ಸ್ಥಗಿತಗೊಳಿಸುವುದು"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nಮಾದರಿಗಳನ್ನು ತೆರವುಗೊಳಿಸಲಾಗಿದೆ"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "{editor} ನಲ್ಲಿ config.ini ತೆರೆಯಲಾಗುತ್ತಿದೆ"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "ಸಂಪಾದಕವನ್ನು ತೆರೆಯಲು ವಿಫಲವಾಗಿದೆ: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "ದೋಷ: ಸೂಕ್ತವಾದ ಪಠ್ಯ ಸಂಪಾದಕವನ್ನು ಕಂಡುಹಿಡಿಯಲಾಗಲಿಲ್ಲ."

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr ""
"ದಯವಿಟ್ಟು 'nano' ಅಥವಾ 'vi' ಅನ್ನು ಸ್ಥಾಪಿಸಿ ಅಥವಾ EDITOR ಪರಿಸರ ವೇರಿಯೇಬಲ್ ಅ"
"ನ್ನು ಹೊಂದಿಸಿ."

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."

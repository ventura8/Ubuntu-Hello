msgstr "მოდელები ჯერ არ არის შექმნილი, ვერ გავასუფთავებთ თუ არ არსებობენ"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} არ აქვს მოდელები ან ისინი უკვე გასუფთავებულია"

#: src/cli/clear.py:27

"o"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"შესასრულებელი ბრძანების ვარიანტი შეიძლება იყოს ერთ-ერთი შემდეგი: დამატ"
"ება, გასუფთავება, კონფიგურაცია, გამორთვა, კლავიშების დაჭერა, სია, წაშლ"
"ა, სნეპშოტი, დაყენება, ტესტირება ან ვერსია."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "არჩევითი არგუმენტები დამატება, გამორთვა, წაშლა და დაყენების ბრძანებები."

#: src/cli.py:55
msgid "Set the user account to use."

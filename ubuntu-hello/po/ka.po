#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr "მოდელები ჯერ არ არის შექმნილი, ვერ გავასუფთავებთ თუ არ არსებობენ"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} არ აქვს მოდელები ან ისინი უკვე გასუფთავებულია"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "ეს გაასუფთავებს ყველა მოდელს"

#: src/cli/clear.py:28 src/cli/remove.py:53

msgstr ""
"Якщо запити тривають, встановіть пароль брелока входу або KWallet у Se"
"ahorse / Параметрах системи."

#: src/cli/keyring.py:161
msgid "Restored login wallet password for user {}."
msgstr "Пароль гаманця входу відновлено для користувача {}."

#: src/cli/keyring.py:163
msgid "Could not restore login wallet password for user {}."
msgstr "Не вдалося відновити пароль гаманця входу для користувача {}."

#: src/cli/keyring.py:167

#: src/compare.py:266
msgid "Starting up..."
msgstr "ආරම්භ කරමින්..."

#: src/compare.py:319
msgid "Identifying you..."
msgstr "ඔබව හඳුනා ගනිමින්..."

#: src/compare.py:351
msgid "FAILED"
msgstr "අසාර්ථකයි"

#: src/compare.py:354 src/cli/add.py:188
msgid "All frames were too dark, please check dark_threshold in config"
msgstr ""
"සියලුම රාමු අඳුරු වැඩියි, කරුණාකර වින්‍යාසය තුළ අඳුරු_ඉතිහාසය පරීක්ෂා "
"කරන්න"

#: src/compare.py:355 src/cli/add.py:189
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "සාමාන්‍ය අන්ධකාරය: {avg}, සීමාව: {threshold}"

#: src/compare.py:456
msgid "Time spent"
msgstr "ගත කළ කාලය"

#: src/compare.py:457
msgid "Starting up"
msgstr "ආරම්භ කිරීම"

#: src/compare.py:458
msgid "  Open cam + load libs: %dms"
msgstr "විවෘත cam + load libs: %dms"

#: src/compare.py:459
msgid "  Opening the camera"
msgstr "කැමරාව විවෘත කිරීම"

#: src/compare.py:460
msgid "  Importing recognition libs"
msgstr "පිළිගැනීමේ ලිබ් ආනයනය කිරීම"

#: src/compare.py:461
msgid "Searching for known face"
msgstr "දන්නා මුහුණ සොයමින්"

#: src/compare.py:462
msgid "Total time"
msgstr "මුළු කාලය"

#: src/compare.py:464
msgid ""
"\nResolution"
msgstr ""
"\nවිභේදනය"

#: src/compare.py:466
msgid "  Native: %dx%d"
msgstr "නිජබිම: %dx%d"

#: src/compare.py:469
msgid "  Used: %dx%d"
msgstr "භාවිත: %dx%d"

#: src/compare.py:472
msgid ""
"\nFrames searched: %d (%.2f fps)"
msgstr ""
"\nසෙවූ රාමු: %d (%.2f fps)"

#: src/compare.py:473
msgid "Black frames ignored: %d "
msgstr "කළු රාමු නොසලකා හැර ඇත: %d"

#: src/compare.py:474
msgid "Dark frames ignored: %d "
msgstr "අඳුරු රාමු නොසලකා හරින ලදී: %d"

#: src/compare.py:475
msgid "Certainty of winning frame: %.3f"
msgstr "ජයග්‍රාහී රාමුවේ නිශ්චිතභාවය: %.3f"

#: src/compare.py:477
msgid "Winning model: %d (\"%s\")"
msgstr "ජයග්‍රාහී ආකෘතිය: %d (\"%s\")"

#: src/compare.py:481
msgid "SUCCESSFUL"
msgstr "සාර්ථකයි"

#: src/wallet_backend.py:62 src/wallet_backend.py:72
msgid "KWallet"
msgstr "KWallet"

#: src/wallet_backend.py:64
msgid "GNOME Keyring"
msgstr "GNOME Keyring"

#: src/wallet_backend.py:65
msgid "None"
msgstr "None"

#: src/wallet_backend.py:74
msgid "login keyring"
msgstr "පිවිසුම් යතුරුකරණය"

#: src/wallet_backend.py:75
msgid "login keyring or KWallet"
msgstr "පිවිසුම් යතුරුකරණය හෝ KWallet"

#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\ndlib මොඩියුලය ආයාත කළ නොහැක, ප්‍රතිදානය පරීක්ෂා කරන්න"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "මුහුණු ආකෘති ෆෝල්ඩරයක් හමු නොවීය, එකක් සාදයි"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr ""
"දැනුම්දීම: සෑම අමතර මාදිලියක්ම මුහුණු හඳුනාගැනීමේ එන්ජිම තරමක් මන්දගාම"
"ී කරයි"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"අවලංගු කිරීමට Ctrl+C ඔබන්න\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "පරිශීලකයා සඳහා මුහුණු ආකෘතිය එක් කිරීම"

#: src/cli/add.py:88
msgid "Model #"
msgstr "මාදිලිය #"

#: src/cli/add.py:93
msgid "Using default label \"%s\" because of -y flag"
msgstr "-y ධජය නිසා \"%s\" පෙරනිමි ලේබලය භාවිතා කිරීම"

#: src/cli/add.py:97
msgid "Enter a label for this new model [{}]: "
msgstr "මෙම නව මාදිලිය සඳහා ලේබලයක් ඇතුළු කරන්න [{}]:"

#: src/cli/add.py:107
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "දැනුම්දීම: ආකෘති නාමයෙන් නීති විරෝධී අක්ෂර \",\" ඉවත් කිරීම"

#: src/cli/add.py:121
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nකරුණාකර කෙලින්ම කැමරාව දෙස බලන්න"

#: src/cli/add.py:186
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "කැමරාව දුටුවේ කළු රාමු පමණි - IR විමෝචකය ක්‍රියා කරයිද?"

#: src/cli/add.py:191
msgid "No face detected, aborting"
msgstr "මුහුණක් අනාවරණය වී නැත, ගබ්සා කිරීම"

#: src/cli/add.py:196
msgid "Multiple faces detected, aborting"
msgstr "බහු මුහුණු අනාවරණය කර ගැනීම, ගබ්සා කිරීම"

#: src/cli/add.py:218
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nස්කෑන් කිරීම සම්පූර්ණයි\nනව මාදිලියක් එකතු කරන ලදී"


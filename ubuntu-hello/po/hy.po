msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\nՄեկնաբանել որպես «ՉԻ», վիժեցնել"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nՄոդելները մաքրված են"


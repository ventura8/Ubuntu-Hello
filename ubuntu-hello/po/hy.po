#: src/cli.py:35
msgid "arguments"
msgstr "փաստարկներ"

#: src/cli.py:36
msgid ""
"For support please visit\n"
"https://github.com/ventura8/ubuntu-hello"
msgstr ""
"Աջակցության համար խնդրում ենք այցելել\n"
"https://github.com/ventura8/ubuntu-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear, "
"config, disable, keyring, list, remove, snapshot, set, test or version."
msgstr ""
"Կատարելու հրամանի տարբերակը կարող է լինել հետևյալներից մեկը՝ ավելացնել, "
"մաքրել, կազմաձևել, անջատել, ստեղնաշար, ցուցակել, հեռացնել, լուսանկար, "
"սահմանել, փորձարկել կամ տարբերակ:"

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr ""
"Լրացուցիչ, անջատելու, հեռացնելու և սահմանելու հրամանների կամընտիր փաստարկներ:"


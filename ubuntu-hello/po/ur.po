msgid "Print machine-friendly output."
msgstr "پرنٹ مشین دوستانہ آؤٹ پٹ۔"

#: src/cli.py:74
msgid "Show this help message and exit."
msgstr "یہ مدد پیغام دکھائیں اور باہر نکلیں۔"


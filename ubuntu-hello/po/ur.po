msgstr "صارف کا تعین نہیں کیا جا سکا، براہ کرم --user پرچم استعمال کریں۔"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello چہرے کی توثیق کے لیے کمانڈ لائن انٹرفیس۔"

#: src/cli.py:35
msgid "command"
msgstr "حکم"

#: src/cli.py:35
msgid "arguments"
msgstr "دلائل"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"سپورٹ کے لیے براہ کرم ملاحظہ کریں۔\nhttps://github.com/ventura8/ubuntu"

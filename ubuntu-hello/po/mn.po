#: src/compare.py:116
msgid "Hostname: "
msgstr "Хост нэр:"

#: src/compare.py:117
msgid "Best certainty value: "
msgstr "Хамгийн сайн баталгааны үнэ цэнэ:"

#: src/compare.py:214
msgid "Starting up..."
msgstr "Эхэлж байна..."

#: src/compare.py:262
msgid "Identifying you..."
msgstr "Таныг тодорхойлж байна..."

#: src/compare.py:285
msgid "FAILED"
msgstr "БҮТЭЭЛГҮЙ"

#: src/compare.py:288 src/cli/add.py:184

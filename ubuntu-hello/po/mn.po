#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Hello идэвхгүй болсон"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Hello идэвхжсэн"

#: src/cli/keyring.py:36 src/cli/keyring.py:156
msgid "Usage:"
msgstr "Хэрэглээ:"

#: src/cli/keyring.py:53
msgid "Enter password for user {} to unlock {} ({}): "
msgstr "{} ({}) түгжээг тайлахын тулд хэрэглэгчийн {} нууц үгийг оруулна уу:"

#: src/cli/keyring.py:55
msgid "Password cannot be empty"
msgstr "Нууц үг хоосон байж болохгүй"

#: src/cli/keyring.py:58
msgid "Confirm password: "
msgstr "Нууц үгээ баталгаажуулах:"

#: src/cli/keyring.py:60
msgid "Passwords do not match"
msgstr "Нууц үг таарахгүй байна"

#: src/cli/keyring.py:69
msgid "TPM hardware detected. Auto-installing tpm2-tools..."
msgstr "TPM техник хангамж илэрсэн. tpm2-tools-г автоматаар суулгаж байна..."

#: src/cli/keyring.py:78
msgid "TPM hardware active. Sealing password in TPM..."
msgstr "TPM техник хангамж идэвхтэй байна. TPM дээр нууц үгийг битүүмжлэх..."

#: src/cli/keyring.py:104
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} using TPM "
"(wallet: {})."
msgstr ""
"TPM (түрийвч: {}) ашиглан {} хэрэглэгчийн хувьд түлхүүрийн/KWallet түгжээг "
"тайлахыг амжилттай идэвхжүүлсэн."

#: src/cli/keyring.py:106
msgid "Failed to seal password to TPM: {}"
msgstr "TPM-д нууц үгийг битүүмжилж чадсангүй: {}"

#: src/cli/keyring.py:110
msgid "No TPM active. Using software-based credential caching..."
msgstr ""
"Идэвхтэй TPM байхгүй. Програм хангамжид суурилсан итгэмжлэлийн кэшийг "
"ашиглах..."

#: src/cli/keyring.py:126
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} (Software "

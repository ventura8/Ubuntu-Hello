#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "Амжилтгүй, хугацаа хэтэрсэн"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "Нүүр таних дүрс хэт бараан байна"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "Үл мэдэгдэх алдаа:"

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "%s гэж тодорхойлсон царай"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr ""
"Enter товчийг илгээхэд хангалттай зөвшөөрөл байхгүй тул хэрэглэгч үүни"
"йг дарахыг хүлээж байна"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr ""
"Enter товчийг илгээж чадсангүй, хэрэглэгчийн оронд үүнийг дарахыг хүлэ"
"эж байна"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "Нүүр царайгаар баталгаажуулахыг оролдож байна"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "Хэрэглэгчийг тодорхойлж чадсангүй, --user тугийг ашиглана уу"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello царайг баталгаажуулах командын мөрийн интерфейс."

#: src/cli.py:35
msgid "command"
msgstr "тушаал"

#: src/cli.py:35
msgid "arguments"
msgstr "аргументууд"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"Дэмжлэг авахыг хүсвэл зочилно уу\nhttps://github.com/ventura8/ubuntu-h"
"ello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"Гүйцэтгэх командын сонголт нь дараах зүйлсийн аль нэг нь байж болно: н"
"эмэх, арилгах, тохируулах, идэвхгүй болгох, түлхүүр, жагсаалт, устгах,"
" хормын хувилбар, тохируулах, турших эсвэл хувилбар."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "Нэмэх, идэвхгүй болгох, устгах, тохируулах командын нэмэлт аргументууд."

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "Ашиглах хэрэглэгчийн бүртгэлийг тохируулна уу."

#: src/cli.py:60
msgid "Skip all questions."
msgstr "Бүх асуултыг алгасах."

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "Машинд ээлтэй гаралтыг хэвлэх."

#: src/cli.py:74
msgid "Show this help message and exit."
msgstr "Энэ тусламжийн мессежийг үзүүлээд гар."

#: src/cli.py:78
msgid "current active user: "
msgstr "Одоогийн идэвхтэй хэрэглэгч:"

#: src/cli.py:88
msgid "Invalid username format"
msgstr "Хэрэглэгчийн нэрийн формат буруу байна"

#: src/cli.py:98
msgid ""
"Please run this command as root:\n"
msgstr ""
"Энэ тушаалыг root болгон ажиллуулна уу:\n"

#: src/cli.py:104
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr ""
"Ubuntu-hello командуудыг root болгон ажиллуулах боломжгүй, энэ команды"
"г --user туг ашиглан ажиллуулна уу."

#: src/compare.py:128 src/cli/add.py:32
msgid "Data files have not been downloaded, please run the following commands:"
msgstr "Өгөгдлийн файлуудыг татаж аваагүй тул дараах тушаалуудыг ажиллуулна уу:"

#: src/compare.py:154
msgid " LOGIN"
msgstr "НЭВТРЭХ"

#: src/compare.py:155 src/cli/snap.py:44
msgid "Date: "
msgstr "Огноо:"

#: src/compare.py:156
msgid "Scan time: "
msgstr "Скан хийх хугацаа:"

#: src/compare.py:157
msgid "Frames: "
msgstr "Хүрээ:"

#: src/compare.py:158
msgid "Hostname: "
msgstr "Хост нэр:"

#: src/compare.py:159
msgid "Best certainty value: "
msgstr "Хамгийн сайн баталгааны үнэ цэнэ:"

#: src/compare.py:259
msgid "Starting up..."
msgstr "Эхэлж байна..."

#: src/compare.py:312
msgid "Identifying you..."
msgstr "Таныг тодорхойлж байна..."

#: src/compare.py:344
msgid "FAILED"
msgstr "БҮТЭЭЛГҮЙ"

#: src/compare.py:347 src/cli/add.py:184
msgid "All frames were too dark, please check dark_threshold in config"
msgstr "Бүх хүрээ хэт бараан байсан тул тохиргооноос dark_threshold-г шалгана уу"

#: src/compare.py:348 src/cli/add.py:185
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "Дундаж харанхуй: {avg}, Босго: {threshold}"

#: src/compare.py:449
msgid "Time spent"
msgstr "Цаг хугацаа зарцуулсан"

#: src/compare.py:450
msgid "Starting up"
msgstr "Эхлэж байна"

#: src/compare.py:451
msgid "  Open cam + load libs: %dms"
msgstr "Нээлттэй камер + ачаалах хэсэг: %dms"

#: src/compare.py:452
msgid "  Opening the camera"
msgstr "Камерыг нээж байна"

#: src/compare.py:453
msgid "  Importing recognition libs"
msgstr "Таних файлуудыг импортлож байна"

#: src/compare.py:454
msgid "Searching for known face"
msgstr "Мэдэгдэж буй царайг хайж байна"

#: src/compare.py:455
msgid "Total time"
msgstr "Нийт хугацаа"

#: src/compare.py:457
msgid ""
"\nResolution"
msgstr ""
"\nШийдвэр"

#: src/compare.py:459
msgid "  Native: %dx%d"
msgstr "Төрөлх: %dx%d"

#: src/compare.py:462
msgid "  Used: %dx%d"
msgstr "Ашигласан: %dx%d"

#: src/compare.py:465
msgid ""
"\nFrames searched: %d (%.2f fps)"
msgstr ""
"\nХайсан хүрээ: %d (%.2f fps)"

#: src/compare.py:466
msgid "Black frames ignored: %d "
msgstr "Хар хүрээг үл тоомсорлосон: %d"

#: src/compare.py:467
msgid "Dark frames ignored: %d "
msgstr "Бараан хүрээг үл тоомсорлосон: %d"

#: src/compare.py:468
msgid "Certainty of winning frame: %.3f"
msgstr "Ялалтын хүрээ: %.3f"

#: src/compare.py:470
msgid "Winning model: %d (\"%s\")"
msgstr "Ялагч загвар: %d (\"%s\")"

#: src/compare.py:474
msgid "SUCCESSFUL"
msgstr "АМЖИЛТТАЙ"

#: src/wallet_backend.py:62 src/wallet_backend.py:72
msgid "KWallet"
msgstr "KWallet"

#: src/wallet_backend.py:64
msgid "GNOME Keyring"
msgstr "GNOME Keyring"

#: src/wallet_backend.py:65
msgid "None"
msgstr "None"

#: src/wallet_backend.py:74
msgid "login keyring"
msgstr "нэвтрэх түлхүүрийн бөгж"

#: src/wallet_backend.py:75
msgid "login keyring or KWallet"
msgstr "нэвтрэх түлхүүр эсвэл KWallet"

#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\ndlib модулийг импортлох боломжгүй, гаралтыг шалгана уу"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "Нүүрний загварын хавтас олдсонгүй, нэгийг үүсгэсэн"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr ""
"АНХААРУУЛГА: Нэмэлт загвар бүр нь царай таних хөдөлгүүрийг бага зэрэг "
"удаашруулдаг"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"Цуцлахын тулд Ctrl+C дарна уу\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "Хэрэглэгчийн нүүрний загварыг нэмж байна"

#: src/cli/add.py:88
msgid "Model #"
msgstr "Загвар #"

#: src/cli/add.py:92
msgid "Using default label \"%s\" because of -y flag"
msgstr "-y тугны улмаас \"%s\" гэсэн өгөгдмөл шошгыг ашиглаж байна"

#: src/cli/add.py:95
msgid "Enter a label for this new model [{}]: "
msgstr "Энэ шинэ загварын [{}] шошгыг оруулна уу:"

#: src/cli/add.py:103
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "АНХААРУУЛГА: Загварын нэрнээс хууль бус тэмдэгт \",\" устгаж байна"

#: src/cli/add.py:117
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nКамер руу шууд харна уу"

#: src/cli/add.py:182
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "Камер зөвхөн хар хүрээ харсан - IR ялгаруулагч ажиллаж байна уу?"

#: src/cli/add.py:187
msgid "No face detected, aborting"
msgstr "Царай илрээгүй, цуцалж байна"

#: src/cli/add.py:192
msgid "Multiple faces detected, aborting"
msgstr "Олон царай илрүүлсэн, цуцалж байна"

#: src/cli/add.py:214
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nСкан хийж дууслаа\nШинэ загвар нэмсэн"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr "Одоогоор загвар үүсгээгүй, байхгүй бол тэдгээрийг арилгах боломжгүй"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} загвар байхгүй эсвэл тэдгээрийг аль хэдийн арилгасан"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "Энэ нь бүх загварыг цэвэрлэх болно"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "Та үргэлжлүүлэхийг хүсэж байна уу [y/N]:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\n\"ҮГҮЙ\" гэж тайлбарлаж, цуцлах"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nЗагваруудыг арилгасан"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "config.ini-г {editor} дотор нээж байна"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "Засварлагчийг нээж чадсангүй: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "Алдаа: Тохирох текст засварлагч олдсонгүй."

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr ""
"'nano' эсвэл 'vi'-г суулгана уу эсвэл EDITOR орчны хувьсагчийг тохируу"
"лна уу."

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."
msgstr ""
"Хэрэв та энэ командыг sudo-р ажиллуулж байгаа бол 'sudo -E ubuntu-hell"
"o config'-г ашиглан EDITOR хувьсагчаа хадгална уу."

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "Аргумент болгон 0 (идэвхжүүлэх) эсвэл 1 (идэвхгүй болгох) нэмнэ үү"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr ""
"Зөвхөн 0 (идэвхжүүлэх) эсвэл 1 (идэвхгүй болгох) утгыг аргумент болгон"
" ашиглана уу"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "Идэвхгүй болгох сонголтыг аль хэдийн тохируулсан байна"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Hello идэвхгүй болсон"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Hello идэвхжсэн"

#: src/cli/keyring.py:32 src/cli/keyring.py:157
msgid "Usage: keyring [enable|disable|restore [--all]]"
msgstr "Хэрэглээ: түлхүүрийн бөгж [идэвхжүүлэх|идэвхгүй болгох|сэргээх] [--all]"

#: src/cli/keyring.py:49
msgid "Enter password for user {} to unlock {} ({}): "
msgstr "{} ({}) түгжээг тайлахын тулд хэрэглэгчийн {} нууц үгийг оруулна уу:"

#: src/cli/keyring.py:51
msgid "Password cannot be empty"
msgstr "Нууц үг хоосон байж болохгүй"

#: src/cli/keyring.py:54
msgid "Confirm password: "
msgstr "Нууц үгээ баталгаажуулах:"

#: src/cli/keyring.py:56
msgid "Passwords do not match"
msgstr "Нууц үг таарахгүй байна"

#: src/cli/keyring.py:65
msgid "TPM hardware detected. Auto-installing tpm2-tools..."
msgstr "TPM техник хангамж илэрсэн. tpm2-tools-г автоматаар суулгаж байна..."

#: src/cli/keyring.py:74
msgid "TPM hardware active. Sealing password in TPM..."
msgstr "TPM техник хангамж идэвхтэй байна. TPM дээр нууц үгийг битүүмжлэх..."

#: src/cli/keyring.py:100
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} using TPM ("
"wallet: {})."
msgstr ""
"TPM (түрийвч: {}) ашиглан {} хэрэглэгчийн хувьд түлхүүрийн/KWallet түг"
"жээг тайлахыг амжилттай идэвхжүүлсэн."

#: src/cli/keyring.py:102
msgid "Failed to seal password to TPM: {}"
msgstr "TPM-д нууц үгийг битүүмжилж чадсангүй: {}"

#: src/cli/keyring.py:106
msgid "No TPM active. Using software-based credential caching..."
msgstr ""
"Идэвхтэй TPM байхгүй. Програм хангамжид суурилсан итгэмжлэлийн кэшийг "
"ашиглах..."

#: src/cli/keyring.py:122
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} (Software C"
"aching, wallet: {})."
msgstr ""
"Түлхүүр/KWallet түгжээг тайлахыг {} хэрэглэгчийн хувьд амжилттай идэвх"
"жүүлсэн (Програм хангамжийн кэш, түрийвч: {})."

#: src/cli/keyring.py:124
msgid "Failed to enable keyring unlocking: {}"
msgstr "Түлхүүрийн түгжээг тайлахыг идэвхжүүлж чадсангүй: {}"

#: src/cli/keyring.py:135
msgid "Failed to disable keyring unlocking: {}"
msgstr "Түлхүүрийн түгжээг тайлахыг идэвхгүй болгож чадсангүй: {}"

#: src/cli/keyring.py:138
msgid "Keyring/KWallet unlocking disabled for user {}."
msgstr "Түлхүүр/KWallet түгжээг тайлах {} хэрэглэгчийн хувьд идэвхгүй болсон."

#: src/cli/keyring.py:140
msgid "Keyring/KWallet unlocking was not enabled for user {}."
msgstr "Түлхүүр/KWallet түгжээг тайлахыг хэрэглэгч {}-д идэвхжүүлээгүй байна."

#: src/cli/keyring.py:149
msgid "No sealed login passwords found; nothing to restore."
msgstr "Лацтай нэвтрэх нууц үг олдсонгүй; сэргээх зүйл байхгүй."

#: src/cli/keyring.py:151
msgid "Restored login wallet password for {} user(s)."
msgstr "{} хэрэглэгчийн нэвтрэх түрийвчний нууц үгийг сэргээлээ."

#: src/cli/keyring.py:153
msgid "Could not restore login wallet password for {} user(s)."
msgstr "{} хэрэглэгчийн нэвтрэх түрийвчний нууц үгийг сэргээж чадсангүй."

#: src/cli/keyring.py:154
msgid ""
"If prompts persist, set the login keyring or KWallet password in Seaho"
"rse / System Settings."
msgstr ""
"Асуултууд үргэлжилбэл Seahorse / Системийн тохиргооноос нэвтрэх түлхүү"
"рийн бөгж эсвэл KWallet-ийн нууц үгийг тохируулна уу."

#: src/cli/keyring.py:161
msgid "Restored login wallet password for user {}."
msgstr "{} хэрэглэгчийн нэвтрэх түрийвчний нууц үгийг сэргээлээ."

#: src/cli/keyring.py:163
msgid "Could not restore login wallet password for user {}."
msgstr "{} хэрэглэгчийн нэвтрэх түрийвчний нууц үгийг сэргээж чадсангүй."

#: src/cli/keyring.py:167
msgid "Invalid action. Use 'enable', 'disable', or 'restore'."
msgstr ""
"Буруу үйлдэл. «идэвхжүүлэх», «идэвхгүй болгох» эсвэл «сэргээх»-г ашигл"
"ана уу."

#: src/cli/list.py:17 src/cli/remove.py:25
msgid "Face models have not been initialized yet, please run:"
msgstr ""
"Нүүрний загваруудыг хараахан эхлүүлээгүй байгаа тул дараахыг ажиллуулн"
"а уу:"

#: src/cli/list.py:29 src/cli/remove.py:36
msgid "No face model known for the user {}, please run:"
msgstr "{} хэрэглэгчдэд танигдсан царайны загвар байхгүй тул ажиллуулна уу:"

#: src/cli/list.py:35
msgid "Known face models for {}:"
msgstr "{}-н алдартай царайны загварууд:"

#: src/cli/list.py:36
msgid "ID  Date                 Label[0m"
msgstr "ID огноо шошго [0м"

#: src/cli/remove.py:16
msgid "Please add the ID of the model you want to remove as an argument"
msgstr "Аргумент болгон устгахыг хүссэн загварын ID-г нэмнэ үү"

#: src/cli/remove.py:17 src/cli/set.py:18
msgid "For example:"
msgstr "Жишээ нь:"

#: src/cli/remove.py:19
msgid "You can find the IDs by running:"
msgstr "Та дараахийг ажиллуулснаар ID-г олох боломжтой:"

#: src/cli/remove.py:52
msgid "This will remove the model called \"{label}\" for {user}"
msgstr "Энэ нь {user}-д зориулсан \"{label}\" нэртэй загварыг устгах болно."

#: src/cli/remove.py:69
msgid "No model with ID {id} exists for {user}"
msgstr "{user}-д {id} ID-тай загвар байхгүй"

#: src/cli/remove.py:75
msgid "Removed last model, ubuntu-hello disabled for user"
msgstr ""
"Сүүлийн загварыг устгасан, хэрэглэгчдэд зориулж ubuntu-hello-г идэвхгү"
"й болгосон"

#: src/cli/remove.py:89
msgid "Removed model {}"
msgstr "Устгасан загвар {}"

#: src/cli/set.py:17
msgid "Please add a setting you would like to change and the value to set it to"
msgstr "Өөрчлөхийг хүсэж буй тохиргоо болон түүнийг тохируулах утгыг нэмнэ үү"

#: src/cli/set.py:37
msgid "Could not find a \"{}\" config option to set"

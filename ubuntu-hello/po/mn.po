#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "Хэрэглэгчийг тодорхойлж чадсангүй, --user тугийг ашиглана уу"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello царайг баталгаажуулах командын мөрийн интерфейс."

#: src/cli.py:35
msgid "command"
msgstr "тушаал"

#: src/cli.py:35
msgid "arguments"
msgstr "аргументууд"

#: src/cli.py:36
msgid ""
"For support please visit\n"
"https://github.com/ventura8/ubuntu-hello"
msgstr ""
"Дэмжлэг авахыг хүсвэл зочилно уу\n"
"https://github.com/ventura8/ubuntu-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear, "
"config, disable, keyring, list, remove, snapshot, set, test or version."
msgstr ""
"Гүйцэтгэх командын сонголт нь дараах зүйлсийн аль нэг нь байж болно: add, "
"clear, config, disable, keyring, list, remove, snapshot, set, test эсвэл "
"version."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "add, disable, remove болон set командуудын нэмэлт аргументууд."

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "Ашиглах хэрэглэгчийн бүртгэлийг тохируулна уу."

#: src/cli.py:60
msgid "Skip all questions."
msgstr "Бүх асуултыг алгасах."

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "Машинд ээлтэй гаралтыг хэвлэх."

#: src/cli.py:72
msgid "With keyring restore: restore sealed login passwords for all users."
msgstr ""
"«keyring restore»-оор: бүх хэрэглэгчийн лацдсан нэвтрэх нууц үгийг сэргээнэ."

#: src/cli.py:80
msgid "Show this help message and exit."
msgstr "Энэ тусламжийн мессежийг үзүүлээд гар."

#: src/cli.py:84
msgid "current active user: "
msgstr "Одоогийн идэвхтэй хэрэглэгч:"

#: src/cli.py:94
msgid "Invalid username format"
msgstr "Хэрэглэгчийн нэрийн формат буруу байна"

#: src/cli.py:104
msgid "Please run this command as root:\n"
msgstr "Энэ тушаалыг root болгон ажиллуулна уу:\n"

#: src/cli.py:110
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with the --"
"user flag"
msgstr ""
"ubuntu-hello командуудыг root болгон ажиллуулах боломжгүй, энэ командыг --"
"user туг ашиглан ажиллуулна уу."


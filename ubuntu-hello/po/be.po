#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\nНемагчыма імпартаваць модуль dlib, праверце вывад"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "Стварэнне папкі з мадэллю твару не знойдзена"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr ""
"УВАГА: кожная дадатковая мадэль трохі запавольвае механізм распазнання"
" твараў"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"Каб адмяніць, націсніце Ctrl+C\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "Даданне мадэлі твару для карыстальніка"

#: src/cli/add.py:88
msgid "Model #"
msgstr "мадэль #"

#: src/cli/add.py:93
msgid "Using default label \"%s\" because of -y flag"
msgstr "Выкарыстанне цэтліка па змаўчанні \"%s\" з-за сцяга -y"

#: src/cli/add.py:97
msgid "Enter a label for this new model [{}]: "
msgstr "Увядзіце метку для гэтай новай мадэлі [{}]:"

#: src/cli/add.py:107
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "УВАГА: Выдаленне недапушчальнага сімвала \",\" з назвы мадэлі"

#: src/cli/add.py:121
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nКалі ласка, глядзіце прама ў камеру"

#: src/cli/add.py:186
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "Камера бачыла толькі чорныя рамкі - ВК-выпраменьвальнік працуе?"

#: src/cli/add.py:191
msgid "No face detected, aborting"
msgstr "Твар не выяўлены, перапыняецца"

#: src/cli/add.py:196
msgid "Multiple faces detected, aborting"
msgstr "Выяўлена некалькі твараў, спыненне"

#: src/cli/add.py:218
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nСканаванне завершана\nДададзена новая мадэль"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr "Мадэлі яшчэ не створаны, немагчыма ачысціць іх, калі яны не існуюць"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "У {} няма мадэляў або яны ўжо ачышчаны"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "Гэта выдаліць усе мадэлі для"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "Вы хочаце працягнуць [y/N]:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\nІнтэрпрэтацыя як \"НЕ\", перапыненне"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nМадэлі ачышчаны"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "Адкрыццё config.ini ў {editor}"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "Не ўдалося адкрыць рэдактар: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "Памылка: не ўдалося знайсці прыдатны тэкставы рэдактар."

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr ""
"Калі ласка, усталюйце 'nano' або 'vi' або задайце зменную асяроддзя ED"
"ITOR."

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."
msgstr ""
"Калі вы запускаеце гэтую каманду з sudo, паспрабуйце 'sudo -E ubuntu-h"
"ello config', каб захаваць вашу зменную EDITOR."

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "Калі ласка, дадайце 0 (уключыць) або 1 (выключыць) у якасці аргумента"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr ""
"Калі ласка, выкарыстоўвайце толькі 0 (уключыць) або 1 (выключыць) у як"
"асці аргумента"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "Опцыя адключэння ўжо ўстаноўлена на"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Hello быў адключаны"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Hello быў уключаны"

#: src/cli/keyring.py:32 src/cli/keyring.py:148
msgid "Usage: keyring [enable|disable|restore [--all]]"
msgstr "Выкарыстанне: брелок [уключыць|выключыць|аднавіць] [--all]"

#: src/cli/keyring.py:49
msgid "Enter password for user {} to unlock {} ({}): "
msgstr "Увядзіце пароль для карыстальніка {}, каб разблакіраваць {} ({}):"

#: src/cli/keyring.py:51
msgid "Password cannot be empty"
msgstr "Пароль не можа быць пустым"

#: src/cli/keyring.py:54
msgid "Confirm password: "
msgstr "Пацвердзіце пароль:"

#: src/cli/keyring.py:56
msgid "Passwords do not match"
msgstr "Паролі не супадаюць"

#: src/cli/keyring.py:65
msgid "TPM hardware detected. Auto-installing tpm2-tools..."
msgstr "Выяўлена абсталяванне TPM. Аўтаматычная ўстаноўка tpm2-tools..."

#: src/cli/keyring.py:74
msgid "TPM hardware active. Sealing password in TPM..."
msgstr "Апаратнае забеспячэнне TPM актыўнае. Запячатванне пароля ў TPM..."

#: src/cli/keyring.py:100
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} using TPM ("
"wallet: {})."
msgstr ""
"Разблакіроўка бірулькі/KWallet паспяхова ўключана для карыстальніка {}"
" з дапамогай TPM (кашалёк: {})."

#: src/cli/keyring.py:102
msgid "Failed to seal password to TPM: {}"
msgstr "Не ўдалося замацаваць пароль для TPM: {}"

#: src/cli/keyring.py:106
msgid "No TPM active. Using software-based credential caching..."
msgstr "Няма актыўнага TPM. Выкарыстанне праграмнага кэшавання ўліковых даных..."

#: src/cli/keyring.py:122
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} (Software C"
"aching, wallet: {})."
msgstr ""
"Разблакіроўка бірулькі/KWallet паспяхова ўключана для карыстальніка {}"
" (праграмнае кэшаванне, кашалёк: {})."

#: src/cli/keyring.py:124
msgid "Failed to enable keyring unlocking: {}"
msgstr "Не ўдалося ўключыць разблакіроўку бірулькі: {}"

#: src/cli/keyring.py:135
msgid "Failed to disable keyring unlocking: {}"
msgstr "Не ўдалося адключыць разблакіроўку бірулькі: {}"

#: src/cli/keyring.py:138
msgid "Keyring/KWallet unlocking disabled for user {}."
msgstr "Разблакіроўка бірулькі/KWallet адключана для карыстальніка {}."

#: src/cli/keyring.py:140
msgid "Keyring/KWallet unlocking was not enabled for user {}."
msgstr "Разблакіроўка бірулькі/KWallet не была ўключана для карыстальніка {}."

#: src/cli/keyring.py:153
msgid "No sealed login passwords found; nothing to restore."
msgstr "Запячатаных пароляў уваходу не знойдзена; аднаўляць няма чаго."

#: src/cli/keyring.py:155
msgid "Restored login wallet password for {} user(s)."
msgstr "Пароль кашалька ўваходу адноўлены для {} карыстальніка(ў)."

#: src/cli/keyring.py:157
msgid "Could not restore login wallet password for {} user(s)."
msgstr "Не ўдалося аднавіць пароль кашалька ўваходу для {} карыстальніка(ў)."

#: src/cli/keyring.py:158
msgid ""
"If prompts persist, set the login keyring or KWallet password in Seaho"
"rse / System Settings."
msgstr ""
"Калі запыты працягваюцца, задайце пароль брелкі ўваходу або KWallet у "
"Seahorse / Наладах сістэмы."

#: src/cli/keyring.py:161
msgid "Restored login wallet password for user {}."
msgstr "Пароль кашалька ўваходу для карыстальніка {} адноўлены."

#: src/cli/keyring.py:163
msgid "Could not restore login wallet password for user {}."
msgstr "Не ўдалося аднавіць пароль кашалька ўваходу для карыстальніка {}."

#: src/cli/keyring.py:167
msgid "Invalid action. Use 'enable', 'disable', or 'restore'."
msgstr ""
"Няправільнае дзеянне. Выкарыстоўвайце «уключыць», «выключыць» або «адн"
"авіць»."

#: src/cli/list.py:17 src/cli/remove.py:25

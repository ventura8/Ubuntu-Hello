"\nFrames searched: %d (%.2f fps)"
msgstr ""
"\nПошук кадраў: %d (%.2f кадраў у секунду)"

#: src/compare.py:473
msgid "Black frames ignored: %d "
msgstr "Чорныя рамкі ігнаруюцца: %d"

#: src/compare.py:474
msgid "Dark frames ignored: %d "
msgstr "Цёмныя рамкі ігнаруюцца: %d"

#: src/compare.py:475
msgid "Certainty of winning frame: %.3f"
msgstr "Пэўнасць выйгрышнага кадра: %.3f"

#: src/compare.py:477

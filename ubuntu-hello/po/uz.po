msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "add, disable, remove va set buyruqlari uchun ixtiyoriy argumentlar."

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "Foydalanish uchun foydalanuvchi hisobini o'rnating."


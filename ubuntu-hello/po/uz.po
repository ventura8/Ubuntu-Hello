msgid "Skip all questions."
msgstr "Barcha savollarni o'tkazib yuboring."

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "Mashina uchun qulay mahsulotni chop etish."

#: src/cli.py:72
msgid "With keyring restore: restore sealed login passwords for all users."
msgstr ""
"«keyring restore» bilan: barcha foydalanuvchilarning muhrlangan kirish "

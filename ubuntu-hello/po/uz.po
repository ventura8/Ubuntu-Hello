#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear, "
"config, disable, keyring, list, remove, snapshot, set, test or version."
msgstr ""
"Amalga oshirish uchun buyruq varianti quyidagilardan biri bo'lishi mumkin: "
"add, clear, config, disable, keyring, list, remove, snapshot, set, test yoki "
"version."


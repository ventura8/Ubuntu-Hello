#: src/cli/add.py:23
msgid ""
"\n"
"Can't import the dlib module, check the output of"
msgstr ""
"\n"
"dlib मॉड्यूल आयात करू शकत नाही, चे आउटपुट तपासा"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "फेस मॉडेल फोल्डर आढळले नाही, एक तयार करत आहे"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine slightly"
msgstr "सूचना: प्रत्येक अतिरिक्त मॉडेल चेहरा ओळखण्याचे इंजिन थोडे कमी करते"

#: src/cli/add.py:70
msgid "Press Ctrl+C to cancel\n"
msgstr "रद्द करण्यासाठी Ctrl+C दाबा\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "वापरकर्त्यासाठी चेहरा मॉडेल जोडत आहे"

#: src/cli/add.py:88
msgid "Model #"
msgstr "मॉडेल #"

#: src/cli/add.py:92
#, python-format
msgid "Using default label \"%s\" because of -y flag"
msgstr "-y ध्वजामुळे डीफॉल्ट लेबल \"%s\" वापरत आहे"

#: src/cli/add.py:95
msgid "Enter a label for this new model [{}]: "
msgstr "या नवीन मॉडेलसाठी लेबल एंटर करा [{}]:"

#: src/cli/add.py:103
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "सूचना: मॉडेलच्या नावातून अवैध वर्ण \",\" काढून टाकत आहे"

#: src/cli/add.py:117
msgid ""
"\n"
"Please look straight into the camera"
msgstr ""
"\n"
"कृपया थेट कॅमेऱ्यात पहा"

#: src/cli/add.py:182
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "कॅमेराने फक्त काळ्या फ्रेम्स पाहिल्या - IR emitter कार्यरत आहे का?"

#: src/cli/add.py:187
msgid "No face detected, aborting"
msgstr "कोणताही चेहरा आढळला नाही, रद्द करत आहे"

#: src/cli/add.py:192
msgid "Multiple faces detected, aborting"
msgstr "एकाधिक चेहरे आढळले, रद्द करत आहे"

#: src/cli/add.py:214
msgid ""
"\n"
"Scan complete\n"
"Added a new model to "
msgstr ""
"\n"
"स्कॅन पूर्ण\n"
"मध्ये नवीन मॉडेल जोडले"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr "अद्याप कोणतेही मॉडेल तयार केलेले नाहीत, ते अस्तित्वात नसल्यास ते साफ करू शकत नाहीत"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} मध्ये कोणतेही मॉडेल नाहीत किंवा ते आधीच साफ केले गेले आहेत"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "हे सर्व मॉडेल साफ करेल"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "तुम्ही सुरू ठेवू इच्छिता [y/N]:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\n"
"Interpreting as a \"NO\", aborting"
msgstr ""
"\n"
"\"नाही\" म्हणून अर्थ लावणे, रद्द करणे"

#: src/cli/clear.py:37
msgid ""
"\n"
"Models cleared"
msgstr ""
"\n"
"मॉडेल साफ केले"

#: src/cli/config.py:32
#, python-brace-format
msgid "Opening config.ini in {editor}"
msgstr "config.ini {editor} मध्ये उघडत आहे"

#: src/cli/config.py:38
#, python-brace-format
msgid "Failed to open editor: {error}"
msgstr "संपादक उघडण्यात अयशस्वी: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "त्रुटी: योग्य मजकूर संपादक सापडला नाही."

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr "कृपया 'nano' किंवा 'vi' स्थापित करा किंवा EDITOR पर्यावरण व्हेरिएबल सेट करा."

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello config' "
"to preserve your EDITOR variable."
msgstr ""
"जर तुम्ही ही कमांड sudo सह चालवत असाल, तर तुमचे EDITOR व्हेरिएबल जतन करण्यासाठी "
"'sudo -E ubuntu-hello config' वापरून पहा."

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "कृपया युक्तिवाद म्हणून 0 (सक्षम) किंवा 1 (अक्षम) जोडा"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr "कृपया युक्तिवाद म्हणून फक्त 0 (सक्षम) किंवा 1 (अक्षम) वापरा"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "अक्षम पर्याय आधीच सेट केला गेला आहे"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Hello अक्षम केले गेले आहे"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Hello सक्षम केले आहे"

#: src/cli/keyring.py:31
msgid "Usage: keyring [enable|disable]"
msgstr "वापर: कीरिंग [सक्षम|अक्षम]"

#: src/cli/keyring.py:48
msgid "Enter password for user {} to unlock {} ({}): "
msgstr "अनलॉक करण्यासाठी {} वापरकर्त्यासाठी पासवर्ड एंटर करा {} ({}):"

#: src/cli/keyring.py:50
msgid "Password cannot be empty"
msgstr "पासवर्ड रिक्त असू शकत नाही"

#: src/cli/keyring.py:53
msgid "Confirm password: "
msgstr "पासवर्डची पुष्टी करा:"

#: src/cli/keyring.py:55
msgid "Passwords do not match"
msgstr "पासवर्ड जुळत नाहीत"

#: src/cli/keyring.py:64
msgid "TPM hardware detected. Auto-installing tpm2-tools..."
msgstr "TPM हार्डवेअर आढळले. स्वयं-स्थापित करत आहे tpm2-tools..."

#: src/cli/keyring.py:73
msgid "TPM hardware active. Sealing password in TPM..."
msgstr "TPM हार्डवेअर सक्रिय. TPM मध्ये पासवर्ड सील करत आहे..."

#: src/cli/keyring.py:99
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} using TPM "
"(wallet: {})."
msgstr ""
"TPM (वॉलेट: {}) वापरून {} वापरकर्त्यासाठी कीरिंग/KWallet अनलॉक करणे यशस्वीरित्या "
"सक्षम केले."

#: src/cli/keyring.py:101
msgid "Failed to seal password to TPM: {}"
msgstr "TPM वर पासवर्ड सील करण्यात अयशस्वी: {}"

#: src/cli/keyring.py:105
msgid "No TPM active. Using software-based credential caching..."
msgstr "कोणतेही TPM सक्रिय नाही. सॉफ्टवेअर-आधारित क्रेडेंशियल कॅशिंग वापरणे..."

#: src/cli/keyring.py:121
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} (Software "
"Caching, wallet: {})."
msgstr ""
"वापरकर्त्यासाठी कीरिंग/KWallet अनलॉकिंग यशस्वीरित्या सक्षम केले {} (सॉफ्टवेअर कॅशिंग, "
"वॉलेट: {})."

#: src/cli/keyring.py:123
msgid "Failed to enable keyring unlocking: {}"
msgstr "कीरिंग अनलॉकिंग सक्षम करण्यात अयशस्वी: {}"

#: src/cli/keyring.py:134
msgid "Failed to disable keyring unlocking: {}"
msgstr "कीरिंग अनलॉकिंग अक्षम करण्यात अयशस्वी: {}"

#: src/cli/keyring.py:137
msgid "Keyring/KWallet unlocking disabled for user {}."
msgstr "वापरकर्त्यासाठी कीरिंग/KWallet अनलॉक करणे अक्षम केले आहे {}."

#: src/cli/keyring.py:139
msgid "Keyring/KWallet unlocking was not enabled for user {}."
msgstr "कीरिंग/KWallet अनलॉक करणे वापरकर्त्यासाठी सक्षम केले नाही {}."

#: src/cli/keyring.py:142
msgid "Invalid action. Use 'enable' or 'disable'."
msgstr "अवैध क्रिया. 'सक्षम' किंवा 'अक्षम' वापरा."

#: src/cli/list.py:17 src/cli/remove.py:25
msgid "Face models have not been initialized yet, please run:"
msgstr "चेहर्याचे मॉडेल अद्याप सुरू केलेले नाहीत, कृपया चालवा:"

#: src/cli/list.py:29 src/cli/remove.py:36
msgid "No face model known for the user {}, please run:"
msgstr "वापरकर्त्यासाठी कोणतेही फेस मॉडेल ज्ञात नाही {}, कृपया चालवा:"

#: src/cli/list.py:35
msgid "Known face models for {}:"
msgstr "{} साठी ज्ञात चेहर्याचे मॉडेल:"

#: src/cli/list.py:36
msgid "ID  Date                 Label[0m"
msgstr "आयडी तारीख लेबल [0 मी"

#: src/cli/remove.py:16
msgid "Please add the ID of the model you want to remove as an argument"
msgstr "कृपया तुम्ही युक्तिवाद म्हणून काढू इच्छित असलेल्या मॉडेलचा आयडी जोडा"

#: src/cli/remove.py:17 src/cli/set.py:18
msgid "For example:"
msgstr "उदाहरणार्थ:"

#: src/cli/remove.py:19
msgid "You can find the IDs by running:"
msgstr "तुम्ही चालवून आयडी शोधू शकता:"

#: src/cli/remove.py:52
#, python-brace-format
msgid "This will remove the model called \"{label}\" for {user}"
msgstr "हे {user} साठी \"{label}\" नावाचे मॉडेल काढून टाकेल"

#: src/cli/remove.py:69
#, python-brace-format
msgid "No model with ID {id} exists for {user}"
msgstr "{user} साठी {id} ID असलेले कोणतेही मॉडेल अस्तित्वात नाही"

#: src/cli/remove.py:75
msgid "Removed last model, ubuntu-hello disabled for user"
msgstr "शेवटचे मॉडेल काढले, वापरकर्त्यासाठी ubuntu-hello अक्षम केले"

#: src/cli/remove.py:89
msgid "Removed model {}"
msgstr "काढलेले मॉडेल {}"

#: src/cli/set.py:17
msgid ""
"Please add a setting you would like to change and the value to set it to"

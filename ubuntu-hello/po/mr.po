msgstr "ओळख libs आयात करत आहे"

#: src/compare.py:391
msgid "Searching for known face"
msgstr "ओळखीचा चेहरा शोधत आहे"

#: src/compare.py:392
msgid "Total time"
msgstr "एकूण वेळ"

#: src/compare.py:394
msgid ""
"\n"
"Resolution"
msgstr ""
"\n"
"ठराव"


#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "अयशस्वी, कालबाह्य झाले"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "फेस डिटेक्शन इमेज खूप गडद आहे"


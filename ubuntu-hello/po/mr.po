#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "अयशस्वी, कालबाह्य झाले"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "फेस डिटेक्शन इमेज खूप गडद आहे"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "अज्ञात त्रुटी:"

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "%s म्हणून ओळखला चेहरा"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr ""
"एंटर दाबा पाठवण्यासाठी अपुऱ्या परवानग्या, वापरकर्त्याने ते दाबण्याची प"
"्रतीक्षा करत आहे"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr ""
"एंटर दाबा पाठवण्यात अयशस्वी, त्याऐवजी वापरकर्त्याने ते दाबण्याची प्रती"
"क्षा करत आहे"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "चेहर्याचे प्रमाणीकरण करण्याचा प्रयत्न करत आहे"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "वापरकर्ता निर्धारित करू शकलो नाही, कृपया --user ध्वज वापरा"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello फेस ऑथेंटिकेशनसाठी कमांड लाइन इंटरफेस."

#: src/cli.py:35
msgid "command"
msgstr "आज्ञा"

#: src/cli.py:35
msgid "arguments"
msgstr "युक्तिवाद"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"समर्थनासाठी कृपया भेट द्या\nhttps://github.com/ventura8/ubuntu-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"कार्यान्वित करण्यासाठी कमांड पर्याय, खालीलपैकी एक असू शकतो: जोडा, साफ "
"करा, कॉन्फिगरेशन, अक्षम करा, कीरिंग, सूची, काढा, स्नॅपशॉट, सेट, चाचणी "
"किंवा आवृत्ती."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "जोडा, अक्षम करा, काढा आणि आदेश सेट करा यासाठी पर्यायी युक्तिवाद."

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "वापरकर्ता खाते वापरण्यासाठी सेट करा."

#: src/cli.py:60
msgid "Skip all questions."
msgstr "सर्व प्रश्न वगळा."

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "प्रिंट मशीन-फ्रेंडली आउटपुट."

#: src/cli.py:72
msgid "With keyring restore: restore sealed login passwords for all users."
msgstr "With keyring restore: restore sealed login passwords for all users."

#: src/cli.py:80
msgid "Show this help message and exit."
msgstr "हा मदत संदेश दाखवा आणि बाहेर पडा."

#: src/cli.py:84
msgid "current active user: "
msgstr "वर्तमान सक्रिय वापरकर्ता:"

#: src/cli.py:94
msgid "Invalid username format"
msgstr "अवैध वापरकर्तानाव स्वरूप"

#: src/cli.py:104
msgid ""
"Please run this command as root:\n"
msgstr ""
"कृपया ही आज्ञा रूट म्हणून चालवा:\n"

#: src/cli.py:110
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr ""
"ubuntu-hello कमांड रूट म्हणून चालवू शकत नाही, कृपया ही कमांड --user फ्"
"लॅगसह चालवा"

#: src/compare.py:128 src/cli/add.py:32
msgid "Data files have not been downloaded, please run the following commands:"
msgstr "डेटा फाइल डाउनलोड केल्या गेल्या नाहीत, कृपया खालील आदेश चालवा:"

#: src/compare.py:154
msgid " LOGIN"
msgstr "लॉगिन करा"

#: src/compare.py:155 src/cli/snap.py:44
msgid "Date: "
msgstr "तारीख:"

#: src/compare.py:156
msgid "Scan time: "
msgstr "स्कॅन वेळ:"

#: src/compare.py:157
msgid "Frames: "
msgstr "फ्रेम्स:"

#: src/compare.py:158
msgid "Hostname: "
msgstr "होस्टनाव:"

#: src/compare.py:159
msgid "Best certainty value: "
msgstr "सर्वोत्तम निश्चितता मूल्य:"

#: src/compare.py:266
msgid "Starting up..."
msgstr "सुरू करत आहे..."

#: src/compare.py:319
msgid "Identifying you..."
msgstr "तुमची ओळख..."

#: src/compare.py:351
msgid "FAILED"
msgstr "अयशस्वी"

#: src/compare.py:354 src/cli/add.py:188
msgid "All frames were too dark, please check dark_threshold in config"
msgstr "सर्व फ्रेम खूप गडद होत्या, कृपया कॉन्फिगमध्ये dark_threshold तपासा"

#: src/compare.py:355 src/cli/add.py:189
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "सरासरी अंधार: {avg}, थ्रेशोल्ड: {threshold}"

#: src/compare.py:456
msgid "Time spent"
msgstr "वेळ घालवला"

#: src/compare.py:457
msgid "Starting up"
msgstr "सुरू होत आहे"

#: src/compare.py:458
msgid "  Open cam + load libs: %dms"
msgstr "उघडा कॅम + लोड libs: %dms"

#: src/compare.py:459
msgid "  Opening the camera"
msgstr "कॅमेरा उघडत आहे"

#: src/compare.py:460
msgid "  Importing recognition libs"
msgstr "ओळख libs आयात करत आहे"

#: src/compare.py:461
msgid "Searching for known face"
msgstr "ओळखीचा चेहरा शोधत आहे"

#: src/compare.py:462
msgid "Total time"
msgstr "एकूण वेळ"

#: src/compare.py:464
msgid ""
"\nResolution"
msgstr ""
"\nठराव"

#: src/compare.py:466
msgid "  Native: %dx%d"
msgstr "मूळ: %dx%d"

#: src/compare.py:469
msgid "  Used: %dx%d"
msgstr "वापरलेले: %dx%d"

#: src/compare.py:472
msgid ""
"\nFrames searched: %d (%.2f fps)"
msgstr ""
"\nफ्रेम शोधल्या: %d (%.2f fps)"

#: src/compare.py:473
msgid "Black frames ignored: %d "
msgstr "काळ्या फ्रेम्सकडे दुर्लक्ष केले: %d"

#: src/compare.py:474
msgid "Dark frames ignored: %d "
msgstr "गडद फ्रेम दुर्लक्षित: %d"

#: src/compare.py:475
msgid "Certainty of winning frame: %.3f"
msgstr "फ्रेम जिंकण्याची निश्चितता: %.3f"

#: src/compare.py:477
msgid "Winning model: %d (\"%s\")"
msgstr "विजेते मॉडेल: %d (\"%s\")"

#: src/compare.py:481
msgid "SUCCESSFUL"
msgstr "यशस्वी"

#: src/wallet_backend.py:62 src/wallet_backend.py:72
msgid "KWallet"
msgstr "KWallet"

#: src/wallet_backend.py:64
msgid "GNOME Keyring"
msgstr "GNOME Keyring"

#: src/wallet_backend.py:65
msgid "None"
msgstr "None"

#: src/wallet_backend.py:74
msgid "login keyring"
msgstr "लॉगिन कीरिंग"

#: src/wallet_backend.py:75
msgid "login keyring or KWallet"
msgstr "लॉगिन कीरिंग किंवा KWallet"

#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\ndlib मॉड्यूल आयात करू शकत नाही, चे आउटपुट तपासा"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "फेस मॉडेल फोल्डर आढळले नाही, एक तयार करत आहे"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr "सूचना: प्रत्येक अतिरिक्त मॉडेल चेहरा ओळखण्याचे इंजिन थोडे कमी करते"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"रद्द करण्यासाठी Ctrl+C दाबा\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "वापरकर्त्यासाठी चेहरा मॉडेल जोडत आहे"

#: src/cli/add.py:88
msgid "Model #"
msgstr "मॉडेल #"

#: src/cli/add.py:93
msgid "Using default label \"%s\" because of -y flag"
msgstr "-y ध्वजामुळे डीफॉल्ट लेबल \"%s\" वापरत आहे"

#: src/cli/add.py:97
msgid "Enter a label for this new model [{}]: "
msgstr "या नवीन मॉडेलसाठी लेबल एंटर करा [{}]:"

#: src/cli/add.py:107
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "सूचना: मॉडेलच्या नावातून अवैध वर्ण \",\" काढून टाकत आहे"

#: src/cli/add.py:121
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nकृपया थेट कॅमेऱ्यात पहा"

#: src/cli/add.py:186
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "कॅमेराने फक्त काळ्या फ्रेम्स पाहिल्या - IR emitter कार्यरत आहे का?"

#: src/cli/add.py:191
msgid "No face detected, aborting"
msgstr "कोणताही चेहरा आढळला नाही, रद्द करत आहे"

#: src/cli/add.py:196
msgid "Multiple faces detected, aborting"
msgstr "एकाधिक चेहरे आढळले, रद्द करत आहे"

#: src/cli/add.py:218
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nस्कॅन पूर्ण\nमध्ये नवीन मॉडेल जोडले"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr ""
"अद्याप कोणतेही मॉडेल तयार केलेले नाहीत, ते अस्तित्वात नसल्यास ते साफ क"
"रू शकत नाहीत"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} मध्ये कोणतेही मॉडेल नाहीत किंवा ते आधीच साफ केले गेले आहेत"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "हे सर्व मॉडेल साफ करेल"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "तुम्ही सुरू ठेवू इच्छिता [y/N]:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\n\"नाही\" म्हणून अर्थ लावणे, रद्द करणे"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nमॉडेल साफ केले"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "config.ini {editor} मध्ये उघडत आहे"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "संपादक उघडण्यात अयशस्वी: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "त्रुटी: योग्य मजकूर संपादक सापडला नाही."

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr ""
"कृपया 'nano' किंवा 'vi' स्थापित करा किंवा EDITOR पर्यावरण व्हेरिएबल से"
"ट करा."

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."
msgstr ""
"जर तुम्ही ही कमांड sudo सह चालवत असाल, तर तुमचे EDITOR व्हेरिएबल जतन क"
"रण्यासाठी 'sudo -E ubuntu-hello config' वापरून पहा."

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "कृपया युक्तिवाद म्हणून 0 (सक्षम) किंवा 1 (अक्षम) जोडा"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr "कृपया युक्तिवाद म्हणून फक्त 0 (सक्षम) किंवा 1 (अक्षम) वापरा"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "अक्षम पर्याय आधीच सेट केला गेला आहे"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Hello अक्षम केले गेले आहे"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Hello सक्षम केले आहे"

#: src/cli/keyring.py:32 src/cli/keyring.py:148
msgid "Usage: keyring [enable|disable|restore [--all]]"
msgstr "वापर: कीरिंग [सक्षम|अक्षम|पुनर्संचयित] [--all]"

#: src/cli/keyring.py:49
msgid "Enter password for user {} to unlock {} ({}): "
msgstr "अनलॉक करण्यासाठी {} वापरकर्त्यासाठी पासवर्ड एंटर करा {} ({}):"

#: src/cli/keyring.py:51
msgid "Password cannot be empty"
msgstr "पासवर्ड रिक्त असू शकत नाही"

#: src/cli/keyring.py:54
msgid "Confirm password: "
msgstr "पासवर्डची पुष्टी करा:"

#: src/cli/keyring.py:56
msgid "Passwords do not match"
msgstr "पासवर्ड जुळत नाहीत"

#: src/cli/keyring.py:65
msgid "TPM hardware detected. Auto-installing tpm2-tools..."
msgstr "TPM हार्डवेअर आढळले. स्वयं-स्थापित करत आहे tpm2-tools..."

#: src/cli/keyring.py:74
msgid "TPM hardware active. Sealing password in TPM..."
msgstr "TPM हार्डवेअर सक्रिय. TPM मध्ये पासवर्ड सील करत आहे..."

#: src/cli/keyring.py:100
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} using TPM ("
"wallet: {})."
msgstr ""
"TPM (वॉलेट: {}) वापरून {} वापरकर्त्यासाठी कीरिंग/KWallet अनलॉक करणे यश"
"स्वीरित्या सक्षम केले."

#: src/cli/keyring.py:102
msgid "Failed to seal password to TPM: {}"
msgstr "TPM वर पासवर्ड सील करण्यात अयशस्वी: {}"

#: src/cli/keyring.py:106
msgid "No TPM active. Using software-based credential caching..."
msgstr "कोणतेही TPM सक्रिय नाही. सॉफ्टवेअर-आधारित क्रेडेंशियल कॅशिंग वापरणे..."

#: src/cli/keyring.py:122
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} (Software C"
"aching, wallet: {})."
msgstr ""
"वापरकर्त्यासाठी कीरिंग/KWallet अनलॉकिंग यशस्वीरित्या सक्षम केले {} (सॉ"
"फ्टवेअर कॅशिंग, वॉलेट: {})."

#: src/cli/keyring.py:124
msgid "Failed to enable keyring unlocking: {}"
msgstr "कीरिंग अनलॉकिंग सक्षम करण्यात अयशस्वी: {}"

#: src/cli/keyring.py:135
msgid "Failed to disable keyring unlocking: {}"
msgstr "कीरिंग अनलॉकिंग अक्षम करण्यात अयशस्वी: {}"

#: src/cli/keyring.py:138
msgid "Keyring/KWallet unlocking disabled for user {}."
msgstr "वापरकर्त्यासाठी कीरिंग/KWallet अनलॉक करणे अक्षम केले आहे {}."

#: src/cli/keyring.py:140
msgid "Keyring/KWallet unlocking was not enabled for user {}."
msgstr "कीरिंग/KWallet अनलॉक करणे वापरकर्त्यासाठी सक्षम केले नाही {}."

#: src/cli/keyring.py:153
msgid "No sealed login passwords found; nothing to restore."
msgstr ""
"सील केलेले लॉगिन पासवर्ड सापडले नाहीत; पुनर्संचयित करण्यासाठी काहीही न"
"ाही."

#: src/cli/keyring.py:155
msgid "Restored login wallet password for {} user(s)."
msgstr "{} वापरकर्ता(यां)साठी लॉगिन वॉलेट पासवर्ड पुनर्संचयित केला."

#: src/cli/keyring.py:157
msgid "Could not restore login wallet password for {} user(s)."
msgstr "{} वापरकर्ता(यां)साठी लॉगिन वॉलेट पासवर्ड पुनर्संचयित करता आला नाही."

#: src/cli/keyring.py:158
msgid ""
"If prompts persist, set the login keyring or KWallet password in Seaho"
"rse / System Settings."
msgstr ""
"प्रॉम्प्ट सुरू राहिल्यास Seahorse / सिस्टम सेटिंग्जमध्ये लॉगिन कीरिंग "
"किंवा KWallet पासवर्ड सेट करा."

#: src/cli/keyring.py:161
msgid "Restored login wallet password for user {}."
msgstr "वापरकर्ता {} साठी लॉगिन वॉलेट पासवर्ड पुनर्संचयित केला."

#: src/cli/keyring.py:163
msgid "Could not restore login wallet password for user {}."
msgstr "वापरकर्ता {} साठी लॉगिन वॉलेट पासवर्ड पुनर्संचयित करता आला नाही."

#: src/cli/keyring.py:167
msgid "Invalid action. Use 'enable', 'disable', or 'restore'."
msgstr "अवैध क्रिया. 'सक्षम', 'अक्षम' किंवा 'पुनर्संचयित' वापरा."

#: src/cli/list.py:17 src/cli/remove.py:25
msgid "Face models have not been initialized yet, please run:"
msgstr "चेहर्याचे मॉडेल अद्याप सुरू केलेले नाहीत, कृपया चालवा:"

#: src/cli/list.py:29 src/cli/remove.py:36
msgid "No face model known for the user {}, please run:"
msgstr "वापरकर्त्यासाठी कोणतेही फेस मॉडेल ज्ञात नाही {}, कृपया चालवा:"

#: src/cli/list.py:35
msgid "Known face models for {}:"
msgstr "{} साठी ज्ञात चेहर्याचे मॉडेल:"

#: src/cli/list.py:36
msgid "ID  Date                 Label[0m"

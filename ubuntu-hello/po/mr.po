#, c-format
msgid "Identified face as %s"
msgstr "%s म्हणून ओळखला चेहरा"

#: src/pam/main.cc:390
msgid ""
"Insufficient permissions to send Enter press, waiting for user to press it "
"instead"
msgstr ""
"एंटर दाबा पाठवण्यासाठी अपुऱ्या परवानग्या, वापरकर्त्याने ते दाबण्याची प्रतीक्षा करत आहे"

#: src/pam/main.cc:409 src/pam/main.cc:414
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr "एंटर दाबा पाठवण्यात अयशस्वी, त्याऐवजी वापरकर्त्याने ते दाबण्याची प्रतीक्षा करत आहे"

#: src/pam/main.cc:528
msgid "Attempting facial authentication"
msgstr "चेहर्याचे प्रमाणीकरण करण्याचा प्रयत्न करत आहे"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "वापरकर्ता निर्धारित करू शकलो नाही, कृपया --user ध्वज वापरा"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello फेस ऑथेंटिकेशनसाठी कमांड लाइन इंटरफेस."

#: src/cli.py:35
msgid "command"
msgstr "आज्ञा"

#: src/cli.py:35
msgid "arguments"
msgstr "युक्तिवाद"

#: src/cli.py:36
msgid ""
"For support please visit\n"
"https://github.com/ventura8/ubuntu-hello"
msgstr ""
"समर्थनासाठी कृपया भेट द्या\n"
"https://github.com/ventura8/ubuntu-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear, "
"config, disable, keyring, list, remove, snapshot, set, test or version."
msgstr ""
"कार्यान्वित करण्यासाठी कमांड पर्याय, खालीलपैकी एक असू शकतो: जोडा, साफ करा, "
"कॉन्फिगरेशन, अक्षम करा, कीरिंग, सूची, काढा, स्नॅपशॉट, सेट, चाचणी किंवा आवृत्ती."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "जोडा, अक्षम करा, काढा आणि आदेश सेट करा यासाठी पर्यायी युक्तिवाद."

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "वापरकर्ता खाते वापरण्यासाठी सेट करा."

#: src/cli.py:60
msgid "Skip all questions."
msgstr "सर्व प्रश्न वगळा."

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "प्रिंट मशीन-फ्रेंडली आउटपुट."

#: src/cli.py:74
msgid "Show this help message and exit."
msgstr "हा मदत संदेश दाखवा आणि बाहेर पडा."

#: src/cli.py:78
msgid "current active user: "
msgstr "वर्तमान सक्रिय वापरकर्ता:"

#: src/cli.py:88
msgid "Invalid username format"
msgstr "अवैध वापरकर्तानाव स्वरूप"

#: src/cli.py:98
msgid "Please run this command as root:\n"
msgstr "कृपया ही आज्ञा रूट म्हणून चालवा:\n"

#: src/cli.py:104
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with the --"
"user flag"
msgstr ""
"ubuntu-hello कमांड रूट म्हणून चालवू शकत नाही, कृपया ही कमांड --user फ्लॅगसह चालवा"

#: src/compare.py:88 src/cli/add.py:32

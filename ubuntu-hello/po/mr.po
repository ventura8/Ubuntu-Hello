#, python-format
msgid "Winning model: %d (\"%s\")"
msgstr "विजेते मॉडेल: %d (\"%s\")"

#: src/compare.py:411
msgid "SUCCESSFUL"
msgstr "यशस्वी"

#: src/wallet_backend.py:62 src/wallet_backend.py:72

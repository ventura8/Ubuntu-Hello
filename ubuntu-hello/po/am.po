#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "አለመሳካት፣ ጊዜው አልቋል"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "የፊት ለይቶ ማወቅ ምስል በጣም ጨለማ ነው።"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "ያልታወቀ ስህተት፡-"

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "ተለይቶ የሚታወቅ ፊት ​​%s"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr "አስገባን ለመላክ በቂ ያልሆኑ ፈቃዶች፣ በምትኩ ተጠቃሚው እንዲጫን በመጠበቅ ላይ"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr "አስገባን መላክ አልተሳካም፣ በምትኩ ተጠቃሚው እስኪጭን በመጠበቅ ላይ"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "የፊት ማረጋገጥን በመሞከር ላይ"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "ተጠቃሚን ማወቅ አልተቻለም፣ እባክዎን --user ባንዲራውን ይጠቀሙ"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "የትእዛዝ መስመር በይነገጽ ለ Ubuntu Hello የፊት ማረጋገጫ።"

#: src/cli.py:35
msgid "command"
msgstr "ትእዛዝ"

#: src/cli.py:35
msgid "arguments"
msgstr "ክርክሮች"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"ለድጋፍ እባክዎን ይጎብኙ\n⟦U0000"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"የማስፈጸም የትዕዛዝ አማራጭ ከሚከተሉት ውስጥ አንዱ ሊሆን ይችላል፡ አክል፣ አጽዳ፣ አዋቅር፣ አሰናክል፣ ቁልፍ "
"ማድረግ፣ ዝርዝር፣ ማስወገድ፣ ቅጽበተ-ፎቶ፣ አዘጋጅ፣ ሙከራ ወይም ስሪት።"

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "ለማከል ፣ ለማሰናከል ፣ ለማስወገድ እና ትዕዛዞችን ለማዘጋጀት አማራጭ ነጋሪ እሴቶች።"

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "ለመጠቀም የተጠቃሚ መለያውን ያዘጋጁ።"

#: src/cli.py:60
msgid "Skip all questions."
msgstr "ሁሉንም ጥያቄዎች ዝለል።"

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "የማሽን ተስማሚ ውፅዓት አትም."

#: src/cli.py:74
msgid "Show this help message and exit."
msgstr "ይህንን የእገዛ መልእክት አሳይ እና ውጣ።"

#: src/cli.py:78
msgid "current active user: "
msgstr "የአሁኑ ንቁ ተጠቃሚ፡-"

#: src/cli.py:88
msgid "Invalid username format"
msgstr "የተሳሳተ የተጠቃሚ ስም ቅርጸት"

#: src/cli.py:98
msgid ""
"Please run this command as root:\n"
msgstr ""
"እባኮትን ይህን ትዕዛዝ እንደ ስር ያሂዱ፡-\n"

#: src/cli.py:104
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr "የኡቡንቱ-ሄሎ ትዕዛዞችን እንደ ስር ማስኬድ አይቻልም፣ እባክዎ ይህን ትዕዛዝ በ --ተጠቃሚ ባንዲራ ያሂዱ"

#: src/compare.py:128 src/cli/add.py:32
msgid "Data files have not been downloaded, please run the following commands:"
msgstr "የውሂብ ፋይሎች አልተወረዱም፣ እባክዎ የሚከተሉትን ትዕዛዞችን ያሂዱ፡-"

#: src/compare.py:154
msgid " LOGIN"
msgstr "ግባ"

#: src/compare.py:155 src/cli/snap.py:44
msgid "Date: "
msgstr "ቀን፡-"

#: src/compare.py:156
msgid "Scan time: "
msgstr "የፍተሻ ጊዜ፡"

#: src/compare.py:157
msgid "Frames: "
msgstr "ፍሬሞች፡"

#: src/compare.py:158
msgid "Hostname: "
msgstr "የአስተናጋጅ ስም"

#: src/compare.py:159
msgid "Best certainty value: "
msgstr "የምርጥ እርግጠኝነት ዋጋ፡-"

#: src/compare.py:259
msgid "Starting up..."
msgstr "በመጀመር ላይ..."

#: src/compare.py:312
msgid "Identifying you..."
msgstr "እርስዎን በመለየት ላይ..."

#: src/compare.py:344
msgid "FAILED"
msgstr "አልተሳካም።"

#: src/compare.py:347 src/cli/add.py:184
msgid "All frames were too dark, please check dark_threshold in config"
msgstr "ሁሉም ክፈፎች በጣም ጨለማዎች ነበሩ፣እባክዎ በማዋቀር ውስጥ dark_thresholdን ያረጋግጡ"

#: src/compare.py:348 src/cli/add.py:185
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "አማካይ ጨለማ፡ {avg}፣ ገደብ፡ {threshold}"

#: src/compare.py:449
msgid "Time spent"
msgstr "የጠፋው ጊዜ"

#: src/compare.py:450
msgid "Starting up"
msgstr "በመጀመር ላይ"

#: src/compare.py:451
msgid "  Open cam + load libs: %dms"
msgstr "ካሜራ ክፈት + ሎድ ሊብስ፡ %dms"

#: src/compare.py:452
msgid "  Opening the camera"
msgstr "ካሜራውን በመክፈት ላይ"

#: src/compare.py:453
msgid "  Importing recognition libs"
msgstr "የማወቂያ libs በማስመጣት ላይ"

#: src/compare.py:454
msgid "Searching for known face"
msgstr "የሚታወቅ ፊት ​​በመፈለግ ላይ"

#: src/compare.py:455
msgid "Total time"
msgstr "ጠቅላላ ጊዜ"

#: src/compare.py:457
msgid ""
"\nResolution"
msgstr ""
"\nጥራት"

#: src/compare.py:459
msgid "  Native: %dx%d"
msgstr "ቤተኛ፡ %dx%d"

#: src/compare.py:462
msgid "  Used: %dx%d"
msgstr "ጥቅም ላይ የዋለ: %dx%d"

#: src/compare.py:465
msgid ""
"\nFrames searched: %d (%.2f fps)"
msgstr ""
"\nፍሬሞች ተፈልገው፡ %d (%.2f fps)"

#: src/compare.py:466
msgid "Black frames ignored: %d "
msgstr "ጥቁር ፍሬሞች ችላ ተብለዋል፡ %d"

#: src/compare.py:467
msgid "Dark frames ignored: %d "
msgstr "ጨለማ ክፈፎች ችላ ተብለዋል፡ %d"

#: src/compare.py:468
msgid "Certainty of winning frame: %.3f"
msgstr "የማሸነፍ እርግጠኝነት፡ %.3f"

#: src/compare.py:470
msgid "Winning model: %d (\"%s\")"
msgstr "አሸናፊ ሞዴል፡ %d (\"%s\")"

#: src/compare.py:474
msgid "SUCCESSFUL"
msgstr "ተሳክቷል።"

#: src/wallet_backend.py:62 src/wallet_backend.py:72
msgid "KWallet"
msgstr "KWallet"

#: src/wallet_backend.py:64
msgid "GNOME Keyring"
msgstr "GNOME Keyring"

#: src/wallet_backend.py:65
msgid "None"
msgstr "None"

#: src/wallet_backend.py:74
msgid "login keyring"
msgstr "የመግቢያ ቁልፍ ማድረግ"

#: src/wallet_backend.py:75
msgid "login keyring or KWallet"
msgstr "የመግቢያ ቁልፍ ወይም KWallet"

#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\nየ dlib ሞጁሉን ማስመጣት አልተቻለም፣ ውጤቱን ያረጋግጡ"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "ምንም የመልክ ሞዴል አቃፊ አልተገኘም፣ አንድ በመፍጠር"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr "ማሳሰቢያ: እያንዳንዱ ተጨማሪ ሞዴል የፊት ለይቶ ማወቂያ ሞተርን በትንሹ ይቀንሳል"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"ለመሰረዝ Ctrl+C ይጫኑ\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "ለተጠቃሚው የፊት ሞዴል በማከል ላይ"

#: src/cli/add.py:88
msgid "Model #"
msgstr "ሞዴል #"

#: src/cli/add.py:92
msgid "Using default label \"%s\" because of -y flag"
msgstr "በ -y ባንዲራ ምክንያት ነባሪ መለያ \"%s\" መጠቀም"

#: src/cli/add.py:95
msgid "Enter a label for this new model [{}]: "
msgstr "ለዚህ አዲስ ሞዴል [{}] መለያ አስገባ፡-"

#: src/cli/add.py:103
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "ማሳሰቢያ፡ ህገወጥ ቁምፊን \"\" ከሞዴል ስም በማስወገድ ላይ"

#: src/cli/add.py:117
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nእባክዎን በቀጥታ ወደ ካሜራ ይመልከቱ"

#: src/cli/add.py:182
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "ካሜራ ጥቁር ፍሬሞችን ብቻ አይቷል - IR emitter እየሰራ ነው?"

#: src/cli/add.py:187
msgid "No face detected, aborting"
msgstr "ምንም ፊት አልተገኘም፣ ማስወረድ"

#: src/cli/add.py:192
msgid "Multiple faces detected, aborting"
msgstr "በርካታ ፊቶች ተገኝተዋል፣ ውርጃ"

#: src/cli/add.py:214
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nቅኝት ተጠናቅቋል\nአዲስ ሞዴል ታክሏል።"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr "እስካሁን ምንም ሞዴሎች አልተፈጠሩም፣ ከሌሉ ሊያጸዷቸው አይችሉም"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} ምንም ሞዴሎች የሉትም ወይም ቀድሞውንም ጸድተዋል።"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "ይህ ሁሉንም ሞዴሎች ያጸዳል"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "መቀጠል ይፈልጋሉ [y/N]:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\nእንደ \"አይ\" መተርጎም, ማስወረድ"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nሞዴሎች ጸድተዋል።"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "config.ini {editor} ውስጥ በመክፈት ላይ"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "አርታዒን መክፈት አልተሳካም፦ {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "ስህተት፡ ተስማሚ የጽሑፍ አርታዒ ማግኘት አልተቻለም።"

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr "እባክህ 'nano' ወይም 'vi' ን ጫን፣ ወይም የEDITOR አካባቢን ተለዋዋጭ አዘጋጅ።"

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."
msgstr ""
"ይህን ትእዛዝ በ sudo እያስኬዱ ከሆነ፣ የእርስዎን የEDITOR ተለዋዋጭ ለማቆየት 'sudo -E ubuntu-"
"hello config' ይሞክሩ።"

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "እባክህ 0 (አንቃ) ወይም 1 ጨምር (አሰናክል) እንደ ክርክር"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr "እባክህ 0 ብቻ ተጠቀም (አንቃ) ወይም 1 (አሰናክል) እንደ መከራከሪያ"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "የማሰናከል አማራጭ አስቀድሞ ተቀናብሯል።"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Hello ተሰናክሏል።"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Hello ነቅቷል።"

#: src/cli/keyring.py:32 src/cli/keyring.py:157
msgid "Usage: keyring [enable|disable|restore [--all]]"
msgstr "አጠቃቀም፡ ቁልፍ ማድረግ [ማንቃት|ማሰናከል|መመለስ] [--all]"

#: src/cli/keyring.py:49
msgid "Enter password for user {} to unlock {} ({}): "
msgstr "ለመክፈት ለተጠቃሚ {} የይለፍ ቃል ያስገቡ {} ({}):"

#: src/cli/keyring.py:51
msgid "Password cannot be empty"
msgstr "የይለፍ ቃል ባዶ ሊሆን አይችልም።"

#: src/cli/keyring.py:54
msgid "Confirm password: "
msgstr "የይለፍ ቃል አረጋግጥ፡"

#: src/cli/keyring.py:56
msgid "Passwords do not match"
msgstr "የይለፍ ቃሎች አይዛመዱም።"


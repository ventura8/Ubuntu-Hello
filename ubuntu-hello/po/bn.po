#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "ব্যর্থতা, সময়সীমা পৌঁছেছে"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "ফেস ডিটেকশন ইমেজ খুব গাঢ়"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "অজানা ত্রুটি:"

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "%s হিসাবে চিহ্নিত মুখ"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr ""
"এন্টার প্রেস পাঠানোর জন্য অপর্যাপ্ত অনুমতি, ব্যবহারকারীর পরিবর্তে এটি "
"চাপার জন্য অপেক্ষা করছে"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr ""
"এন্টার প্রেস পাঠাতে ব্যর্থ হয়েছে, ব্যবহারকারীর পরিবর্তে এটি চাপার জন্"
"য অপেক্ষা করছে"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "মুখের প্রমাণীকরণের চেষ্টা করা হচ্ছে"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "ব্যবহারকারী নির্ধারণ করা যায়নি, অনুগ্রহ করে --user পতাকা ব্যবহার করুন"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello মুখ প্রমাণীকরণের জন্য কমান্ড লাইন ইন্টারফেস।"

#: src/cli.py:35
msgid "command"
msgstr "আদেশ"

#: src/cli.py:35
msgid "arguments"
msgstr "যুক্তি"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"সমর্থন জন্য পরিদর্শন করুন\nhttps://github.com/ventura8/ubuntu-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"এক্সিকিউট করার জন্য কমান্ড অপশনটি নিম্নলিখিতগুলির মধ্যে একটি হতে পারে:"
" অ্যাড, ক্লিয়ার, কনফিগ, ডিজেবল, কীরিং, লিস্ট, রিমুভ, স্ন্যাপশট, সেট, "
"টেস্ট বা ভার্সন।"

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "যোগ, নিষ্ক্রিয়, অপসারণ এবং সেট কমান্ডের জন্য ঐচ্ছিক আর্গুমেন্ট।"

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "ব্যবহার করার জন্য ব্যবহারকারীর অ্যাকাউন্ট সেট করুন।"

#: src/cli.py:60
msgid "Skip all questions."
msgstr "সব প্রশ্ন এড়িয়ে যান।"

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "প্রিন্ট মেশিন-বান্ধব আউটপুট।"

#: src/cli.py:72
msgid "With keyring restore: restore sealed login passwords for all users."
msgstr "With keyring restore: restore sealed login passwords for all users."

#: src/cli.py:80
msgid "Show this help message and exit."
msgstr "এই সাহায্য বার্তাটি দেখান এবং প্রস্থান করুন।"

#: src/cli.py:84
msgid "current active user: "
msgstr "বর্তমান সক্রিয় ব্যবহারকারী:"

#: src/cli.py:94
msgid "Invalid username format"
msgstr "অবৈধ ব্যবহারকারীর নাম বিন্যাস"

#: src/cli.py:104
msgid ""
"Please run this command as root:\n"
msgstr ""
"অনুগ্রহ করে এই কমান্ডটি রুট হিসাবে চালান:\n"

#: src/cli.py:110
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr ""
"রুট হিসাবে উবুন্টু-হ্যালো কমান্ড চালানো যাবে না, অনুগ্রহ করে এই কমান্ড"
"টি --user পতাকা দিয়ে চালান"

#: src/compare.py:128 src/cli/add.py:32
msgid "Data files have not been downloaded, please run the following commands:"
msgstr "ডেটা ফাইল ডাউনলোড করা হয়নি, অনুগ্রহ করে নিম্নলিখিত কমান্ডগুলি চালান:"

#: src/compare.py:154
msgid " LOGIN"
msgstr "লগইন করুন"


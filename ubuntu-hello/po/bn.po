#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\ndlib মডিউল আমদানি করা যাচ্ছে না, এর আউটপুট পরীক্ষা করুন"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "কোনও মুখের মডেল ফোল্ডার পাওয়া যায়নি, একটি তৈরি করা হচ্ছে৷"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr ""
"বিজ্ঞপ্তি: প্রতিটি অতিরিক্ত মডেল মুখ শনাক্তকরণ ইঞ্জিনকে কিছুটা ধীর করে"
" দেয়"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"বাতিল করতে Ctrl+C টিপুন\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "ব্যবহারকারীর জন্য মুখের মডেল যোগ করা হচ্ছে"

#: src/cli/add.py:88
msgid "Model #"
msgstr "মডেল #"

#: src/cli/add.py:93
msgid "Using default label \"%s\" because of -y flag"
msgstr "-y পতাকার কারণে ডিফল্ট লেবেল \"%s\" ব্যবহার করা হচ্ছে"

#: src/cli/add.py:97
msgid "Enter a label for this new model [{}]: "
msgstr "এই নতুন মডেলের জন্য একটি লেবেল লিখুন [{}]:"

#: src/cli/add.py:107
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "বিজ্ঞপ্তি: মডেলের নাম থেকে অবৈধ অক্ষর \",\" সরানো হচ্ছে"

#: src/cli/add.py:121
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nদয়া করে সরাসরি ক্যামেরার দিকে তাকান"

#: src/cli/add.py:186
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "ক্যামেরা শুধু কালো ফ্রেম দেখেছে - আইআর ইমিটার কি কাজ করছে?"

#: src/cli/add.py:191
msgid "No face detected, aborting"
msgstr "কোনো মুখ শনাক্ত করা হয়নি, বাতিল করা হচ্ছে"

#: src/cli/add.py:196
msgid "Multiple faces detected, aborting"
msgstr "একাধিক মুখ সনাক্ত করা হয়েছে, বাতিল করা হচ্ছে"

#: src/cli/add.py:218
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nস্ক্যান সম্পূর্ণ\nএকটি নতুন মডেল যোগ করা হয়েছে"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr ""
"এখনও কোন মডেল তৈরি করা হয়নি, যদি তারা বিদ্যমান না থাকে তবে সেগুলি পরি"
"ষ্কার করতে পারবে না৷"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} এর কোন মডেল নেই বা সেগুলি ইতিমধ্যেই সাফ করা হয়েছে৷"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "এটি সমস্ত মডেল সাফ করবে"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "আপনি কি [y/N] চালিয়ে যেতে চান:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\n\"না\" হিসাবে ব্যাখ্যা করা, বাতিল করা হচ্ছে"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nমডেলগুলি সাফ করা হয়েছে"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "config.ini {editor} এ খোলা হচ্ছে"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "সম্পাদক খুলতে ব্যর্থ হয়েছে: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "ত্রুটি: একটি উপযুক্ত পাঠ্য সম্পাদক খুঁজে পাওয়া যায়নি."

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr ""
"অনুগ্রহ করে 'ন্যানো' বা 'vi' ইনস্টল করুন, অথবা EDITOR পরিবেশ পরিবর্তনশ"
"ীল সেট করুন।"

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."
msgstr ""
"আপনি যদি sudo দিয়ে এই কমান্ডটি চালান, তাহলে আপনার EDITOR ভেরিয়েবলটি "
"সংরক্ষণ করতে 'sudo -E ubuntu-hello config' ব্যবহার করে দেখুন।"

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "একটি আর্গুমেন্ট হিসাবে একটি 0 (সক্ষম) বা একটি 1 (অক্ষম) যোগ করুন"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr ""
"অনুগ্রহ করে শুধুমাত্র একটি যুক্তি হিসাবে 0 (সক্ষম) বা 1 (অক্ষম) ব্যবহা"
"র করুন"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "নিষ্ক্রিয় বিকল্পটি ইতিমধ্যেই সেট করা হয়েছে৷"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Hello নিষ্ক্রিয় করা হয়েছে"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Hello সক্ষম করা হয়েছে"

#: src/cli/keyring.py:32 src/cli/keyring.py:148
msgid "Usage: keyring [enable|disable|restore [--all]]"
msgstr "ব্যবহার: কীরিং [সক্ষম|অক্ষম|পুনরুদ্ধার] [--all]"

#: src/cli/keyring.py:49
msgid "Enter password for user {} to unlock {} ({}): "
msgstr "{} ({}) আনলক করতে ব্যবহারকারী {} এর পাসওয়ার্ড লিখুন:"

#: src/cli/keyring.py:51
msgid "Password cannot be empty"
msgstr "পাসওয়ার্ড খালি রাখা যাবে না"

#: src/cli/keyring.py:54
msgid "Confirm password: "
msgstr "পাসওয়ার্ড নিশ্চিত করুন:"

#: src/cli/keyring.py:56
msgid "Passwords do not match"
msgstr "পাসওয়ার্ড মেলে না"

#: src/cli/keyring.py:65
msgid "TPM hardware detected. Auto-installing tpm2-tools..."
msgstr ""
"TPM হার্ডওয়্যার সনাক্ত করা হয়েছে৷ স্বয়ংক্রিয়ভাবে ইনস্টল করা হচ্ছে "
"tpm2-tools..."

#: src/cli/keyring.py:74
msgid "TPM hardware active. Sealing password in TPM..."
msgstr "TPM হার্ডওয়্যার সক্রিয়। TPM-এ পাসওয়ার্ড সিল করা হচ্ছে..."

#: src/cli/keyring.py:100
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} using TPM ("
"wallet: {})."
msgstr ""
"TPM (ওয়ালেট: {}) ব্যবহার করে ব্যবহারকারী {} এর জন্য কীরিং/KWallet আনল"
"কিং সফলভাবে সক্ষম হয়েছে৷"

#: src/cli/keyring.py:102
msgid "Failed to seal password to TPM: {}"
msgstr "TPM-এ পাসওয়ার্ড সিল করতে ব্যর্থ হয়েছে: {}"

#: src/cli/keyring.py:106
msgid "No TPM active. Using software-based credential caching..."
msgstr ""
"কোনো TPM সক্রিয় নেই৷ সফ্টওয়্যার-ভিত্তিক শংসাপত্র ক্যাশিং ব্যবহার করে"
"..."

#: src/cli/keyring.py:122

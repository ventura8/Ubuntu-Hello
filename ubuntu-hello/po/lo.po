#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "ຄວາມລົ້ມເຫຼວ, ຮອດເວລາໝົດເວລາ"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "ຮູບການກວດຫາໃບໜ້າມືດເກີນໄປ"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "ຄວາມຜິດພາດທີ່ບໍ່ຮູ້ຈັກ:"

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "ລະບຸໃບໜ້າເປັນ %s"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr "ການອະນຸຍາດບໍ່ພຽງພໍເພື່ອສົ່ງກົດ Enter, ລໍຖ້າໃຫ້ຜູ້ໃຊ້ກົດມັນແທນ"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr "ສົ່ງກົດ Enter ລົ້ມເຫລວ, ລໍຖ້າໃຫ້ຜູ້ໃຊ້ກົດມັນແທນ"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "ພະຍາຍາມຢັ້ງຢືນໃບໜ້າ"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "ບໍ່ສາມາດກໍານົດຜູ້ໃຊ້ໄດ້, ກະລຸນາໃຊ້ --user flag"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "ການໂຕ້ຕອບເສັ້ນຄໍາສັ່ງສໍາລັບການພິສູດຢືນຢັນໃບຫນ້າ Ubuntu Hello."

#: src/cli.py:35
msgid "command"
msgstr "ຄໍາສັ່ງ"

#: src/cli.py:35
msgid "arguments"
msgstr "ການໂຕ້ຖຽງ"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"ສໍາລັບການຊ່ວຍເຫຼືອກະລຸນາໄປຢ້ຽມຢາມ\nhttps://github.com/ventura8/ubuntu-"
"hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"ຕົວເລືອກຄໍາສັ່ງທີ່ຈະປະຕິບັດ, ສາມາດເປັນຫນຶ່ງໃນຕໍ່ໄປນີ້: ເພີ່ມ, ລ້າງ, co"
"nfig, ປິດການໃຊ້ງານ, keyring, list, remove, snapshot, set, test or vers"
"ion."

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr "ການໂຕ້ຖຽງທາງເລືອກສໍາລັບການເພີ່ມ, ປິດການໃຊ້ງານ, ເອົາອອກແລະກໍານົດຄໍາສັ່ງ."

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "ກໍານົດບັນຊີຜູ້ໃຊ້ທີ່ຈະໃຊ້."

#: src/cli.py:60
msgid "Skip all questions."
msgstr "ຂ້າມຄຳຖາມທັງໝົດ."

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "ພິມຜົນຜະລິດທີ່ເປັນມິດກັບເຄື່ອງຈັກ."

#: src/cli.py:72
msgid "With keyring restore: restore sealed login passwords for all users."
msgstr "With keyring restore: restore sealed login passwords for all users."

#: src/cli.py:80
msgid "Show this help message and exit."
msgstr "ສະແດງຂໍ້ຄວາມຊ່ວຍເຫຼືອນີ້ ແລະອອກ."

#: src/cli.py:84
msgid "current active user: "
msgstr "ຜູ້​ໃຊ້​ທີ່​ໃຊ້​ໃນ​ປະ​ຈຸ​ບັນ​:"

#: src/cli.py:94
msgid "Invalid username format"
msgstr "ຮູບແບບຊື່ຜູ້ໃຊ້ບໍ່ຖືກຕ້ອງ"

#: src/cli.py:104
msgid ""
"Please run this command as root:\n"
msgstr ""
"ກະລຸນາດໍາເນີນການຄໍາສັ່ງນີ້ເປັນຮາກ:\n"

#: src/cli.py:110
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr ""
"ບໍ່ສາມາດເອີ້ນໃຊ້ຄໍາສັ່ງ ubuntu-hello ເປັນ root ໄດ້, ກະລຸນາດໍາເນີນການຄໍ"
"າສັ່ງນີ້ດ້ວຍທຸງຜູ້ໃຊ້"

#: src/compare.py:128 src/cli/add.py:32
msgid "Data files have not been downloaded, please run the following commands:"
msgstr "ບໍ່ໄດ້ດາວໂຫລດໄຟລ໌ຂໍ້ມູນ, ກະລຸນາດໍາເນີນການຄໍາສັ່ງຕໍ່ໄປນີ້:"

#: src/compare.py:154
msgid " LOGIN"
msgstr "ເຂົ້າສູ່ລະບົບ"

#: src/compare.py:155 src/cli/snap.py:44
msgid "Date: "
msgstr "ວັນທີ:"

#: src/compare.py:156
msgid "Scan time: "
msgstr "ເວລາສະແກນ:"

#: src/compare.py:157
msgid "Frames: "
msgstr "ຂອບ:"

#: src/compare.py:158
msgid "Hostname: "
msgstr "ຊື່ເຈົ້າພາບ:"

#: src/compare.py:159
msgid "Best certainty value: "
msgstr "ຄ່າຄວາມແນ່ນອນທີ່ດີທີ່ສຸດ:"

#: src/compare.py:266
msgid "Starting up..."
msgstr "ກຳລັງເລີ່ມ..."

#: src/compare.py:319
msgid "Identifying you..."
msgstr "ກຳລັງລະບຸຕົວເຈົ້າ..."

#: src/compare.py:351
msgid "FAILED"
msgstr "ລົ້ມເຫລວ"

#: src/compare.py:354 src/cli/add.py:188
msgid "All frames were too dark, please check dark_threshold in config"
msgstr "ເຟຣມທັງໝົດແມ່ນມືດເກີນໄປ, ກະລຸນາກວດເບິ່ງ dark_threshold ໃນ config"

#: src/compare.py:355 src/cli/add.py:189
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "ຄວາມມືດສະເລ່ຍ: {avg}, ເກນ: {threshold}"

#: src/compare.py:456
msgid "Time spent"
msgstr "ເວລາທີ່ໃຊ້"

#: src/compare.py:457
msgid "Starting up"
msgstr "ກຳລັງເລີ່ມຂຶ້ນ"

#: src/compare.py:458
msgid "  Open cam + load libs: %dms"
msgstr "ເປີດກ້ອງ + ໂຫຼດ libs: %dms"

#: src/compare.py:459
msgid "  Opening the camera"
msgstr "ການເປີດກ້ອງຖ່າຍຮູບ"

#: src/compare.py:460
msgid "  Importing recognition libs"
msgstr "ການ​ນໍາ​ເຂົ້າ libs ການ​ຮັບ​ຮູ້​"

#: src/compare.py:461
msgid "Searching for known face"
msgstr "ຊອກຫາໃບໜ້າທີ່ຮູ້ຈັກ"

#: src/compare.py:462
msgid "Total time"
msgstr "ເວລາທັງໝົດ"

#: src/compare.py:464
msgid ""
"\nResolution"
msgstr ""
"\nຄວາມລະອຽດ"

#: src/compare.py:466
msgid "  Native: %dx%d"
msgstr "ເດີມ: %dx%d"

#: src/compare.py:469
msgid "  Used: %dx%d"
msgstr "ໃຊ້ແລ້ວ: %dx%d"

#: src/compare.py:472
msgid ""
"\nFrames searched: %d (%.2f fps)"
msgstr ""
"\nຊອກຫາເຟຣມ: %d (%.2f fps)"

#: src/compare.py:473
msgid "Black frames ignored: %d "
msgstr "ຂອບສີດຳຖືກລະເລີຍ: %d"

#: src/compare.py:474
msgid "Dark frames ignored: %d "
msgstr "ຂອບມືດຖືກລະເລີຍ: %d"

#: src/compare.py:475
msgid "Certainty of winning frame: %.3f"
msgstr "ຄວາມແນ່ນອນຂອງການຊະນະກອບ: %.3f"

#: src/compare.py:477
msgid "Winning model: %d (\"%s\")"
msgstr "ລຸ້ນທີ່ຊະນະ: %d (\"%s\")"

#: src/compare.py:481
msgid "SUCCESSFUL"
msgstr "ສຳເລັດຜົນ"

#: src/wallet_backend.py:62 src/wallet_backend.py:72
msgid "KWallet"
msgstr "KWallet"

#: src/wallet_backend.py:64
msgid "GNOME Keyring"
msgstr "GNOME Keyring"

#: src/wallet_backend.py:65
msgid "None"
msgstr "None"

#: src/wallet_backend.py:74
msgid "login keyring"
msgstr "ເຂົ້າ​ສູ່​ລະ​ບົບ keyring"

#: src/wallet_backend.py:75
msgid "login keyring or KWallet"
msgstr "ກະແຈເຂົ້າສູ່ລະບົບ ຫຼື KWallet"

#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\nບໍ່ສາມາດນໍາເຂົ້າໂມດູນ dlib, ໃຫ້ກວດເບິ່ງຜົນຜະລິດຂອງ"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "ບໍ່ພົບໂຟນເດີຕົວແບບໃບໜ້າ, ສ້າງອັນດຽວ"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr "ຂໍ້ສັງເກດ: ແຕ່ລະຕົວແບບເພີ່ມເຕີມເຮັດໃຫ້ເຄື່ອງຈັກຮັບຮູ້ໃບໜ້າຊ້າລົງເລັກນ້ອຍ"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"ກົດ Ctrl+C ເພື່ອຍົກເລີກ\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "ເພີ່ມຮູບແບບໃບຫນ້າສໍາລັບຜູ້ໃຊ້"

#: src/cli/add.py:88
msgid "Model #"
msgstr "ຮຸ່ນ #"

#: src/cli/add.py:93
msgid "Using default label \"%s\" because of -y flag"
msgstr "ໃຊ້ປ້າຍກຳກັບເລີ່ມຕົ້ນ \"%s\" ເນື່ອງຈາກທຸງ -y"

#: src/cli/add.py:97
msgid "Enter a label for this new model [{}]: "
msgstr "ໃສ່ປ້າຍກຳກັບສຳລັບລຸ້ນໃໝ່ນີ້ [{}]:"

#: src/cli/add.py:107
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "ແຈ້ງ​ການ​: ການ​ລົບ​ຕົວ​ອັກ​ສອນ​ຜິດ​ກົດ​ຫມາຍ \",\" ຈາກ​ຊື່​ຕົວ​ແບບ​"

#: src/cli/add.py:121
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nກະລຸນາເບິ່ງກົງເຂົ້າໄປໃນກ້ອງຖ່າຍຮູບ"

#: src/cli/add.py:186
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "ກ້ອງຖ່າຍຮູບເຫັນພຽງແຕ່ກອບສີດໍາ - IR emitter ເຮັດວຽກບໍ?"

#: src/cli/add.py:191
msgid "No face detected, aborting"
msgstr "ບໍ່ພົບໃບໜ້າ, ເອົາລູກອອກ"

#: src/cli/add.py:196
msgid "Multiple faces detected, aborting"
msgstr "ກວດພົບຫຼາຍໃບໜ້າ, ການເອົາລູກອອກ"

#: src/cli/add.py:218
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nສະແກນສຳເລັດ\nເພີ່ມຮູບແບບໃໝ່ໃສ່"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr ""
"ບໍ່​ມີ​ຕົວ​ແບບ​ທີ່​ສ້າງ​ຂຶ້ນ​ເທື່ອ, ບໍ່​ສາ​ມາດ​ລົບ​ລ້າງ​ພວກ​ມັນ​ໄດ້​ຖ້"
"າ​ຫາກ​ວ່າ​ພວກ​ມັນ​ບໍ່​ມີ"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{} ບໍ່ມີແບບ ຫລື ລ້າງອອກແລ້ວ"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "ນີ້ຈະລຶບລ້າງຮູບແບບທັງຫມົດສໍາລັບ"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "ທ່ານຕ້ອງການສືບຕໍ່ [y/N]:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\nການແປເປັນ \"ບໍ່\", ຍົກເລີກ"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nລຶບລ້າງຕົວແບບແລ້ວ"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "ກຳລັງເປີດ config.ini ໃນ {editor}"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "ເປີດບັນນາທິການບໍ່ສຳເລັດ: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "ຜິດພາດ: ບໍ່ສາມາດຊອກຫາຕົວແກ້ໄຂຂໍ້ຄວາມທີ່ເຫມາະສົມ."

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr "ກະລຸນາຕິດຕັ້ງ 'nano' ຫຼື 'vi', ຫຼືຕັ້ງຕົວແປສະພາບແວດລ້ອມ EDITOR."

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."
msgstr ""
"ຖ້າທ່ານກໍາລັງແລ່ນຄໍາສັ່ງນີ້ກັບ sudo, ລອງ 'sudo -E ubuntu-hello config'"
" ເພື່ອຮັກສາຕົວແປ EDITOR ຂອງທ່ານ."

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "ກະລຸນາເພີ່ມ 0 (ເປີດໃຊ້ງານ) ຫຼື 1 (ປິດການໃຊ້ງານ) ເປັນການໂຕ້ຖຽງ"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr "ກະລຸນາໃຊ້ພຽງແຕ່ 0 (ເປີດໃຊ້ງານ) ຫຼື 1 (ປິດການໃຊ້ງານ) ເປັນການໂຕ້ຖຽງ"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "ທາງເລືອກປິດການໃຊ້ງານໄດ້ຖືກຕັ້ງໄວ້ແລ້ວ"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Ubuntu Helloຖືກປິດໃຊ້ງານ"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Ubuntu Helloຖືກເປີດໃຊ້ແລ້ວ"

#: src/cli/keyring.py:32 src/cli/keyring.py:148
msgid "Usage: keyring [enable|disable|restore [--all]]"
msgstr "ການໃຊ້ງານ: ພວງກະແຈ [ເປີດ|ປິດ|ກູ້ຄືນ] [--all]"


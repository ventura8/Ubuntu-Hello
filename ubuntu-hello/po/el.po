msgstr "Ετικέτα Ημερομηνίας Ταυτότητας [0μ"

#: src/cli/remove.py:16
msgid "Please add the ID of the model you want to remove as an argument"
msgstr ""
"Προσθέστε ως όρισμα το αναγνωριστικό του μοντέλου που θέλετε να καταργ"
"ήσετε"

#: src/cli/remove.py:17 src/cli/set.py:18
msgid "For example:"
msgstr "Για παράδειγμα:"

#: src/cli/remove.py:19
msgid "You can find the IDs by running:"
msgstr "Μπορείτε να βρείτε τα αναγνωριστικά εκτελώντας:"

#: src/cli/remove.py:52

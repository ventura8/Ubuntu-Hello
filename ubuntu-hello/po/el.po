msgid "Identifying you..."
msgstr "Αναγνωρίζοντας σας..."

#: src/compare.py:351
msgid "FAILED"
msgstr "ΑΠΟΤΥΧΗΜΕΝΟΣ"

#: src/compare.py:354 src/cli/add.py:188

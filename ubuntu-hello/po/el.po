#: src/cli/remove.py:89
msgid "Removed model {}"
msgstr "Καταργήθηκε το μοντέλο {}"

#: src/cli/set.py:17
msgid "Please add a setting you would like to change and the value to set it to"
msgstr ""
"Προσθέστε μια ρύθμιση που θέλετε να αλλάξετε και την τιμή στην οποία θ"
"α την ορίσετε"

#: src/cli/set.py:37
msgid "Could not find a \"{}\" config option to set"
msgstr "Δεν ήταν δυνατή η εύρεση της επιλογής ρύθμισης παραμέτρων \"{}\"."

#: src/cli/set.py:44
msgid "Config option updated"
msgstr "Η επιλογή διαμόρφωσης ενημερώθηκε"

#: src/cli/snap.py:43
msgid "GENERATED SNAPSHOT"
msgstr "ΔΗΜΙΟΥΡΓΗΜΕΝΟ ΣΤΙΓΜΥΡΙΟ"

#: src/cli/snap.py:45
msgid "Dark threshold config: "
msgstr "Διαμόρφωση σκοτεινού ορίου:"

#: src/cli/snap.py:46
msgid "Certainty config: "
msgstr "Διαμόρφωση βεβαιότητας:"

#: src/cli/snap.py:50

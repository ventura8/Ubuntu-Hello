msgstr "Αυτό θα καταργήσει το μοντέλο που ονομάζεται \"{label}\" για το {user}"

#: src/cli/remove.py:69
msgid "No model with ID {id} exists for {user}"
msgstr "Δεν υπάρχει μοντέλο με αναγνωριστικό {id} για το {user}"

#: src/cli/remove.py:75
msgid "Removed last model, ubuntu-hello disabled for user"
msgstr ""
"Καταργήθηκε το τελευταίο μοντέλο, το ubuntu-hello απενεργοποιήθηκε για"

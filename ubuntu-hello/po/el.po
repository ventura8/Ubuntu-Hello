#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\nΔεν είναι δυνατή η εισαγωγή της μονάδας dlib, ελέγξτε την έξοδο του"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "Δεν βρέθηκε φάκελος μοντέλου προσώπου, δημιουργώντας έναν"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr ""
"ΕΙΔΟΠΟΙΗΣΗ: Κάθε πρόσθετο μοντέλο επιβραδύνει ελαφρώς τον κινητήρα ανα"
"γνώρισης προσώπου"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"Πατήστε Ctrl+C για ακύρωση\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "Προσθήκη μοντέλου προσώπου για τον χρήστη"

#: src/cli/add.py:88
msgid "Model #"
msgstr "Μοντέλο #"

#: src/cli/add.py:93
msgid "Using default label \"%s\" because of -y flag"
msgstr "Χρήση προεπιλεγμένης ετικέτας \"%s\" λόγω της σημαίας -y"

#: src/cli/add.py:97
msgid "Enter a label for this new model [{}]: "
msgstr "Εισαγάγετε μια ετικέτα για αυτό το νέο μοντέλο [{}]:"

#: src/cli/add.py:107
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "ΕΙΔΟΠΟΙΗΣΗ: Αφαίρεση του παράνομου χαρακτήρα \",\" από το όνομα μοντέλου"

#: src/cli/add.py:121
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nΠαρακαλώ κοιτάξτε κατευθείαν στην κάμερα"

#: src/cli/add.py:186
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "Πριόνι κάμερας μόνο μαύρα πλαίσια - λειτουργεί ο πομπός υπερύθρων;"

#: src/cli/add.py:191
msgid "No face detected, aborting"
msgstr "Δεν εντοπίστηκε πρόσωπο, αποβολή"

#: src/cli/add.py:196
msgid "Multiple faces detected, aborting"
msgstr "Εντοπίστηκαν πολλά πρόσωπα, αποβολή"

#: src/cli/add.py:218
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nΗ σάρωση ολοκληρώθηκε\nΠροστέθηκε ένα νέο μοντέλο στο"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr ""
"Δεν έχουν δημιουργηθεί ακόμη μοντέλα, δεν είναι δυνατή η εκκαθάριση εά"
"ν δεν υπάρχουν"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "Το {} δεν έχει μοντέλα ή έχουν ήδη διαγραφεί"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "Αυτό θα διαγράψει όλα τα μοντέλα"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "Θέλετε να συνεχίσετε [y/N]:"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\nΕρμηνεία ως «ΟΧΙ», αποβολή"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nΤα μοντέλα εκκαθαρίστηκαν"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "Άνοιγμα config.ini στο {editor}"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "Απέτυχε το άνοιγμα του προγράμματος επεξεργασίας: {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "Σφάλμα: Δεν ήταν δυνατή η εύρεση του κατάλληλου επεξεργαστή κειμένου."

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr ""
"Εγκαταστήστε το 'nano' ή το 'vi' ή ορίστε τη μεταβλητή περιβάλλοντος E"
"DITOR."

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."
msgstr ""
"Εάν εκτελείτε αυτήν την εντολή με sudo, δοκιμάστε το 'sudo -E ubuntu-h"
"ello config' για να διατηρήσετε τη μεταβλητή EDITOR."

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr "Προσθέστε ένα 0 (ενεργοποίηση) ή ένα 1 (απενεργοποίηση) ως όρισμα"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr "Χρησιμοποιήστε μόνο 0 (ενεργοποίηση) ή 1 (απενεργοποίηση) ως όρισμα"

#: src/cli/disable.py:40
msgid "The disable option has already been set to "
msgstr "Η επιλογή απενεργοποίησης έχει ήδη οριστεί σε"

#: src/cli/disable.py:49
msgid "Ubuntu Hello has been disabled"
msgstr "Το Ubuntu Hello έχει απενεργοποιηθεί"

#: src/cli/disable.py:51
msgid "Ubuntu Hello has been enabled"
msgstr "Το Ubuntu Hello έχει ενεργοποιηθεί"

#: src/cli/keyring.py:32 src/cli/keyring.py:148
msgid "Usage: keyring [enable|disable|restore [--all]]"
msgstr "Χρήση: μπρελόκ [ενεργοποίηση|απενεργοποίηση|επαναφορά] [--all]"

#: src/cli/keyring.py:49
msgid "Enter password for user {} to unlock {} ({}): "
msgstr ""
"Εισαγάγετε τον κωδικό πρόσβασης για τον χρήστη {} για ξεκλείδωμα {} ({"
"}):"

#: src/cli/keyring.py:51
msgid "Password cannot be empty"
msgstr "Ο κωδικός πρόσβασης δεν μπορεί να είναι κενός"

#: src/cli/keyring.py:54
msgid "Confirm password: "
msgstr "Επιβεβαίωση κωδικού πρόσβασης:"

#: src/cli/keyring.py:56
msgid "Passwords do not match"
msgstr "Οι κωδικοί πρόσβασης δεν ταιριάζουν"

#: src/cli/keyring.py:65
msgid "TPM hardware detected. Auto-installing tpm2-tools..."
msgstr "Εντοπίστηκε υλικό TPM. Αυτόματη εγκατάσταση tpm2-tools..."

#: src/cli/keyring.py:74
msgid "TPM hardware active. Sealing password in TPM..."
msgstr "Το υλικό TPM είναι ενεργό. Σφράγιση κωδικού πρόσβασης στο TPM..."

#: src/cli/keyring.py:100
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} using TPM ("
"wallet: {})."
msgstr ""
"Το ξεκλείδωμα κλειδώματος/KWallet ενεργοποιήθηκε με επιτυχία για τον χ"
"ρήστη {} χρησιμοποιώντας TPM (πορτοφόλι: {})."

#: src/cli/keyring.py:102
msgid "Failed to seal password to TPM: {}"
msgstr "Απέτυχε η σφράγιση του κωδικού πρόσβασης στο TPM: {}"

#: src/cli/keyring.py:106
msgid "No TPM active. Using software-based credential caching..."
msgstr ""
"Δεν υπάρχει ενεργό TPM. Χρήση προσωρινής αποθήκευσης διαπιστευτηρίων π"
"ου βασίζεται σε λογισμικό..."

#: src/cli/keyring.py:122
msgid ""
"Keyring/KWallet unlocking enabled successfully for user {} (Software C"
"aching, wallet: {})."
msgstr ""
"Το ξεκλείδωμα κλειδώματος/KWallet ενεργοποιήθηκε με επιτυχία για τον χ"
"ρήστη {} (Αποθήκευση λογισμικού, πορτοφόλι: {})."

#: src/cli/keyring.py:124
msgid "Failed to enable keyring unlocking: {}"
msgstr "Αποτυχία ενεργοποίησης ξεκλειδώματος μπρελόκ: {}"

#: src/cli/keyring.py:135
msgid "Failed to disable keyring unlocking: {}"
msgstr "Αποτυχία απενεργοποίησης ξεκλειδώματος μπρελόκ: {}"

#: src/cli/keyring.py:138
msgid "Keyring/KWallet unlocking disabled for user {}."
msgstr "Το ξεκλείδωμα κλειδιού/KWallet είναι απενεργοποιημένο για τον χρήστη {}."

#: src/cli/keyring.py:140
msgid "Keyring/KWallet unlocking was not enabled for user {}."
msgstr "Το ξεκλείδωμα κλειδώματος/KWallet δεν ενεργοποιήθηκε για τον χρήστη {}."

#: src/cli/keyring.py:153
msgid "No sealed login passwords found; nothing to restore."
msgstr ""
"Δεν βρέθηκαν σφραγισμένοι κωδικοί σύνδεσης· δεν υπάρχει τίποτα για επα"
"ναφορά."

#: src/cli/keyring.py:155
msgid "Restored login wallet password for {} user(s)."
msgstr "Επαναφέρθηκε ο κωδικός πορτοφολιού σύνδεσης για {} χρήστη(ες)."

#: src/cli/keyring.py:157
msgid "Could not restore login wallet password for {} user(s)."
msgstr ""
"Δεν ήταν δυνατή η επαναφορά του κωδικού πορτοφολιού σύνδεσης για {} χρ"
"ήστη(ες)."

#: src/cli/keyring.py:158
msgid ""
"If prompts persist, set the login keyring or KWallet password in Seaho"
"rse / System Settings."
msgstr ""
"Αν τα μηνύματα συνεχίζονται, ορίστε τον κωδικό του μπρελόκ σύνδεσης ή "
"του KWallet στο Seahorse / Ρυθμίσεις συστήματος."

#: src/cli/keyring.py:161
msgid "Restored login wallet password for user {}."
msgstr "Επαναφέρθηκε ο κωδικός πορτοφολιού σύνδεσης για τον χρήστη {}."

#: src/cli/keyring.py:163
msgid "Could not restore login wallet password for user {}."
msgstr ""
"Δεν ήταν δυνατή η επαναφορά του κωδικού πορτοφολιού σύνδεσης για τον χ"
"ρήστη {}."

#: src/cli/keyring.py:167
msgid "Invalid action. Use 'enable', 'disable', or 'restore'."
msgstr ""
"Μη έγκυρη ενέργεια. Χρησιμοποιήστε «ενεργοποίηση», «απενεργοποίηση» ή "
"«επαναφορά»."

#: src/cli/list.py:17 src/cli/remove.py:25

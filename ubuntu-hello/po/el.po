msgstr "Όλα τα καρέ ήταν πολύ σκοτεινά, ελέγξτε το dark_threshold στη διαμόρφωση"

#: src/compare.py:355 src/cli/add.py:189
msgid "Average darkness: {avg}, Threshold: {threshold}"
msgstr "Μέσο σκοτάδι: {avg}, Κατώφλι: {threshold}"

#: src/compare.py:456
msgid "Time spent"
msgstr "Χρόνος που ξοδεύτηκε"

#: src/compare.py:457
msgid "Starting up"
msgstr "Εκκίνηση"

#: src/compare.py:458
msgid "  Open cam + load libs: %dms"
msgstr "Άνοιγμα έκκεντρου + φόρτωση λωρίδων: %dms"

#: src/compare.py:459
msgid "  Opening the camera"
msgstr "Άνοιγμα της κάμερας"

#: src/compare.py:460
msgid "  Importing recognition libs"
msgstr "Εισαγωγή libs αναγνώρισης"

#: src/compare.py:461
msgid "Searching for known face"
msgstr "Αναζήτηση γνωστού προσώπου"

#: src/compare.py:462
msgid "Total time"
msgstr "Συνολικός χρόνος"

#: src/compare.py:464
msgid ""
"\nResolution"
msgstr ""
"\nΨήφισμα"

#: src/compare.py:466
msgid "  Native: %dx%d"
msgstr "Εγγενής: %dx%d"

#: src/compare.py:469
msgid "  Used: %dx%d"
msgstr "Μεταχειρισμένο: %dx%d"

#: src/compare.py:472
msgid ""
"\nFrames searched: %d (%.2f fps)"
msgstr ""
"\nΑναζήτηση καρέ: %d (%.2f fps)"

#: src/compare.py:473
msgid "Black frames ignored: %d "
msgstr "Τα μαύρα καρέ αγνοήθηκαν: %d"

#: src/compare.py:474
msgid "Dark frames ignored: %d "
msgstr "Τα σκοτεινά καρέ αγνοήθηκαν: %d"

#: src/compare.py:475
msgid "Certainty of winning frame: %.3f"
msgstr "Βεβαιότητα νικηφόρου καρέ: %.3f"

#: src/compare.py:477
msgid "Winning model: %d (\"%s\")"
msgstr "Μοντέλο που κερδίζει: %d (\"%s\")"

#: src/compare.py:481
msgid "SUCCESSFUL"
msgstr "ΕΠΙΤΥΧΗΣ"


#: src/pam/main.cc:107
msgid "Failure, timeout reached"
msgstr "ပျက်ကွက်၊ အချိန်ကုန်သွားပါပြီ။"

#: src/pam/main.cc:114
msgid "Face detection image too dark"
msgstr "မျက်နှာ ထောက်လှမ်းမှုပုံသည် မှောင်လွန်းသည်။"

#: src/pam/main.cc:123
msgid "Unknown error: "
msgstr "အမည်မသိ အမှား-"

#: src/pam/main.cc:159
msgid "Identified face as %s"
msgstr "မျက်နှာကို %s အဖြစ် သတ်မှတ်ခဲ့သည်"

#: src/pam/main.cc:398
msgid ""
"Insufficient permissions to send Enter press, waiting for user to pres"
"s it instead"
msgstr ""
"Enter နှိပ် ပေးပို့ရန် ခွင့်ပြုချက် မလုံလောက်သဖြင့် ၎င်းအစား အသုံးပြုသ"
"ူကို နှိပ်ရန် စောင့်ဆိုင်းနေပါသည်။"

#: src/pam/main.cc:417 src/pam/main.cc:422
msgid "Failed to send Enter press, waiting for user to press it instead"
msgstr ""
"အသုံးပြုသူမှ ၎င်းအစား နှိပ်ရန် စောင့်ဆိုင်းနေစဉ် Enter နှိပ်၍ ပေးပို့ရ"
"န် မအောင်မြင်ပါ။"

#: src/pam/main.cc:534
msgid "Attempting facial authentication"
msgstr "မျက်နှာကို စစ်မှန်ကြောင်း သက်သေပြရန် ကြိုးစားနေပါသည်။"

#: src/cli.py:26
msgid "Could not determine user, please use the --user flag"
msgstr "အသုံးပြုသူကို မဆုံးဖြတ်နိုင်ပါ၊ ကျေးဇူးပြု၍ --user အလံကို အသုံးပြုပါ။"

#: src/cli.py:31
msgid "Command line interface for Ubuntu Hello face authentication."
msgstr "Ubuntu Hello မျက်နှာအထောက်အထားစိစစ်ခြင်းအတွက် ကွန်မန်းလိုင်းအင်တာဖေ့စ်။"

#: src/cli.py:35
msgid "command"
msgstr "အမိန့်"

#: src/cli.py:35
msgid "arguments"
msgstr "ဆင်ခြေများ"

#: src/cli.py:36
msgid ""
"For support please visit\nhttps://github.com/ventura8/ubuntu-hello"
msgstr ""
"ပံ့ပိုးမှုအတွက် ကျေးဇူးပြု၍ သွားရောက်ကြည့်ရှုပါ။\nhttps://github.com/v"
"entura8/ubuntu-hello"

#: src/cli.py:41
msgid ""
"The command option to execute, can be one of the following: add, clear"
", config, disable, keyring, list, remove, snapshot, set, test or versi"
"on."
msgstr ""
"လုပ်ဆောင်ရန် အမိန့်ပေးရွေးချယ်မှုသည် အောက်ပါတို့အနက်မှတစ်ခု ဖြစ်နိုင်သ"
"ည်- ထည့်ရန်၊ ရှင်းလင်းရန်၊ ပြင်ဆင်သတ်မှတ်ရန်၊ ပိတ်ရန်၊ သော့ချိတ်၊ စာရင"
"်း၊ ဖယ်ရှားရန်၊ လျှပ်တစ်ပြက်ရိုက်ချက်၊ သတ်မှတ်၊ စမ်းသပ်မှု သို့မဟုတ် ဗ"
"ားရှင်း။"

#: src/cli.py:48
msgid "Optional arguments for the add, disable, remove and set commands."
msgstr ""
"ပေါင်းထည့်ရန်၊ ပိတ်ရန်၊ ဖယ်ရှားရန်နှင့် အမိန့်ပေးရန်အတွက် ရွေးချယ်နိုင"
"်သော အကြောင်းပြချက်များ။"

#: src/cli.py:55
msgid "Set the user account to use."
msgstr "အသုံးပြုရန် အသုံးပြုသူအကောင့်ကို သတ်မှတ်ပါ။"

#: src/cli.py:60
msgid "Skip all questions."
msgstr "မေးခွန်းအားလုံးကို ကျော်လိုက်ပါ။"

#: src/cli.py:66
msgid "Print machine-friendly output."
msgstr "ပရင့်ထုတ်စက်နှင့် လိုက်ဖက်သော အထွက်။"

#: src/cli.py:72
msgid "With keyring restore: restore sealed login passwords for all users."
msgstr "With keyring restore: restore sealed login passwords for all users."

#: src/cli.py:80
msgid "Show this help message and exit."
msgstr "ဤအကူအညီမက်ဆေ့ဂျ်ကို ပြပြီး ထွက်လိုက်ပါ။"

#: src/cli.py:84
msgid "current active user: "
msgstr "လက်ရှိအသုံးပြုသူ-"

#: src/cli.py:94
msgid "Invalid username format"
msgstr "မမှန်ကန်သော အသုံးပြုသူအမည်ဖော်မတ်"

#: src/cli.py:104
msgid ""
"Please run this command as root:\n"
msgstr ""
"ကျေးဇူးပြု၍ ဤ command ကို root အဖြစ် run ပါ။\n"

#: src/cli.py:110
msgid ""
"Can't run ubuntu-hello commands as root, please run this command with "
"the --user flag"
msgstr ""
"ubuntu-hello ညွှန်ကြားချက်များကို root အဖြစ် မလုပ်ဆောင်နိုင်ပါ၊ ကျေးဇူ"
"းပြု၍ ဤအမိန့်ကို --user အလံဖြင့် လုပ်ဆောင်ပါ။"

#: src/compare.py:128 src/cli/add.py:32
msgid "Data files have not been downloaded, please run the following commands:"
msgstr ""
"ဒေတာဖိုင်များကို ဒေါင်းလုဒ်မလုပ်ရသေးပါ၊ ကျေးဇူးပြု၍ အောက်ပါ command မျ"
"ားကို လုပ်ဆောင်ပါ။"

#: src/compare.py:154
msgid " LOGIN"

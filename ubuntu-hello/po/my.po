msgstr "GNOME Keyring"

#: src/wallet_backend.py:65
msgid "None"
msgstr "None"

#: src/wallet_backend.py:74
msgid "login keyring"
msgstr "လော့ဂ်အင်သော့ချိတ်"

#: src/wallet_backend.py:75
msgid "login keyring or KWallet"
msgstr "အကောင့်ဝင်သော့ချိတ် သို့မဟုတ် KWallet"

#: src/cli/add.py:23
msgid ""
"\nCan't import the dlib module, check the output of"
msgstr ""
"\ndlib module ကို မတင်သွင်းနိုင်ပါ၊ ၏ output ကိုစစ်ဆေးပါ။"

#: src/cli/add.py:58
msgid "No face model folder found, creating one"
msgstr "မျက်နှာပုံစံ ဖိုင်တွဲကို ရှာမတွေ့ပါ၊ တစ်ခုဖန်တီးပါ။"

#: src/cli/add.py:69
msgid ""
"NOTICE: Each additional model slows down the face recognition engine s"
"lightly"
msgstr ""
"သတိပေးချက်- နောက်ထပ်မော်ဒယ်တစ်ခုစီသည် မျက်နှာမှတ်မိခြင်းအင်ဂျင်ကို အနည"
"်းငယ်နှေးကွေးစေသည်။"

#: src/cli/add.py:70
msgid ""
"Press Ctrl+C to cancel\n"
msgstr ""
"ပယ်ဖျက်ရန် Ctrl+C ကိုနှိပ်ပါ။\n"

#: src/cli/add.py:74
msgid "Adding face model for the user "
msgstr "အသုံးပြုသူအတွက် မျက်နှာပုံစံကို ထည့်သွင်းခြင်း။"

#: src/cli/add.py:88
msgid "Model #"
msgstr "မော်ဒယ် #"

#: src/cli/add.py:93
msgid "Using default label \"%s\" because of -y flag"
msgstr "-y အလံကြောင့် မူရင်းအညွှန်း \"%s\" ကို အသုံးပြုခြင်း။"

#: src/cli/add.py:97
msgid "Enter a label for this new model [{}]: "
msgstr "ဤမော်ဒယ်သစ် [{}] အတွက် အညွှန်းတစ်ခု ထည့်ပါ-"

#: src/cli/add.py:107
msgid "NOTICE: Removing illegal character \",\" from model name"
msgstr "သတိပေးချက်- မော်ဒယ်အမည်မှ တရားမဝင် စာလုံး \"\" ကို ဖယ်ရှားခြင်း။"

#: src/cli/add.py:121
msgid ""
"\nPlease look straight into the camera"
msgstr ""
"\nကျေးဇူးပြု၍ ကင်မရာကို တည့်တည့်ကြည့်ပေးပါ။"

#: src/cli/add.py:186
msgid "Camera saw only black frames - is IR emitter working?"
msgstr "ကင်မရာသည် အနက်ရောင်ဘောင်များကိုသာ မြင်သည် - IR emitter အလုပ်လုပ်ပါသလား။"

#: src/cli/add.py:191
msgid "No face detected, aborting"
msgstr "မျက်နှာကို မတွေ့ပါ၊ ဖျက်ပစ်ပါ။"

#: src/cli/add.py:196
msgid "Multiple faces detected, aborting"
msgstr "မျက်နှာများစွာကို တွေ့ရှိပြီး ပျက်သွားသည်"

#: src/cli/add.py:218
msgid ""
"\nScan complete\nAdded a new model to "
msgstr ""
"\nစကင်န်ဖတ်ပြီးပါပြီ။\nမော်ဒယ်အသစ်ကို ထပ်ထည့်လိုက်ပါတယ်။"

#: src/cli/clear.py:16
msgid "No models created yet, can't clear them if they don't exist"
msgstr "မော်ဒယ်များ မဖန်တီးရသေးပါ၊ မရှိလျှင် ၎င်းတို့ကို ရှင်းလင်း၍ မရပါ။"

#: src/cli/clear.py:21
msgid "{} has no models or they have been cleared already"
msgstr "{}တွင် မော်ဒယ်များ မရှိပါ သို့မဟုတ် ၎င်းတို့ကို ရှင်းလင်းပြီးဖြစ်ပါသည်။"

#: src/cli/clear.py:27
msgid "This will clear all models for "
msgstr "၎င်းသည် မော်ဒယ်အားလုံးကို ရှင်းလင်းမည်ဖြစ်သည်။"

#: src/cli/clear.py:28 src/cli/remove.py:53
msgid "Do you want to continue [y/N]: "
msgstr "ဆက်လုပ်လိုပါသလား [y/N]-"

#: src/cli/clear.py:32 src/cli/remove.py:57
msgid ""
"\nInterpreting as a \"NO\", aborting"
msgstr ""
"\n\"NO\" အဖြစ် ဘာသာပြန်ခြင်းကို ပျက်သွားစေသည်။"

#: src/cli/clear.py:37
msgid ""
"\nModels cleared"
msgstr ""
"\nမော်ဒယ်များကို ရှင်းလင်းထားသည်။"

#: src/cli/config.py:32
msgid "Opening config.ini in {editor}"
msgstr "{editor} တွင် config.ini ကိုဖွင့်နေသည်"

#: src/cli/config.py:38
msgid "Failed to open editor: {error}"
msgstr "တည်းဖြတ်သူကိုဖွင့်၍မရပါ- {error}"

#: src/cli/config.py:40
msgid "Error: Could not find a suitable text editor."
msgstr "အမှား- သင့်လျော်သော စာသားတည်းဖြတ်သူကို ရှာမတွေ့ပါ။"

#: src/cli/config.py:41
msgid "Please install 'nano' or 'vi', or set the EDITOR environment variable."
msgstr ""
"ကျေးဇူးပြု၍ 'nano' သို့မဟုတ် 'vi' ကို ထည့်သွင်းပါ၊ သို့မဟုတ် EDITOR ပတ"
"်၀န်းကျင် ပြောင်းလဲနိုင်သော အမျိုးအစားကို သတ်မှတ်ပါ။"

#: src/cli/config.py:42
msgid ""
"If you are running this command with sudo, try 'sudo -E ubuntu-hello c"
"onfig' to preserve your EDITOR variable."
msgstr ""
"သင်သည် ဤအမိန့်ကို sudo ဖြင့် လုပ်ဆောင်နေပါက၊ သင်၏ EDITOR variable ကို "
"ထိန်းသိမ်းရန် 'sudo -E ubuntu-hello config' ကို စမ်းကြည့်ပါ။"

#: src/cli/disable.py:22
msgid "Please add a 0 (enable) or a 1 (disable) as an argument"
msgstr ""
"အငြင်းအခုံအဖြစ် 0 (ဖွင့်ရန်) သို့မဟုတ် 1 (ပိတ်ရန်) ကို ကျေးဇူးပြု၍ ထည့"
"်ပါ။"

#: src/cli/disable.py:35
msgid "Please only use 0 (enable) or 1 (disable) as an argument"
msgstr "အငြင်းအခုံအဖြစ် 0 (ဖွင့်ရန်) သို့မဟုတ် 1 (ပိတ်ရန်) ကိုသာ အသုံးပြုပါ။"

#: src/cli/disable.py:40
